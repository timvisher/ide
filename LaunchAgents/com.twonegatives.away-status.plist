<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keep the human's away status current for agents at
  ~/.local/state/timvisher/away-status/status.json.

  Sixty seconds: the idle threshold is ten minutes, so a minute of
  staleness never changes the answer by much, and each run is ~80ms.
  Timers do not fire while the Mac sleeps, so readers treat a stale
  file as unknown rather than as present.

  __HOME__ is substituted with the real home directory by the deployer
  (LaunchAgents/bin/start); launchd does not expand ~ in path values.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.twonegatives.away-status</string>

	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/bin/timvisher_away_status</string>
		<string>--write</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>StartInterval</key>
	<integer>60</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/timvisher_away_status.log</string>

	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/timvisher_away_status.log</string>
</dict>
</plist>
