<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Auto-recompile AppleScript Script Libraries on change.

  __HOME__ is a placeholder substituted with the real home directory by
  LaunchAgents/bin/start when it deploys this plist (launchd does not
  expand ~ or environment variables inside ProgramArguments paths).

  KeepAlive is the restart mechanism: the watcher exits when entr -d
  detects a file added to a watched directory, and launchd brings it
  back up -- re-globbing the file list. ThrottleInterval keeps that from
  becoming a tight respawn loop.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.twonegatives.applescript-library-watch</string>

	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/bin/timvisher_applescript_library_watch</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/timvisher_applescript_library_watch.log</string>

	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/timvisher_applescript_library_watch.log</string>
</dict>
</plist>
