#!/usr/bin/env bash

# Tests for ~/.functions/gh.bash (shared gh helpers for timvisher_gh and
# timvisher_git).

failures=0
tests=0

fail() { echo "FAIL: $1" >&2; ((failures++)) || true; }
pass() { echo "PASS: $1"; }
run_test() { ((tests++)) || true; }

funcs_dir="$(cd "$(dirname "$0")/../functions" && pwd)" ||
  { echo "cannot resolve funcs_dir" >&2; exit 1; }
# shellcheck source=/dev/null
source "${funcs_dir}/gh.bash" ||
  { echo "cannot source gh.bash" >&2; exit 1; }

tmpdir=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }
trap 'rm -rf "$tmpdir"' EXIT

# --- repo_spec_from_url: host-agnostic parsing ---
check_spec() {
  local url=$1 want=$2 got
  run_test
  got=$(timvisher_gh__repo_spec_from_url "$url")
  if [[ $got == "$want" ]]
  then pass "repo_spec '$url' -> '$want'"
  else fail "repo_spec '$url': want '$want', got '$got'"
  fi
}
check_spec "https://github.com/DataDog/dd-source.git"         "DataDog/dd-source"
check_spec "https://github.com/DataDog/dd-source"             "DataDog/dd-source"
check_spec "git@github.com:DataDog/dd-source.git"             "DataDog/dd-source"
check_spec "ssh://git@github.com/DataDog/dd-source.git"       "DataDog/dd-source"
check_spec "git@ddoghq.github.com:ddoghq/dd-source.git"       "ddoghq/dd-source"
check_spec "git@ddoghq.github.com:ddoghq/dd-source"           "ddoghq/dd-source"
check_spec "ssh://git@ddoghq.github.com/ddoghq/dd-source.git" "ddoghq/dd-source"

# --- owner_for_repo: preferred-first probe, first 200 wins, cache, die-signal ---
mkdir -p "$tmpdir/mockbin2"
cat > "$tmpdir/mockbin2/gh" <<'MOCK'
#!/usr/bin/env bash
if [[ $1 == api && $2 == /repos/* ]]; then
  case "${2#/repos/}" in
    ddoghq/dd-source|ddoghq/both|DataDog/appgate|DataDog/both|DataDog/dd-source) exit 0 ;;
    *) exit 1 ;;
  esac
fi
exit 1
MOCK
chmod +x "$tmpdir/mockbin2/gh"
mgh="$tmpdir/mockbin2/gh"

export TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache"

owner_is() { # want alias repo candidates
  local want=$1 alias=$2 repo=$3 cands=$4 got rc
  run_test
  got=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
        timvisher_gh__owner_for_repo "$alias" "$repo" "$cands" "$mgh") && rc=0 || rc=$?
  if [[ $rc -eq 0 && $got == "$want" ]]
  then pass "owner_for_repo $alias/$repo [$cands] -> $want"
  else fail "owner_for_repo $alias/$repo [$cands]: want '$want', got '$got' (rc=$rc)"
  fi
}

# appgate only in DataDog: ddoghq probed first (404), falls back to DataDog.
owner_is DataDog dd appgate   "ddoghq,DataDog"
# dd-source in both: ddoghq wins because it is preferred-first, even though
# DataDog/dd-source also exists.
owner_is ddoghq  dd dd-source "ddoghq,DataDog"
# a repo in both, sanity: ddoghq preferred.
owner_is ddoghq  dd both      "ddoghq,DataDog"

# all candidates 404 -> non-zero, no output (caller turns this into a die).
run_test
if out=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
         timvisher_gh__owner_for_repo dd ghost "ddoghq,DataDog" "$mgh" 2>/dev/null)
then fail "owner_for_repo: absent repo should return non-zero (got '$out')"
else
  if [[ -z ${out:-} ]]
  then pass "owner_for_repo: absent repo returns non-zero with no output"
  else fail "owner_for_repo: absent repo printed '$out'"
  fi
fi

# cache hit never probes: seed the cache, then point at a gh that always fails.
run_test
mkdir -p "$tmpdir/ghcache/repo_owner/dd"
printf 'DataDog' > "$tmpdir/ghcache/repo_owner/dd/cached-repo"
if [[ $(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
        timvisher_gh__owner_for_repo dd cached-repo "ddoghq,DataDog" /bin/false) == "DataDog" ]]
then pass "owner_for_repo: cache hit returns without probing"
else fail "owner_for_repo: cache hit should return cached owner without probing"
fi

# a successful probe caches the answer: a second call with a gh that always
# fails must still resolve, proving it came from the cache rather than a probe.
run_test
rm -rf "$tmpdir/ghcache"
first=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
  timvisher_gh__owner_for_repo dd dd-source "ddoghq,DataDog" "$mgh")
second=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
  timvisher_gh__owner_for_repo dd dd-source "ddoghq,DataDog" /bin/false)
if [[ $first == "ddoghq" && $second == "ddoghq" ]]
then pass "owner_for_repo: successful probe caches the answer"
else fail "owner_for_repo: probe should cache (first='$first' second='$second')"
fi

echo ""
echo "Results: $((tests - failures))/${tests} passed"
(( failures == 0 ))
