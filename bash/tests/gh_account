check_web_owner "-"       https://github.com/../x
check_web_owner "-"       https://github.com/-bad/x
check_web_owner "-"       ddoghq/dd-source

# --- account_for_owner: config-driven via TIMVISHER_GH_CONFIG_DIR ---
cfg="$tmpdir/cfg"
mkdir -p "$cfg/orgs/ddoghq"
printf 'tim-visher_ddog\n' > "$cfg/orgs/ddoghq/account"
export TIMVISHER_GH_CONFIG_DIR="$cfg"

run_test
if [[ $(timvisher_gh__account_for_owner ddoghq) == "tim-visher_ddog" ]]
then pass "account_for_owner: mapped org -> account"
else fail "account_for_owner: mapped org should resolve"
fi

run_test
if timvisher_gh__account_for_owner DataDog 2>/dev/null
then fail "account_for_owner: unmapped org should return 1"
else pass "account_for_owner: unmapped org returns 1"
fi

# --- pin_token_for_owner: mock gh mints token; unmapped is a no-op ---
mkdir -p "$tmpdir/mockbin"
cat > "$tmpdir/mockbin/gh" <<'MOCK'
#!/usr/bin/env bash
if [[ $1 == auth && $2 == token ]]; then echo "gho_faketoken_for_emu"; exit 0; fi
exit 1
MOCK
chmod +x "$tmpdir/mockbin/gh"

run_test
if ( unset GH_TOKEN
     timvisher_gh__pin_token_for_owner ddoghq "$tmpdir/mockbin/gh" || exit 9
     [[ ${GH_TOKEN:-} == "gho_faketoken_for_emu" ]] || exit 8 )
then pass "pin_token_for_owner: mapped org exports GH_TOKEN"
else fail "pin_token_for_owner: mapped org should export GH_TOKEN"
fi

run_test
if ( unset GH_TOKEN
     timvisher_gh__pin_token_for_owner DataDog "$tmpdir/mockbin/gh" || exit 9
     [[ -z ${GH_TOKEN:-} ]] || exit 8 )
then pass "pin_token_for_owner: unmapped org is a no-op (no GH_TOKEN)"
else fail "pin_token_for_owner: unmapped org should not set GH_TOKEN"
fi

run_test
if ( unset GH_TOKEN
     if timvisher_gh__pin_token_for_owner ddoghq /bin/false; then exit 8; fi
     [[ -z ${GH_TOKEN:-} ]] || exit 7 )
then pass "pin_token_for_owner: token failure returns non-zero, no GH_TOKEN"
else fail "pin_token_for_owner: token failure should return non-zero without setting GH_TOKEN"
fi

# --- owner_for_repo: preferred-first probe, first 200 wins, cache, die-signal ---
mkdir -p "$tmpdir/mockbin2"
cat > "$tmpdir/mockbin2/gh" <<'MOCK'
#!/usr/bin/env bash
if [[ $1 == api && $2 == /repos/* ]]
then
  case "${2#/repos/}" in
    ddoghq/dd-source|ddoghq/both|DataDog/appgate|DataDog/both|DataDog/dd-source)
      exit 0
      ;;
    *)
      exit 1
      ;;
  esac
fi
exit 1
MOCK
chmod +x "$tmpdir/mockbin2/gh"
mgh="$tmpdir/mockbin2/gh"

export TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache"

owner_is() { # want alias repo candidates
  local want=$1 alias=$2 repo=$3 cands=$4 got rc
  run_test
  got=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
        timvisher_gh__owner_for_repo "$alias" "$repo" "$cands" "$mgh") && rc=0 || rc=$?
  if [[ $rc -eq 0 && $got == "$want" ]]
  then
    pass "owner_for_repo $alias/$repo [$cands] -> $want"
  else
    fail "owner_for_repo $alias/$repo [$cands]: want '$want', got '$got' (rc=$rc)"
  fi
}

# appgate only in DataDog: ddoghq probed first (404), falls back to DataDog.
owner_is DataDog dd appgate   "ddoghq,DataDog"
# dd-source in both: ddoghq wins because it is preferred-first, even though
# DataDog/dd-source also exists.
owner_is ddoghq  dd dd-source "ddoghq,DataDog"
# a repo in both, sanity: ddoghq preferred.
owner_is ddoghq  dd both      "ddoghq,DataDog"

# all candidates 404 -> non-zero, no output (caller turns this into a die).
run_test
if out=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
         timvisher_gh__owner_for_repo dd ghost "ddoghq,DataDog" "$mgh" 2>/dev/null)
then
  fail "owner_for_repo: absent repo should return non-zero (got '$out')"
else
  if [[ -z ${out:-} ]]
  then
    pass "owner_for_repo: absent repo returns non-zero with no output"
  else
    fail "owner_for_repo: absent repo printed '$out'"
  fi
fi

# cache hit never probes: seed the cache, then point at a gh that always fails.
run_test
mkdir -p "$tmpdir/ghcache/repo_owner/dd"
printf 'DataDog' > "$tmpdir/ghcache/repo_owner/dd/cached-repo"
if [[ $(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
        timvisher_gh__owner_for_repo dd cached-repo "ddoghq,DataDog" /bin/false) == "DataDog" ]]
then
  pass "owner_for_repo: cache hit returns without probing"
else
  fail "owner_for_repo: cache hit should return cached owner without probing"
fi

# a successful probe caches the answer: a second call with a gh that always
# fails must still resolve, proving it came from the cache rather than a probe.
run_test
rm -rf "$tmpdir/ghcache"
first=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
  timvisher_gh__owner_for_repo dd dd-source "ddoghq,DataDog" "$mgh")
second=$(TIMVISHER_GH_CACHE_DIR="$tmpdir/ghcache" \
  timvisher_gh__owner_for_repo dd dd-source "ddoghq,DataDog" /bin/false)
if [[ $first == "ddoghq" && $second == "ddoghq" ]]
then
  pass "owner_for_repo: successful probe caches the answer"
else
  fail "owner_for_repo: probe should cache (first='$first' second='$second')"
fi

echo ""
echo "Results: $((tests - failures))/${tests} passed"
(( failures == 0 ))
