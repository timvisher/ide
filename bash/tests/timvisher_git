# Test: fork dies when an unrelated repo with the fork name exists.
# parentorg/collisionrepo is the request; myuser/collisionrepo also
# exists but is NOT a fork. Without the collision check, fork would
# silently clone myuser/collisionrepo (the unrelated repo) instead
# of forking parentorg/collisionrepo and cloning that.
run_test
result=$(
  clone() { printf 'CLONE %s\n' "$1"; }
  fork "parentorg/collisionrepo" 2>&1
) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"already exists but is not a fork"* ]] && \
   [[ $result != *"CLONE"* ]]
then
  pass "fork dies on name collision with non-fork"
else
  fail "fork collision: expected die with 'not a fork', no clone; got rc=${rc} result='${result}'"
fi

# ---------------------------------------------------------------------------
# should_auto_fork tests
#
# Mock gh: nopush/parentrepo is a fork-of-parent that I lack push to.
# parentorg/parentrepo is a non-fork I lack push to.  Branch "main"
# exists on each; "feature-x" does not.
# ---------------------------------------------------------------------------

# Test: triggers when branch missing AND no push rights AND foreign org
run_test
should_auto_fork "parentorg/parentrepo/feature-x" && rc=0 || rc=$?
if (( rc == 0 ))
then
  pass "should_auto_fork: triggers on missing branch + no push + foreign org"
else
  fail "should_auto_fork triggered: expected rc=0, got rc=${rc}"
fi

# Test: no-op when branch already exists on the named repo
run_test
should_auto_fork "parentorg/parentrepo/main" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: no-op when branch exists on the named repo"
else
  fail "expected no auto-fork when branch exists, got rc=${rc}"
fi

# Test: no-op when input org matches gh user (we own it)
run_test
should_auto_fork "myuser/parentrepo/feature-x" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: no-op when input org matches gh user"
else
  fail "expected no auto-fork on own org, got rc=${rc}"
fi

# Test: no-op when input is bare org/repo (no branch component)
run_test
should_auto_fork "parentorg/parentrepo" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: no-op for bare org/repo (no branch)"
else
  fail "expected no auto-fork for org/repo, got rc=${rc}"
fi

# Test: TIMVISHER_GIT_NO_AUTO_FORK env var disables the feature
run_test
TIMVISHER_GIT_NO_AUTO_FORK=1 should_auto_fork "parentorg/parentrepo/feature-x" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: disabled by TIMVISHER_GIT_NO_AUTO_FORK env var"
else
  fail "expected env-var disable to suppress auto-fork, got rc=${rc}"
fi

# Test: no-op for PR URLs — auto-fork is only for org/repo/branch
# shorthands, but URLs match the */*/* shape too because they have
# many slashes.  Regression: ntmux3 of a PR URL on a foreign repo
# treated the entire URL tail as the "branch" and forked spuriously.
run_test
should_auto_fork "https://github.com/parentorg/parentrepo/pull/698" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: no-op for PR URLs"
else
  fail "expected no auto-fork for PR URL, got rc=${rc}"
fi

# Test: no-op for tree URLs
run_test
should_auto_fork "https://github.com/parentorg/parentrepo/tree/feature-x" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: no-op for tree URLs"
else
  fail "expected no auto-fork for tree URL, got rc=${rc}"
fi

# Test: no-op for SSH (SCP-style) URLs
run_test
should_auto_fork "git@github.com:parentorg/parentrepo.git" && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "should_auto_fork: no-op for git@ SSH URLs"
else
  fail "expected no auto-fork for git@ URL, got rc=${rc}"
fi

# ---------------------------------------------------------------------------
# worktree_gc__reap_reason: which ref the ancestry leg measures against.
# gc wants the trunk as it is now; a dev_ci run wants the commit it pinned.
# ---------------------------------------------------------------------------

rr_cache="$tmpdir/reap_cache"
rr_wt="$tmpdir/reap_wt"
mkdir -p "$rr_cache" "$rr_wt" || exit 1

# Leg 1 needs a recorded PR URL and leg 3 needs a repo slug; with neither,
# only the ancestry leg runs.
rr_branch=refs/heads/feature
rr_pin=1111111111111111111111111111111111111111

# No upstream remote, so the resolved trunk is origin/<trunk>.
mock_respond git --exit 1 -- -C "$rr_cache" show-ref --verify --quiet refs/remotes/upstream/main

# Reachable from the pinned commit, but not from origin/main.
mock_respond git --exit 1 -- -C "$rr_cache" merge-base --is-ancestor "$rr_branch" origin/main
mock_respond git -- -C "$rr_cache" merge-base --is-ancestor "$rr_branch" "$rr_pin"

run_test
rr_out=$(worktree_gc__reap_reason "$rr_wt" "$rr_cache" "$rr_branch" main "" "$rr_pin")
rr_rc=$?
if (( rr_rc == 0 )) && [[ $rr_out == "ancestor of ${rr_pin}" ]]
then
  pass "reap_reason: a given ancestry target is the one measured against"
else
  fail "pinned target: rc=${rr_rc} out='${rr_out}'"
fi

run_test
rr_out=$(worktree_gc__reap_reason "$rr_wt" "$rr_cache" "$rr_branch" main "")
rr_rc=$?
if (( rr_rc != 0 ))
then
  pass "reap_reason: without one it falls back to the resolved trunk"
else
  fail "default target: expected non-zero, got rc=${rr_rc} out='${rr_out}'"
fi

# ---------------------------------------------------------------------------
# worktree_gc__never_started: a branch that has not started has not landed.
# Both a fresh worktree and a deliberately emptied one sit on the trunk, so
# only the reflog separates them.
# ---------------------------------------------------------------------------

ns_wt="$tmpdir/never_started_wt"
mkdir -p "$ns_wt" || exit 1
ns_branch=refs/heads/feature

run_test
mock_respond git --stdout '1fb9ed01 feature@{0}: branch: Created from origin/main' -- \
  -C "$ns_wt" reflog show "$ns_branch"
if worktree_gc__never_started "$ns_wt" "$ns_branch"
then
  pass "never_started: a lone creation entry means the branch never started"
else
  fail "lone creation entry: expected never-started"
fi

run_test
mock_respond git --stdout '7e857d59 feature@{0}: reset: moving to upstream/main
d2b94e63 feature@{1}: commit: real work
1fb9ed01 feature@{2}: branch: Created from origin/main' -- \
  -C "$ns_wt" reflog show "$ns_branch"
if ! worktree_gc__never_started "$ns_wt" "$ns_branch"
then
  pass "never_started: a branch emptied back onto the trunk did start"
else
  fail "emptied branch: expected started, so it stays retirable"
fi

run_test
mock_respond git --stdout '' -- -C "$ns_wt" reflog show "$ns_branch"
if ! worktree_gc__never_started "$ns_wt" "$ns_branch"
then
  pass "never_started: no reflog says nothing, so the usual checks run"
else
  fail "absent reflog: expected fall-through"
fi

# ---------------------------------------------------------------------------
# worktree_gc__trunk_ref: which trunk a worktree's branch lands in. Same
# three cases resolve_retire_merge_ref covers, over a resolved trunk branch.
# ---------------------------------------------------------------------------

tr_cache="$tmpdir/trunkref_cache"
mkdir -p "$tr_cache" || exit 1

run_test
tr_wt="$tmpdir/trunkref_softfork"
mkdir -p "$tr_wt" || exit 1
touch "$tr_wt/x.timvisher_git.soft-fork"
tr_out=$(worktree_gc__trunk_ref "$tr_wt" "$tr_cache" main)
if [[ $tr_out == origin/main ]]
then
  pass "trunk_ref: a soft fork lands in its own origin"
else
  fail "soft fork: expected 'origin/main', got '${tr_out}'"
fi

run_test
tr_wt="$tmpdir/trunkref_fork"
mkdir -p "$tr_wt" || exit 1
mock_respond git -- -C "$tr_cache" show-ref --verify --quiet refs/remotes/upstream/main
tr_out=$(worktree_gc__trunk_ref "$tr_wt" "$tr_cache" main)
if [[ $tr_out == upstream/main ]]
then
  pass "trunk_ref: a fork lands in the parent's upstream"
else
  fail "fork: expected 'upstream/main', got '${tr_out}'"
fi

run_test
tr_wt="$tmpdir/trunkref_plain"
mkdir -p "$tr_wt" || exit 1
mock_respond git --exit 1 -- -C "$tr_cache" show-ref --verify --quiet refs/remotes/upstream/main
tr_out=$(worktree_gc__trunk_ref "$tr_wt" "$tr_cache" main)
if [[ $tr_out == origin/main ]]
then
  pass "trunk_ref: with no upstream remote it falls back to origin"
else
  fail "plain repo: expected 'origin/main', got '${tr_out}'"
fi

mock_finish || (( failures += 1 ))

echo ""
echo "Results: $((tests - failures))/${tests} passed"

if (( 0 < failures ))
then
  exit 1
fi
