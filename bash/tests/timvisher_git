#!/usr/bin/env bash
# shellcheck source=bash/tests/lib/timvisher_git.bash
source "$(dirname "$0")/lib/timvisher_git.bash" || exit 1

# Tests for timvisher_git functions that need no real repository. git
# is mocked with no passthrough: a test answers the git calls its unit
# makes, and any other call fails the suite. Tests of real repository
# state live in bash/tests/integration/timvisher_git.

source_timvisher_git

repo_trunks_dir="$cache_dir/repo_trunks"
live_repo_dir="$live_dir"

# ---------------------------------------------------------------------------
# maintenance scheduler ensure tests
# ---------------------------------------------------------------------------

# Stub git so these never touch real launchd.
ms_home="$tmpdir/sched_home"
mkdir -p "$ms_home/Library/LaunchAgents" "$ms_home/.config/git" \
  "$ms_home/cache" "$ms_home/trunk" "$ms_home/stub"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$MS_LOG"\nexit ${MS_RC:-0}\n' \
  > "$ms_home/stub/git"
chmod +x "$ms_home/stub/git"

ms_run() {
  MS_LOG="$ms_home/invocations" MS_RC="${1:-0}" \
    PATH="$ms_home/stub:$PATH" \
    new_cache_root="$ms_home/cache" \
    timvisher_tests_with_home "$ms_home" ensure_maintenance_scheduler "$ms_home/trunk"
}
ms_stamp="$ms_home/cache/.timvisher_maintenance_scheduler_attempted"

# Present scheduler must be a silent no-op -- this is the normal path and
# runs on every git invocation.
run_test
: > "$ms_home/Library/LaunchAgents/org.git-scm.git.daily.plist"
: > "$ms_home/invocations"
ms_run >/dev/null 2>&1
if [[ ! -s $ms_home/invocations ]]
then
  pass "ensure_maintenance_scheduler does nothing when the scheduler is present"
else
  fail "ensure_maintenance_scheduler ran git with a scheduler present: $(cat "$ms_home/invocations")"
fi

# Missing scheduler must install via launchctl, and must not write the
# registration into the tracked global config.
run_test
rm -f "$ms_home/Library/LaunchAgents/org.git-scm.git.daily.plist" "$ms_stamp"
: > "$ms_home/invocations"
ms_run >/dev/null 2>&1
ms_got=$(cat "$ms_home/invocations" 2>/dev/null)
if [[ $ms_got == *"maintenance start"* && $ms_got == *"--scheduler=launchctl"* &&
      $ms_got == *"--config-file ${ms_home}/.config/git/config_machine"* ]]
then
  pass "ensure_maintenance_scheduler installs via launchctl with --config-file"
else
  fail "ensure_maintenance_scheduler invocation wrong: '${ms_got}'"
fi

run_test
if [[ ! -f $ms_stamp ]]
then
  pass "ensure_maintenance_scheduler clears its attempt stamp on success"
else
  fail "attempt stamp should be gone after a successful install"
fi

# A failing install must leave the stamp so it does not fork on every
# subsequent git call.
run_test
rm -f "$ms_stamp"
: > "$ms_home/invocations"
ms_run 1 >/dev/null 2>&1
if [[ -f $ms_stamp ]]
then
  pass "ensure_maintenance_scheduler keeps its stamp after a failed install"
else
  fail "attempt stamp should persist after a failed install"
fi

run_test
: > "$ms_home/invocations"
ms_run 1 >/dev/null 2>&1
if [[ ! -s $ms_home/invocations ]]
then
  pass "ensure_maintenance_scheduler does not retry while the stamp exists"
else
  fail "ensure_maintenance_scheduler retried despite the stamp"
fi

# ---------------------------------------------------------------------------
# hook org-alias fallthrough tests
# ---------------------------------------------------------------------------

hook_alias_saved_hooks_dir=$hooks_dir
hooks_dir="$tmpdir/hook_alias/hooks"
mkdir -p "$hooks_dir/DataDog/dd-source"
printf '#!/usr/bin/env bash\necho HOOK_RAN\n' \
  > "$hooks_dir/DataDog/dd-source/post-make-branch-dir"
chmod +x "$hooks_dir/DataDog/dd-source/post-make-branch-dir"
org_aliases[dd]="ddoghq,DataDog"
org_aliases[datadog]="ddoghq,DataDog"

# Resolved org first, then alias siblings, deduped across alias groups.
run_test
result=$(hook_org_candidates ddoghq | tr '\n' ' ')
if [[ $result == "ddoghq DataDog " ]]
then
  pass "hook_org_candidates puts resolved org first, then alias siblings"
else
  fail "hook_org_candidates ddoghq: expected 'ddoghq DataDog ', got '${result}'"
fi

run_test
result=$(hook_org_candidates DataDog | tr '\n' ' ')
if [[ $result == "DataDog ddoghq " ]]
then
  pass "hook_org_candidates orders by resolved org, not alias order"
else
  fail "hook_org_candidates DataDog: expected 'DataDog ddoghq ', got '${result}'"
fi

# An org in no alias group resolves to just itself.
run_test
result=$(hook_org_candidates xenodium | tr '\n' ' ')
if [[ $result == "xenodium " ]]
then
  pass "hook_org_candidates leaves a non-alias org untouched"
else
  fail "hook_org_candidates xenodium: expected 'xenodium ', got '${result}'"
fi

# The regression this guards: dd-source resolves to ddoghq but its hooks
# live under DataDog/, so without fallthrough they silently stop running.
# Hook output goes to stderr (maybe_execute_hook runs it with >&2), and warn
# is level-gated, so pin the level rather than inherit the ambient one.
run_test
stderr=$(timvisher_logging_log_level=WARN \
  maybe_execute_hook ddoghq dd-source post-make-branch-dir 2>&1 >/dev/null)
if [[ $stderr == *HOOK_RAN* ]]
then
  pass "maybe_execute_hook runs a hook found under an alias org"
else
  fail "maybe_execute_hook ddoghq/dd-source: expected HOOK_RAN, got '${stderr}'"
fi

run_test
stderr=$(timvisher_logging_log_level=WARN \
  maybe_execute_hook ddoghq dd-source post-make-branch-dir 2>&1 >/dev/null)
if [[ $stderr == *"absent; running alias org DataDog/dd-source"* ]]
then
  pass "maybe_execute_hook warns when it falls through to an alias org"
else
  fail "maybe_execute_hook should warn on alias fallthrough, got '${stderr}'"
fi

# An exact hit runs the hook but must not warn — the warning marks drift.
run_test
stderr=$(timvisher_logging_log_level=WARN \
  maybe_execute_hook DataDog dd-source post-make-branch-dir 2>&1 >/dev/null)
if [[ $stderr == *HOOK_RAN* && $stderr != *"alias org"* ]]
then
  pass "maybe_execute_hook does not warn on an exact org hit"
else
  fail "maybe_execute_hook should not warn on exact hit, got '${stderr}'"
fi

# No hook under any candidate org is still a no-op, not an error.
run_test
maybe_execute_hook ddoghq no-such-repo post-make-branch-dir >/dev/null 2>&1
if (( $? == 0 ))
then
  pass "maybe_execute_hook is a silent no-op when no candidate org has the hook"
else
  fail "maybe_execute_hook should succeed when no hook exists"
fi

# ---------------------------------------------------------------------------
# die_if_trunk_cached_under_alias_org tests
# ---------------------------------------------------------------------------

alias_trunk_saved_repo_trunks_dir=$repo_trunks_dir
repo_trunks_dir="$tmpdir/alias_trunk/repo_trunks"
mkdir -p "$repo_trunks_dir/DataDog/moved-repo" "$repo_trunks_dir/DataDog/noted-repo" \
  "$repo_trunks_dir/xenodium/solo-repo"
printf 'PICKUP: see the migration epic\n' > "$repo_trunks_dir/DataDog/noted-repo/x.relocation-note"

run_test
stderr=$( (die_if_trunk_cached_under_alias_org ddoghq moved-repo) 2>&1 >/dev/null )
rc=$?
if (( rc != 0 )) &&
  [[ $stderr == *"Refusing to clone a second trunk"* ]] &&
  [[ $stderr == *"$repo_trunks_dir/DataDog/moved-repo"* ]]
then
  pass "die_if_trunk_cached_under_alias_org refuses when an alias org holds the trunk"
else
  fail "die_if_trunk_cached_under_alias_org ddoghq moved-repo: rc=${rc} stderr='${stderr}'"
fi

run_test
stderr=$( (die_if_trunk_cached_under_alias_org ddoghq noted-repo) 2>&1 >/dev/null )
rc=$?
if (( rc != 0 )) && [[ $stderr == *"PICKUP: see the migration epic"* ]]
then
  pass "die_if_trunk_cached_under_alias_org prints the other trunk's x.relocation-note"
else
  fail "die_if_trunk_cached_under_alias_org should print x.relocation-note: rc=${rc} stderr='${stderr}'"
fi

run_test
( die_if_trunk_cached_under_alias_org ddoghq never-cached ) >/dev/null 2>&1
rc=$?
if (( rc == 0 ))
then
  pass "die_if_trunk_cached_under_alias_org allows a clone when no alias org holds the trunk"
else
  fail "die_if_trunk_cached_under_alias_org ddoghq never-cached: expected rc 0, got ${rc}"
fi

run_test
( die_if_trunk_cached_under_alias_org xenodium solo-repo ) >/dev/null 2>&1
rc=$?
if (( rc == 0 ))
then
  pass "die_if_trunk_cached_under_alias_org ignores the org's own trunk and non-alias orgs"
else
  fail "die_if_trunk_cached_under_alias_org xenodium solo-repo: expected rc 0, got ${rc}"
fi

repo_trunks_dir=$alias_trunk_saved_repo_trunks_dir

# ---------------------------------------------------------------------------
# ensure_worktree cache_trunk failure tests
# ---------------------------------------------------------------------------

run_test
stderr=$(
  cache_trunk() { return 1; }
  branch_path_for_source() { printf 'ENSURE_WORKTREE_CONTINUED' >&2; }
