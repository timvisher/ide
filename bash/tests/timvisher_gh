# Test: issue opens existing issue.md.url if present
run_test
echo "https://github.com/testuser/testrepo/issues/42" > "$tmpdir/repo/issue.md.url"
export MOCK_LOG="$tmpdir/log_issue_existing"
touch "$MOCK_LOG"
PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' issue" 2>&1 || true
if grep -q 'mock-open.*https://github.com/testuser/testrepo/issues/42' "$MOCK_LOG"
then
  pass "issue opens existing issue.md.url"
else
