mkdir -p "$tmpdir/mockbin_react"
cat > "$tmpdir/mockbin_react/gh" <<'MOCK'
#!/usr/bin/env bash
echo "mock-gh $*" >> "$MOCK_LOG"
if [[ $1 == api ]]
then
  echo "${GH_TOKEN-unset} $*" >> "${MOCK_LOG}.tokens"
fi
if [[ $1 == auth && $2 == token ]]
then
  [[ $6 == brokenacct ]] && exit 1
  echo "token-$6"
elif [[ $1 == api && $2 == --method && $3 == HEAD && $5 =~ ^/repos/[^/]+/[^/]+$ ]]
then
  if [[ ${MOCK_REPO_HEAD_STATUS:-200} == 200 ]]
  then
    printf 'HTTP/2.0 200 OK\r\n\r\n'
  else
    printf 'HTTP/2.0 %s Error\r\n\r\n' "$MOCK_REPO_HEAD_STATUS"
    exit 1
  fi
elif [[ $1 == api && $2 == --include && $3 == --method && $4 == POST ]]
then
  case ${MOCK_POST_MODE:-201} in
    200)
      printf 'HTTP/2.0 200 OK\n'
      ;;
    fail)
      echo 'gh: Forbidden (HTTP 403)' >&2
      exit 1
      ;;
    garbage)
      printf 'HTTP/2.0 201 Created\nContent-Type: application/json\r\n\r\nnull\n'
      exit 0
      ;;
    *)
      printf 'HTTP/2.0 201 Created\n'
      ;;
  esac
  printf 'Content-Type: application/json; charset=utf-8\r\n\r\n987654321\n'
elif [[ $1 == api && $2 == --method && $3 == HEAD ]]
then
  case ${MOCK_HEAD_STATUS:-200} in
    none)
      exit 1
      ;;
    200)
      printf 'HTTP/2.0 200 OK\r\n\r\n'
      ;;
    *)
      printf 'HTTP/2.0 %s Error\r\n\r\n' "$MOCK_HEAD_STATUS"
      exit 1
      ;;
  esac
elif [[ $1 == api && $2 == --method && $3 == DELETE ]]
then
  case ${MOCK_DELETE_STATUS:-204} in
    none)
      exit 1
      ;;
    204)
      printf 'HTTP/2.0 204 No Content\r\n\r\n'
      ;;
    *)
      printf 'HTTP/2.0 %s Error\r\n\r\n{"message":"mock %s","status":"%s"}' "$MOCK_DELETE_STATUS" "$MOCK_DELETE_STATUS" "$MOCK_DELETE_STATUS"
      exit 1
      ;;
  esac
fi
MOCK
