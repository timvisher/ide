crun() {
  local -a envs=()
  local keep_state=0 e pair node
  while [[ ${1-} != -- ]]
  do
    [[ $1 == MOCK_STATE_KEEP=1 ]] && keep_state=1
    envs+=("$1")
    shift
  done
  shift
  if (( ! keep_state ))
  then
    rm -rf "$tmpdir/mock_state"
    mkdir -p "$tmpdir/mock_state"
    for e in "${envs[@]}"
    do
      [[ $e == MOCK_REACTED=* ]] ||
        continue
      for pair in ${e#MOCK_REACTED=}
      do
        node=${pair%%=*}
        tr ',' '\n' <<<"${pair#*=}" > "$tmpdir/mock_state/$node"
      done
    done
  fi
  envs+=(MOCK_STATE_DIR="$tmpdir/mock_state")
  export MOCK_LOG="$tmpdir/log_comment"
  : > "$MOCK_LOG"
  : > "${MOCK_LOG}.tokens"
  c_out=$(
    cd "$tmpdir/repo" &&
      printf '%s' "${c_stdin-}" |
      env -u GH_TOKEN TIMVISHER_GH_CONFIG_DIR="$tmpdir/ghconfig" "${envs[@]}" PATH="$comment_path" timvisher_logging_log_level=INFO \
        bash -c "source '${funcs_dir}/logging.bash'; \"\$0\" \"\$@\"" "$script" "$@" \
        2>"$tmpdir/comment_err"
  )
  c_rc=$?
  c_err=$(< "$tmpdir/comment_err")
}

creset() {
  local f
  for f in "$@"
  do
    rm -f "$tmpdir/repo/$f" "$tmpdir/repo/$f.json" "$tmpdir/repo/$f.url"
  done
  rm -f "$tmpdir/repo/pr.md.url"
}

cfile() {
  printf '%s\n' "$2" > "$tmpdir/repo/$1"
}

csidecar() {
  printf '%s\n' "$2" > "$tmpdir/repo/$1.json"
}

cjq() {
  jq -r "$2" "$tmpdir/repo/$1.json" 2>/dev/null
}

no_api() {
  ! grep -q '^mock-gh' "$MOCK_LOG"
}

expect_clean_fail() {
  local name=$1 expected=$2
  if (( c_rc != 0 )) && [[ -z $c_out && $c_err == *"$expected"* ]]
  then
    pass "$name"
  else
    fail "$name: rc=${c_rc} stdout='${c_out}' stderr='${c_err}' log=$(cat "$MOCK_LOG")"
  fi
}

cfail() {
  fail "$1: rc=${c_rc} stdout='${c_out}' stderr='${c_err}' log=$(cat "$MOCK_LOG")"
}

