    echo '{"id":102,"node_id":"PRRC_new","html_url":"https://github.com/testuser/testrepo/pull/50#discussion_r102","created_at":"2026-10-10T12:01:00Z"}'
    ;;
  'api --method PATCH '*|'api --method PUT '*)
    mock_id=\${4##*/}
    for mock_arg in "\$@"
    do
      if [[ \$mock_arg == body=* ]]
      then
        jq -n --arg b "\${mock_arg#body=}" '{body: \$b}' > "$conv_dir/remote_\$mock_id.json"
      fi
    done
    echo '{}'
    ;;
  'api repos/'*)
    mock_id=\${2##*/}
    respond < "$conv_dir/remote_\$mock_id.json"
    ;;
  'pr view'*)
    echo '{"title":"","body":""}' | respond
    ;;
esac
HANDLER
}

