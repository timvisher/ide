merge_graphql() {
  local state=$1 extra=${2-}
  jq -n --arg state "$state" --argjson extra "${extra:-{\}}" '
    {data: {viewer: {login: "testuser"},
            repository: {pullRequest: ({
              state: $state,
              isInMergeQueue: false,
              autoMergeRequest: null,
              mergeCommit: (if $state == "MERGED" then {oid: "abc123"} else null end),
              commits: {nodes: [{commit: {committedDate: "2026-10-10T10:00:00Z"}}]},
              timelineItems: {nodes: []}
