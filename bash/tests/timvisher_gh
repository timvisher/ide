#!/usr/bin/env bash

# Tests for timvisher_gh
# Heavy mocking since this interacts with git, gh, and macOS open.

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

script="$(cd "$(dirname "$0")/.." && pwd)/bin/timvisher_gh"
funcs_dir="$(cd "$(dirname "$0")/../functions" && pwd)"
real_git="$(brew --prefix)/bin/git"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# Set up a fake git repo
mkdir -p "$tmpdir/repo"
cd "$tmpdir/repo" ||
  { echo "cannot cd to the fixture repo" >&2; exit 1; }
"$real_git" init -q .
printf '%s\n' .timvisher_gh/ pr.md pr.md.url x.merged issue.md issue.md.url >> .git/info/exclude
"$real_git" config user.email "test@test.com"
"$real_git" config user.name "Test"
"$real_git" remote add origin https://github.com/testuser/testrepo.git
echo "init" > README.md
"$real_git" add README.md
"$real_git" commit -q -m "init"

# Create mock commands
mkdir -p "$tmpdir/mockbin"

cat > "$tmpdir/mockbin/git" <<MOCK
#!/usr/bin/env bash
if [[ \$1 == rev-parse || \$1 == status || \$1 == remote ]]
then
  "$real_git" "\$@"
elif [[ \$1 == push ]]
then
  echo "mock-git-push \$*" >> "\$MOCK_LOG"
  [[ -z \${MOCK_GIT_PUSH_FAIL-} ]]
elif [[ \$1 == ls-remote ]]
then
  echo "mock-git-ls-remote \$*" >> "\$MOCK_LOG"
  if [[ -n \${MOCK_REMOTE_SHA-} ]]
  then
    printf '%s\\t%s\\n' "\$MOCK_REMOTE_SHA" "\$3"
  fi
else
  "$real_git" "\$@"
fi
MOCK
chmod +x "$tmpdir/mockbin/git"

cat > "$tmpdir/mockbin/gh" <<'MOCK'
#!/usr/bin/env bash
echo "mock-gh $*" >> "$MOCK_LOG"
if [[ $1 == repo && $2 == view ]]
then
  echo "main"
elif [[ $1 == pr && $2 == create ]]
then
  echo "https://github.com/testuser/testrepo/pull/1"
elif [[ $1 == pr && $2 == edit ]]
then
  echo "mock-pr-edit"
elif [[ $1 == pr && $2 == checks ]]
then
  # Return contents of MOCK_CHECKS_FILE if set, otherwise empty array
  if [[ -r ${MOCK_CHECKS_FILE:-} ]]
  then
    cat "$MOCK_CHECKS_FILE"
  else
    echo '[]'
  fi
elif [[ $1 == pr && $2 == ready ]]
then
  echo "mock-pr-ready"
elif [[ $1 == issue && $2 == create ]]
then
  echo "https://github.com/testuser/testrepo/issues/1"
elif [[ $1 == issue && $2 == edit ]]
then
  echo "mock-issue-edit"
elif [[ $1 == pr && $2 == comment ]]
then
  echo "https://github.com/testuser/testrepo/pull/1#issuecomment-12345"
elif [[ $1 == api && $2 == user ]]
then
  echo "testuser"
elif [[ $1 == api && $2 == repos/archivedorg/* ]]
then
  echo '{"fork":false,"source":null,"archived":true}'
elif [[ $1 == api && $2 == repos/* ]]
then
  echo '{"fork":true,"source":"upstreamorg/testrepo","archived":false}'
elif [[ $1 == api && $2 == --method && $3 == PATCH ]]
then
  echo '{"html_url":"https://github.com/testuser/testrepo/pull/1#issuecomment-12345"}'
elif [[ $1 == api && $2 == --method && $3 == HEAD ]]
then
  # Simulate comment exists (HEAD check)
  true
elif [[ $1 == api && $2 == --method && $3 == DELETE ]]
then
  # Successful DELETE returns empty body
  true
fi
MOCK
chmod +x "$tmpdir/mockbin/gh"

cat > "$tmpdir/mockbin/open" <<'MOCK'
#!/usr/bin/env bash
echo "mock-open $*" >> "$MOCK_LOG"
MOCK
chmod +x "$tmpdir/mockbin/open"

# Mock osascript: timvisher_gh now routes URL opens through
# `osascript -e '...openUrl(item 1 of argv)...' "$url"` so the URL
# lands in currentBrowser instead of the system default. The script
# body is in argv[0..N-1] and the URL is the trailing positional arg
# after `--`-style separation; we just record argv to MOCK_LOG and
# whitelist 'mock-open' assertions to also match this path.
cat > "$tmpdir/mockbin/osascript" <<'MOCK'
#!/usr/bin/env bash
url=
for arg in "$@"
do
  case $arg in
    -e|-l) ;;  # flag; next arg is its value but we don't track which
    *)
      # Heuristic: any plain arg matching http(s):// is the URL we
      # opened. Tests assert on the URL substring.
      if [[ $arg == http*://* ]]
      then
        url=$arg
      fi
      ;;
  esac
done
if [[ -n $url ]]
then
  echo "mock-open $url" >> "$MOCK_LOG"
fi
MOCK
chmod +x "$tmpdir/mockbin/osascript"

cat > "$tmpdir/mockbin/timvisher_git" <<'MOCK'
#!/usr/bin/env bash
if [[ $1 == info && $2 == --json ]]
then
  cat <<'JSON'
{"timvisher_git":{"org":"testuser","repo":"testrepo","branch":"main","branchPath":"main","absPath":"/fake/testuser/testrepo/main","prefixPath":"testuser/testrepo/main"}}
JSON
  exit 0
fi
echo "(mock timvisher_git) unhandled: $*" >&2
exit 2
MOCK
chmod +x "$tmpdir/mockbin/timvisher_git"

test_path="$tmpdir/mockbin:$PATH"

rm_state() {
  local name
  for name in "$@"
  do
    rm -f "$tmpdir/repo/$name"
    case $name in
      pr.md)        rm -f "$tmpdir/repo/.timvisher_gh/pr/pr.md" ;;
      pr.md.url)    rm -f "$tmpdir/repo/.timvisher_gh/pr/pr.json" "$tmpdir/repo/.timvisher_gh/pr/pr.url" ;;
      x.merged)     rm -f "$tmpdir/repo/.timvisher_gh/pr/merged" ;;
      issue.md)     rm -f "$tmpdir/repo/.timvisher_gh/issue/issue.md" ;;
      issue.md.url) rm -f "$tmpdir/repo/.timvisher_gh/issue/issue.json" "$tmpdir/repo/.timvisher_gh/issue/issue.url" ;;
    esac
  done
}


# --- dispatch tests ---

# Test: no args prints usage and exits nonzero
run_test
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script'" 2>&1 || true)
if [[ $result == *"Usage:"* ]]
then
  pass "no args prints usage"
else
  fail "no args prints usage: got '${result}'"
fi

# Test: --help prints usage and exits zero
run_test
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' --help" 2>&1)
if [[ $result == *"Usage:"* ]]
then
  pass "--help prints usage"
else
  fail "--help prints usage: got '${result}'"
fi

# Test: --help works outside a git repository
run_test
nonrepo_dir="$tmpdir/not-a-repo"
mkdir -p "$nonrepo_dir"
result=$(cd "$nonrepo_dir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' --help" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == *"Usage:"* ]] && [[ $result != *"Not in a git repository"* ]]
then
  pass "--help works outside a git repository"
else
  fail "--help outside repo: rc=${rc} got '${result}'"
fi

# Test: unknown subcommand prints usage and exits nonzero
run_test
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' bogus" 2>&1 || true)
if [[ $result == *"Usage:"* ]]
then
  pass "unknown subcommand prints usage"
else
  fail "unknown subcommand prints usage: got '${result}'"
fi

# --- info tests ---

# Test: info --json merges the timvisher_git blob with the gh fields
