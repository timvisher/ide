run_test
export MOCK_LOG="$tmpdir/log_info_extra"
touch "$MOCK_LOG"
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info .me '$tmpdir/repo'" 2>&1) && rc=0 || rc=$?
