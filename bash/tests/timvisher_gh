}

no_api() {
  ! grep -q '^mock-gh' "$MOCK_LOG"
}

expect_clean_fail() {
  local name=$1 expected=$2
  if (( c_rc != 0 )) && [[ -z $c_out && $c_err == *"$expected"* ]]
  then
    pass "$name"
  else
    fail "$name: rc=${c_rc} stdout='${c_out}' stderr='${c_err}' log=$(cat "$MOCK_LOG")"
  fi
}

cfail() {
  fail "$1: rc=${c_rc} stdout='${c_out}' stderr='${c_err}' log=$(cat "$MOCK_LOG")"
