write_push_conv_handler() {
  cat > "$MOCK_GH_HANDLER" <<HANDLER
case "\$*" in
  'api user'*)
    echo testuser
    ;;
  *addReaction*|*resolveReviewThread*)
    echo '{"data":{}}'
    ;;
  'api graphql'*)
    case "\$*" in
      *'reviewThreads(first'*) mock_conn=reviewThreads ;;
      *'reviews(first'*) mock_conn=reviews ;;
      *'comments(first'*) mock_conn=comments ;;
    esac
    jq --arg c "\$mock_conn" '{data: {repository: {pullRequest: {(\$c): {nodes: .}}}}}' "$conv_dir/\$mock_conn.json" | respond
    ;;
  'api --method POST repos/testuser/testrepo/issues/50/comments'*)
    echo '{"id":101,"node_id":"IC_new","html_url":"https://github.com/testuser/testrepo/pull/50#issuecomment-101","created_at":"2026-10-10T12:00:00Z"}'
    ;;
