   [[ $(jq -r '.timvisher_git.branch | type' <<<"$result") == "null" ]] &&
   [[ $(jq -r '.timvisher_git.branchPath' <<<"$result") == "main" ]] &&
   [[ $(jq -r '.timvisher_gh.me' <<<"$result") == "testuser" ]]
then
  pass "info --json carries a null branch through for a detached worktree"
else
  fail "info --json detached: rc=${rc} got '${result}'"
fi

# Test: -C with an empty path errors rather than silently meaning cwd
run_test
