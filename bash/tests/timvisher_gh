result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$nonrepo_c' info .me" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) &&
