else
  fail "-C existing non-repo: rc=${rc} got '${result}'"
fi

# Test: --help wins over a bad -C path
run_test
result=$(cd "$tmpdir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$tmpdir/no-such-dir' --help" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == *"Usage:"* ]]
then
  pass "-C <bad-path> --help still prints usage"
else
  fail "-C bad path --help: rc=${rc} got '${result}'"
fi

# Test: --help goes to stdout; usage-on-error goes to stderr
run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' --help" 2>/dev/null) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == *"Usage:"* ]]
then
  pass "--help writes usage to stdout"
else
  fail "--help on stdout: rc=${rc} got '${result}'"
fi

run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script'" 2>/dev/null) && rc=0 || rc=$?
if (( 0 < rc )) && [[ -z $result ]]
then
  pass "no-args usage goes to stderr, not stdout"
else
  fail "no-args stream: rc=${rc} stdout='${result}'"
fi

# Test: info --json surfaces a timvisher_git failure rather than
# emitting a blob with a missing half
run_test
export MOCK_LOG="$tmpdir/log_info_json_gitfail"
touch "$MOCK_LOG"
mkdir -p "$tmpdir/failgitbin"
cp "$tmpdir/mockbin/gh" "$tmpdir/failgitbin/gh"
cat > "$tmpdir/failgitbin/timvisher_git" <<'MOCK'
#!/usr/bin/env bash
echo "info: worktree is not under TIMVISHER_GIT_HOME" >&2
exit 1
MOCK
chmod +x "$tmpdir/failgitbin/timvisher_git"
result=$(cd "$tmpdir/repo" && PATH="$tmpdir/failgitbin:$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"Unable to query timvisher_git context"* ]]
then
  pass "info --json fails when timvisher_git cannot resolve the worktree"
else
  fail "info --json git failure: rc=${rc} got '${result}'"
fi

# Test: no git context is an error, not an elided blob
run_test
result=$(cd "$nonrepo_dir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"Not in a git repository"* ]]
then
  pass "info --json with no git context errors"
else
  fail "info --json no context: rc=${rc} got '${result}'"
fi

run_timvisher_gh_in() {
  local dir=$1
  shift
  local quoted
  printf -v quoted '%q ' "$@"
  (cd "$dir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' ${quoted}")
}

run_test
export MOCK_LOG="$tmpdir/log_r_archived"
: > "$MOCK_LOG"
result=$(run_timvisher_gh_in "$tmpdir" -R archivedorg/oldrepo info .archived 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == true ]] && grep -qF 'mock-gh api repos/archivedorg/oldrepo' "$MOCK_LOG"
then
  pass "-R OWNER/REPO info .archived answers for a repository with no worktree"
else
  fail "-R info .archived: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir/repo" info .archived 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == false ]]
then
  pass "info .archived is false for a live repository"
else
  fail "info .archived in a worktree: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" --repo github.com/someorg/somerepo info .forkNetwork.mainRepo 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == upstreamorg/testrepo ]]
then
  pass "--repo accepts github.com/OWNER/REPO and resolves fields without a worktree"
else
  fail "--repo github.com/OWNER/REPO: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir/repo" -C "$tmpdir/repo" -R someorg/somerepo info .me 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"mutually exclusive"* ]]
then
  pass "-C and -R together are rejected"
else
  fail "-C with -R: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir/repo" -R someorg/somerepo pr ready 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"only supported with 'info'"* ]]
then
  pass "-R is rejected for subcommands that need a worktree"
else
  fail "-R with pr: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" -R just-an-owner info .me 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"is not OWNER/REPO"* ]]
then
