touch "$MOCK_LOG"
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) &&
   [[ $(jq -r '.timvisher_git.org' <<<"$result") == "testuser" ]] &&
   [[ $(jq -r '.timvisher_git.branchPath' <<<"$result") == "main" ]] &&
   [[ $(jq -r '.timvisher_gh.me' <<<"$result") == "testuser" ]] &&
   [[ $(jq -r '.timvisher_gh.forkNetwork.mainRepo' <<<"$result") == "upstreamorg/testrepo" ]] &&
   [[ $(jq -r '.timvisher_gh.forkNetwork.mainOwner' <<<"$result") == "upstreamorg" ]]
then
  pass "info --json emits .timvisher_git and .timvisher_gh"
else
  fail "info --json: rc=${rc} got '${result}'"
fi

# Test: -C resolves context from the path, not the cwd
run_test
export MOCK_LOG="$tmpdir/log_info_c"
touch "$MOCK_LOG"
result=$(cd "$tmpdir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$tmpdir/repo' info .me" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == "testuser" ]]
then
  pass "-C <path> info .me resolves from the path"
else
  fail "-C info .me: rc=${rc} got '${result}'"
fi

# Test: -C must come before the subcommand to be recognised
run_test
export MOCK_LOG="$tmpdir/log_info_c_after"
touch "$MOCK_LOG"
result=$(cd "$tmpdir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info -C '$tmpdir/repo'" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"Not in a git repository"* ]]
then
  pass "post-subcommand -C is not treated as a context flag"
else
  fail "post-subcommand -C: rc=${rc} got '${result}'"
fi

# Test: -C without a path errors
run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"requires a <path> argument"* ]]
then
