  (( c_rc == 0 )) && (( $(printf '%s' "${c_out}.json.XXXXXX" | wc -c) <= 255 ))
then
  pass "comment get keeps generated names within 255 bytes"
else
  cfail "comment get keeps generated names within 255 bytes ($(printf '%s' "$c_out" | wc -c) bytes)"
fi
creset "$c_out"

run_test
if (( EUID == 0 ))
then
  pass "comment refuses an unreadable .url (skipped: root ignores file permissions)"
else
  creset legacy.md
  cfile legacy.md "x"
  echo "$issuecomment_url" > "$tmpdir/repo/legacy.md.url"
  chmod 000 "$tmpdir/repo/legacy.md.url"
  crun -- comment edit legacy.md
  chmod 644 "$tmpdir/repo/legacy.md.url"
  expect_clean_fail "comment refuses an unreadable .url" "isn't readable"
  creset legacy.md
fi

run_test
creset comment.md
cfile comment.md "body"
crun -- comment --pull-request=https://github.com/testuser/testrepo/pull/123oops comment.md
expect_clean_fail "comment refuses a malformed PR number" "isn't a github.com PR URL"

run_test
crun -- comment react --reaction +1 -- "$issuecomment_url"
if
  (( c_rc == 0 )) && grep -q "op=addReaction id=IC_222 content=THUMBS_UP" "$MOCK_LOG"
then
  pass "comment react takes its target after --"
else
  cfail "comment react takes its target after --"
fi

# accounts

run_test
mkdir -p "$tmpdir/ghconfig/orgs/testuser"
echo testacct > "$tmpdir/ghconfig/orgs/testuser/account"
crun -- comment react https://github.com/otherorg/repo/pull/1#issuecomment-5 --reaction +1
if
  (( c_rc == 0 )) && ! grep -qv "^unset " "${MOCK_LOG}.tokens" &&
  grep -q "^unset owner=unset host=github.com GET repos/otherorg/repo/issues/comments/5 " "${MOCK_LOG}.tokens" &&
  grep -q "^unset owner=otherorg host=github.com POST graphql addReaction" "${MOCK_LOG}.tokens"
then
  pass "comment verbs leave REST account choice to the shim and name the owner for GraphQL"
else
  cfail "comment verbs leave REST account choice to the shim and name the owner for GraphQL"
fi

run_test
crun GH_TOKEN=caller-token -- comment react https://github.com/otherorg/repo/pull/1#issuecomment-5 --reaction +1
if
  (( c_rc == 0 )) && ! grep -qv "^caller-token " "${MOCK_LOG}.tokens"
then
  pass "comment verbs keep a token the caller pinned"
else
  cfail "comment verbs keep a token the caller pinned"
fi
rm -rf "$tmpdir/ghconfig/orgs/testuser"

run_test
crun -- --help
if
  (( c_rc == 0 )) &&
  [[ $c_out == *"comment reply <target> <file> [--reaction R]..."* && $c_out == *"comment edit [--force] <file>"* &&
     $c_out == *"comment react [--delete] <target> --reaction R..."* && $c_out == *"comment resolve [--unresolve] <target>"* &&
     $c_out == *"comment get <target> [<file>]"* && $c_out == *"comment delete [--force] <file>"* ]]
then
  pass "--help documents every comment verb"
else
  cfail "--help documents every comment verb"
fi
creset comment.md reply.md target.md their.md loose.md

echo ""
echo "Results: $((tests - failures))/${tests} passed"

if (( 0 < failures ))
then
  exit 1
fi
