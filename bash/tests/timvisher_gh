write_edit_handler() {
  local remote=${MOCK_REMOTE_DESC:-$MOCK_GH_HANDLER.remote}
  if [[ ! -e $remote ]]
  then
    echo '{"title":"","body":""}' > "$remote"
  fi
  cat > "$MOCK_GH_HANDLER" <<'HANDLER'
mock_remote=${MOCK_REMOTE_DESC:-$MOCK_GH_HANDLER.remote}
case "$1 $2" in
  'pr view'|'issue view')
    respond < "$mock_remote"
    ;;
  'pr edit'|'issue edit')
    mock_title=
    mock_body=
    mock_prev=
    for mock_arg in "$@"
    do
      case $mock_prev in
        --title) mock_title=$mock_arg ;;
        --body-file) mock_body=$(< "$mock_arg") ;;
      esac
      mock_prev=$mock_arg
    done
    jq -n --arg title "$mock_title" --arg body "$mock_body" '{title: $title, body: $body}' > "$mock_remote"
    echo "mock-$1-edit"
    ;;
  'pr list')
    if [[ -n ${MOCK_EXISTING_PR-} ]]
    then
      jq -n --arg url "$MOCK_EXISTING_PR" '[{url: $url}]' | respond
    else
      echo '[]' | respond
    fi
    ;;
  'repo view')
    echo '{"defaultBranchRef":{"name":"main"}}' | respond
    ;;
  'pr create')
    printf '%s\n' "$*" >> "$MOCK_GH_HANDLER.created"
    echo 'https://github.com/testuser/testrepo/pull/50'
    ;;
  'pr ready')
    jq '.isDraft = false' "$mock_remote" > "$mock_remote.new" && mv "$mock_remote.new" "$mock_remote"
    ;;
  'pr checks')
    echo '[]'
    ;;
  'pr diff')
    if [[ -r ${MOCK_PR_DIFF_FILE-} ]]
    then
      cat "$MOCK_PR_DIFF_FILE"
    fi
    ;;
  'pr comment')
    echo 'https://github.com/testuser/testrepo/pull/50#issuecomment-7'
    ;;
esac
HANDLER
}

