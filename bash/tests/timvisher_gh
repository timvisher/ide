else
  fail "-R bad spec: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" -R someorg/somerepo info --json 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"info --json needs a worktree"* ]]
then
  pass "-R with info --json explains that --json needs a worktree"
else
  fail "-R info --json: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" -R 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"requires an OWNER/REPO argument"* ]]
then
  pass "-R with no argument errors"
else
  fail "-R no argument: rc=${rc} got '${result}'"
fi

run_test
export MOCK_LOG="$tmpdir/log_json_archived"
: > "$MOCK_LOG"
result=$(run_timvisher_gh_in "$tmpdir/repo" info --json 2>/dev/null) && rc=0 || rc=$?
if (( rc == 0 )) &&
   [[ $(jq -r '.timvisher_gh.archived' <<<"$result") == false ]] &&
   [[ $(grep -c 'mock-gh api repos/' "$MOCK_LOG") == 1 ]]
then
  pass "info --json carries archived and fetches the repository once"
else
  fail "info --json archived: rc=${rc} repos-calls=$(grep -c 'mock-gh api repos/' "$MOCK_LOG") got '${result}'"
fi

