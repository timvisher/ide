issuecomment_reaction_url=https://api.github.com/repos/testuser/testrepo/issues/comments/222/reactions/987654321

react_run() {
  local -a envs=()
  while [[ ${1-} != -- ]]
  do
    envs+=("$1")
    shift
  done
  shift
  export MOCK_LOG="$tmpdir/log_react"
  : > "$MOCK_LOG"
  : > "${MOCK_LOG}.tokens"
  react_out=$(
    cd "$tmpdir/repo" &&
      printf '%s' "${react_stdin-}" |
      env -u GH_TOKEN TIMVISHER_GH_CONFIG_DIR="$tmpdir/ghconfig" "${envs[@]}" PATH="$react_path" timvisher_logging_log_level=INFO \
        bash -c "source '${funcs_dir}/logging.bash'; \"\$0\" \"\$@\"" "$script" "$@" \
        2>"$tmpdir/react_err"
  )
  react_rc=$?
  react_err=$(< "$tmpdir/react_err")
}

react_reset() {
  rm -f "$tmpdir/repo/reaction.md" "$tmpdir/repo/reaction.md.url"
  if (( 0 < $# ))
  then
    printf '%s\n' "$1" > "$tmpdir/repo/reaction.md"
  fi
}

react_fails_cleanly() {
  local name=$1 expected=$2
  if (( react_rc != 0 )) && [[ -z $react_out && $react_err == *"$expected"* ]] &&
     ! grep -q 'mock-gh api' "$MOCK_LOG"
  then
    pass "$name"
  else
    fail "$name: rc=${react_rc} stdout='${react_out}' stderr='${react_err}' log=$(cat "$MOCK_LOG")"
  fi
}

