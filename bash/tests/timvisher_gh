run_test
export MOCK_LOG="$tmpdir/log_info_json_detached"
touch "$MOCK_LOG"
mkdir -p "$tmpdir/detachedbin"
cp "$tmpdir/mockbin/gh" "$tmpdir/detachedbin/gh"
cat > "$tmpdir/detachedbin/timvisher_git" <<'MOCK'
#!/usr/bin/env bash
cat <<'JSON'
{"timvisher_git":{"org":"testuser","repo":"testrepo","branch":null,"branchPath":"main","absPath":"/fake","prefixPath":"testuser/testrepo/main"}}
JSON
MOCK
chmod +x "$tmpdir/detachedbin/timvisher_git"
result=$(cd "$tmpdir/repo" && PATH="$tmpdir/detachedbin:$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
