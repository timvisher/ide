#!/usr/bin/env bash

# Tests for timvisher_gh
# Heavy mocking since this interacts with git, gh, and macOS open.

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

script="$(cd "$(dirname "$0")/.." && pwd)/bin/timvisher_gh"
funcs_dir="$(cd "$(dirname "$0")/../functions" && pwd)"
real_git="$(brew --prefix)/bin/git"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# Set up a fake git repo
mkdir -p "$tmpdir/repo"
cd "$tmpdir/repo" ||
  { echo "cannot cd to the fixture repo" >&2; exit 1; }
"$real_git" init -q .
"$real_git" config user.email "test@test.com"
"$real_git" config user.name "Test"
"$real_git" remote add origin https://github.com/testuser/testrepo.git
echo "init" > README.md
"$real_git" add README.md
"$real_git" commit -q -m "init"

# Create mock commands
mkdir -p "$tmpdir/mockbin"

cat > "$tmpdir/mockbin/git" <<MOCK
#!/usr/bin/env bash
if [[ \$1 == rev-parse || \$1 == status || \$1 == remote ]]
then
  "$real_git" "\$@"
elif [[ \$1 == push ]]
then
  echo "mock-git-push \$*" >> "\$MOCK_LOG"
else
  "$real_git" "\$@"
fi
MOCK
chmod +x "$tmpdir/mockbin/git"

cat > "$tmpdir/mockbin/gh" <<'MOCK'
#!/usr/bin/env bash
echo "mock-gh $*" >> "$MOCK_LOG"
target_repo=''
if [[ $1 == -R ]]
then
  target_repo=$2
  shift 2
fi
if [[ $1 == repo && $2 == view && $* == *mergeCommitAllowed* ]]
then
  if [[ $target_repo == upstreamorg/testrepo ]]
  then
    echo '{"mergeCommitAllowed":false,"squashMergeAllowed":true,"rebaseMergeAllowed":false}'
  else
    echo '{"mergeCommitAllowed":true,"squashMergeAllowed":false,"rebaseMergeAllowed":false}'
  fi
elif [[ $1 == pr && $2 == merge ]]
then
  true
elif [[ $1 == pr && $2 == view && $* == *'--json state'* ]]
then
  echo "MERGED"
elif [[ $1 == repo && $2 == view ]]
then
  echo "main"
elif [[ $1 == pr && $2 == create ]]
then
  echo "https://github.com/testuser/testrepo/pull/1"
elif [[ $1 == pr && $2 == edit ]]
then
  echo "mock-pr-edit"
elif [[ $1 == pr && $2 == checks && -n ${MOCK_CHECKS_ERR-} ]]
then
  echo "$MOCK_CHECKS_ERR" >&2
  exit 1
elif [[ $1 == pr && $2 == checks && -n ${MOCK_CHECKS_REFUSE-} ]]
then
  echo '{"type":"instruction","level":"error","code":"gh_account_token_unavailable","message":"no token"}' >&2
  exit 1
elif [[ $1 == pr && $2 == checks ]]
then
  # Return contents of MOCK_CHECKS_FILE if set, otherwise empty array
  if [[ -r ${MOCK_CHECKS_FILE:-} ]]
  then
    cat "$MOCK_CHECKS_FILE"
  else
    echo '[]'
  fi
elif [[ $1 == pr && $2 == ready ]]
then
  echo "mock-pr-ready"
elif [[ $1 == issue && $2 == create ]]
then
  echo "https://github.com/testuser/testrepo/issues/1"
elif [[ $1 == issue && $2 == edit ]]
then
  echo "mock-issue-edit"
elif [[ $1 == pr && $2 == comment ]]
then
  echo "https://github.com/testuser/testrepo/pull/1#issuecomment-12345"
elif [[ $1 == api && $2 == user && -n $target_repo ]]
then
  echo "testuser"
elif [[ $1 == api && $2 == repos/archivedorg/* ]]
then
  echo '{"fork":false,"source":null,"archived":true}'
elif [[ $1 == api && $2 == repos/* ]]
then
  echo '{"fork":true,"source":"upstreamorg/testrepo","archived":false}'
elif [[ $1 == api && $3 == --method && $4 == PATCH ]]
then
  echo '{"html_url":"https://github.com/testuser/testrepo/pull/1#issuecomment-12345"}'
elif [[ $1 == api && $3 == --method && $4 == HEAD ]]
then
  printf 'HTTP/2.0 200 OK\r\n\r\n'
elif [[ $1 == api && $2 == --method && $3 == DELETE ]]
then
  printf 'HTTP/2.0 204 No Content\r\n\r\n'
fi
MOCK
chmod +x "$tmpdir/mockbin/gh"

cat > "$tmpdir/mockbin/open" <<'MOCK'
#!/usr/bin/env bash
echo "mock-open $*" >> "$MOCK_LOG"
MOCK
chmod +x "$tmpdir/mockbin/open"

# Mock osascript: timvisher_gh now routes URL opens through
# `osascript -e '...openUrl(item 1 of argv)...' "$url"` so the URL
# lands in currentBrowser instead of the system default. The script
# body is in argv[0..N-1] and the URL is the trailing positional arg
# after `--`-style separation; we just record argv to MOCK_LOG and
# whitelist 'mock-open' assertions to also match this path.
cat > "$tmpdir/mockbin/osascript" <<'MOCK'
#!/usr/bin/env bash
url=
for arg in "$@"
do
  case $arg in
    -e|-l) ;;  # flag; next arg is its value but we don't track which
    *)
      # Heuristic: any plain arg matching http(s):// is the URL we
      # opened. Tests assert on the URL substring.
      if [[ $arg == http*://* ]]
      then
        url=$arg
      fi
      ;;
  esac
done
if [[ -n $url ]]
then
  echo "mock-open $url" >> "$MOCK_LOG"
fi
MOCK
chmod +x "$tmpdir/mockbin/osascript"

cat > "$tmpdir/mockbin/timvisher_git" <<'MOCK'
#!/usr/bin/env bash
if [[ $1 == info && $2 == --json ]]
then
  cat <<'JSON'
{"timvisher_git":{"org":"testuser","repo":"testrepo","branch":"main","branchPath":"main","absPath":"/fake/testuser/testrepo/main","prefixPath":"testuser/testrepo/main"}}
JSON
  exit 0
fi
echo "(mock timvisher_git) unhandled: $*" >&2
exit 2
MOCK
chmod +x "$tmpdir/mockbin/timvisher_git"

test_path="$tmpdir/mockbin:$PATH"

# --- dispatch tests ---

# Test: no args prints usage and exits nonzero
run_test
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script'" 2>&1 || true)
if [[ $result == *"Usage:"* ]]
then
  pass "no args prints usage"
else
  fail "no args prints usage: got '${result}'"
fi

# Test: --help prints usage and exits zero
run_test
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' --help" 2>&1)
if [[ $result == *"Usage:"* ]]
then
  pass "--help prints usage"
else
  fail "--help prints usage: got '${result}'"
fi

# Test: --help works outside a git repository
run_test
nonrepo_dir="$tmpdir/not-a-repo"
mkdir -p "$nonrepo_dir"
result=$(cd "$nonrepo_dir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' --help" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == *"Usage:"* ]] && [[ $result != *"Not in a git repository"* ]]
then
  pass "--help works outside a git repository"
else
  fail "--help outside repo: rc=${rc} got '${result}'"
fi

# Test: unknown subcommand prints usage and exits nonzero
run_test
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' bogus" 2>&1 || true)
if [[ $result == *"Usage:"* ]]
then
  pass "unknown subcommand prints usage"
else
  fail "unknown subcommand prints usage: got '${result}'"
fi

# --- info tests ---

# Test: info --json merges the timvisher_git blob with the gh fields
run_test
export MOCK_LOG="$tmpdir/log_info_json"
touch "$MOCK_LOG"
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) &&
   [[ $(jq -r '.timvisher_git.org' <<<"$result") == "testuser" ]] &&
   [[ $(jq -r '.timvisher_git.branchPath' <<<"$result") == "main" ]] &&
   [[ $(jq -r '.timvisher_gh.me' <<<"$result") == "testuser" ]] &&
   [[ $(jq -r '.timvisher_gh.forkNetwork.mainRepo' <<<"$result") == "upstreamorg/testrepo" ]] &&
   [[ $(jq -r '.timvisher_gh.forkNetwork.mainOwner' <<<"$result") == "upstreamorg" ]]
then
  pass "info --json emits .timvisher_git and .timvisher_gh"
else
  fail "info --json: rc=${rc} got '${result}'"
fi

# Test: -C resolves context from the path, not the cwd
run_test
export MOCK_LOG="$tmpdir/log_info_c"
touch "$MOCK_LOG"
result=$(cd "$tmpdir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$tmpdir/repo' info .me" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == "testuser" ]]
then
  pass "-C <path> info .me resolves from the path"
else
  fail "-C info .me: rc=${rc} got '${result}'"
fi

# Test: -C must come before the subcommand to be recognised
run_test
export MOCK_LOG="$tmpdir/log_info_c_after"
touch "$MOCK_LOG"
result=$(cd "$tmpdir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info -C '$tmpdir/repo'" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"Not in a git repository"* ]]
then
  pass "post-subcommand -C is not treated as a context flag"
else
  fail "post-subcommand -C: rc=${rc} got '${result}'"
fi

# Test: -C without a path errors
run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"requires a <path> argument"* ]]
then
  pass "-C with no path errors"
else
  fail "-C no path: rc=${rc} got '${result}'"
fi

# Test: an extra positional arg errors rather than silently answering
# for the current directory
run_test
export MOCK_LOG="$tmpdir/log_info_extra"
touch "$MOCK_LOG"
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info .me '$tmpdir/repo'" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"unexpected argument"* ]]
then
  pass "info rejects an extra positional arg"
else
  fail "info extra positional: rc=${rc} got '${result}'"
fi

# Test: a null branch from timvisher_git passes through intact, so a
# detached worktree still yields a usable blob
run_test
export MOCK_LOG="$tmpdir/log_info_json_detached"
touch "$MOCK_LOG"
mkdir -p "$tmpdir/detachedbin"
cp "$tmpdir/mockbin/gh" "$tmpdir/detachedbin/gh"
cat > "$tmpdir/detachedbin/timvisher_git" <<'MOCK'
#!/usr/bin/env bash
cat <<'JSON'
{"timvisher_git":{"org":"testuser","repo":"testrepo","branch":null,"branchPath":"main","absPath":"/fake","prefixPath":"testuser/testrepo/main"}}
JSON
MOCK
chmod +x "$tmpdir/detachedbin/timvisher_git"
result=$(cd "$tmpdir/repo" && PATH="$tmpdir/detachedbin:$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) &&
   [[ $(jq -r '.timvisher_git.branch | type' <<<"$result") == "null" ]] &&
   [[ $(jq -r '.timvisher_git.branchPath' <<<"$result") == "main" ]] &&
   [[ $(jq -r '.timvisher_gh.me' <<<"$result") == "testuser" ]]
then
  pass "info --json carries a null branch through for a detached worktree"
else
  fail "info --json detached: rc=${rc} got '${result}'"
fi

# Test: -C with an empty path errors rather than silently meaning cwd
run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '' info .me" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"non-empty"* ]]
then
  pass "-C with an empty path errors"
else
  fail "-C empty path: rc=${rc} got '${result}'"
fi

# Test: a bad -C path says so, rather than blaming the git context
run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$tmpdir/no-such-dir' info .me" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"unable to enter"* ]]
then
  pass "-C with a non-existent path reports the path, not 'Not in a git repository'"
else
  fail "-C bad path: rc=${rc} got '${result}'"
fi

# Test: an existing non-repo -C path is a different failure from a
# path that does not exist
run_test
nonrepo_c="$tmpdir/exists-but-not-a-repo"
mkdir -p "$nonrepo_c"
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$nonrepo_c' info .me" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) &&
   [[ $result == *"Not in a git repository"* ]] &&
   [[ $result != *"unable to enter"* ]]
then
  pass "-C <existing-non-repo> reports 'Not in a git repository', not 'unable to enter'"
else
  fail "-C existing non-repo: rc=${rc} got '${result}'"
fi

# Test: --help wins over a bad -C path
run_test
result=$(cd "$tmpdir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' -C '$tmpdir/no-such-dir' --help" 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == *"Usage:"* ]]
then
  pass "-C <bad-path> --help still prints usage"
else
  fail "-C bad path --help: rc=${rc} got '${result}'"
fi

# Test: --help goes to stdout; usage-on-error goes to stderr
run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' --help" 2>/dev/null) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == *"Usage:"* ]]
then
  pass "--help writes usage to stdout"
else
  fail "--help on stdout: rc=${rc} got '${result}'"
fi

run_test
result=$(cd "$tmpdir/repo" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script'" 2>/dev/null) && rc=0 || rc=$?
if (( 0 < rc )) && [[ -z $result ]]
then
  pass "no-args usage goes to stderr, not stdout"
else
  fail "no-args stream: rc=${rc} stdout='${result}'"
fi

# Test: info --json surfaces a timvisher_git failure rather than
# emitting a blob with a missing half
run_test
export MOCK_LOG="$tmpdir/log_info_json_gitfail"
touch "$MOCK_LOG"
mkdir -p "$tmpdir/failgitbin"
cp "$tmpdir/mockbin/gh" "$tmpdir/failgitbin/gh"
cat > "$tmpdir/failgitbin/timvisher_git" <<'MOCK'
#!/usr/bin/env bash
echo "info: worktree is not under TIMVISHER_GIT_HOME" >&2
exit 1
MOCK
chmod +x "$tmpdir/failgitbin/timvisher_git"
result=$(cd "$tmpdir/repo" && PATH="$tmpdir/failgitbin:$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"Unable to query timvisher_git context"* ]]
then
  pass "info --json fails when timvisher_git cannot resolve the worktree"
else
  fail "info --json git failure: rc=${rc} got '${result}'"
fi

# Test: no git context is an error, not an elided blob
run_test
result=$(cd "$nonrepo_dir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' info --json" 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"Not in a git repository"* ]]
then
  pass "info --json with no git context errors"
else
  fail "info --json no context: rc=${rc} got '${result}'"
fi

run_timvisher_gh_in() {
  local dir=$1
  shift
  local quoted
  printf -v quoted '%q ' "$@"
  (cd "$dir" && PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' ${quoted}")
}

run_test
export MOCK_LOG="$tmpdir/log_r_archived"
: > "$MOCK_LOG"
result=$(run_timvisher_gh_in "$tmpdir" -R archivedorg/oldrepo info .archived 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == true ]] && grep -qF 'mock-gh api repos/archivedorg/oldrepo' "$MOCK_LOG"
then
  pass "-R OWNER/REPO info .archived answers for a repository with no worktree"
else
  fail "-R info .archived: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir/repo" info .archived 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == false ]]
then
  pass "info .archived is false for a live repository"
else
  fail "info .archived in a worktree: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" --repo github.com/someorg/somerepo info .forkNetwork.mainRepo 2>&1) && rc=0 || rc=$?
if (( rc == 0 )) && [[ $result == upstreamorg/testrepo ]]
then
  pass "--repo accepts github.com/OWNER/REPO and resolves fields without a worktree"
else
  fail "--repo github.com/OWNER/REPO: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir/repo" -C "$tmpdir/repo" -R someorg/somerepo info .me 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"mutually exclusive"* ]]
then
  pass "-C and -R together are rejected"
else
  fail "-C with -R: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir/repo" -R someorg/somerepo pr ready 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"only supported with 'info'"* ]]
then
  pass "-R is rejected for subcommands that need a worktree"
else
  fail "-R with pr: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" -R just-an-owner info .me 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"is not OWNER/REPO"* ]]
then
  pass "-R rejects a value that is not OWNER/REPO"
else
  fail "-R bad spec: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" -R someorg/somerepo info --json 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"info --json needs a worktree"* ]]
then
  pass "-R with info --json explains that --json needs a worktree"
else
  fail "-R info --json: rc=${rc} got '${result}'"
fi

run_test
result=$(run_timvisher_gh_in "$tmpdir" -R 2>&1) && rc=0 || rc=$?
if (( 0 < rc )) && [[ $result == *"requires an OWNER/REPO argument"* ]]
then
  pass "-R with no argument errors"
else
  fail "-R no argument: rc=${rc} got '${result}'"
fi

run_test
export MOCK_LOG="$tmpdir/log_json_archived"
: > "$MOCK_LOG"
result=$(run_timvisher_gh_in "$tmpdir/repo" info --json 2>/dev/null) && rc=0 || rc=$?
if (( rc == 0 )) &&
   [[ $(jq -r '.timvisher_gh.archived' <<<"$result") == false ]] &&
   [[ $(grep -c 'mock-gh api repos/' "$MOCK_LOG") == 1 ]]
then
  pass "info --json carries archived and fetches the repository once"
else
  fail "info --json archived: rc=${rc} repos-calls=$(grep -c 'mock-gh api repos/' "$MOCK_LOG") got '${result}'"
fi

# --- pr tests ---

# Test: pr exits if pr.md doesn't exist and pr.md.url doesn't exist
run_test
export MOCK_LOG="$tmpdir/log_pr_nofile"
touch "$MOCK_LOG"
result=$(PATH="$test_path" bash -c "source '${funcs_dir}/logging.bash'; '$script' pr" 2>&1 || true)
if [[ $result == *"not readable"* ]]
then
  pass "pr exits if pr.md doesn't exist"
else
  fail "pr exits if pr.md doesn't exist: got '${result}'"
fi

# Test: pr opens existing pr.md.url if present
run_test
echo "https://github.com/testuser/testrepo/pull/42" > "$tmpdir/repo/pr.md.url"
export MOCK_LOG="$tmpdir/log_pr_existing"
