#!/usr/bin/env bash

# Tests for timvisher_bd_topics.
# Currently covers the `resolve` subcommand.

# shellcheck disable=SC1091
source "$(dirname "$0")/lib/mock_commands.bash" || exit 1
mock_init || { echo "mock_init failed" >&2; exit 1; }
mock_command git
mock_git_toplevel

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

script="$(cd "$(dirname "$0")/.." && pwd)/bin/timvisher_bd_topics"

# pwd -P, not a bare mktemp -d: on macOS mktemp hands back a /var/folders
# path, while the script resolves its own location with pwd -P and reports
# /private/var. Resolving here keeps the two comparable.
tmpdir=$(cd "$(mktemp -d)" && pwd -P) || exit 1
trap 'rm -rf "$tmpdir"' EXIT

mkdir -p "$tmpdir/topics" || exit 1
mkdir -p "$tmpdir/config/timvisher/ide" || exit 1
printf '%s\n' "$tmpdir/topics" > "$tmpdir/config/timvisher/ide/bd_topics_root"

run_resolve() {
  XDG_CONFIG_HOME="$tmpdir/config" "$script" resolve "$@"
}

# Test: path under topics root prints the relative topic name
run_test
if result=$(run_resolve "$tmpdir/topics/Topic/Example" 2>/dev/null) &&
    [[ $result == "Topic/Example" ]]
then
  pass "resolve under topics root prints topic rel"
else
  fail "expected 'Topic/Example', got '${result:-}'"
fi

# Test: nonexistent path under topics root still resolves
run_test
if result=$(run_resolve "$tmpdir/topics/does/not/exist" 2>/dev/null) &&
    [[ $result == "does/not/exist" ]]
then
  pass "resolve works for nonexistent paths under root"
else
  fail "expected 'does/not/exist', got '${result:-}'"
fi

# Test: path outside topics root exits non-zero
run_test
if ! run_resolve "/tmp/not-a-topic" >/dev/null 2>&1
then
  pass "resolve outside topics root exits non-zero"
else
  fail "expected non-zero exit for path outside root"
fi

# Test: topics root itself exits non-zero (must be *under*)
run_test
if ! run_resolve "$tmpdir/topics" >/dev/null 2>&1
then
  pass "resolve topics root itself exits non-zero"
else
  fail "expected non-zero exit for topics root itself"
fi

# Test: /.beads suffix is stripped before resolution
run_test
if result=$(run_resolve "$tmpdir/topics/foo/.beads" 2>/dev/null) &&
    [[ $result == "foo" ]]
then
  pass "resolve strips /.beads suffix"
else
  fail "expected 'foo', got '${result:-}'"
fi

# Test: empty argument exits non-zero
run_test
if ! run_resolve "" >/dev/null 2>&1
then
  pass "resolve with empty argument exits non-zero"
else
  fail "expected non-zero exit for empty argument"
fi

# Test: wrong argument count exits non-zero
run_test
if ! XDG_CONFIG_HOME="$tmpdir/config" "$script" resolve >/dev/null 2>&1
then
  pass "resolve with no arguments exits non-zero"
else
  fail "expected non-zero exit for missing argument"
fi

# Test: multiple arguments exit non-zero
run_test
if ! XDG_CONFIG_HOME="$tmpdir/config" "$script" resolve arg1 arg2 >/dev/null 2>&1
then
  pass "resolve with multiple arguments exits non-zero"
else
  fail "expected non-zero exit for multiple arguments"
fi

# Test: relative path resolves against topics root
run_test
if result=$(run_resolve "Topic/Example" 2>/dev/null) &&
    [[ $result == "Topic/Example" ]]
then
  pass "resolve joins relative paths against topics root"
else
  fail "expected 'Topic/Example' from relative, got '${result:-}'"
fi

# Test: a topic that is a symlink to storage outside the root still
# resolves under the root, by name and by its path under the root.
run_test
mkdir -p "$tmpdir/elsewhere/Linked Topic/.beads" "$tmpdir/topics/Linked" || exit 1
ln -s "$tmpdir/elsewhere/Linked Topic" "$tmpdir/topics/Linked/Topic" || exit 1
if by_name=$(run_resolve "Linked/Topic" 2>/dev/null) &&
    by_path=$(run_resolve "$tmpdir/topics/Linked/Topic/.beads" 2>/dev/null) &&
    [[ $by_name == "Linked/Topic" && $by_path == "Linked/Topic" ]]
then
  pass "resolve keeps a symlinked topic under the root"
else
  fail "symlinked topic: by name '${by_name:-}', by path '${by_path:-}'"
fi

# Test: the symlink's target, named directly, is still outside the root.
run_test
if ! run_resolve "$tmpdir/elsewhere/Linked Topic" >/dev/null 2>&1
then
  pass "resolve still refuses a path outside the root"
else
  fail "resolve accepted a symlinked topic's target outside the root"
fi

# Test: tilde expansion — overriding HOME requires the script's
# `source ~/.functions/logging.bash` to still resolve, so symlink it in.
run_test
fake_home="$tmpdir/home"
mkdir -p "$fake_home/.functions" "$fake_home/topics-under-home"
ln -s "$HOME/.functions/logging.bash" "$fake_home/.functions/logging.bash"
mkdir -p "$fake_home/.config/timvisher/ide"
printf '%s\n' "$fake_home/topics-under-home" > "$fake_home/.config/timvisher/ide/bd_topics_root"
# shellcheck disable=SC2088
if result=$(HOME="$fake_home" \
    XDG_CONFIG_HOME="$fake_home/.config" \
    XDG_DATA_HOME="$fake_home/.local/share" \
    XDG_STATE_HOME="$fake_home/.local/state" \
    XDG_CACHE_HOME="$fake_home/.cache" \
    "$script" resolve '~/topics-under-home/foo' 2>/dev/null) &&
    [[ $result == "foo" ]]
then
  pass "resolve expands tilde"
else
  fail "expected 'foo' from tilde, got '${result:-}'"
fi

# Test: symlinked topics-root path still resolves (canonicalization)
run_test
ln -s "$tmpdir/topics" "$tmpdir/alias"
if result=$(run_resolve "$tmpdir/alias/Topic/Example" 2>/dev/null) &&
    [[ $result == "Topic/Example" ]]
then
  pass "resolve canonicalizes symlinked topics-root paths"
else
  fail "expected 'Topic/Example' through symlink, got '${result:-}'"
fi

# Test: `..` traversal that stays under root resolves cleanly
run_test
if result=$(run_resolve "$tmpdir/topics/a/../b" 2>/dev/null) &&
    [[ $result == "b" ]]
then
  pass "resolve collapses safe '..' traversal"
else
  fail "expected 'b' from '..' traversal, got '${result:-}'"
fi

# Test: `..` traversal that escapes topics root exits non-zero
run_test
if ! run_resolve "$tmpdir/topics/../outside" >/dev/null 2>&1
then
  pass "resolve rejects '..' traversal that escapes root"
else
  fail "expected non-zero exit for traversal escape"
fi

# ---------------------------------------------------------------------------
# Exercise the code paths that pass fewer than 2 output params to
# try_resolve_topic / resolve_topic. A reviewer flagged these as a
# potential return-code bug (trailing `if` with an unmatched condition),
# but POSIX `if` without a matching branch exits 0, so they work —
# these tests lock that in.
# ---------------------------------------------------------------------------

# Helper: run the CLI with our scoped config dir. Used for subcommands
# other than `resolve`.
run_cli() {
  XDG_CONFIG_HOME="$tmpdir/config" "$script" "$@"
}

# Test: `ls <prefix>` exercises the single-output-param call
#   resolve_topic "$prefix_stripped" prefix_abs
# (line 556). A working topic under the prefix should be listed, which
# can only happen if resolve_topic returned 0 for a valid input when
# only the abs output name was passed.
run_test
# Set up a real topic with .beads so list_topics_under_dir finds it.
mkdir -p "$tmpdir/topics/single-param-test/nested/.beads" || exit 1
: > "$tmpdir/topics/single-param-test/nested/.beads/beads.db"
result=$(run_cli ls single-param-test 2>&1)
if [[ $result == *"single-param-test/nested"* ]]
then
  pass "ls <prefix> works (single-output-param resolve_topic path)"
else
  fail "single-param resolve_topic: got '${result}'"
fi

# Test: probe form `(resolve_topic "$x" >/dev/null 2>&1)` (line 636) —
# exercised by `bd <topic>` when the topic exists. Stub `bd` via PATH
# so we don't depend on a real beads install.
run_test
stubdir="$tmpdir/stubbin"
mkdir -p "$stubdir"
cat > "$stubdir/bd" <<'STUB'
#!/usr/bin/env bash
printf 'bd-called: %s\n' "$*"
STUB
chmod +x "$stubdir/bd"
# bd subcommand requires the topic dir to exist and contain .beads.
mkdir -p "$tmpdir/topics/probe-test/.beads" || exit 1
: > "$tmpdir/topics/probe-test/.beads/beads.db"
result=$(PATH="$stubdir:$PATH" run_cli bd probe-test status 2>&1)
if [[ $result == *"bd-called: status"* ]]
then
  pass "bd <topic> routes through the zero-output-param probe"
else
  fail "zero-param probe: got '${result}'"
fi

# Test: mv/rename exercises two separate dual-output calls with
# DIFFERENT output variable names (src_abs/src_rel and dst_abs/dst_rel).
# The function's nameref must not leak between the two calls.
run_test
mkdir -p "$tmpdir/topics/rename-src/.beads" || exit 1
: > "$tmpdir/topics/rename-src/.beads/beads.db"
# The `mv` subcommand does the actual rename; just check it doesn't
# die during resolve (nonexistent dst is fine — it's the target).
result=$(run_cli mv rename-src rename-dst 2>&1)
if [[ -d "$tmpdir/topics/rename-dst" ]] && [[ ! -e "$tmpdir/topics/rename-src" ]]
then
  pass "mv <src> <dst> uses distinct output var names cleanly"
else
  fail "mv dual-call: result='${result}'"
fi

# Test: `current` returns the topic dir CWD lives in, even when the
# surrounding repo has a topic.txt pointing somewhere else. Mirrors the
# real-world setup where the topics root is itself a git repo and the
# repo's last-set topic shadows the topic the user is actually in.
run_test
mkdir -p "$tmpdir/topics/Incidents/100/.beads" || exit 1
: > "$tmpdir/topics/Incidents/100/.beads/beads.db"
mkdir -p "$tmpdir/topics"/.git
mkdir -p "$tmpdir/topics/.timvisher_bd_topics" || exit 1
printf 'wrong/topic\n' > "$tmpdir/topics/.timvisher_bd_topics/topic.txt"
result=$(cd "$tmpdir/topics/Incidents/100" && run_cli current 2>&1)
if [[ $result == "Incidents/100" ]]
then
  pass "current returns the topic dir CWD is in, not the repo's topic.txt"
else
  fail "expected 'Incidents/100', got '${result}'"
fi

# Test: `current` walks up from CWD to find the closest topic dir.
run_test
mkdir -p "$tmpdir/topics/Incidents/100/sub/dir" || exit 1
result=$(cd "$tmpdir/topics/Incidents/100/sub/dir" && run_cli current 2>&1)
if [[ $result == "Incidents/100" ]]
then
  pass "current walks up to the closest topic dir"
else
  fail "expected 'Incidents/100' from nested CWD, got '${result}'"
fi

# Test: `current` from a non-topic dir under topics root falls back to
# the surrounding repo's topic.txt.
run_test
mkdir -p "$tmpdir/topics/no-beads-here" || exit 1
result=$(cd "$tmpdir/topics/no-beads-here" && run_cli current 2>&1)
if [[ $result == "wrong/topic" ]]
then
  pass "current falls back to repo's topic.txt when CWD has no topic ancestor"
else
  fail "expected 'wrong/topic' fallback, got '${result}'"
fi

topics_real=$(cd "$tmpdir/topics" && pwd -P)

# Test: `root` prints the absolute dir of the topic CWD is in.
run_test
result=$(cd "$tmpdir/topics/Incidents/100/sub/dir" && run_cli root 2>/dev/null)
if [[ $result == "$topics_real/Incidents/100" ]]
then
  pass "root prints the closest topic dir"
else
  fail "expected '$topics_real/Incidents/100', got '${result}'"
fi

# Test: `root` stops at a subtopic rather than its parent topic.
run_test
mkdir -p "$tmpdir/topics/Incidents/100/child/.beads" || exit 1
: > "$tmpdir/topics/Incidents/100/child/.beads/beads.db"
result=$(cd "$tmpdir/topics/Incidents/100/child" && run_cli root 2>/dev/null)
if [[ $result == "$topics_real/Incidents/100/child" ]]
then
  pass "root prints the subtopic dir, not its parent"
else
  fail "expected '$topics_real/Incidents/100/child', got '${result}'"
fi

# Test: `root` from a non-topic dir under the topics root prints the
# repo root, not the topic the repo's topic.txt points at.
run_test
result=$(cd "$tmpdir/topics/no-beads-here" && run_cli root 2>/dev/null)
if [[ $result == "$topics_real" ]]
then
  pass "root falls back to the repo root outside any topic dir"
else
  fail "expected '$topics_real', got '${result}'"
fi

# Test: `root` in a code repo subscribed to a topic prints the repo
# root, not the topic dir.
run_test
mkdir -p "$tmpdir/code/sub" "$tmpdir/code/.timvisher_bd_topics"
mkdir -p "$tmpdir/code"/.git
printf 'Incidents/100\n' > "$tmpdir/code/.timvisher_bd_topics/topic.txt"
code_real=$(cd "$tmpdir/code" && pwd -P)
result=$(cd "$tmpdir/code/sub" && run_cli root 2>/dev/null)
if [[ $result == "$code_real" ]]
then
  pass "root prints the repo root in a subscribed code repo"
else
  fail "expected '$code_real', got '${result}'"
fi

# Test: `root` outside any repo, topic or todo.org dir exits non-zero
# with nothing on stdout.
run_test
mkdir -p "$tmpdir/nowhere" || exit 1
if result=$(cd "$tmpdir/nowhere" && GIT_CEILING_DIRECTORIES="$tmpdir" run_cli root 2>/dev/null)
then
  fail "expected non-zero exit outside any root, got '${result}'"
elif [[ -n $result ]]
then
  fail "expected empty stdout outside any root, got '${result}'"
else
  pass "root outside any root exits non-zero with empty stdout"
fi

# Test: `root` takes no arguments.
run_test
if ! (cd "$tmpdir/topics/Incidents/100" && run_cli root extra >/dev/null 2>&1)
then
  pass "root with arguments exits non-zero"
else
  fail "expected non-zero exit for root with arguments"
fi

# Test: mv stops the source topic's dolt server so the next bd call
# auto-starts a fresh server. A live dolt sql-server cannot serve its
# database after the parent dir is renamed; leaving it running puts the
# topic into a "database not found" state until manual cleanup.
run_test
mkdir -p "$tmpdir/topics/stop-dolt-src/.beads" || exit 1
: > "$tmpdir/topics/stop-dolt-src/.beads/beads.db"
sleep 60 &
sleep_pid=$!
printf '%s' "$sleep_pid" > "$tmpdir/topics/stop-dolt-src/.beads/dolt-server.pid"
printf '%s' "54321" > "$tmpdir/topics/stop-dolt-src/.beads/dolt-server.port"
result=$(run_cli mv stop-dolt-src stop-dolt-dst 2>&1)
sleep 0.2
if [[ -d "$tmpdir/topics/stop-dolt-dst" ]] &&
    ! kill -0 "$sleep_pid" 2>/dev/null &&
    [[ ! -e "$tmpdir/topics/stop-dolt-dst/.beads/dolt-server.pid" ]] &&
    [[ ! -e "$tmpdir/topics/stop-dolt-dst/.beads/dolt-server.port" ]]
then
  pass "mv stops the source topic's dolt server and clears pid/port files"
else
  alive=no
  if kill -0 "$sleep_pid" 2>/dev/null
  then
    alive=yes
    kill "$sleep_pid" 2>/dev/null || true
  fi
  fail "mv-stops-dolt: alive='${alive}' dst-exists='$([[ -d "$tmpdir/topics/stop-dolt-dst" ]] && echo yes || echo no)' result='${result}'"
fi
wait "$sleep_pid" 2>/dev/null || true

# Test: mv tolerates a stale pid file (process already exited) without
# leaving pid/port files behind.
run_test
mkdir -p "$tmpdir/topics/stale-pid-src/.beads" || exit 1
: > "$tmpdir/topics/stale-pid-src/.beads/beads.db"
# Spawn and immediately reap a short-lived process to get a definitely-dead pid.
( exec true ) &
dead_pid=$!
wait "$dead_pid" 2>/dev/null || true
printf '%s' "$dead_pid" > "$tmpdir/topics/stale-pid-src/.beads/dolt-server.pid"
printf '%s' "54322" > "$tmpdir/topics/stale-pid-src/.beads/dolt-server.port"
result=$(run_cli mv stale-pid-src stale-pid-dst 2>&1)
if [[ -d "$tmpdir/topics/stale-pid-dst" ]] &&
    [[ ! -e "$tmpdir/topics/stale-pid-dst/.beads/dolt-server.pid" ]] &&
    [[ ! -e "$tmpdir/topics/stale-pid-dst/.beads/dolt-server.port" ]]
then
  pass "mv tolerates stale pid file and clears pid/port"
else
  fail "mv-stale-pid: result='${result}'"
fi

# Test: a repo subscribed through a symlinked path is the same subscriber
# as its resolved path.
run_test
mkdir -p "$tmpdir/topics/sym-a/.beads" "$tmpdir/topics/sym-b/.beads" \
  "$tmpdir/DevVolume/repo/.timvisher_bd_topics" "$tmpdir/DevVolume/repo/.beads" || exit 1
ln -s "$tmpdir/DevVolume" "$tmpdir/symgit" || exit 1
mkdir -p "$tmpdir/DevVolume/repo"/.git
printf 'sym-a\n' > "$tmpdir/DevVolume/repo/.timvisher_bd_topics/topic.txt"
printf '%s\n' "$topics_real/sym-a/.beads" > "$tmpdir/DevVolume/repo/.beads/redirect"
mkdir -p "$tmpdir/topics/sym-a/.timvisher_bd_topics" || exit 1
printf '%s\0' "$tmpdir/symgit/repo" > "$tmpdir/topics/sym-a/.timvisher_bd_topics/subscribers.txt"
sym_repo_real=$(cd "$tmpdir/DevVolume/repo" && pwd -P)
result=$(cd "$sym_repo_real" && run_cli set sym-b 2>&1)
(cd "$sym_repo_real" && run_cli set sym-b >/dev/null 2>&1)
a_subs=$(tr '\0' '\n' < "$tmpdir/topics/sym-a/.timvisher_bd_topics/subscribers.txt")
b_subs=$(tr '\0' '\n' < "$tmpdir/topics/sym-b/.timvisher_bd_topics/subscribers.txt" 2>/dev/null)
if [[ -z $a_subs && $b_subs == "$sym_repo_real" ]]
then
  pass "subscribers match across a symlinked repo path"
else
  fail "symlinked subscriber: sym-a='${a_subs}' sym-b='${b_subs}' set='${result}'"
fi

docs="$tmpdir/docs"
mkdir -p "$docs/projects/inner/.beads" "$docs/config/timvisher/ide" "$docs/bin" || exit 1
: > "$docs/todo.org"
: > "$docs/projects/inner/todo.org"
printf '%s\n' "$docs/projects" > "$docs/config/timvisher/ide/bd_topics_root"
cat > "$docs/bin/bd" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FAKE_BD_LOG"
if [[ $1 == init ]]
then
  mkdir -p "$BEADS_DIR"
fi
EOF
chmod +x "$docs/bin/bd" || exit 1

run_docs() {
  PATH="$docs/bin:$PATH" FAKE_BD_LOG="$docs/bd.log" XDG_CONFIG_HOME="$docs/config" "$script" "$@"
}

# Test: set refuses a todo.org directory that contains the topics root.
run_test
if ! (cd "$docs" && run_docs set inner >/dev/null 2>&1) &&
    [[ ! -e $docs/.beads/redirect && ! -e $docs/.timvisher_bd_topics/topic.txt ]]
then
  pass "set refuses a directory containing the topics root"
else
  fail "set from a directory containing the topics root subscribed it"
fi

# Test: set refuses a todo.org directory inside the topics root.
run_test
if ! (cd "$docs/projects/inner" && run_docs set inner >/dev/null 2>&1) &&
    [[ ! -e $docs/projects/inner/.timvisher_bd_topics/topic.txt ]]
then
  pass "set refuses a directory inside the topics root"
else
  fail "set from a directory inside the topics root subscribed it"
fi

# Test: new from a directory containing the topics root creates the topic
# without subscribing that directory, and keeps bd init's agent files out.
run_test
result=$(cd "$docs" && run_docs new fresh 2>&1)
if [[ -d $docs/projects/fresh/.beads && ! -e $docs/.beads/redirect &&
    ! -e $docs/.timvisher_bd_topics/topic.txt ]] &&
    grep -q -- '--skip-agents' "$docs/bd.log"
then
  pass "new creates the topic without subscribing a directory containing the topics root"
else
  fail "new from the topics root's parent: result='${result}' bd='$(< "$docs/bd.log")'"
fi

# Test: new refuses a topic whose repo name an active topic already has.
run_test
mkdir -p "$docs/projects/Cloud Networks/.beads" || exit 1
if ! (cd "$docs" && run_docs new cloud-networks >/dev/null 2>&1) &&
    [[ ! -e $docs/projects/cloud-networks ]]
then
  pass "new refuses a topic whose repo name is taken"
else
  fail "new created 'cloud-networks' alongside 'Cloud Networks'"
fi

# Test: a deactivated twin does not block new, but blocks its own activate.
run_test
: > "$docs/projects/Cloud Networks/.beads/deactivated"
(cd "$docs" && run_docs new cloud-networks >/dev/null 2>&1)
if [[ -d $docs/projects/cloud-networks/.beads ]] &&
    ! run_docs activate 'Cloud Networks' >/dev/null 2>&1 &&
    [[ -f "$docs/projects/Cloud Networks/.beads/deactivated" ]]
then
  pass "deactivated twins don't count, and activate refuses to revive one"
else
  fail "new/activate around a deactivated twin"
fi

# Test: mv refuses a destination whose repo name another topic has, but
# not one that only matches the topic being moved.
run_test
mkdir -p "$docs/projects/mv-src/.beads" "$docs/projects/Mv Taken/.beads" || exit 1
if ! run_docs mv mv-src mv-taken >/dev/null 2>&1 &&
    [[ -d $docs/projects/mv-src ]] &&
    run_docs mv 'Mv Taken' 'mv/taken' >/dev/null 2>&1 &&
    [[ -d $docs/projects/mv/taken/.beads ]]
then
  pass "mv checks the destination's repo name against other topics"
else
  fail "mv repo-name check"
fi

# remote and sync: gh, ssh, bd, dolt and git ls-remote are mocks. The
# fixture topic has an embedded database whose repo_state.json the unit
# reads directly. The unit runs from a copy so that its core registry,
# found next to the script, is a fixture rather than the repo's own.
mkdir -p "$tmpdir/ide/bash/bin" || exit 1
cp -- "$script" "$tmpdir/ide/bash/bin/timvisher_bd_topics" || exit 1
script="$tmpdir/ide/bash/bin/timvisher_bd_topics"
mock_command gh bd dolt ssh
forge_file="$tmpdir/config/timvisher/ide/bd_topics_forge"
forge_url='git+ssh://git@ddoghq.github.com/tim-visher_ddog'
nas_base='git+ssh://me@nas.example/volume3/git/topics'
remote_topic="$tmpdir/topics/Remote/Alpha One"
remote_url="$forge_url/bd-topic_remote-alpha-one.git"
nas_url="$nas_base/remote-alpha-one.git"
core_registry="$tmpdir/ide/bash/bin/timvisher_bd_topics.config/replicated.json"
overlay_registry="$tmpdir/config/timvisher/ide/bash/bin/timvisher_bd_topics.config/replicated.json"
mkdir -p "${core_registry%/*}" "${overlay_registry%/*}" || exit 1

write_repo_state() {
  local dir=$1 remotes=$2
  mkdir -p "$dir/.dolt" || exit 1
  printf '{"head": "refs/heads/main", "remotes": %s, "backups": {}, "branches": {}}\n' \
    "$remotes" > "$dir/.dolt/repo_state.json"
}

write_registry() {
  local file=$1 forge=$2 entries=$3
  printf '{"schema": 1, "forges": ["%s"], "topics": [%s]}\n' "$forge" "$entries" > "$file"
}

alpha_entry() {
  printf '{"topic": "Remote/Alpha One", "forge": "%s", "repo": "%s"}' "$1" "$2"
}

mock_remote_add() {
  # shellcheck disable=SC2016
  mock_respond bd --run '
    printf "{\"remotes\": {\"origin\": {\"name\": \"origin\", \"url\": \"%s\"}}}\n" "$5" \
      > "$BEADS_DIR/embeddeddolt/alpha/.dolt/repo_state.json"' \
    -- dolt remote add origin "$1"
}

reset_remote_fixture() {
  mock_reset gh bd dolt git ssh
  mock_git_toplevel
  rm -rf -- "$tmpdir/topics/Remote"
  write_repo_state "$remote_topic/.beads/embeddeddolt/alpha" '{}'
  printf 'github %s bd-topic_\ngit-shell %s\n' "$forge_url" "$nas_base" > "$forge_file"
  write_registry "$core_registry" git-shell ''
  write_registry "$overlay_registry" github "$(alpha_entry github bd-topic_remote-alpha-one)"
  mock_respond bd --stdout '  Database: alpha' -- dolt show
  mock_remote_add "$remote_url"
  mock_respond bd -- sync --remote origin
  mock_respond bd -- dolt push --remote origin
  mock_respond bd -- dolt pull --remote origin
  mock_respond dolt -- log --oneline '*'
