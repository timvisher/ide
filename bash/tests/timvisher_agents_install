#!/usr/bin/env bash

# Tests for timvisher_agents_install

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"

unlock_tree() {
  if command -v chflags &>/dev/null
  then
    chflags -R nouchg "$1"
  fi
}

test_root=''
trap '[[ -z $test_root ]] || { unlock_tree "$test_root"; rm -rf "$test_root"; }' EXIT
test_root=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }

# shellcheck disable=SC1091
source "${repo_root}/bash/functions/logging.bash"
# shellcheck disable=SC1091
source "${repo_root}/bash/tests/lib/timvisher_tests.bash"

setup_home() {
  local tmpdir
  tmpdir=$(mktemp -d "${test_root}/t.XXXXXX")
  mkdir -p "${tmpdir}/.agents"
  mkdir -p "${tmpdir}/.agents/skills"
  mkdir -p "${tmpdir}/.agents/languages"
  mkdir -p "${tmpdir}/.claude"
  mkdir -p "${tmpdir}/.codex/skills/.system"
  mkdir -p "${tmpdir}/git/ide/ai/HOME/.agents/languages"
  touch "${tmpdir}/git/ide/ai/HOME/AGENTS.md"
  mkdir -p "${tmpdir}/.functions"
  cp "${repo_root}/bash/functions/logging.bash" "${tmpdir}/.functions/logging.bash"
  echo "$tmpdir"
}

empty_source() {
  local dir
  dir=$(mktemp -d "${test_root}/t.XXXXXX")
  mkdir -p "${dir}/.agents/skills"
  echo "$dir"
}

cleanup() {
  unlock_tree "$1"
  rm -rf "$1"
}

is_locked_stub() {
  local path=$1

  [[ -f $path && ! -L $path ]] || return 1
  grep -qF -- 'Stop reading here unless you need to change this file itself.' "$path" || return 1
  [[ $(head -n1 "$path") == '# Do not edit this file' ]] || return 1
  [[ $(/usr/bin/stat -f '%Lp' "$path" 2>/dev/null || stat -c '%a' "$path") == 400 ]] || return 1
  if command -v chflags &>/dev/null
  then
    [[ $(/usr/bin/stat -f '%Sf' "$path") == *uchg* ]] || return 1
  fi
}

