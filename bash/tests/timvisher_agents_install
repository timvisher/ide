mkdir -p "${source_dir}/.agents/skills/skill-c"

timvisher_tests_with_home "$test_home" "${repo_root}/bash/bin/timvisher_agents_install" \
  "$source_dir" 2>/dev/null

count=0
for s in skill-a skill-b skill-c
do
  if [[ -L "${test_home}/.agents/skills/${s}" ]]
  then
    ((count++)) || true
  fi
