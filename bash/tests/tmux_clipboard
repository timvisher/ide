#!/usr/bin/env bash

# A real tmux server with the ide tmux.conf, attached through script(1)
# so its output to the outer terminal can be read back: the clipboard
# writes are OSC 52 sequences in that output.

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  (( failures += 1 ))
}

pass() {
  echo "PASS: $1"
}

run_test() {
  (( tests += 1 ))
}

# shellcheck disable=SC1091
source "$(dirname "$0")/lib/timvisher_tests.bash" || exit 1

tmux_conf="$(cd "$(dirname "$0")/.." && pwd)/tmux.conf"

if ! real_tmux=$(command -v tmux) || ! real_script=$(command -v script)
then
  echo "tmux and script are required" >&2
  exit 1
fi

t_dir=
# shellcheck disable=SC2329
cleanup() {
  if [[ -n $t_dir ]]
  then
    env -u TMUX TMUX_TMPDIR="$t_dir" "$real_tmux" kill-server 2>/dev/null
    rm -rf -- "$t_dir"
  fi
}
trap cleanup EXIT

# Under /tmp, not TMPDIR: the tmux socket path must fit in 104 bytes,
# and the runner's per-suite TMPDIR is nested too deep for that.
if ! t_dir=$(mktemp -d /tmp/tmux_clipboard.XXXXXX)
then
  echo "mktemp -d failed" >&2
  exit 1
fi

no_pbcopy_bin="${t_dir}/no-pbcopy-bin"
pbcopy_bin="${t_dir}/pbcopy-bin"
pbcopy_out="${t_dir}/pbcopy.out"
if ! mkdir "$no_pbcopy_bin" "$pbcopy_bin" \
  || ! ln -s "$real_tmux" "${no_pbcopy_bin}/tmux" \
  || ! ln -s "$real_tmux" "${pbcopy_bin}/tmux"
then
  echo "stub bin setup failed under '${t_dir}'" >&2
  exit 1
fi
cat > "${pbcopy_bin}/pbcopy" <<STUB
#!/bin/sh
cat > '${pbcopy_out}'
STUB
chmod +x "${pbcopy_bin}/pbcopy"

if "$real_script" --version 2>/dev/null | grep -q util-linux
then
  script_style=util-linux
else
  script_style=bsd
fi

t() {
  env -u TMUX TMUX_TMPDIR="$t_dir" "$real_tmux" "$@"
}

# Start a server with the ide tmux.conf whose one client is script(1)'s
# pty, recording everything tmux writes to it. The server's PATH is
# <bin>:/bin, so whether pbcopy exists is up to the case.
workspace=0
start_server() {
  local capture=$1 bin=$2 pane_cmd=$3 i
  local -a cmd=(
    env -u TMUX "TMUX_TMPDIR=${t_dir}" "PATH=${bin}:/bin" TERM=xterm-256color
    "TIMVISHER_WORKSPACE_CLIPBOARD=${workspace}" ${server_env[@]+"${server_env[@]}"}
    "$real_tmux" -f "$tmux_conf" new-session -x 80 -y 24 "$pane_cmd"
  )
  if [[ $script_style = util-linux ]]
  then
    local quoted
    printf -v quoted '%q ' "${cmd[@]}"
    "$real_script" -q -e -c "$quoted" "$capture" </dev/null >/dev/null 2>&1 &
  else
    "$real_script" -q "$capture" "${cmd[@]}" </dev/null >/dev/null 2>&1 &
  fi
  script_pid=$!
  for (( i = 0; i < 50; i += 1 ))
  do
    client=$(t list-clients -F '#{client_name}' 2>/dev/null)
    [[ -n $client ]] && return 0
    sleep 0.1
  done
  return 1
}

stop_server() {
  sleep 0.5
  t kill-server 2>/dev/null
  wait "$script_pid" 2>/dev/null
}

osc52s() {
  grep -a -o $'\e\\]52;[^\a]*\a' "$1" | cat -v
}

b64() {
  printf %s "$1" | base64 | tr -d '\n'
}

check_osc52() {
  local name=$1 capture=$2 want=$3 got
  got=$(osc52s "$capture")
  run_test
  if [[ $got = "$want" ]]
  then
    pass "$name"
  else
    fail "${name}: want '${want}', got '${got}'"
  fi
}

text=tmux-clipboard-set-buffer
capture="${t_dir}/set-buffer"
if start_server "$capture" "$no_pbcopy_bin" 'sleep 30'
then
  t set-buffer -w "$text"
  stop_server
  check_osc52 "a tmux copy reaches the outer terminal as OSC 52 selection c" \
    "$capture" "^[]52;c;$(b64 "$text")^G"
else
  stop_server
  run_test
  fail "no client attached for the set-buffer case"
fi

text=tmux-clipboard-primary
capture="${t_dir}/pane-primary"
if start_server "$capture" "$no_pbcopy_bin" \
  "printf '\\033]52;p;$(b64 "$text")\\a'; sleep 30"
then
  stop_server
  check_osc52 "a pane's OSC 52 passes through tmux, as selection c" \
    "$capture" "^[]52;c;$(b64 "$text")^G"
else
  stop_server
  run_test
  fail "no client attached for the pane OSC 52 case"
fi

text=tmux-clipboard-prefix-y-osc52
capture="${t_dir}/prefix-y-osc52"
if start_server "$capture" "$no_pbcopy_bin" 'sleep 30'
then
  t set-buffer "$text"
  t send-keys -K -c "$client" C-] y
  stop_server
  check_osc52 "C-] y without pbcopy copies by OSC 52" \
    "$capture" "^[]52;c;$(b64 "$text")^G"
else
  stop_server
  run_test
  fail "no client attached for the C-] y OSC 52 case"
fi

text=tmux-clipboard-prefix-y-pbcopy
capture="${t_dir}/prefix-y-pbcopy"
if start_server "$capture" "$pbcopy_bin" 'sleep 30'
then
  t set-buffer "$text"
  t send-keys -K -c "$client" C-] y
  stop_server
  check_osc52 "C-] y with pbcopy sends no OSC 52" "$capture" ''
  run_test
  if [[ $(cat "$pbcopy_out" 2>/dev/null) = "$text" ]]
  then
    pass "C-] y with pbcopy copies through pbcopy"
  else
    fail "pbcopy got '$(cat "$pbcopy_out" 2>/dev/null)', want '${text}'"
  fi
else
  stop_server
  run_test
  fail "no client attached for the C-] y pbcopy case"
fi

workspace=1
ws_home="${t_dir}/ws-home"
ws_copied="${t_dir}/ws-copied"
if ! mkdir -p "${ws_home}/bin"
then
  echo "mkdir '${ws_home}/bin' failed" >&2
  exit 1
fi
cat > "${ws_home}/bin/timvisher_workspace_clipboard" <<STUB
#!/bin/sh
cat >> '${ws_copied}'
printf '\n' >> '${ws_copied}'
STUB
chmod +x "${ws_home}/bin/timvisher_workspace_clipboard"

text=tmux-clipboard-ws-copy-mode
capture="${t_dir}/ws-copy-mode"
rm -f -- "$ws_copied"
if timvisher_tests_with_home "$ws_home" start_server "$capture" "$no_pbcopy_bin" \
  "printf '%s\\n' '${text}'; sleep 30"
then
  t copy-mode
  t send-keys -X history-top
  t send-keys -X begin-selection
  t send-keys -X end-of-line
  t send-keys -X copy-pipe-and-cancel
  stop_server
  check_osc52 "workspace: a copy-mode copy sends no OSC 52" "$capture" ''
  run_test
  if grep -q -- "$text" "$ws_copied" 2>/dev/null
  then
    pass "workspace: a copy-mode copy goes to timvisher_workspace_clipboard"
  else
    fail "workspace: copy-command got '$(cat "$ws_copied" 2>/dev/null)', want '${text}'"
  fi
else
  stop_server
  run_test
  fail "no client attached for the workspace copy-mode case"
fi

text=tmux-clipboard-ws-prefix-y
capture="${t_dir}/ws-prefix-y"
rm -f -- "$ws_copied" "$pbcopy_out"
if timvisher_tests_with_home "$ws_home" start_server "$capture" "$pbcopy_bin" 'sleep 30'
then
  t set-buffer "$text"
  t send-keys -K -c "$client" C-] y
  sleep 0.5
  stop_server
  check_osc52 "workspace: C-] y sends no OSC 52, pbcopy or not" "$capture" ''
  run_test
  if [[ $(cat "$ws_copied" 2>/dev/null) = "$text" && ! -e $pbcopy_out ]]
  then
    pass "workspace: C-] y goes to timvisher_workspace_clipboard, not pbcopy"
  else
    fail "workspace: C-] y copied '$(cat "$ws_copied" 2>/dev/null)', pbcopy got '$(cat "$pbcopy_out" 2>/dev/null)'"
  fi
else
  stop_server
  run_test
  fail "no client attached for the workspace C-] y case"
fi

text=tmux-clipboard-ws-pane
capture="${t_dir}/ws-pane"
if timvisher_tests_with_home "$ws_home" start_server "$capture" "$no_pbcopy_bin" \
  "printf '\\033]52;c;$(b64 "${text}-raw")\\a\\033Ptmux;\\033\\033]52;c;$(b64 "$text")\\a\\033\\\\'; sleep 30"
then
  stop_server
  check_osc52 "workspace: only a pane's passthrough OSC 52 reaches the terminal" \
    "$capture" "^[]52;c;$(b64 "$text")^G"
else
  stop_server
  run_test
  fail "no client attached for the workspace pane case"
fi

fallback_home="${t_dir}/fallback-home"
if ! mkdir -p "${fallback_home}/bin" \
  || ! ln -s "$(cd "$(dirname "$0")/../bin" && pwd)/timvisher_workspace_clipboard" \
    "${fallback_home}/bin/timvisher_workspace_clipboard"
then
  echo "fallback home setup failed under '${t_dir}'" >&2
  exit 1
fi
text=tmux-clipboard-ws-fallback
capture="${t_dir}/ws-fallback"
server_env=("WORKSPACES_DAEMON_SOCKET=${t_dir}/no-daemon.sock" "TIMVISHER_WORKSPACE_CLIPBOARD_XCLIP=/bin/false")
if timvisher_tests_with_home "$fallback_home" start_server "$capture" "${no_pbcopy_bin}:/usr/bin" 'sleep 30'
then
  t set-buffer "$text"
  t send-keys -K -c "$client" C-] y
  sleep 2
  stop_server
  check_osc52 "workspace: with no daemon, C-] y falls back to OSC 52 once" \
    "$capture" "^[]52;c;$(b64 "$text")^G"
else
  stop_server
  run_test
  fail "no client attached for the workspace fallback case"
fi
server_env=()

echo
echo "Results: ${tests} tests, ${failures} failures"
exit "$failures"
