#!/usr/bin/env bash

failures=0
tests=0

check() {
  local description=$1
  shift
  (( tests += 1 ))
  if "$@"
  then
    echo "PASS: $description"
  else
    echo "FAIL: $description" >&2
    sed 's/^/    stderr: /' "$tmpdir/stderr" >&2
    (( failures += 1 ))
  fi
}

repo_root=$(cd "$(dirname "$0")/../.." && pwd -P)
tool=$repo_root/bash/bin/timvisher_notify

tmpdir=
trap '[[ -z $tmpdir ]] || rm -rf -- "$tmpdir"' EXIT
tmpdir=$(mktemp -d) || { echo 'FAIL: mktemp' >&2; exit 1; }
mkdir -p "$tmpdir/bin" || exit 1

cat > "$tmpdir/bin/osascript" <<'FAKE'
#!/usr/bin/env bash
printf 'osascript %s\n' "$*" >> "$FAKE_DIR/calls"
FAKE
cat > "$tmpdir/client" <<'FAKE'
#!/usr/bin/env bash
printf 'client %s\n' "$*" >> "$FAKE_DIR/calls"
exit "${FAKE_CLIENT_RC:-0}"
FAKE
chmod +x "$tmpdir/bin/osascript" "$tmpdir/client" || exit 1

run() {
  rm -f -- "$tmpdir/calls"
  env -u TERM_PROGRAM -u TMUX -u GHOSTTY_RESOURCES_DIR -u ITERM_SESSION_ID \
    -u WEZTERM_EXECUTABLE -u KITTY_PID \
    PATH="$tmpdir/bin:$PATH" FAKE_DIR="$tmpdir" TIMVISHER_NOTIFY_RELAY_CLIENT="$tmpdir/client" \
    "$@" "$tool" 'build done' 'exit 0 after 41s' 2> "$tmpdir/stderr" < /dev/null
}

calls() {
  [[ $(cat -- "$tmpdir/calls" 2> /dev/null) == "$1" ]]
}

stderr_has() {
  grep -q -F -- "$1" "$tmpdir/stderr"
}

run env -u WORKSPACES_DAEMON_SOCKET
check 'laptop: the OS notification, not the relay' calls "osascript -e display notification \"exit 0 after 41s\" with title \"build done\""
check 'laptop: the line on stderr' stderr_has 'build done: exit 0 after 41s'

run env WORKSPACES_DAEMON_SOCKET=/home/bits/.local/state/workspaces/daemon.sock
check 'workspace: through the relay client, title and body' calls 'client --title build done --body exit 0 after 41s'
check 'workspace: the line on stderr too' stderr_has 'build done: exit 0 after 41s'

run env WORKSPACES_DAEMON_SOCKET=x FAKE_CLIENT_RC=69
rc=$?
check 'workspace, laptop unreachable: still exit 0' [ "$rc" = 0 ]

run env WORKSPACES_DAEMON_SOCKET=x TIMVISHER_NOTIFY_RELAY_CLIENT="$tmpdir/no-such-client"
rc=$?
check 'workspace, no relay client: exit 0, and says so' [ "$rc" = 0 ]
check 'workspace, no relay client: nothing else tried' [ ! -e "$tmpdir/calls" ]
check 'workspace, no relay client: one line saying why' stderr_has 'not shown on the laptop: no agent relay client at'

rm -f -- "$tmpdir/calls"
env WORKSPACES_DAEMON_SOCKET=x PATH="$tmpdir/bin:$PATH" FAKE_DIR="$tmpdir" TIMVISHER_NOTIFY_RELAY_CLIENT="$tmpdir/client" \
  "$tool" --silent t m 2> "$tmpdir/stderr" < /dev/null
check '--silent on a workspace: no relay call' [ ! -e "$tmpdir/calls" ]

cat > "$tmpdir/bin/tmux" <<'FAKE'
#!/usr/bin/env bash
case "$*" in
  'show-environment -g TERM_PROGRAM') printf 'TERM_PROGRAM=ghostty\n' ;;
  'show-option -gv allow-passthrough') printf 'on\n' ;;
  *'#{pane_tty}'*) printf '/dev/null\n' ;;
  *'#{session_attached}'*) printf '%s\n' "$FAKE_PANE_VISIBILITY" ;;
  *) exit 1 ;;
esac
FAKE
cat > "$tmpdir/bin/lsappinfo" <<'FAKE'
#!/usr/bin/env bash
[[ -n $FAKE_FRONT_BUNDLE ]] || exit 1
case $1 in
  front) printf 'ASN:0x0-0x1:\n' ;;
  info) printf '[ NULL ]  ASN:0x0-0x1: \n    bundleID="%s"\n' "$FAKE_FRONT_BUNDLE" ;;
  *) exit 1 ;;
esac
FAKE
chmod +x "$tmpdir/bin/tmux" "$tmpdir/bin/lsappinfo" || exit 1

# An agent tool call inside tmux: no controlling terminal, a writable pane tty.
# $1 is the frontmost app's bundle id; $2 is the pane's
# '#{session_attached} #{window_active} #{window_zoomed_flag} #{pane_active}'.
run_in_pane() {
  run env -u WORKSPACES_DAEMON_SOCKET TERM_PROGRAM=tmux TMUX=/tmp/x.tmux-fake,1,0 TMUX_PANE=%1 \
    TIMVISHER_NOTIFY_TTY="$tmpdir/no-controlling-terminal" TIMVISHER_NOTIFY_DEBUG=1 \
    FAKE_FRONT_BUNDLE="$1" FAKE_PANE_VISIBILITY="$2"
}

wrote_pane() {
  stderr_has "wrote to tmux pane tty '/dev/null'" && [ ! -e "$tmpdir/calls" ]
}

used_osascript() {
  ! stderr_has "wrote to tmux pane tty" && grep -q '^osascript ' "$tmpdir/calls"
}

run_in_pane com.apple.Safari '1 1 0 1'
check 'no ctty, another app frontmost, pane on screen: the pane tty' wrote_pane

run_in_pane com.mitchellh.ghostty '1 1 0 1'
check 'no ctty, Ghostty frontmost: osascript, since Ghostty hides its banners while focused' used_osascript

run_in_pane com.apple.Safari '0 1 0 1'
check 'no ctty, detached session: osascript, since tmux drops passthrough nobody sees' used_osascript

run_in_pane com.apple.Safari '1 0 0 1'
check 'no ctty, pane in a background window: osascript' used_osascript

run_in_pane com.apple.Safari '1 1 1 0'
check 'no ctty, another pane zoomed over it: osascript' used_osascript

run_in_pane com.apple.Safari '1 1 1 1'
check 'no ctty, the zoomed pane itself: the pane tty' wrote_pane

run_in_pane '' '1 1 0 1'
check 'no ctty, frontmost app unknown: osascript' used_osascript

printf 'Results: %d tests, %d failures\n' "$tests" "$failures"
(( failures == 0 ))
