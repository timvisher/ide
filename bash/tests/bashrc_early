#!/usr/bin/env bash
# shellcheck disable=SC2016

failures=0
tests=0

check() {
  local description=$1
  local expected=$2
  local actual=$3

  (( tests += 1 ))
  if [[ $actual == "$expected" ]]
  then
    echo "PASS: $description"
  else
    echo "FAIL: $description: expected '${expected}', got '${actual}'" >&2
    (( failures += 1 ))
  fi
}

core="$(cd "$(dirname "$0")/../.." && pwd -P)"
# shellcheck disable=SC1091
source "$(dirname "$0")/lib/timvisher_tests.bash" || exit 1

tmpdir=
cleanup() { [[ -z $tmpdir ]] || rm -rf -- "$tmpdir"; }
trap cleanup EXIT
tmpdir=$(mktemp -d) || { echo 'FAIL: mktemp' >&2; exit 1; }

home=$tmpdir/home
overlay=$home/.config/timvisher/ide/bash
mkdir -p "$overlay" "$home/.functions" || exit 1

printf 'order="${order-} ai"\n' > "$home/.functions/ai.bash"

run_bashrc() {
  timvisher_tests_with_home "$home" bash -c '
    source "$1" > /dev/null 2>&1
    printf "order=[%s] HISTSIZE=[%s] stop=[%s]" \
      "${order# }" "${HISTSIZE-unset}" "${timvisher_ide_bashrc_stop-unset}"
  ' _ "$core/bash/bashrc" < /dev/null
}

check 'no bashrc_early: core init runs as before' \
      'order=[ai] HISTSIZE=[500000] stop=[unset]' \
      "$(run_bashrc)"

printf 'order="${order-} early"\n' > "$overlay/bashrc_early"

check 'bashrc_early runs once, before ~/.functions/ai.bash, and init goes on' \
      'order=[early ai] HISTSIZE=[500000] stop=[unset]' \
      "$(run_bashrc)"

printf 'order="${order-} early"\ntimvisher_ide_bashrc_stop=1\n' > "$overlay/bashrc_early"

check 'bashrc_early setting timvisher_ide_bashrc_stop ends core init there, and the flag does not leak' \
      'order=[early] HISTSIZE=[unset] stop=[unset]' \
      "$(run_bashrc)"

echo
echo "$(( tests - failures ))/$tests passed"
(( 0 == failures ))
