#!/usr/bin/env bash

# Tests for timvisher_uv

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  (( failures += 1 ))
}

pass() {
  echo "PASS: $1"
}

run_test() {
  (( tests += 1 ))
}

script_dir="$(cd "$(dirname "$0")/.." && pwd)"
script="${script_dir}/bin/timvisher_uv"

tmpdir=
trap 'rm -rf -- "$tmpdir"' EXIT
if ! tmpdir=$(mktemp -d)
then
  echo "mktemp failed" >&2
  exit 1
fi

mkdir -p "$tmpdir/home" "$tmpdir/mockbin" "$tmpdir/core/python/bin" "$tmpdir/overlay/python/bin"
ln -s "${script_dir}/functions" "$tmpdir/home/.functions"

cat > "$tmpdir/mockbin/uv" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "VIRTUAL_ENV=${VIRTUAL_ENV-} uv $*" >> "$FAKE_UV_LOG"
case "$1 $2" in
  'python find')
    if [[ -e $FAKE_UV_DIR/installed ]]
    then
      printf '%s\n' "$FAKE_UV_DIR/python"
    else
      echo "error: No interpreter found for Python $3" >&2
      exit 2
    fi
    ;;
  'python install')
    touch "$FAKE_UV_DIR/installed"
    echo "Installed Python $3" >&2
    ;;
  venv\ *)
    shift
    venv=
    version=
    while (( 0 < $# ))
    do
      case $1 in
        --python) version=$2; shift 2 ;;
        --*) shift ;;
        *) venv=$1; shift ;;
      esac
    done
    mkdir -p "$venv/bin"
    printf 'version_info = %s\n' "$version" > "$venv/pyvenv.cfg"
    ;;
  sync\ *)
    if (( 0 != ${FAKE_UV_SYNC_RC:-0} ))
    then
      echo "error: Failed to resolve script requirements" >&2
      exit "$FAKE_UV_SYNC_RC"
    fi
    ;;
esac
MOCK
chmod +x "$tmpdir/mockbin/uv"

cat > "$tmpdir/mockbin/python" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$FAKE_PY_VERSION"
MOCK
chmod +x "$tmpdir/mockbin/python"

make_tool() {
  local path=$1
  local name=${path##*/}
  local requires=${2-'>=3.15'}
  {
    printf '#!/usr/bin/env -S timvisher_uv exec %s\n' "$name"
    printf '# /// script\n'
    if [[ -n $requires ]]
    then
      printf '# requires-python = "%s"\n' "$requires"
    fi
    printf '# dependencies = []\n'
    printf '# ///\n'
    printf 'print("hi")\n'
  } > "$path"
  chmod +x "$path"
}

reset_uv() {
  rm -rf "$tmpdir/data" "$tmpdir/fakeuv"
  mkdir -p "$tmpdir/fakeuv"
  ln -s "$tmpdir/mockbin/python" "$tmpdir/fakeuv/python"
  touch "$tmpdir/fakeuv/installed"
  : > "$tmpdir/uv.log"
}

run_uv() {
  HOME="$tmpdir/home" \
  XDG_DATA_HOME="$tmpdir/data" \
  PATH="$tmpdir/overlay/python/bin:$tmpdir/core/python/bin:$tmpdir/mockbin:$PATH" \
  FAKE_UV_LOG="$tmpdir/uv.log" \
  FAKE_UV_DIR="$tmpdir/fakeuv" \
  FAKE_PY_VERSION="${FAKE_PY_VERSION:-3.15.0}" \
  TIMVISHER_AGENT=true \
  timvisher_logging_log_level=INFO \
    "$script" "$@" > "$tmpdir/stdout" 2> "$tmpdir/stderr"
}

check() {
  local description=$1
  shift
  run_test
  if "$@"
  then
    pass "$description"
  else
    fail "$description"
    sed 's/^/    stderr: /' "$tmpdir/stderr" >&2
    sed 's/^/    uv: /' "$tmpdir/uv.log" >&2
  fi
}

logged() {
  grep -qF -- "$1" "$tmpdir/uv.log"
}

not_logged() {
  ! grep -qF -- "$1" "$tmpdir/uv.log"
}

stdout_empty() {
  [[ ! -s $tmpdir/stdout ]]
}

stderr_has() {
  grep -qF -- "$1" "$tmpdir/stderr"
}

venv="$tmpdir/data/timvisher_uv/virtualenvs/demo"
core_demo="$tmpdir/core/python/bin/demo"
make_tool "$core_demo"

reset_uv
run_uv demo
rc=$?
check 'create: exits 0' test "$rc" -eq 0
check 'create: prints nothing on stdout' stdout_empty
check 'create: makes the venv with the found version' \
      logged "uv venv --python 3.15.0 --allow-existing $venv"
check 'create: does not clear a new venv' not_logged '--clear'
check 'create: syncs the script into the venv' \
      logged "VIRTUAL_ENV=$venv uv sync --script $core_demo --active"
check 'create: logs that it created the venv' stderr_has 'created'
check 'create: skips python install when uv finds a match' not_logged 'uv python install'

: > "$tmpdir/uv.log"
run_uv demo
rc=$?
check 'no-op: exits 0' test "$rc" -eq 0
check 'no-op: prints nothing on stdout' stdout_empty
check 'no-op: does not clear the venv' not_logged '--clear'
check 'no-op: logs no change to the venv' eval "! grep -qE 'created|recreated' '$tmpdir/stderr'"

: > "$tmpdir/uv.log"
FAKE_PY_VERSION=3.15.1 run_uv demo
rc=$?
check 'version change: exits 0' test "$rc" -eq 0
check 'version change: recreates the venv with --clear' \
      logged "uv venv --python 3.15.1 --allow-existing --clear $venv"
check 'version change: logs the old and new versions' stderr_has '3.15.0 -> 3.15.1'

reset_uv
rm "$tmpdir/fakeuv/installed"
run_uv demo
rc=$?
check 'python install: exits 0' test "$rc" -eq 0
check 'python install: installs the requested Python when none is found' \
      logged 'uv python install >=3.15'
check 'python install: logs the install' stderr_has 'installed Python'

overlay_demo="$tmpdir/overlay/python/bin/demo"
make_tool "$overlay_demo"
reset_uv
run_uv demo
check 'precedence: the overlay tool wins over core' \
      logged "uv sync --script $overlay_demo --active"
check 'precedence: the core tool is not synced' not_logged "$core_demo"

make_tool "$tmpdir/core/python/bin/other"
printf '#!/usr/bin/env python3\nprint("not a tool")\n' > "$tmpdir/core/python/bin/plain"
chmod +x "$tmpdir/core/python/bin/plain"
reset_uv
run_uv
rc=$?
check 'all tools: exits 0' test "$rc" -eq 0
check 'all tools: upserts the overlay demo' \
      logged "uv sync --script $overlay_demo --active"
check 'all tools: upserts core-only tools' \
      logged "uv sync --script $tmpdir/core/python/bin/other --active"
check 'all tools: skips the shadowed core demo' not_logged "$core_demo"
check 'all tools: ignores executables without the timvisher_uv shebang' not_logged 'plain'

reset_uv
run_uv plain
rc=$?
check 'unknown tool: exits 1' test "$rc" -eq 1
check 'unknown tool: reports timvisher_uv_tool_not_found' \
      stderr_has '"code":"timvisher_uv_tool_not_found"'
check 'unknown tool: suggests where tools live' stderr_has 'python/bin'

make_tool "$tmpdir/core/python/bin/noreq" ''
reset_uv
run_uv noreq
rc=$?
check 'no requires-python: exits 1' test "$rc" -eq 1
check 'no requires-python: reports timvisher_uv_metadata_invalid' \
      stderr_has '"code":"timvisher_uv_metadata_invalid"'

reset_uv
FAKE_UV_SYNC_RC=1 run_uv demo
rc=$?
check 'uv failure: exits 1' test "$rc" -eq 1
check 'uv failure: reports timvisher_uv_uv_failed' stderr_has '"code":"timvisher_uv_uv_failed"'
check "uv failure: includes uv's own error" stderr_has 'Failed to resolve script requirements'
check 'uv failure: suggests rerunning' stderr_has 'timvisher_uv demo'

reset_uv
FAKE_UV_SYNC_RC=1 run_uv
rc=$?
check 'all tools with a failure: exits 1' test "$rc" -eq 1
check 'all tools with a failure: still tries every tool' \
      logged "uv sync --script $tmpdir/core/python/bin/other --active"
rm "$tmpdir/core/python/bin/noreq"

run_uv --help
rc=$?
check '--help: exits 0 with usage on stdout' eval "(( rc == 0 )) && grep -q 'Usage: timvisher_uv' '$tmpdir/stdout'"

echo ""
echo "Results: $((tests - failures))/${tests} passed"

if (( 0 < failures ))
then
  exit 1
fi
