# ---------------------------------------------------------------------------
# temp-build + move invariant tests (ide-8hi)
#
# A newly-created worktree must be built in a hidden temp sibling and moved
# into the canonical path only as the final step, so an agent that knows the
# predictable canonical path can never see/edit a half-built worktree.  We
# prove this with a post-initial-branch-dir-creation hook that records the
# directory the slow post-create maintenance runs in: it must be a
# .x.ntmux3-building.* temp dir, NOT the canonical path.
# ---------------------------------------------------------------------------

# Install a hook that records $PWD where post-create maintenance runs.
# hooks_dir resolves under XDG_CONFIG_HOME — see script's config_dir.
build_pwd_record="$tmpdir/build_pwd.txt"
mkdir -p "$hooks_dir/testorg/testrepo"
cat > "$hooks_dir/testorg/testrepo/post-initial-branch-dir-creation" <<HOOK
#!/usr/bin/env bash
printf '%s\n' "\$PWD" > "$build_pwd_record"
HOOK
chmod +x "$hooks_dir/testorg/testrepo/post-initial-branch-dir-creation"

# Test: post-create maintenance runs in a temp build dir, not the canonical path
run_test
rm -f "$build_pwd_record"
tempcheck_dir=$(ensure_worktree "testorg/testrepo/feature/tempcheck" 2>/dev/null) && rc=0 || rc=$?
build_pwd=$(cat "$build_pwd_record" 2>/dev/null) || true
if (( rc == 0 )) && [[ ${build_pwd##*/} == .x.ntmux3-building.* && $build_pwd != "$tempcheck_dir" ]]
then
  pass "ensure_worktree: builds new worktree in temp dir (window invisible at canonical path)"
else
  fail "ensure_worktree temp-build: rc=$rc build_pwd='${build_pwd}' canonical='${tempcheck_dir}'"
fi

# Test: the canonical worktree is valid and on the right branch after the move
run_test
if [[ -d $tempcheck_dir ]] &&
  [[ $("$test_git" -C "$tempcheck_dir" rev-parse --abbrev-ref HEAD 2>/dev/null) == "feature/tempcheck" ]]
then
  pass "ensure_worktree: moved worktree is valid and on the expected branch"
else
  fail "ensure_worktree: canonical worktree invalid at '${tempcheck_dir}'"
fi

# Test: no x.ntmux3-building marker remains once the worktree is ready
run_test
if [[ ! -f "${tempcheck_dir}/x.ntmux3-building" ]]
then
  pass "ensure_worktree: x.ntmux3-building marker removed when worktree is ready"
else
  fail "ensure_worktree: x.ntmux3-building should not remain at '${tempcheck_dir}'"
fi

# Test: no leftover temp build dirs remain in the parent after a successful build
run_test
leftover=$(find "$(dirname "$tempcheck_dir")" -maxdepth 1 -name '.x.ntmux3-building.*' 2>/dev/null)
if [[ -z $leftover ]]
then
  pass "ensure_worktree: no leftover temp build dir after successful move"
else
  fail "ensure_worktree: leftover temp build dir(s): ${leftover}"
fi

# Remove the test hook so it doesn't fire for unrelated worktree creations below.
rm -f "$hooks_dir/testorg/testrepo/post-initial-branch-dir-creation"

