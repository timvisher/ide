#!/usr/bin/env bash
# shellcheck source=bash/tests/lib/timvisher_git.bash
source "$(dirname "$0")/../lib/timvisher_git.bash" || exit 1

# Integration tests for timvisher_git: worktrees, bare caches,
# submodules, remotes and pushes, against real repositories. git is
# mocked with a passthrough to the real git, so the unit never runs the
# ~/bin/git wrapper (its own suite covers it). Fixtures are built with
# "$real_git" directly.

mock_passthrough git "$real_git"

source_timvisher_git

# ---------------------------------------------------------------------------
# maintenance registry reconcile tests
# ---------------------------------------------------------------------------

mr_home="$tmpdir/maint_home"
mkdir -p "$mr_home/.config/git"
mr_config="$mr_home/.config/git/config_machine"
mr_live="$tmpdir/maint_live_trunk"
mr_live2="$tmpdir/maint_live_trunk2"
mkdir -p "$mr_live" "$mr_live2"

# Dead entries must go, live ones must stay, and ~ in a stored path has
# to expand before the existence check -- the real registry stored
# tilde-prefixed paths.
run_test
: > "$mr_config"
"$real_git" config --file "$mr_config" --add maintenance.repo '~/definitely-not-a-real-dir-xyz'
"$real_git" config --file "$mr_config" --add maintenance.repo "$mr_live"
XDG_CONFIG_HOME="$mr_home/.config" reconcile_maintenance_repos >/dev/null 2>&1
mr_after=$("$real_git" config --file "$mr_config" --get-all maintenance.repo 2>/dev/null | tr '\n' ' ')
if [[ $mr_after == "${mr_live} " ]]
then
  pass "reconcile_maintenance_repos prunes missing entries and keeps live ones"
else
  fail "maintenance prune: expected only '${mr_live}', got '${mr_after}'"
fi

run_test
XDG_CONFIG_HOME="$mr_home/.config" reconcile_maintenance_repos "$mr_live2" >/dev/null 2>&1
mr_after=$("$real_git" config --file "$mr_config" --get-all maintenance.repo 2>/dev/null | tr '\n' ' ')
if [[ $mr_after == "${mr_live} ${mr_live2} " ]]
then
  pass "reconcile_maintenance_repos registers a new trunk"
else
  fail "maintenance register: expected both trunks, got '${mr_after}'"
fi

# Re-registering must not duplicate.
run_test
XDG_CONFIG_HOME="$mr_home/.config" reconcile_maintenance_repos "$mr_live2" >/dev/null 2>&1
mr_count=$("$real_git" config --file "$mr_config" --get-all maintenance.repo 2>/dev/null | grep -cxF "$mr_live2")
if [[ $mr_count == 1 ]]
then
  pass "reconcile_maintenance_repos does not duplicate an existing trunk"
else
  fail "maintenance re-register: expected 1 entry for the trunk, got ${mr_count}"
fi

# Nothing to do must mean no rewrite at all.
run_test
mr_before_mtime=$(stat -c %Y "$mr_config")
XDG_CONFIG_HOME="$mr_home/.config" reconcile_maintenance_repos "$mr_live2" >/dev/null 2>&1
mr_after_mtime=$(stat -c %Y "$mr_config")
if [[ $mr_before_mtime == "$mr_after_mtime" ]]
then
  pass "reconcile_maintenance_repos leaves the file alone when converged"
else
  fail "maintenance reconcile rewrote a converged file"
fi

# `git maintenance register` and `start` write maintenance.repo to
# --global, which is a symlink into a git repo here. Entries that land
# there must be drained out, normalised to the trunk that owns the object
# store, and existence-checked like any other.
run_test
mr_global="$mr_home/.config/git/config"
mr_trunks="$tmpdir/mr_trunks"
mkdir -p "$mr_trunks/myorg/live"
mkdir -p "$mr_home/git/myorg/live/some/branch"
: > "$mr_config"
: > "$mr_global"
"$real_git" config --file "$mr_global" --add maintenance.repo "$mr_home/git/myorg/live/some/branch"
"$real_git" config --file "$mr_global" --add maintenance.repo "$mr_home/git/myorg/gone/a/branch"
(
  XDG_CONFIG_HOME="$mr_home/.config" \
  live_repo_dir="$mr_home/git" \
  repo_trunks_dir="$mr_trunks" \
    reconcile_maintenance_repos
) >/dev/null 2>&1
mr_global_left=$("$real_git" config --file "$mr_global" --get-all maintenance.repo 2>/dev/null | wc -l | tr -d ' ')
mr_after=$("$real_git" config --file "$mr_config" --get-all maintenance.repo 2>/dev/null | tr '\n' ' ')
if [[ $mr_global_left == 0 && $mr_after == "${mr_trunks}/myorg/live " ]]
then
  pass "reconcile_maintenance_repos drains the tracked global config and normalises to trunks"
else
  fail "maintenance drain: global_left=${mr_global_left} machine='${mr_after}' (wanted 0 and '${mr_trunks}/myorg/live ')"
fi

# ---------------------------------------------------------------------------
# bare-poisoning source repair tests
# ---------------------------------------------------------------------------

# A cache with extensions.worktreeConfig on AND core.bare still in the
# shared config is malformed per git: every linked worktree inherits
# bare=true, so even raw `git worktree add` yields an unusable worktree.
bp_dir="$tmpdir/bare_poison"
mkdir -p "$bp_dir"
bp_make_malformed() {
  local d=$1
  rm -rf "$d"
  mkdir -p "$d"
  "$real_git" init -q --bare "$d/trunk.git"
  "$real_git" init -q "$d/seed"
  (
    cd "$d/seed" &&
      echo x > a &&
      "$real_git" add a &&
      "$real_git" -c user.email=a@b -c user.name=a commit -qm i &&
      "$real_git" push -q "$d/trunk.git" HEAD:refs/heads/main
  ) >/dev/null 2>&1
  "$real_git" -C "$d/trunk.git" symbolic-ref HEAD refs/heads/main
  "$real_git" -C "$d/trunk.git" config extensions.worktreeConfig true
}

run_test
bp_make_malformed "$bp_dir/m1"
"$real_git" -C "$bp_dir/m1/trunk.git" worktree add -q "$bp_dir/m1/wt" main >/dev/null 2>&1
poisoned_before=$("$real_git" -C "$bp_dir/m1/wt" rev-parse --is-bare-repository 2>/dev/null)
repair_bare_poisoning_source "$bp_dir/m1/trunk.git" >/dev/null 2>&1
shared_after=$("$real_git" -C "$bp_dir/m1/trunk.git" config --file "$bp_dir/m1/trunk.git/config" --get core.bare 2>/dev/null) || shared_after=""
still_bare=$("$real_git" -C "$bp_dir/m1/trunk.git" rev-parse --is-bare-repository 2>/dev/null)
poisoned_after=$("$real_git" -C "$bp_dir/m1/wt" rev-parse --is-bare-repository 2>/dev/null)
if [[ $poisoned_before == true && -z $shared_after && $still_bare == true && $poisoned_after == false ]]
then
  pass "repair_bare_poisoning_source migrates core.bare and heals worktrees"
else
  fail "repair expected poisoned->healed with cache still bare, got before=${poisoned_before} shared=${shared_after} bare=${still_bare} after=${poisoned_after}"
fi

# The whole point: raw `git worktree add` must work afterwards, with no
# per-worktree healing involved.
run_test
"$real_git" -C "$bp_dir/m1/trunk.git" worktree add -q "$bp_dir/m1/wt2" -b second main >/dev/null 2>&1
raw_bare=$("$real_git" -C "$bp_dir/m1/wt2" rev-parse --is-bare-repository 2>/dev/null)
if [[ $raw_bare == false ]]
then
  pass "raw git worktree add yields a usable worktree after source repair"
else
  fail "raw worktree add after repair: expected is-bare false, got '${raw_bare}'"
fi

# Idempotent: a second pass must not re-migrate or disturb anything.
run_test
repair_bare_poisoning_source "$bp_dir/m1/trunk.git" >/dev/null 2>&1
rc=$?
still_bare2=$("$real_git" -C "$bp_dir/m1/trunk.git" rev-parse --is-bare-repository 2>/dev/null)
if (( rc == 0 )) && [[ $still_bare2 == true ]]
then
  pass "repair_bare_poisoning_source is idempotent"
else
  fail "second repair pass: rc=${rc} still_bare=${still_bare2}"
fi

# Inert when the extension is off -- the overwhelmingly common case, and
# the one where touching core.bare would be actively wrong.
run_test
rm -rf "$bp_dir/healthy"
mkdir -p "$bp_dir/healthy"
"$real_git" init -q --bare "$bp_dir/healthy/trunk.git"
repair_bare_poisoning_source "$bp_dir/healthy/trunk.git" >/dev/null 2>&1
healthy_shared=$("$real_git" -C "$bp_dir/healthy/trunk.git" config --file "$bp_dir/healthy/trunk.git/config" --get core.bare 2>/dev/null)
if [[ $healthy_shared == true ]]
then
  pass "repair_bare_poisoning_source leaves a healthy cache untouched"
else
  fail "healthy cache core.bare should stay in shared config, got '${healthy_shared}'"
fi

# ---------------------------------------------------------------------------
# Setup for is_branch_ish and clone_stacked integration tests
# ---------------------------------------------------------------------------

# Fixtures are built with the real git directly, unrecorded.
test_git=$real_git

# Create a source repo to serve as the remote
source_repo="$tmpdir/remote"
"$test_git" init "$source_repo" >/dev/null 2>&1
"$test_git" -C "$source_repo" -c user.email=test@test.com -c user.name=Test \
  -c core.hooksPath=/dev/null commit --allow-empty -m "initial" >/dev/null 2>&1
default_branch=$("$test_git" -C "$source_repo" rev-parse --abbrev-ref HEAD)

# Add a feature/base branch with a unique commit
"$test_git" -C "$source_repo" checkout -b feature/base >/dev/null 2>&1
"$test_git" -C "$source_repo" -c user.email=test@test.com -c user.name=Test \
  -c core.hooksPath=/dev/null commit --allow-empty -m "base commit" >/dev/null 2>&1
base_commit=$("$test_git" -C "$source_repo" rev-parse HEAD)
"$test_git" -C "$source_repo" checkout "$default_branch" >/dev/null 2>&1

# Initialize a bare cache (simulating what cache_trunk creates)
mkdir -p "$cache_dir/repo_trunks/testorg"
"$test_git" init --bare "$cache_dir/repo_trunks/testorg/testrepo" >/dev/null 2>&1
"$test_git" -C "$cache_dir/repo_trunks/testorg/testrepo" remote add origin "$source_repo"
"$test_git" -C "$cache_dir/repo_trunks/testorg/testrepo" fetch origin >/dev/null 2>&1
"$test_git" -C "$cache_dir/repo_trunks/testorg/testrepo" remote set-head origin -a >/dev/null 2>&1

# Add org alias: to → testorg, and re-source to pick it up
echo 'to=testorg' > "$ide_config/git_org_aliases"
source_timvisher_git

# Override cache/live dirs to use test paths
repo_trunks_dir="$cache_dir/repo_trunks"
live_repo_dir="$live_dir"
# Re-add alias (source_timvisher_git re-reads the file, but the script
# also sources from $ide_config under XDG_CONFIG_HOME — however
# the source function blanks the file.  Set it directly.)
org_aliases[to]=testorg

# ---------------------------------------------------------------------------
# is_branch_ish tests
# ---------------------------------------------------------------------------

# Test: rejects empty arg
run_test
if is_branch_ish "" 2>/dev/null
then
  fail "is_branch_ish should reject empty arg"
else
  pass "is_branch_ish rejects empty arg"
fi

# Test: rejects bare word with no slash
run_test
if is_branch_ish "notabranchish" 2>/dev/null
then
  fail "is_branch_ish should reject bare word"
else
  pass "is_branch_ish rejects bare word"
fi

# Test: rejects non-existent local path
run_test
if is_branch_ish "/tmp/nonexistent_$(date +%s)" 2>/dev/null
then
  fail "is_branch_ish should reject non-existent local path"
else
  pass "is_branch_ish rejects non-existent local path"
fi

# Test: rejects non-git local directory
run_test
plain_dir="$tmpdir/plain_dir"
mkdir -p "$plain_dir"
if is_branch_ish "$plain_dir" 2>/dev/null
then
  fail "is_branch_ish should reject non-git local directory"
else
  pass "is_branch_ish rejects non-git local directory"
fi

# Test: rejects purely local (non-managed) git repo
run_test
local_repo="$tmpdir/local_repo"
"$test_git" init "$local_repo" >/dev/null 2>&1
"$test_git" -C "$local_repo" -c user.email=test@test.com -c user.name=Test \
  -c core.hooksPath=/dev/null commit --allow-empty -m "local" >/dev/null 2>&1
if is_branch_ish "$local_repo" 2>/dev/null
then
  fail "is_branch_ish should reject purely local (non-managed) git repo"
else
  pass "is_branch_ish rejects purely local (non-managed) git repo"
fi

# Test: accepts valid org/repo/branch shorthand
run_test
if is_branch_ish "testorg/testrepo/mybranch" 2>/dev/null
then
  pass "is_branch_ish accepts valid org/repo/branch"
else
  fail "is_branch_ish should accept valid org/repo/branch"
fi

run_test
if is_branch_ish "main" "testorg/testrepo/feature/top" 2>/dev/null
then
  pass "is_branch_ish accepts a relative branch-ish given a context"
else
  fail "is_branch_ish should accept a bare branch name when a context is given"
fi

run_test
if is_branch_ish "not a branch" "testorg/testrepo/feature/top" 2>/dev/null
then
  fail "is_branch_ish should reject an invalid branch name even with a context"
else
  pass "is_branch_ish rejects an invalid branch name even with a context"
fi

run_test
if is_branch_ish "main" "banana" 2>/dev/null
then
  fail "is_branch_ish should reject a context that is not itself a complete branch-ish"
else
  pass "is_branch_ish rejects a context that is not a complete branch-ish"
fi

run_test
if "$script" is-branch-ish main testorg/testrepo/feature/top 2>/dev/null &&
  ! "$script" is-branch-ish main 2>/dev/null
then
  pass "is-branch-ish CLI takes the optional context"
else
  fail "is-branch-ish CLI: 'main' should pass only with a context"
fi

# Test: accepts org/repo shorthand (resolves to trunk)
run_test
if is_branch_ish "testorg/testrepo" 2>/dev/null
then
  pass "is_branch_ish accepts valid org/repo"
else
  fail "is_branch_ish should accept valid org/repo"
fi

# Test: accepts org alias shorthand
run_test
if is_branch_ish "to/testrepo" 2>/dev/null
then
  pass "is_branch_ish accepts org alias shorthand"
else
  fail "is_branch_ish should accept org alias shorthand (to -> testorg)"
fi

# Test: accepts org/repo shape even when the repo isn't cached
# (downstream callers surface the real fetch/auth error)
run_test
if is_branch_ish "nosuchorg/nosuchrepo" 2>/dev/null
then
  pass "is_branch_ish accepts org/repo shape regardless of cache state"
else
  fail "is_branch_ish should accept org/repo shape regardless of cache state"
fi

# Test: accepts https:// URL shape
run_test
if is_branch_ish "https://github.com/some/repo" 2>/dev/null
then
  pass "is_branch_ish accepts https URL shape"
else
  fail "is_branch_ish should accept https URL shape"
fi

# Test: accepts git@ SSH URL shape
run_test
if is_branch_ish "git@github.com:some/repo" 2>/dev/null
then
  pass "is_branch_ish accepts git@ SSH URL shape"
else
  fail "is_branch_ish should accept git@ SSH URL shape"
fi

# Test: rejects input with no slash
run_test
if is_branch_ish "singletoken" 2>/dev/null
then
  fail "is_branch_ish should reject slash-less tokens"
else
  pass "is_branch_ish rejects slash-less tokens"
fi

# ---------------------------------------------------------------------------
# clone_stacked tests
# ---------------------------------------------------------------------------

# Test: clone_stacked creates target stacked on base
run_test
target_dir=$(clone_stacked "testorg/testrepo/feature/target" "testorg/testrepo/feature/base" 2>/dev/null) && rc=0 || rc=$?
if (( rc == 0 ))
then
  target_head=$("$test_git" -C "$target_dir" rev-parse HEAD 2>/dev/null) || true
  base_dir="$live_dir/testorg/testrepo/feature/base"
  base_head=$("$test_git" -C "$base_dir" rev-parse HEAD 2>/dev/null) || true
  if [[ $target_head == "$base_head" && $target_head == "$base_commit" ]]
  then
    pass "clone_stacked: target HEAD matches base HEAD"
  else
    fail "clone_stacked: target HEAD '${target_head}' != base commit '${base_commit}' (base HEAD '${base_head}')"
  fi
else
  fail "clone_stacked: returned rc=${rc}"
fi

# Test: x.ntmux3-building is cleaned up after successful stacking
run_test
if [[ ! -f "${target_dir}/x.ntmux3-building" ]]
then
  pass "clone_stacked: x.ntmux3-building cleaned up after stacking"
else
  fail "clone_stacked: x.ntmux3-building should not exist after successful stacking"
fi

# Test: is_branch_ish accepts managed worktree local path
# (depends on clone_stacked having created the base worktree above)
run_test
if is_branch_ish "$base_dir" 2>/dev/null
then
  pass "is_branch_ish accepts managed worktree local path"
else
  fail "is_branch_ish should accept managed worktree local path"
fi

# Test: clone_stacked skips stacking on existing target with no x.ntmux3-building
run_test
if [[ -z $target_dir || ! -d $target_dir ]]
then
  fail "clone_stacked: skipping — target_dir is empty from prior failure"
else
  # Make a commit in the target so we can detect if reset happens
  "$test_git" -C "$target_dir" -c user.email=test@test.com -c user.name=Test \
    -c core.hooksPath=/dev/null commit --allow-empty -m "target-only commit" >/dev/null 2>&1
  target_only_commit=$("$test_git" -C "$target_dir" rev-parse HEAD)
  target_dir2=$(clone_stacked "testorg/testrepo/feature/target" "testorg/testrepo/feature/base" 2>/dev/null) && rc=0 || rc=$?
  if (( rc == 0 ))
  then
    target_head2=$("$test_git" -C "$target_dir2" rev-parse HEAD 2>/dev/null) || true
    if [[ $target_head2 == "$target_only_commit" ]]
    then
      pass "clone_stacked: skips stacking on existing target (HEAD preserved)"
    else
      fail "clone_stacked: should preserve existing target HEAD '${target_only_commit}', got '${target_head2}'"
    fi
  else
    fail "clone_stacked: second call returned rc=${rc}"
  fi
fi

# Test: clone_stacked recovers via x.ntmux3-building
run_test
if [[ -z $base_dir || ! -d $base_dir || -z $target_dir || ! -d $target_dir ]]
then
  fail "clone_stacked: skipping recovery — base_dir or target_dir is empty from prior failure"
else
  # Advance the base branch with a new commit
  "$test_git" -C "$base_dir" -c user.email=test@test.com -c user.name=Test \
    -c core.hooksPath=/dev/null commit --allow-empty -m "recovery commit" >/dev/null 2>&1
  recovery_commit=$("$test_git" -C "$base_dir" rev-parse HEAD)
  # Simulate partial failure: write x.ntmux3-building
  printf '%s\n' "testorg/testrepo/feature/base" > "${target_dir}/x.ntmux3-building"
  target_dir3=$(clone_stacked "testorg/testrepo/feature/target" "testorg/testrepo/feature/base" 2>/dev/null) && rc=0 || rc=$?
  if (( rc == 0 ))
  then
    target_head3=$("$test_git" -C "$target_dir3" rev-parse HEAD 2>/dev/null) || true
    if [[ $target_head3 == "$recovery_commit" && ! -f "${target_dir3}/x.ntmux3-building" ]]
    then
      pass "clone_stacked: recovers via x.ntmux3-building and re-stacks"
    else
      fail "clone_stacked: recovery failed (target=${target_head3} expected=${recovery_commit} pending=$(test -f "${target_dir3}/x.ntmux3-building" && echo yes || echo no))"
    fi
  else
    fail "clone_stacked: recovery call returned rc=${rc}"
  fi
fi

# Test: clone_stacked rejects mismatched org/repo
run_test
result=$(clone_stacked "testorg/testrepo/feature/a" "otherorg/otherrepo/feature/b" 2>/dev/null) && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "clone_stacked: rejects mismatched org/repo"
else
  fail "clone_stacked: should reject mismatched org/repo"
fi

run_test
if (cd "$live_dir/testorg/testrepo" && is_branch_ish ./feature/base) 2>/dev/null
then
  pass "is_branch_ish: accepts a ./relative managed worktree path"
else
  fail "is_branch_ish: should accept a ./relative managed worktree path"
fi

run_test
if is_branch_ish "main" "$live_dir/testorg/testrepo/feature/base" 2>/dev/null
then
  pass "is_branch_ish: a managed worktree path is a valid context"
else
  fail "is_branch_ish: a managed worktree path should be a valid context"
fi

stack_base_as_human() {
  (
    unset CLAUDECODE TIMVISHER_CODEX TIMVISHER_AGENT timvisher_logging_log_level
    "$@"
  )
}

stack_base_as_agent() {
  (
    unset CLAUDECODE TIMVISHER_CODEX timvisher_logging_log_level
    export TIMVISHER_AGENT=1
    "$@"
  )
}

stack_base_err="$tmpdir/stack_base.err"

run_test
result=$(stack_base_as_human resolve_stack_base "testorg/testrepo/feature/target" main 2>"$stack_base_err")
if [[ $result == "testorg/testrepo/main" ]] && ! grep -q ambiguous "$stack_base_err"
then
  pass "resolve_stack_base: slash-less base is a branch of the target repo, no warning"
else
  fail "resolve_stack_base: slash-less base: got '${result}', stderr: $(cat "$stack_base_err")"
fi

run_test
result=$(stack_base_as_human resolve_stack_base "testorg/testrepo/feature/target" "testorg/testrepo/feature/base" 2>"$stack_base_err")
if [[ $result == "testorg/testrepo/feature/base" ]] && ! grep -q ambiguous "$stack_base_err"
then
  pass "resolve_stack_base: base qualified with the target org/repo is used as-is"
else
  fail "resolve_stack_base: qualified base: got '${result}', stderr: $(cat "$stack_base_err")"
fi

run_test
result=$(stack_base_as_human resolve_stack_base "testorg/testrepo/feature/target" "TestOrg/testrepo/feature/base" 2>"$stack_base_err")
if [[ $result == "TestOrg/testrepo/feature/base" ]] && ! grep -q ambiguous "$stack_base_err"
then
  pass "resolve_stack_base: org match is case-insensitive"
else
  fail "resolve_stack_base: case-insensitive org: got '${result}', stderr: $(cat "$stack_base_err")"
fi

run_test
result=$(stack_base_as_human resolve_stack_base "testorg/testrepo/feature/target" "to/testrepo/feature/base" 2>"$stack_base_err")
if [[ $result == "to/testrepo/feature/base" ]] && ! grep -q ambiguous "$stack_base_err"
then
  pass "resolve_stack_base: base qualified via an org alias of the target is used as-is"
else
  fail "resolve_stack_base: alias-qualified base: got '${result}', stderr: $(cat "$stack_base_err")"
fi

run_test
result=$(stack_base_as_human resolve_stack_base "testorg/testrepo/feature/target" "feature/base" 2>"$stack_base_err")
if [[ $result == "testorg/testrepo/feature/base" ]] &&
  grep -q ambiguous "$stack_base_err" &&
  grep -qF "Pass the base qualified to make the intent explicit: testorg/testrepo/feature/base" "$stack_base_err"
then
  pass "resolve_stack_base: slashed unqualified base defaults to the target repo and warns"
else
  fail "resolve_stack_base: ambiguous base: got '${result}', stderr: $(cat "$stack_base_err")"
fi

run_test
result=$(stack_base_as_human resolve_stack_base "testorg/testrepo/feature/target" "someone/area/thing" 2>"$stack_base_err")
if [[ $result == "testorg/testrepo/someone/area/thing" ]] &&
  grep -qF "names repo someone/area" "$stack_base_err"
then
  pass "resolve_stack_base: warning names the repo the base would otherwise point at"
else
  fail "resolve_stack_base: foreign-looking base: got '${result}', stderr: $(cat "$stack_base_err")"
fi

run_test
result=$(stack_base_as_agent resolve_stack_base "testorg/testrepo/feature/target" "feature/base" 2>"$stack_base_err")
if [[ $result == "testorg/testrepo/feature/base" ]] &&
  grep -qF '"type":"instruction"' "$stack_base_err" &&
  grep -qF '"code":"timvisher_git_stack_base_inherited"' "$stack_base_err"
then
  pass "resolve_stack_base: ambiguity reaches agents as an aictl instruction"
else
  fail "resolve_stack_base: agent notice: got '${result}', stderr: $(cat "$stack_base_err")"
fi

stack_base_with_siblings() {
  (
    org_aliases[tg]="testorg,oldorg,liveorg,ghostorg"
    "$@"
  )
}

run_test
result=$(stack_base_as_human stack_base_with_siblings resolve_stack_base "testorg/testrepo/feature/target" "oldorg/testrepo/feature/base" 2>"$stack_base_err")
