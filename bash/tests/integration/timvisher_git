# ---------------------------------------------------------------------------
# push
# ---------------------------------------------------------------------------

push_root="$tmpdir/push"
mkdir -p "$push_root" ||
  die "cannot create '$push_root'"

pg() {
  "$test_git" -c commit.gpgsign=false -c init.defaultBranch=main "$@"
}

push_commit() {
  local repo=$1 name=$2
  printf '%s\n' "$name" > "$repo/$name" &&
    pg -C "$repo" add "$name" &&
    pg -C "$repo" commit -q -m "$name"
}

# push_fixture <name>: a bare origin with main, a worktree on feature
# branched from it, and a second clone for other people's pushes.
push_fixture() {
  local name=$1 dir=$push_root/$1
  pg init -q --bare "$dir/origin.git" &&
    pg clone -q "$dir/origin.git" "$dir/seed" 2>/dev/null &&
    push_commit "$dir/seed" m1 &&
    pg -C "$dir/seed" push -q origin HEAD:refs/heads/main &&
    pg -C "$dir/origin.git" symbolic-ref HEAD refs/heads/main &&
    pg clone -q "$dir/origin.git" "$dir/work" &&
    pg -C "$dir/work" switch -q -c feature &&
    push_commit "$dir/work" a1 &&
    pg clone -q "$dir/origin.git" "$dir/other" ||
    die "cannot build push fixture '$name'"
  printf '%s\n' "$dir"
}

push_out=
push_err=
push_rc=
push_run() {
  local repo=$1
  shift
  push_out=$(cd "$repo" &&
    PATH="$(dirname "$test_git"):$PATH" TIMVISHER_AGENT=1 \
      "$script" push "$@" </dev/null 2>"$push_root/err") && push_rc=0 || push_rc=$?
  push_err=$(< "$push_root/err")
}

remote_feature() {
  pg -C "$1/origin.git" rev-parse -q --verify refs/heads/feature
}

head_of() {
  pg -C "$1/work" rev-parse HEAD
}

check_push() {
  local description=$1
  shift
  run_test
