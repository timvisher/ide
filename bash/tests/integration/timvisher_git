# Test: dies cleanly when the mv loop fails mid-flatten.
# Regression for main-669: die() inside the subshell only exited the
# subshell, so an mv failure was masked by a downstream rmdir error.
# Now the parent should die with a "failed to flatten" message.
run_test
mv_fail_src="$tmpdir/mv_fail_src"
"$test_git" init "$mv_fail_src" >/dev/null 2>&1
"$test_git" -C "$mv_fail_src" -c user.email=t@t -c user.name=t \
  -c core.hooksPath=/dev/null commit --allow-empty -m init >/dev/null 2>&1
mv_fail_cache="$tmpdir/mv_fail_cache"
"$test_git" clone "$mv_fail_src" "$mv_fail_cache" >/dev/null 2>&1
"$test_git" -C "$mv_fail_cache" -c core.hooksPath=/dev/null checkout --detach >/dev/null 2>&1

# Force every mv to fail by shadowing it on PATH. The function's `mv`
# (not `command mv`) resolves through PATH; `command git` is unaffected.
mkdir -p "$tmpdir/mv_fail_bin"
cat > "$tmpdir/mv_fail_bin/mv" <<'FAKE_MV'
#!/usr/bin/env bash
echo "fake mv: refusing" >&2
exit 1
FAKE_MV
chmod +x "$tmpdir/mv_fail_bin/mv"

mv_fail_output=$(PATH="$tmpdir/mv_fail_bin:$PATH" \
  migrate_cache_to_bare_if_needed "$mv_fail_cache" 2>&1)
mv_fail_rc=$?

if (( 0 < mv_fail_rc )) && [[ $mv_fail_output == *"failed to flatten"* ]]
then
  pass "migrate_cache_to_bare_if_needed: dies on mv failure with correct error (main-669)"
else
  fail "migrate mv-failure path: rc=${mv_fail_rc}, output='${mv_fail_output}'"
fi

# ---------------------------------------------------------------------------
# ensure_worktrees_not_poisoned_by_bare tests (ide-wfp)
# ---------------------------------------------------------------------------
#
# Build a small helper that creates an already-bare cache whose linked
# worktrees lack the per-worktree `core.bare = false` override — the
# state the buggy migration leaves caches in.

setup_poisoned_cache() {
  local label=$1
  local with_extension=$2  # true|false

  local src="$tmpdir/poison_${label}_src"
  "$test_git" init "$src" >/dev/null 2>&1
  "$test_git" -C "$src" -c user.email=t@t -c user.name=t \
    -c core.hooksPath=/dev/null commit --allow-empty -m init >/dev/null 2>&1

  local cache="$tmpdir/poison_${label}_cache"
  "$test_git" init --bare "$cache" >/dev/null 2>&1
  "$test_git" -C "$cache" remote add origin "$src" >/dev/null 2>&1
  "$test_git" -C "$cache" fetch origin >/dev/null 2>&1
  "$test_git" -C "$cache" remote set-head origin -a >/dev/null 2>&1

  if [[ $with_extension == true ]]
  then
    "$test_git" -C "$cache" config extensions.worktreeConfig true
  fi

  local wt="$tmpdir/poison_${label}_wt"
  "$test_git" -C "$cache" worktree add --detach "$wt" \
    "origin/$default_branch" >/dev/null 2>&1

  printf '%s;%s' "$cache" "$wt"
}

# Test: heal pass writes per-worktree core.bare=false on a worktree that
# is poisoned by core.bare=true on the common config + worktreeConfig
# extension enabled.
run_test
poisoned=$(setup_poisoned_cache "wfp_heal" true)
heal_cache=${poisoned%%;*}
heal_wt=${poisoned#*;}

# Confirm pre-state: no per-worktree override yet.
pre_override=$("$test_git" -C "$heal_wt" config --worktree --get core.bare 2>/dev/null) || pre_override=""

migrate_cache_to_bare_if_needed "$heal_cache" >/dev/null 2>&1

post_override=$("$test_git" -C "$heal_wt" config --worktree --get core.bare 2>/dev/null) || post_override=""
post_inside=$("$test_git" -C "$heal_wt" rev-parse --is-inside-work-tree 2>/dev/null) || post_inside=""

if [[ -z $pre_override ]] && [[ $post_override == false ]] && [[ $post_inside == true ]]
then
  pass "ensure_worktrees_not_poisoned_by_bare: writes per-worktree core.bare=false (ide-wfp)"
else
  fail "heal pass: pre_override='${pre_override}' post_override='${post_override}' post_inside='${post_inside}'"
fi

# Test: no-op when extensions.worktreeConfig is not enabled. Without the
# extension, `git config --worktree` would fail and we have no evidence
# that bare-poisoning happens — the heal must skip silently and not
# write any per-worktree config.
run_test
poisoned_noext=$(setup_poisoned_cache "wfp_noext" false)
noext_cache=${poisoned_noext%%;*}
noext_wt=${poisoned_noext#*;}

migrate_cache_to_bare_if_needed "$noext_cache" >/dev/null 2>&1

# config.worktree must not exist under the linked worktree's gitdir.
noext_wt_gitdir=$("$test_git" -C "$noext_wt" rev-parse --git-dir 2>/dev/null)
noext_wt_gitdir=$(cd "$noext_wt" && cd "$noext_wt_gitdir" && pwd -P)

if [[ ! -e "$noext_wt_gitdir/config.worktree" ]]
then
  pass "ensure_worktrees_not_poisoned_by_bare: no-op when extensions.worktreeConfig is off (ide-wfp)"
else
  fail "no-extension heal: config.worktree should not exist at '${noext_wt_gitdir}'"
fi

# Test: idempotent — already-healed worktree stays at core.bare=false
# and a second heal pass is a no-op (no rewrite of the file).
run_test
poisoned_idem=$(setup_poisoned_cache "wfp_idem" true)
idem_cache=${poisoned_idem%%;*}
idem_wt=${poisoned_idem#*;}

migrate_cache_to_bare_if_needed "$idem_cache" >/dev/null 2>&1

idem_wt_gitdir=$("$test_git" -C "$idem_wt" rev-parse --git-dir 2>/dev/null)
idem_wt_gitdir=$(cd "$idem_wt" && cd "$idem_wt_gitdir" && pwd -P)
first_mtime=$(/usr/bin/stat -f '%m' "$idem_wt_gitdir/config.worktree" 2>/dev/null) || first_mtime=""

# Wait one second so a re-write would produce a distinct mtime.
sleep 1
migrate_cache_to_bare_if_needed "$idem_cache" >/dev/null 2>&1
second_mtime=$(/usr/bin/stat -f '%m' "$idem_wt_gitdir/config.worktree" 2>/dev/null) || second_mtime=""
second_value=$("$test_git" -C "$idem_wt" config --worktree --get core.bare 2>/dev/null) || second_value=""

if [[ -n $first_mtime ]] && [[ $first_mtime == "$second_mtime" ]] && [[ $second_value == false ]]
then
  pass "ensure_worktrees_not_poisoned_by_bare: idempotent on already-healed worktree (ide-wfp)"
else
  fail "idempotent heal: first_mtime='${first_mtime}' second_mtime='${second_mtime}' second_value='${second_value}'"
fi

