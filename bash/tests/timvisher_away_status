#!/usr/bin/env bash

# Tests for timvisher_away_status

# The fakes below replace ioreg but not plutil, so off macOS there is
# nothing to run the script against.
if [[ $(uname -s) != Darwin ]]
then
  printf 'SKIP: timvisher_away_status is macOS-only (ioreg, plutil); this is %s\n' "$(uname -s)"
  exit 0
fi

failures=0

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  (( failures += 1 ))
}

pass() {
  printf 'PASS: %s\n' "$1"
}

tmpdir=
cleanup() {
  [[ -z $tmpdir ]] || rm -rf -- "$tmpdir"
}
trap cleanup EXIT
tmpdir=$(mktemp -d) || exit 1

script="$(cd "$(dirname "$0")/.." && pwd)/bin/timvisher_away_status"

mkdir -- "$tmpdir/bin" || exit 1

cat > "$tmpdir/bin/ioreg" <<'FAKE'
#!/usr/bin/env bash
case " $* " in
  *' HIDIdleTime '*)
    printf '+-o IOHIDSystem  <class IOHIDSystem>\n  {\n    "HIDIdleTime" = %s\n  }\n' "$FAKE_IDLE_NS"
    ;;
  *' Root '*)
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>IOConsoleUsers</key>
  <array>
    <dict>
      <key>kCGSSessionOnConsoleKey</key>
      <true/>
      ${FAKE_LOCK_XML}
    </dict>
  </array>
</dict>
</plist>
PLIST
    ;;
  *)
    exit 1
    ;;
esac
FAKE

cat > "$tmpdir/bin/pgrep" <<'FAKE'
#!/usr/bin/env bash
[[ -n $FAKE_SCREENSAVER ]]
FAKE

chmod +x "$tmpdir/bin/ioreg" "$tmpdir/bin/pgrep" || exit 1

locked_xml='<key>CGSSessionScreenIsLocked</key><true/>'

run() {
  local idle_ns=$1 screensaver=$2 lock_xml=$3
  shift 3
  PATH="$tmpdir/bin:$PATH" FAKE_IDLE_NS=$idle_ns FAKE_SCREENSAVER=$screensaver \
    FAKE_LOCK_XML=$lock_xml XDG_STATE_HOME="$tmpdir/state" "$script" "$@"
}

strip_time() {
  sed -E 's/^\{"checked_at":"[^"]*","checked_at_epoch":[0-9]+,/{/'
}

check() {
  local name=$1 expected=$2
  shift 2
  local actual
  actual=$(run "$@" | strip_time)
  if [[ $actual == "$expected" ]]
  then
    pass "$name"
  else
    fail "$name: expected '${expected}', got '${actual}'"
  fi
}

check "present" \
  '{"idle_seconds":4,"idle_threshold_seconds":600,"screensaver_active":false,"screen_locked":false,"idle":false,"away":false,"away_reasons":[]}' \
  4126095583 '' ''

check "idle just under the threshold" \
  '{"idle_seconds":599,"idle_threshold_seconds":600,"screensaver_active":false,"screen_locked":false,"idle":false,"away":false,"away_reasons":[]}' \
  599999999999 '' ''

check "idle at the threshold" \
  '{"idle_seconds":600,"idle_threshold_seconds":600,"screensaver_active":false,"screen_locked":false,"idle":true,"away":true,"away_reasons":["idle"]}' \
  600000000000 '' ''

check "screensaver running" \
  '{"idle_seconds":30,"idle_threshold_seconds":600,"screensaver_active":true,"screen_locked":false,"idle":false,"away":true,"away_reasons":["screensaver"]}' \
  30000000000 1 ''

check "screen locked" \
  '{"idle_seconds":0,"idle_threshold_seconds":600,"screensaver_active":false,"screen_locked":true,"idle":false,"away":true,"away_reasons":["locked"]}' \
  75872500 '' "$locked_xml"

check "every reason at once" \
  '{"idle_seconds":3600,"idle_threshold_seconds":600,"screensaver_active":true,"screen_locked":true,"idle":true,"away":true,"away_reasons":["screensaver","locked","idle"]}' \
  3600000000000 1 "$locked_xml"

check "lock key present but false" \
  '{"idle_seconds":0,"idle_threshold_seconds":600,"screensaver_active":false,"screen_locked":false,"idle":false,"away":false,"away_reasons":[]}' \
  0 '' '<key>CGSSessionScreenIsLocked</key><false/>'

now=$(timvisher_date now +%s)
epoch=$(run 0 '' '' | sed -E 's/.*"checked_at_epoch":([0-9]+).*/\1/')
if [[ $epoch =~ ^[0-9]+$ ]] && (( now - 5 <= epoch && epoch <= now + 5 ))
then
  pass "checked_at_epoch is the current time"
else
  fail "checked_at_epoch is the current time: got '${epoch}', now '${now}'"
fi

status_file="$tmpdir/state/timvisher/away-status/status.json"
stdout=$(run 600000000000 '' '' --write)
if [[ -z $stdout && -f $status_file ]] &&
  [[ $(strip_time < "$status_file") == *'"away":true,"away_reasons":["idle"]}' ]]
then
  pass "--write writes the status file and nothing to stdout"
else
  fail "--write writes the status file and nothing to stdout: stdout '${stdout}'"
fi

run 0 '' '' --write
if [[ $(strip_time < "$status_file") == *'"away":false,"away_reasons":[]}' ]] &&
  [[ -z $(find "$tmpdir/state/timvisher/away-status" -name 'status.json.*') ]]
then
  pass "--write replaces the status file and leaves no temp files"
else
  fail "--write replaces the status file and leaves no temp files"
fi

# --live, and an empty state dir, both on purpose: a bare call prefers a
# fresh cache, so once the daemon is installed this would read a cached
# answer, exit 0, and stop testing the sensor it names. Verified by
# constructing a fresh cache and watching the bare form return 0.
if PATH="$tmpdir/bin:$PATH" FAKE_IDLE_NS=bogus XDG_STATE_HOME="$tmpdir/empty-state" \
  "$script" --live >/dev/null 2>&1
then
  fail "unparsable HIDIdleTime exits non-zero"
else
  pass "unparsable HIDIdleTime exits non-zero"
fi

if [[ -n $("$script" --help 2>/dev/null) ]]
then
  pass "--help prints to stdout"
else
  fail "--help prints to stdout"
fi

if [[ -z $("$script" bogus 2>/dev/null) ]] && ! "$script" bogus >/dev/null 2>&1
then
  pass "bad argument prints nothing to stdout and exits non-zero"
else
  fail "bad argument prints nothing to stdout and exits non-zero"
fi


# --- the freshness contract -------------------------------------------
#
# These run with a BROKEN sensor on purpose. ioreg exits non-zero, so a
# live computation cannot succeed: any run that produces output proves the
# cached answer was used, and any run that fails proves it was not. That
# is the whole question, asked so it cannot be answered by accident.

cat > "$tmpdir/bin/broken-ioreg" <<'FAKE'
#!/usr/bin/env bash
exit 1
FAKE
chmod +x "$tmpdir/bin/broken-ioreg" || exit 1

cache_state=
seed_cache() {
  local age=$1 body=$2 epoch
  cache_state=$(mktemp -d "$tmpdir/cache.XXXXXX") || return 1
  mkdir -p -- "$cache_state/timvisher/away-status" || return 1
  if [[ -z $body ]]
  then
    printf -v epoch '%(%s)T' -1
    (( epoch -= age ))
    body=$(printf '{"checked_at":"seeded","checked_at_epoch":%d,"idle_seconds":7,"idle_threshold_seconds":600,"screensaver_active":false,"screen_locked":false,"idle":false,"away":false,"away_reasons":[]}' "$epoch")
  fi
  printf '%s\n' "$body" > "$cache_state/timvisher/away-status/status.json"
}

cache_case() {
  local name=$1 age=$2 body=$3 want=$4
  shift 4
  seed_cache "$age" "$body" || { fail "$name: could not seed"; return; }
  # Break the sensor for this call only.
  mv -- "$tmpdir/bin/ioreg" "$tmpdir/bin/ioreg.real"
  cp -- "$tmpdir/bin/broken-ioreg" "$tmpdir/bin/ioreg"
  local out rc
  out=$(PATH="$tmpdir/bin:$PATH" XDG_STATE_HOME="$cache_state" "$script" "$@" 2>/dev/null)
  rc=$?
  mv -f -- "$tmpdir/bin/ioreg.real" "$tmpdir/bin/ioreg"
  case $want in
    used)
      if (( 0 == rc )) && [[ $out == *'"checked_at":"seeded"'* ]]
      then
        pass "$name"
      else
        fail "$name: expected the cached answer, got rc=${rc} '${out}'"
      fi
      ;;
    ignored)
      if (( 0 != rc ))
      then
        pass "$name"
      else
        fail "$name: expected the cache to be ignored, got rc=0 '${out}'"
      fi
      ;;
  esac
}

cache_case "a fresh cache is reused" 10 '' used
# Not seeded at exactly max_age_seconds. The script compares whole
# seconds against the clock it reads itself, so a cache seeded at the
# limit is one second older by the time it is read and is correctly
# ignored -- the test loses a race the script is winning. A reused case
# has to sit far enough inside that elapsed time cannot carry it out;
# an ignored case only gets more ignored, so it can sit next to the
# limit. The pair still pins max_age_seconds to [170, 180].
cache_case "a cache well inside the age limit is still reused" 170 '' used
cache_case "a cache past the age limit is ignored" 181 '' ignored
cache_case "a long-stale cache, as after sleep, is ignored" 86400 '' ignored
cache_case "a cache timestamped in the future is ignored" -600 '' ignored
cache_case "an unparsable cache is ignored" 0 'not json at all' ignored
cache_case "a cache with no checked_at_epoch is ignored" 0 '{"away":false}' ignored
cache_case "an empty cache file is ignored" 0 ' ' ignored
cache_case "--live ignores a fresh cache" 10 '' ignored --live
cache_case "--write ignores a fresh cache" 10 '' ignored --write


# --- self-healing the LaunchAgent -------------------------------------
#
# launchctl is stubbed rather than suppressed, so these assert what the
# script DOES rather than that it stays away from launchd. The stub
# records its arguments; absence of the record is a real answer.

cat > "$tmpdir/bin/launchctl" <<'FAKE'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$HEAL_LOG"
FAKE
chmod +x "$tmpdir/bin/launchctl" || exit 1

heal_home=
heal_log=
setup_heal() {
  local install_plist=$1
  heal_home=$(mktemp -d "$tmpdir/heal.XXXXXX") || return 1
  heal_log="$heal_home/launchctl.log"
  : > "$heal_log" || return 1
  mkdir -p -- "$heal_home/LaunchAgents" || return 1
  if [[ -n $install_plist ]]
  then
    printf 'plist\n' > "$heal_home/LaunchAgents/com.twonegatives.away-status.plist"
  fi
}

# HOME is left alone on purpose: the script sources ~/.functions/aictl.bash
# before it does anything, so overriding HOME does not isolate the test, it
# stops the script from starting at all -- which looks exactly like "the
# heal did not run".
run_heal() {
  PATH="$tmpdir/bin:$PATH" FAKE_IDLE_NS=0 FAKE_SCREENSAVER='' FAKE_LOCK_XML='' \
    TIMVISHER_LAUNCHAGENTS_DIR="$heal_home/LaunchAgents" \
    HEAL_LOG="$heal_log" XDG_STATE_HOME="$cache_state" \
    "$script" "$@" > /dev/null 2>&1
}

heal_case() {
  local name=$1 want=$2
  if [[ $want == bootstrapped ]] && [[ -s $heal_log ]] &&
    [[ $(< "$heal_log") == bootstrap\ gui/* ]]
  then
    pass "$name"
  elif [[ $want == quiet ]] && [[ ! -s $heal_log ]]
  then
    pass "$name"
  else
    fail "$name: launchctl log was '$(< "$heal_log")'"
  fi
}

# A fresh cache means the agent is doing its job, so nothing should happen.
setup_heal install || exit 1
seed_cache 10 '' || exit 1
run_heal
heal_case "a fresh cache does not touch launchctl" quiet

# A stale cache is the signal the agent stopped being refreshed.
setup_heal install || exit 1
seed_cache 86400 '' || exit 1
run_heal
heal_case "a stale cache bootstraps the agent" bootstrapped

setup_heal install || exit 1
cache_state=$(mktemp -d "$tmpdir/nocache.XXXXXX") || exit 1
run_heal
heal_case "a missing cache bootstraps the agent" bootstrapped

# Nothing to load, and no repo to deploy from: silence beats an error.
setup_heal '' || exit 1
cache_state=$(mktemp -d "$tmpdir/nocache.XXXXXX") || exit 1
run_heal
heal_case "an uninstalled plist is left alone" quiet

# --live and --write are not evidence about the agent.
setup_heal install || exit 1
seed_cache 86400 '' || exit 1
run_heal --live
heal_case "--live does not bootstrap" quiet

setup_heal install || exit 1
seed_cache 86400 '' || exit 1
run_heal --write
heal_case "--write does not bootstrap" quiet

# The heal runs behind the answer, so a broken launchctl changes nothing.
cat > "$tmpdir/bin/launchctl" <<'FAKE'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$HEAL_LOG"
echo 'launchctl exploded' >&2
exit 3
FAKE
chmod +x "$tmpdir/bin/launchctl" || exit 1

setup_heal install || exit 1
cache_state=$(mktemp -d "$tmpdir/nocache.XXXXXX") || exit 1
out=$(PATH="$tmpdir/bin:$PATH" FAKE_IDLE_NS=0 FAKE_SCREENSAVER='' FAKE_LOCK_XML='' \
  TIMVISHER_LAUNCHAGENTS_DIR="$heal_home/LaunchAgents" \
  HEAL_LOG="$heal_log" XDG_STATE_HOME="$cache_state" \
  "$script" 2>/dev/null)
rc=$?
if (( 0 == rc )) && [[ $out == *'"away":false'* ]]
then
  pass "a failing launchctl does not change the answer or the exit status"
else
  fail "a failing launchctl does not change the answer or the exit status: rc=${rc} out='${out}'"
fi

if (( 0 < failures ))
then
  exit 1
fi
