#!/usr/bin/env bash

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  (( failures += 1 ))
}

pass() {
  echo "PASS: $1"
}

run_test() {
  (( tests += 1 ))
}

# shellcheck disable=SC1091
source "$(dirname "$0")/lib/timvisher_tests.bash" || exit 1

script="$(cd "$(dirname "$0")/../bin" && pwd)/timvisher_workspace_clipboard"

t_dir=
daemon_pid=
# shellcheck disable=SC2329
cleanup() {
  [[ -z $daemon_pid ]] || kill "$daemon_pid" 2>/dev/null
  [[ -z $t_dir ]] || rm -rf -- "$t_dir"
}
trap cleanup EXIT

# Under /tmp, not TMPDIR: a unix socket path must fit in 104 bytes.
if ! t_dir=$(mktemp -d /tmp/timvisher_workspace_clipboard.XXXXXX)
then
  echo "mktemp -d failed" >&2
  exit 1
fi

sock="${t_dir}/daemon.sock"
xclip_in="${t_dir}/xclip.in"
tmux_log="${t_dir}/tmux.log"
bin="${t_dir}/bin"
if ! mkdir "$bin"
then
  echo "mkdir '${bin}' failed" >&2
  exit 1
fi

cat > "${t_dir}/daemon.py" <<'PY'
import os, socket, struct, sys, time
mode, path = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX)
s.bind(path)
s.listen(8)
while True:
    c, _ = s.accept()
    if mode == "silent":
        time.sleep(30)
        c.close()
        continue
    try:
        n = struct.unpack(">I", c.recv(4))[0]
        c.recv(n)
        r = b"\x0a\x1dtype.googleapis.com/daemon.PingResult"
        c.sendall(struct.pack(">I", len(r)) + r)
    finally:
        c.close()
PY

start_daemon() {
  local i
  [[ -z $daemon_pid ]] || kill "$daemon_pid" 2>/dev/null
  wait "$daemon_pid" 2>/dev/null
  rm -f -- "$sock"
  python3 "${t_dir}/daemon.py" "$1" "$sock" &
  daemon_pid=$!
  for (( i = 0; i < 50; i += 1 ))
  do
    [[ -S $sock ]] && return 0
    sleep 0.1
  done
  return 1
}

stop_daemon() {
  [[ -z $daemon_pid ]] || kill "$daemon_pid" 2>/dev/null
  wait "$daemon_pid" 2>/dev/null
  daemon_pid=
  rm -f -- "$sock"
}

cat > "${t_dir}/xclip" <<STUB
#!/bin/sh
cat > '${xclip_in}'
[ -n "\${XCLIP_ERR-}" ] && printf '%s\n' "\$XCLIP_ERR" >&2
exit "\${XCLIP_RC:-0}"
STUB
cat > "${bin}/tmux" <<STUB
#!/bin/sh
printf '%s\n' "\$*" >> '${tmux_log}'
case \$1 in
  load-buffer) cat >> '${tmux_log}'; printf '\n' >> '${tmux_log}' ;;
esac
STUB
if ! chmod +x "${t_dir}/xclip" "${bin}/tmux"
then
  echo "chmod failed under '${t_dir}'" >&2
  exit 1
fi

run_copy() {
  local mode=$1 text=$2
  shift 2
  rm -f -- "$xclip_in" "$tmux_log"
  printf %s "$text" | env "$@" \
    WORKSPACES_DAEMON_SOCKET="$sock" \
    TIMVISHER_WORKSPACE_CLIPBOARD_XCLIP="${t_dir}/xclip" \
    PATH="${bin}:${PATH}" \
    "$script" "$mode" 2>/dev/null
}

check() {
  local name=$1
  shift
  run_test
  if "$@"
  then
    pass "$name"
  else
    fail "$name"
  fi
}

# shellcheck disable=SC2329
xclip_got() {
  [[ -e $xclip_in && $(cat "$xclip_in") = "$1" ]]
}

start_daemon ping || { echo "stub daemon didn't start" >&2; exit 1; }

run_copy copy delivered XCLIP_RC=0
rc=$?
check "a copy the daemon takes exits 0" test 0 -eq "$rc"
check "the daemon's xclip gets the copy" xclip_got delivered

run_copy copy refused XCLIP_RC=1 \
  'XCLIP_ERR=workspaces-tool-helper: xclip: could not connect to the local workspaces daemon at /x: dial unix /x: connect: connection refused'
rc=$?
check "xclip failing to connect means not sent (3)" test 3 -eq "$rc"

run_copy copy too-big XCLIP_RC=1 \
  'XCLIP_ERR=workspaces-tool-helper: xclip: clipboard input exceeds the 1 MiB limit'
rc=$?
check "xclip refusing a big copy means not sent (3)" test 3 -eq "$rc"

run_copy copy lost-reply XCLIP_RC=1 \
  'XCLIP_ERR=workspaces-tool-helper: xclip: timed out after 10s waiting for the local workspaces daemon at /x to handle clipboard write'
rc=$?
check "xclip failing after sending means unconfirmed (4)" test 4 -eq "$rc"

run_copy tmux-copy tmux-delivered XCLIP_RC=0
rc=$?
check "tmux-copy exits 0 when the daemon takes it" test 0 -eq "$rc"
check "tmux-copy sends no OSC 52 when the daemon takes it" test ! -e "$tmux_log"

run_copy tmux-copy tmux-unconfirmed XCLIP_RC=1 'XCLIP_ERR=xclip: read response length: EOF'
check "tmux-copy doesn't resend an unconfirmed copy" \
  bash -c "! grep -q '^load-buffer' '${tmux_log}' && grep -q '^display-message' '${tmux_log}'"

start_daemon silent || { echo "stub daemon didn't start" >&2; exit 1; }

start=$SECONDS
run_copy copy silent XCLIP_RC=0
rc=$?
check "a daemon that doesn't answer Ping means not sent (3)" test 3 -eq "$rc"
check "a daemon that doesn't answer Ping never gets the copy" test ! -e "$xclip_in"
check "the Ping check gives up within 3s" test $(( SECONDS - start )) -le 3

stop_daemon

run_copy copy no-socket XCLIP_RC=0
rc=$?
check "no daemon socket means not sent (3)" test 3 -eq "$rc"
check "no daemon socket never runs xclip" test ! -e "$xclip_in"

run_copy tmux-copy tmux-fallback XCLIP_RC=0
rc=$?
check "tmux-copy exits 0 after its OSC 52 fallback" test 0 -eq "$rc"
check "tmux-copy falls back to load-buffer -w with the copy, once" \
  test "$(cat "$tmux_log" 2>/dev/null)" = $'load-buffer -w -\ntmux-fallback'

out=$("$script" --help 2>/dev/null)
rc=$?
check "--help prints usage on stdout and exits 0" test 0 -eq "$rc" -a -n "$out"
out=$("$script" 2>/dev/null)
rc=$?
check "no subcommand exits 1 with nothing on stdout" test 1 -eq "$rc" -a -z "$out"

echo
echo "Results: ${tests} tests, ${failures} failures"
exit "$failures"
