#!/usr/bin/env bash

script="$(cd "$(dirname "$0")/.." && pwd)/bin/gh" ||
  { echo "cannot resolve script" >&2; exit 1; }

real_gh="$(brew --prefix 2>/dev/null)/bin/gh"

generate() {
  local isolated
  isolated=$(mktemp -d) || return 1
  GH_CONFIG_DIR="$isolated" XDG_DATA_HOME="$isolated" XDG_CONFIG_HOME="$isolated" \
    "$real_gh" help reference 2>/dev/null |
    awk '
      /^##+ gh / {
        line = $0
        sub(/^##+ gh /, "", line)
        n = split(line, w, " ")
        path = ""
        for (i = 1; i <= n; i++)
        {
          if (w[i] !~ /^[a-z][a-z0-9-]*$/)
            break
          path = path (path == "" ? "" : " ") w[i]
        }
        paths[path] = 1
        aliases_next = 0
        next
      }
      path != "" && /^Aliases$/ {
        aliases_next = 1
        next
      }
      aliases_next && /^gh / {
        k = split($0, list, /, /)
        for (j = 1; j <= k; j++)
        {
          a = list[j]
          sub(/^gh /, "", a)
          alias_of[a] = path
        }
        aliases_next = 0
        next
      }
      path != "" && /^ +-/ {
        l = $0
        sub(/^ +/, "", l)
        short = ""
        if (l ~ /^-[A-Za-z0-9], /)
        {
          short = substr(l, 1, 2)
          l = substr(l, 5)
        }
        if (l !~ /^--/)
          next
        split(l, parts, /  +/)
        if (split(parts[1], t, " ") < 2)
          next
        if (t[2] ~ /^-/ || t[2] ~ /\[=/)
          next
        flags[path] = flags[path] (short != "" ? " " short : "") " " t[1]
      }
      END {
        for (p in paths)
        {
          parent = p
          while (sub(/ [^ ]+$/, "", parent))
          {
            if (parent in paths)
              flags[p] = flags[p] flags[parent]
          }
        }
        for (p in paths)
          print p ":" flags[p]
        for (a in alias_of)
        {
          target = alias_of[a]
          for (p in paths)
          {
            if (p == target)
              print a ":" flags[p]
            else if (index(p, target " ") == 1)
              print a substr(p, length(target) + 1) ":" flags[p]
          }
        }
      }
    ' |
    LC_ALL=C sort -u
  rm -rf "$isolated"
}

current() {
  awk '
    /^gh_args__value_flags\(\) \{/ { in_fn = 1; next }
    in_fn && /^}/ { exit }
    in_fn && /^    \x27/ {
      key = $0
      sub(/^    \x27/, "", key)
      sub(/\x27\)$/, "", key)
      next
    }
    in_fn && key != "" && /^      :$/ {
      print key ":"
      key = ""
      next
    }
    in_fn && key != "" && /printf/ {
      line = $0
      sub(/^ *printf \x27%s\\n\x27/, "", line)
      print key ":" line
      key = ""
    }
  ' "$script" |
    LC_ALL=C sort -u
}

print_function() {
  printf "gh_args__value_flags() {\n  case \$1 in\n"
  generate |
    while IFS=: read -r key flags
    do
      if [[ -n $flags ]]
      then
        printf "    '%s')\n      printf '%%s\\\\n'%s\n      ;;\n" "$key" "$flags"
      else
        printf "    '%s')\n      :\n      ;;\n" "$key"
      fi
    done
  printf '    *)\n      return 1\n      ;;\n  esac\n}\n'
}

if [[ ! -x $real_gh ]]
then
  echo "SKIP: no gh at '${real_gh}'"
  exit 0
fi

if [[ ${1-} == --print ]]
then
  print_function
  exit 0
fi

if diff <(current) <(generate) >/dev/null
then
  echo "PASS: gh_args__value_flags matches 'gh help reference' ($("$real_gh" --version | head -1))"
  echo ""
  echo "Results: 1/1 passed"
  exit 0
fi

echo "FAIL: gh_args__value_flags in bash/bin/gh differs from 'gh help reference' ($("$real_gh" --version | head -1)):" >&2
diff <(current) <(generate) >&2
echo "Regenerate it with: bash/tests/gh_value_flags --print" >&2
echo ""
echo "Results: 0/1 passed"
exit 1
