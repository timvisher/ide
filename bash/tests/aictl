#!/usr/bin/env bash

# Tests for aictl structured messaging functions

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

funcs_dir="$(cd "$(dirname "$0")/../functions" && pwd)"

unset TIMVISHER_AGENT TIMVISHER_AICTL_LOG TIMVISHER_AGENT_NIRMI TIMVISHER_AGENT_NIRMI_REASON

# ---------------------------------------------------------------------------
# Schema structure tests
# ---------------------------------------------------------------------------

# Test: type is always "instruction"
run_test
result=$(TIMVISHER_AGENT=1 bash -c "source '${funcs_dir}/aictl.bash'; aictl_die test_code 'msg'" 2>&1 || true)
if [[ $result == *'"type":"instruction"'* ]]
then
  pass "type is 'instruction'"
else
  fail "type field: got '${result}'"
fi

