# ---------------------------------------------------------------------------
# TIMVISHER_AICTL_LOG routing tests
# ---------------------------------------------------------------------------

log_dir=
trap 'rm -rf -- "$tmp_state" "$log_dir"' EXIT
log_dir=$(mktemp -d)

assert_logged() {
  local desc=$1 level=$2 label=$3 want_rc=$4 snippet=$5
  local log="${log_dir}/${desc// /_}.jsonl"
  local rc out err

  run_test
  rc=0
  : > "$log"
  out=$(TIMVISHER_AICTL_LOG="$log" XDG_STATE_HOME="$log_dir/state" \
    TIMVISHER_AGENT=1 bash -c "source '${funcs_dir}/aictl.bash'; ${snippet}" 2>"${log_dir}/err") || rc=$?
  err=$(cat "${log_dir}/err")
  if (( rc == want_rc )) &&
    [[ -z $out ]] &&
    (( $(wc -l < "$log") == 1 )) &&
    [[ $(jq -r .level "$log") == "$level" ]] &&
    [[ $err == "$(cat "$log")" ]]
  then
    pass "TIMVISHER_AICTL_LOG plus TIMVISHER_AGENT: ${desc} JSON in the log and on stderr"
  else
    fail "TIMVISHER_AICTL_LOG plus TIMVISHER_AGENT ${desc}: rc=${rc} stdout='${out}' stderr='${err}' log='$(cat "$log")'"
  fi

  run_test
  rc=0
  : > "$log"
  out=$(env -u TIMVISHER_AGENT TIMVISHER_AICTL_LOG="$log" XDG_STATE_HOME="$log_dir/state" \
    bash -c "source '${funcs_dir}/aictl.bash'; ${snippet}" 2>"${log_dir}/err") || rc=$?
  err=$(cat "${log_dir}/err")
  if (( rc == want_rc )) &&
    [[ -z $out ]] &&
    (( $(wc -l < "$log") == 1 )) &&
    [[ $(jq -r .level "$log") == "$level" ]] &&
    [[ $err =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}\+0000\ ${label}\  ]] &&
    [[ $err != *'"type":"instruction"'* ]]
  then
    pass "TIMVISHER_AICTL_LOG alone: ${desc} JSON in the log, ${label} text on stderr"
  else
    fail "TIMVISHER_AICTL_LOG alone ${desc}: rc=${rc} stdout='${out}' stderr='${err}' log='$(cat "$log")'"
  fi
}

assert_logged "aictl_die" error ERROR 1 "aictl_die tc 'msg'"
assert_logged "aictl_error" error ERROR 1 "aictl_error tc 'msg'"
assert_logged "aictl_warn" warning WARN 1 "aictl_warn tc 'msg'"
assert_logged "aictl_info" info INFO 0 "aictl_info tc 'msg'"
assert_logged "aictl_notice" warning WARN 0 "aictl_notice tc 'msg'"
assert_logged "aictl_warn missing reason" error ERROR 1 \
  "TIMVISHER_AGENT_NIRMI=1 aictl_warn tc 'msg'"
assert_logged "aictl_warn bypass" bypass BYPASS 0 \
  "TIMVISHER_AGENT_NIRMI=1 TIMVISHER_AGENT_NIRMI_REASON=r aictl_warn tc 'msg'"

run_test
rc=0
: > "${log_dir}/warn-blocks.jsonl"
out=$(TIMVISHER_AICTL_LOG="${log_dir}/warn-blocks.jsonl" \
  TIMVISHER_AGENT=1 bash -c "source '${funcs_dir}/aictl.bash'; aictl_warn tc 'msg'; echo continued" 2>/dev/null) || rc=$?
