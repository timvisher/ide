#!/usr/bin/env bash
exit 1
STUB
chmod +x "$stub_dir_ts2/date"
PATH="$stub_dir_ts2:$PATH" XDG_STATE_HOME="$tmp_state_ts2" \
  TIMVISHER_AGENT_NIRMI=1 TIMVISHER_AGENT_NIRMI_REASON="r" \
  TIMVISHER_AGENT=1 bash -c "source '${funcs_dir}/aictl.bash'; aictl_warn --code tc --message m" 2>/dev/null
log_file_ts2="$tmp_state_ts2/timvisher/wrappers/aictl-bypass/log.jsonl"
