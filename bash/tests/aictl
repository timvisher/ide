# ---------------------------------------------------------------------------
# Human audience tests (no TIMVISHER_AGENT, no TIMVISHER_AICTL_LOG)
# ---------------------------------------------------------------------------

human_run() {
  human_rc=0
  human_out=$(env -u TIMVISHER_AGENT -u TIMVISHER_AICTL_LOG XDG_STATE_HOME="$log_dir/state" \
    "$@" bash -c "source '${funcs_dir}/aictl.bash'; ${human_snippet}" 2>"${log_dir}/human-err") ||
    human_rc=$?
  human_err=$(cat "${log_dir}/human-err")
  human_text=$(sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\+0000 //' <<<"$human_err")
}

assert_human() {
  local desc=$1 want_rc=$2 want=$3
  shift 3
  run_test
  human_run "$@"
  if (( human_rc == want_rc )) &&
    [[ -z $human_out ]] &&
    [[ $human_text == "$want" ]] &&
    [[ $human_err =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}\+0000\  ]]
  then
    pass "human form: ${desc}"
  else
    fail "human form ${desc}: rc=${human_rc} (want ${want_rc}) stdout='${human_out}' stderr='${human_err}'"
  fi
}

human_snippet="aictl_die tc 'it broke'; echo continued"
assert_human "aictl_die is ERROR and exits 1" 1 'ERROR tc: it broke'

human_snippet="wrap() { aictl_error tc 'it broke'; }; wrap; echo \"rc=\$?\" >&2"
