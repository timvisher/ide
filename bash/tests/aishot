#!/usr/bin/env bash

# Tests for aishot's diff-prompt building: the shared inline-vs-spill
# logic (exercised via `git diff review`) and the `git diff describe`
# changeset-inventory prompt.
#
# `aishot git diff review make-prompt` and `aishot git diff describe
# make-prompt` build their prompts without invoking the *shot binaries,
# so these tests exercise the prompt construction in isolation. The spill
# threshold is overridable via AISHOT_MAX_PROMPT_CHARS so we can force
# either branch deterministically.

set -uo pipefail

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

script_dir="$(cd "$(dirname "$0")/.." && pwd)" ||
  { echo "cannot resolve script_dir" >&2; exit 1; }
script="${script_dir}/bin/aishot"
test_git="$(brew --prefix)/bin/git"

# Best-effort cleanup backstop; each case also removes its repo explicitly.
trap 'rm -rf "${repo:-}" "${reg_home:-}"' EXIT

# Build a throwaway git repo with a staged + unstaged change to review.
# No commit is made (no upstream needed), so the branch-diff section is
# empty and the staged/unstaged diffs carry the content.
make_repo() {
  local dir
  dir=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }
  (
    cd "$dir" || exit 1
    git init -q
    git config user.email t@example.com
    git config user.name t
    printf 'original\n' > f.txt
    git add f.txt
    printf 'original\nmodified line\n' > f.txt
  ) >/dev/null 2>&1
  printf '%s' "$dir"
}

# ---------------------------------------------------------------------------
# Case 1: large budget -> diffs inlined, no spill file written
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff review make-prompt 2>/dev/null)
if [[ $out == *'```diff'* ]] &&
   [[ $out != *'written to a file instead of inlined'* ]] &&
   [[ ! -f "$repo/x.aishot.review.diff" ]]
then
  pass "large budget inlines diffs and writes no spill file"
else
  fail "expected inline diff and no spill file under large budget"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 2: tiny budget -> diffs spilled to file, prompt references it
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10 "$script" git diff review make-prompt 2>"$repo/err.txt")
spill="$repo/x.aishot.review.diff"
if [[ $out == *'written to a file instead of inlined'* ]] &&
   [[ $out == *"$spill"* ]] &&
   [[ -f $spill ]]
then
  pass "tiny budget spills diffs and references the file"
else
  fail "expected spill notice + file reference under tiny budget"
fi

# Case 2a: the ">>> ... spilled to ..." progress line lands on stderr.
run_test
if grep -q 'spilled to' "$repo/err.txt"
then
  pass "spill emits a progress summary on stderr"
else
  fail "expected 'spilled to' summary on stderr; got: $(cat "$repo/err.txt")"
fi

# Case 2b: the spilled file holds the actual diff, and the prompt body
# does NOT inline the raw hunk.
run_test
if [[ -f $spill ]] &&
   grep -q 'modified line' "$spill" &&
   [[ $out != *'+modified line'* ]]
then
  pass "spilled file contains the diff; prompt omits the raw hunk"
else
  fail "spilled file should hold the diff and prompt should omit raw hunk"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 3: a stale spill file is not re-inlined on a later run
#
# These throwaway repos do NOT inherit the user's global gitignore, so the
# spill file (x.*) shows up as an untracked working file here. That makes
# this the meaningful case: aishot must skip its own spill file in both the
# x.* root-file glob and the untracked-files listing on its own, not lean on
# a global ignore. Don't "fix" this by setting core.excludesFile — it would
# neuter the test.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
echo 'STALE SPILL CONTENT MUST NOT BE INLINED' > "$repo/x.aishot.review.diff"
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff review make-prompt 2>/dev/null)
if [[ $out != *'STALE SPILL CONTENT MUST NOT BE INLINED'* ]]
then
  pass "stale spill file is not re-inlined"
else
  fail "stale spill file was re-inlined into the prompt"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 4: when the spill file can't be written, fall back to inlining
# (rather than emitting a pointer to a file that doesn't exist).
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
# Put a directory where the spill file would go, so the write fails.
mkdir "$repo/x.aishot.review.diff"
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10 "$script" git diff review make-prompt 2>"$repo/err.txt")
if [[ $out == *'+modified line'* ]] &&
   [[ $out != *'written to a file instead of inlined'* ]] &&
   grep -q 'could not write spill file' "$repo/err.txt"
then
  pass "unwritable spill path falls back to inlining with a warning"
else
  fail "expected inline fallback + warning when spill write fails"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 5: `git diff describe` emits the changelog template and factual
# framing, and does NOT carry the review checklist.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff describe make-prompt 2>/dev/null)
if [[ $out == *'## New Features'* ]] &&
   [[ $out == *'## Architectural Changes'* ]] &&
   [[ $out == *'This is NOT a review.'* ]] &&
   [[ $out != *'do a thorough review'* ]]
then
  pass "describe emits changelog template + factual framing, no review checklist"
else
  fail "expected changelog template and factual framing from describe make-prompt"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 6: describe still inlines the diff under a large budget.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff describe make-prompt 2>/dev/null)
if [[ $out == *'+modified line'* ]] &&
   [[ ! -f "$repo/x.aishot.describe.diff" ]]
then
  pass "describe inlines diffs under large budget"
else
  fail "expected describe to inline diffs and write no spill file under large budget"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 7: describe spills to its OWN mode-specific file (not review's).
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10 "$script" git diff describe make-prompt 2>/dev/null)
if [[ $out == *'written to a file instead of inlined'* ]] &&
   [[ -f "$repo/x.aishot.describe.diff" ]] &&
   [[ ! -f "$repo/x.aishot.review.diff" ]] &&
   grep -q 'modified line' "$repo/x.aishot.describe.diff"
then
  pass "describe spills to x.aishot.describe.diff under tiny budget"
else
  fail "expected describe to spill to its own x.aishot.describe.diff"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 8: describe omits the review-only root-working-files framing
# (the "gitignored but MUST be reviewed" section and the pr.md deliverable
# notice). pr.md may still appear as an untracked file — these throwaway
# repos have no gitignore — but the review-only framing must not.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
printf 'PR DRAFT BODY\n' > "$repo/pr.md"
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff describe make-prompt 2>/dev/null)
if [[ $out != *'Repo-root working files'* ]] &&
   [[ $out != *'PR DESCRIPTION DRAFT'* ]]
then
  pass "describe omits review-only root-file framing"
else
  fail "describe should not emit the review-only root-working-files section"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 9: global --with= BEFORE the subcommand routes to the subcommand
# (not the bare-prompt path). Regression guard: `aishot --with=x git diff
# describe ...` must reach describe, not be parsed as a oneshot prompt.
# make-prompt makes this observable without launching shots — a mis-route
# would treat "git diff describe make-prompt" as the prompt and never emit
# the changelog template.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
out=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 \
  "$script" --with=claude git diff describe make-prompt 2>/dev/null)
if [[ $out == *'## New Features'* ]] &&
   [[ $out == *'This is NOT a review.'* ]]
then
  pass "leading --with= routes to git diff describe (not bare prompt)"
else
  fail "flag-before-subcommand mis-routed: describe template not emitted"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 10: record-finding mints a valid finding; validate passes; print
# renders it grouped by level.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(
  cd "$repo" &&
  "$script" git diff review record-finding \
    --title "SQL injection" --description "user input concatenated into query" \
    --file db/q.go --line 42 --level high --category security \
    --flagged-by claude,codex
) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
if [[ -f $rj ]] &&
   (cd "$repo" && "$script" git diff review validate) >/dev/null 2>&1 &&
   [[ $(jq -r '.findings[0].level' "$rj") == high ]] &&
   [[ $(jq -r '.findings[0].category' "$rj") == security ]] &&
   [[ $(jq -r '.findings[0].agent_status' "$rj") == open ]] &&
   [[ $(jq -r '.findings[0].human_status' "$rj") == unreviewed ]] &&
   [[ $(jq -r '.schema_version' "$rj") -eq 2 ]] &&
   [[ $(jq -r '.findings[0].flagged_by|join(",")' "$rj") == claude,codex ]] &&
   [[ $(jq -r '.findings[0].id|length' "$rj") -eq 36 ]] &&
   [[ $(cd "$repo" && "$script" git diff review print 2>/dev/null) == *'## HIGH'*'SQL injection'* ]]
then
  pass "record-finding mints a valid finding; validate + print work"
else
  fail "record-finding mint/validate/print failed"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 11: bad enum is rejected with a non-zero exit and writes nothing.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
if ! (cd "$repo" && "$script" git diff review record-finding \
        --title T --description D --level CRITICAL --category security \
        --flagged-by claude) >/dev/null 2>&1 &&
   [[ ! -f "$repo/.aishot/review.json" ]]
then
  pass "invalid --level is rejected and writes no artifact"
else
  fail "invalid --level should exit non-zero and write nothing"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 12: --id updates only the passed fields (agent_status + flagged_by union),
# preserving the rest, and bumps nothing else improperly.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(
  cd "$repo" &&
  "$script" git diff review record-finding --title "leak" --description "fd leak" \
    --level medium --category reliability --flagged-by claude
) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
fid=$(jq -r '.findings[0].id' "$rj")
(cd "$repo" && "$script" git diff review record-finding --id "$fid" \
   --agent-status fixed --flagged-by gemini) >/dev/null 2>&1
if [[ $(jq -r '.findings[0].agent_status' "$rj") == fixed ]] &&
   [[ $(jq -r '.findings[0].flagged_by|join(",")' "$rj") == claude,gemini ]] &&
   [[ $(jq -r '.findings[0].title' "$rj") == leak ]] &&
   [[ $(jq -r '.findings[0].level' "$rj") == medium ]] &&
   (cd "$repo" && "$script" git diff review validate) >/dev/null 2>&1
then
  pass "--id update touches only passed fields, preserves the rest"
else
  fail "--id update mishandled field preservation"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 13: validate catches a hand-corrupted artifact (bad enum) non-zero.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(cd "$repo" && "$script" git diff review record-finding --title T --description D \
   --level low --category style --flagged-by claude) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
jq '.findings[0].category="nonsense"' "$rj" > "$rj.x" && mv "$rj.x" "$rj"
if ! (cd "$repo" && "$script" git diff review validate) >/dev/null 2>&1
then
  pass "validate rejects a hand-corrupted enum"
else
  fail "validate should reject an invalid category"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 14: print --format=json emits valid JSON of the artifact.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(cd "$repo" && "$script" git diff review record-finding --title T --description D \
   --level low --category testing --flagged-by codex) >/dev/null 2>&1
if (cd "$repo" && "$script" git diff review print --format=json 2>/dev/null) | jq -e '.findings|length==1' >/dev/null
then
  pass "print --format=json emits valid artifact JSON"
else
  fail "print --format=json did not emit valid JSON"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 15: begin initializes the envelope at iteration 1 with the diff
# embedded and an empty findings array.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(cd "$repo" && "$script" git diff review begin) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
if [[ -f $rj ]] &&
   [[ $(jq -r '.iterations' "$rj") -eq 1 ]] &&
   [[ $(jq -r '.findings|length' "$rj") -eq 0 ]] &&
   [[ -n $(jq -r '.diff' "$rj") ]] &&
   [[ $(jq -r '.lineage|length' "$rj") -eq 36 ]] &&
   (cd "$repo" && "$script" git diff review validate) >/dev/null 2>&1
then
  pass "begin initializes envelope (iter 1, diff embedded, empty findings)"
else
  fail "begin did not initialize a valid iteration-1 envelope"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 16: begin on the same base bumps iterations and carries findings,
# keeping the same lineage.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
rj="$repo/.aishot/review.json"
(cd "$repo" && "$script" git diff review begin) >/dev/null 2>&1
l1=$(jq -r '.lineage' "$rj")
(cd "$repo" && "$script" git diff review record-finding --title T --description D \
   --level high --category correctness --flagged-by claude) >/dev/null 2>&1
(cd "$repo" && "$script" git diff review begin) >/dev/null 2>&1
if [[ $(jq -r '.iterations' "$rj") -eq 2 ]] &&
   [[ $(jq -r '.findings|length' "$rj") -eq 1 ]] &&
   [[ $(jq -r '.lineage' "$rj") == "$l1" ]]
then
  pass "begin (same base) bumps iterations, carries findings, keeps lineage"
else
  fail "begin same-base bump/carry/lineage incorrect"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 17: a real rebase onto a moved upstream continues the series:
# findings carry forward, iterations bump, lineage is kept, nothing is
# archived, and base_sha/head_sha are refreshed.
# ---------------------------------------------------------------------------
run_test
repo=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }
(
  cd "$repo" || exit 1
  "$test_git" init -q --bare -b main up.git
  "$test_git" -C up.git config core.hooksPath /dev/null
  "$test_git" -c core.hooksPath=/dev/null init -q -b main work
  cd work || exit 1
  "$test_git" config user.email t@example.com
  "$test_git" config user.name t
  "$test_git" config core.hooksPath /dev/null
  "$test_git" config commit.gpgsign false
  printf 'base\n' > a.txt
  "$test_git" add a.txt
  "$test_git" commit -qm base
  "$test_git" remote add origin ../up.git
  "$test_git" push -q -u origin main
  printf 'feature\n' > b.txt
  "$test_git" add b.txt
  "$test_git" commit -qm feature
) >/dev/null 2>&1
work="$repo/work"
rj="$work/.aishot/review.json"
(cd "$work" && "$script" git diff review begin) >/dev/null 2>&1
(cd "$work" && "$script" git diff review record-finding --title T --description D \
   --level low --category style --flagged-by claude) >/dev/null 2>&1
l1=$(jq -r '.lineage' "$rj")
b1=$(jq -r '.base_sha' "$rj")
(
  cd "$repo" || exit 1
  "$test_git" clone -q -c core.hooksPath=/dev/null up.git other
  cd other || exit 1
  "$test_git" config user.email t@example.com
  "$test_git" config user.name t
  "$test_git" config commit.gpgsign false
  printf 'trunk moved\n' > c.txt
  "$test_git" add c.txt
  "$test_git" commit -qm trunk
  "$test_git" push -q origin main
  cd "$work" || exit 1
  "$test_git" fetch -q origin
  "$test_git" rebase -q '@{u}'
) >/dev/null 2>&1
(cd "$work" && "$script" git diff review begin) >/dev/null 2>&1
if [[ -n $b1 ]] &&
   [[ $(jq -r '.base_sha' "$rj") == "$("$test_git" -C "$work" merge-base '@{u}' HEAD)" ]] &&
   [[ $(jq -r '.base_sha' "$rj") != "$b1" ]] &&
   [[ $(jq -r '.head_sha' "$rj") == "$("$test_git" -C "$work" rev-parse HEAD)" ]] &&
   [[ $(jq -r '.iterations' "$rj") -eq 2 ]] &&
   [[ $(jq -r '.findings|length' "$rj") -eq 1 ]] &&
   [[ $(jq -r '.lineage' "$rj") == "$l1" ]] &&
   ! compgen -G "$work/.aishot/review.bak.*.json" >/dev/null
then
  pass "rebase onto a moved base carries findings forward, refreshes shas"
else
  fail "base-move carry-forward incorrect"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 18: begin --fresh archives the prior and starts a new lineage.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
rj="$repo/.aishot/review.json"
(cd "$repo" && "$script" git diff review begin) >/dev/null 2>&1
l1=$(jq -r '.lineage' "$rj")
(cd "$repo" && "$script" git diff review begin --fresh) >/dev/null 2>&1
if [[ $(jq -r '.iterations' "$rj") -eq 1 ]] &&
   [[ $(jq -r '.lineage' "$rj") != "$l1" ]] &&
   [[ $(ls "$repo"/.aishot/review.bak.*.json 2>/dev/null | wc -l) -eq 1 ]]
then
  pass "begin --fresh archives prior and starts a new lineage"
else
  fail "begin --fresh did not archive + reset lineage"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 19: a review with prior findings inlines them (compact JSON) into
# the prompt so the iteration can judge them; a first-run review does not.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
# First run: no prior findings -> no prior-findings section.
out_first=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff review make-prompt 2>/dev/null)
# Record a finding, then re-build the prompt: it must now be inlined.
(cd "$repo" && "$script" git diff review record-finding \
   --title "unchecked error" --description "err ignored" --level medium \
   --category correctness --flagged-by claude) >/dev/null 2>&1
out_second=$(cd "$repo" && AISHOT_MAX_PROMPT_CHARS=10000000 "$script" git diff review make-prompt 2>/dev/null)
if [[ $out_first != *'Prior review findings'* ]] &&
   [[ $out_second == *'Prior review findings'* ]] &&
   [[ $out_second == *'unchecked error'* ]]
then
  pass "prior findings are inlined on later iterations, absent on the first"
else
  fail "prior-findings inlining incorrect (first has none, later has them)"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 20: a full review run records findings via record-finding (synthesis
# path) and renders review.md — with the shot binaries mocked so no real
# LLM is invoked. The mocked claudeshot plays both roles: as a reviewer it
# emits a report; as the synthesis step (detected by the preamble marker)
# it calls record-finding. Validates the plumbing, not LLM behavior.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
mockbin=$(mktemp -d)
state=$(mktemp -d)
cat > "$mockbin/codexshot" <<'M'
#!/usr/bin/env bash
cat >/dev/null
echo "codex: possible nil deref at foo.go:10"
M
cat > "$mockbin/claudeshot" <<M
#!/usr/bin/env bash
input=\$(cat)
if [[ \$input == *"SYNTHESIS step"* ]]
then
  "$script" git diff review record-finding --title "nil deref" \
    --description "possible nil deref" --level high --category correctness \
    --flagged-by claude,codex --file foo.go --line 10 >/dev/null 2>&1
  echo "recorded 1 findings"
else
  echo "claude: nil deref risk at foo.go:10"
fi
M
chmod +x "$mockbin/codexshot" "$mockbin/claudeshot"
(
  cd "$repo" &&
  PATH="$mockbin:$PATH" XDG_STATE_HOME="$state" AISHOT_MAX_PROMPT_CHARS=10000000 \
    "$script" git diff review
) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
if [[ $(jq '.findings|length' "$rj" 2>/dev/null) -eq 1 ]] &&
   [[ $(jq -r '.findings[0].title' "$rj") == "nil deref" ]] &&
   [[ -f "$repo/.aishot/review.md" ]] &&
   grep -q 'nil deref' "$repo/.aishot/review.md" &&
   grep -q 'mode: review' "$state"/aishot/runs/*/meta.txt
then
  pass "full review run records findings via synthesis + renders review.md"
else
  fail "review run did not populate review.json/review.md via record-finding"
fi
rm -rf "$repo" "$mockbin" "$state"

# ---------------------------------------------------------------------------
# Case 21: begin embeds a diff larger than ARG_MAX. Passing the diff to jq
# as --arg fails with E2BIG ("Argument list too long"); --rawfile must
# handle it. Regression guard for large cleanup branches.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
# ~2.7MB of multi-line text, comfortably over ARG_MAX (~1MB), staged so it
# lands in the embedded diff.
head -c 2000000 /dev/urandom | base64 > "$repo/big.txt"
(cd "$repo" && git add big.txt) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
if (cd "$repo" && "$script" git diff review begin) >/dev/null 2>&1 &&
   [[ -f $rj ]] &&
   (cd "$repo" && "$script" git diff review validate) >/dev/null 2>&1 &&
   [[ $(jq -r '.diff | length' "$rj") -gt 2000000 ]]
then
  pass "begin embeds a >ARG_MAX diff via --rawfile (no E2BIG)"
else
  fail "begin failed on a large diff (ARG_MAX regression)"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 22: --p0 is recorded, defaults to false, and status reports the open
# P0 count as the loop's convergence gate.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(cd "$repo" && "$script" git diff review record-finding --title "nil deref" \
   --description "crash on empty" --level high --category correctness \
   --p0 true --flagged-by claude) >/dev/null 2>&1
(cd "$repo" && "$script" git diff review record-finding --title "rename x" \
   --description "clarity" --level low --category style --flagged-by codex) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
st=$(cd "$repo" && "$script" git diff review status 2>/dev/null)
if [[ $(jq -r '.findings[]|select(.title=="nil deref").p0' "$rj") == true ]] &&
   [[ $(jq -r '.findings[]|select(.title=="rename x").p0' "$rj") == false ]] &&
   [[ $st == *"open_p0=1"* ]] && [[ $st == *"total=2"* ]] &&
   (cd "$repo" && "$script" git diff review validate) >/dev/null 2>&1
then
  pass "--p0 recorded (defaults false); status reports open_p0 gate"
else
  fail "--p0 / status gate mishandled (status: $st)"
fi
rm -rf "$repo"

# ---------------------------------------------------------------------------
# Case 23: refuting a P0 clears it from the open_p0 gate and records the
# rationale; validate still passes.
# ---------------------------------------------------------------------------
run_test
repo=$(make_repo)
(cd "$repo" && "$script" git diff review record-finding --title "maybe race" \
   --description "possible" --level medium --category reliability --p0 true \
   --flagged-by claude) >/dev/null 2>&1
rj="$repo/.aishot/review.json"
fid=$(jq -r '.findings[0].id' "$rj")
(cd "$repo" && "$script" git diff review record-finding --id "$fid" \
   --agent-status refuted --rationale "guarded by mutex" --flagged-by claude) >/dev/null 2>&1
st=$(cd "$repo" && "$script" git diff review status 2>/dev/null)
if [[ $(jq -r '.findings[0].agent_status' "$rj") == refuted ]] &&
