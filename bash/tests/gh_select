check_api_dies() {
  run_test
  run_shim "$tmpdir/norepo" "$@"
  if (( rc != 0 )) && [[ -z $out && $err == *'"code":"gh_api_owner_required"'* ]]
  then
    pass "[$*] dies asking for -R"
  else
    fail "[$*]: expected gh_api_owner_required; rc=$rc out='$out' err='$err'"
  fi
}

