check_api_dies() {
  run_test
  run_shim "$tmpdir/norepo" "$@"
  if (( rc != 0 )) && [[ -z $out && $err == *'"code":"gh_api_owner_required"'* ]]
  then
    pass "[$*] dies asking for -R"
  else
    fail "[$*]: expected gh_api_owner_required; rc=$rc out='$out' err='$err'"
  fi
}

check_api_dies api graphql -f query=mutation -f body=https://github.com/evil/x
check_api_dies api graphql -f body=see/repos/evil/x
check_api_dies api graphql -f query=mutation -f id=PRRC_kwDOabc
check_api_dies api user --jq .login
check_api_dies api search/issues -f q=x
check_api_dies api -R ../x graphql -f query=x
check_api_dies api -R '' user

check_api() {
  local label=$1 want_out=$2 want_err=$3
  shift 3
  run_test
  run_shim "$tmpdir/norepo" "$@"
  if [[ $out == "$want_out" && $err == *"$want_err"* ]]
  then
    pass "$label"
  else
    fail "$label; out='$out' err='$err'"
  fi
}

