check_api() {
  local label=$1 want_out=$2 want_err=$3
  shift 3
  run_test
  run_shim "$tmpdir/norepo" "$@"
  if [[ $out == "$want_out" && $err == *"$want_err"* ]]
  then
    pass "$label"
  else
    fail "$label; out='$out' err='$err'"
  fi
}

