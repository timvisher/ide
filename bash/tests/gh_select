#!/usr/bin/env bash

failures=0
tests=0

fail() { echo "FAIL: $1" >&2; (( failures += 1 )); }
pass() { echo "PASS: $1"; }
run_test() { (( tests += 1 )); }

script="$(cd "$(dirname "$0")/.." && pwd)/bin/gh" ||
  { echo "cannot resolve script" >&2; exit 1; }

tmpdir=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }
trap 'rm -rf "$tmpdir"' EXIT

mkdir -p "$tmpdir/prefix/bin" "$tmpdir/mockbin" "$tmpdir/cfg/orgs" "$tmpdir/norepo"
cat > "$tmpdir/prefix/bin/gh" <<'MOCK'
#!/usr/bin/env bash
if [[ $1 == auth && $2 == token ]]
then
  user=''
  while (( 0 < $# ))
  do
    [[ $1 == --user ]] && user=$2
    shift
  done
  [[ $user == broken ]] && exit 1
  echo "tok-${user}"
  exit 0
fi
echo "real-gh GH_TOKEN=${GH_TOKEN-} GH_REPO=${GH_REPO-} $*"
MOCK
chmod +x "$tmpdir/prefix/bin/gh"
cat > "$tmpdir/mockbin/brew" <<MOCK
#!/usr/bin/env bash
echo "$tmpdir/prefix"
MOCK
chmod +x "$tmpdir/mockbin/brew"

map() {
  mkdir -p "$tmpdir/cfg/orgs/$1"
  printf '%s\n' "$2" > "$tmpdir/cfg/orgs/$1/account"
}

run_shim() {
  local dir=$1
  shift
  out=$(
    cd "$dir" &&
      env -u GH_TOKEN -u GITHUB_TOKEN -u GH_REPO -u TIMVISHER_AGENT \
        GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        PATH="$tmpdir/mockbin:$PATH" \
        TIMVISHER_GH_CONFIG_DIR="$tmpdir/cfg" \
        ${extra_env[@]+"${extra_env[@]}"} \
        "$script" "$@" 2>"$tmpdir/err"
  )
  rc=$?
  err=$(< "$tmpdir/err")
}
extra_env=()

check_owner() {
  local want=$1
  shift
  run_test
  if [[ $want == - ]]
  then
    run_shim "$tmpdir/norepo" "$@"
    if [[ $out == "real-gh GH_TOKEN= "* && $err == *'"code":"gh_account_active"'*'No target org found'* ]]
    then
      pass "[$*] -> (none)"
    else
      fail "[$*]: expected no owner; out='$out' err='$err'"
    fi
    return
  fi
  map "$want" "acct-$want"
  run_shim "$tmpdir/norepo" "$@"
  if [[ $out == "real-gh GH_TOKEN=tok-acct-$want "* && $err == *'"code":"gh_account_selected"'*"for '$want'"* ]]
  then
    pass "[$*] -> '$want'"
  else
    fail "[$*]: want '$want'; out='$out' err='$err'"
  fi
}

