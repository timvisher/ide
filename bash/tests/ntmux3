run_test
log=$(new_log detached)
reset_tmux
out=$(PATH="${stub_bin}:${PATH}" TIMVISHER_AICTL_LOG="$log" \
  bash -c "${preamble} new_tmux_session detached '${session_dir}' '' true" 2>/dev/null) || true
if [[ $out == detached ]] &&
  [[ $(classify "$(cat "$log")") == '{"state":"ready","session":"detached","path":"/fake/session/path"}' ]]
then
  pass "a detached new session is reported as ready"
else
  fail "detached session: out='${out}' log='$(cat "$log")'"
fi

run_ntmux3() {
  local log=$1 clone=$2 ntmux=$3
  shift 3
  local ntmux_stub="ntmux() { ${ntmux}; }"
  if [[ $ntmux == REAL ]]
  then
    ntmux_stub=
  fi
  # shellcheck disable=SC2016
  env -u TMUX -u TIMVISHER_AGENT TIMVISHER_AICTL_LOG="$log" PATH="${stub_bin}:${PATH}" \
    TMPDIR="${ntmux3_tmpdir:-${t_dir}/tmp}" \
    perl -e '$SIG{INT} = $SIG{HUP} = $SIG{TERM} = "DEFAULT"; exec @ARGV' \
    bash -c "${preamble}
      info() { :; }
      maybe_set_beads_topic() { :; }
      ${ntmux_stub}
      timvisher_git() {
        case \$1 in
          clone) ${clone} ;;
          *) return 1 ;;
        esac
      }
      cd '${session_dir}'
      ntmux3 \"\$@\"
    " _ "$@" >/dev/null 2>&1 || true
}

state_dirs() {
  find "${t_dir}/tmp" -name 'ntmux3-state.*' | wc -l | tr -d ' '
}

run_test
log=$(new_log real-fail)
reset_tmux
run_ntmux3 "$log" 'return 1' 'return 0' someorg/somerepo
codes=$(jq -r .code "$log" | paste -sd, -) || true
