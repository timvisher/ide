cat > "${stub_bin}/osascript" <<STUB
#!/usr/bin/env bash
printf '%s' "\$2" > '${t_dir}/osascript.arg'
if [[ -n \${NTMUX3_TEST_OSASCRIPT_FAIL:-} ]]
then
  exit 1
fi
prefix='tell script "timvisher Terminal" to runCommandInteractively("'
suffix='")'
script=\$2
if [[ \$script != "\$prefix"*"\$suffix" ]]
then
  exit 2
fi
literal=\${script#"\$prefix"}
literal=\${literal%"\$suffix"}
command=
while [[ -n \$literal ]]
do
  if [[ \$literal == \\\\* ]]
  then
    command+=\${literal:1:1}
    literal=\${literal:2}
  elif [[ \$literal == \"* ]]
  then
    exit 3
  else
    command+=\${literal:0:1}
    literal=\${literal:1}
  fi
done
printf '%s' "\$command" > '${t_dir}/command'
cd /
nohup bash '${t_dir}/window' "\$command" </dev/null >>'${t_dir}/window.out' 2>&1 &
printf '%s\n' \$! >> '${t_dir}/pids'
STUB
chmod +x "${stub_bin}/osascript"

cat > "${t_dir}/window" <<STUB
${preamble}
tmux() {
  case \$1 in
    has-session) return 0 ;;
    display-message) printf '/fake/window/path\n' ;;
    attach) sleep 30 ;;
  esac
}
ntmux3__main() {
  printf '%s\0' "\$@" > '${t_dir}/args'
  printf '%s' "\$PWD" > '${t_dir}/window.pwd'
  case \${NTMUX3_TEST_SCENARIO:-} in
    ready)
      aictl_notice --code "\$NTMUX3_CODE_WORKTREE_BUILDING" --message building
      printf 'Cloning into somerepo...\n' >> "\${TIMVISHER_AICTL_LOG:-/dev/null}"
      ntmux3__attach fake/session
      ;;
    split)
      local line
      line=\$(TIMVISHER_AGENT=1 TIMVISHER_AICTL_LOG= ntmux3__emit_session_ready fake/session ready 2>&1)
      printf '%s' "\${line:0:20}" >> "\$TIMVISHER_AICTL_LOG"
      sleep 3
      printf '%s\n' "\${line:20}" >> "\$TIMVISHER_AICTL_LOG"
      ntmux3__mark_verdict
      sleep 30
      ;;
    failed)
      ntmux3__fail boom
      sleep 30
      ;;
    closed)
      exit 0
      ;;
    killed)
      kill -KILL "\$BASHPID"
      ;;
    returned)
      return 1
      ;;
    deadline)
      sleep 30
      ;;
  esac
}
if [[ \${NTMUX3_TEST_SCENARIO:-} == silent ]]
then
  sleep 30
  exit 0
fi
eval "\$1"
if [[ \${NTMUX3_TEST_SCENARIO:-} == killed ]]
then
  sleep 30
fi
STUB

run_terminal() {
  local scenario=$1
  shift
  rm -f "${t_dir}/args" "${t_dir}/command" "${t_dir}/osascript.arg" "${t_dir}/window.pwd"
  rc=0
  out=$(cd "${caller_dir:-${t_dir}}" &&
    TIMVISHER_AGENT=1 NTMUX3_TEST_SCENARIO="$scenario" TMPDIR="${t_dir}/tmp" \
    TIMVISHER_NTMUX3_TERMINAL_POLL=1 TIMVISHER_NTMUX3_TERMINAL_DEADLINE="${deadline:-20}" \
    TIMVISHER_NTMUX3_TERMINAL_STARTUP_DEADLINE="${startup_deadline:-20}" \
    PATH="${extra_path:+${extra_path}:}${stub_bin}:${PATH}" \
    bash -c "${preamble} ntmux3 -T \"\$@\"" _ "$@" 2>"${t_dir}/err") || rc=$?
  err=$(cat "${t_dir}/err")
}

leftover_logs() {
  find "${t_dir}/tmp" -name 'ntmux3-terminal.*' | wc -l | tr -d ' '
}

# shellcheck disable=SC2016
awkward=('a b' "it's" 'say "hi"' 'back\slash' '$HOME' $'line\nbreak' '*' '' '-d')
caller_dir="${t_dir}/caller dir with 'quotes' and \"more\""
mkdir -p "$caller_dir"

run_test
caller_dir=$caller_dir run_terminal ready "${awkward[@]}"
got_args=()
if [[ -f ${t_dir}/args ]]
then
  while IFS= read -r -d '' a
  do
    got_args+=("$a")
  done < "${t_dir}/args"
fi
if (( rc == 0 )) && [[ $out == fake/session ]] &&
  [[ $err == *'"code":"ntmux3_started"'* ]] &&
  [[ $err == *'"code":"ntmux3_worktree_building"'* ]] &&
  [[ $err == *'"code":"ntmux3_session_ready"'* ]] &&
  [[ $err != *'Cloning into'* ]] &&
  [[ $(leftover_logs) == 0 ]]
then
  pass "-T ready: forwards instructions, prints the session, exits 0, removes its log"
else
  fail "-T ready: rc=${rc} out='${out}' err='${err}' leftover=$(leftover_logs)"
fi

run_test
if [[ $(declare -p got_args) == "$(declare -p awkward | sed 's/awkward/got_args/')" ]]
then
  pass "-T passes awkward args through AppleScript and the shell intact"
else
  fail "-T quoting: got $(declare -p got_args) command='$(cat "${t_dir}/command" 2>/dev/null)'"
fi

run_test
if [[ $(cat "${t_dir}/window.pwd" 2>/dev/null) == "$caller_dir" ]]
then
  pass "-T runs ntmux3 in the caller's working directory"
else
  fail "-T cwd: got '$(cat "${t_dir}/window.pwd" 2>/dev/null)' want '${caller_dir}'"
fi

run_test
run_terminal split someorg/somerepo
if (( rc == 0 )) && [[ $out == fake/session ]]
then
  pass "-T reassembles an instruction split across read timeouts"
else
  fail "-T split line: rc=${rc} out='${out}' err='${err}'"
fi

run_test
run_terminal failed someorg/somerepo
if (( rc == 1 )) && [[ -z $out ]] &&
  [[ $err == *'"code":"ntmux3_failed"'* ]] &&
  [[ $err == *'"message":"boom"'* ]]
then
  pass "-T failed: forwards ntmux3_failed and exits 1"
else
  fail "-T failed: rc=${rc} out='${out}' err='${err}'"
fi

for scenario in closed killed
do
  run_test
  SECONDS=0
  run_terminal "$scenario" someorg/somerepo
  if (( rc == 1 )) && [[ -z $out ]] &&
    [[ $err == *'"code":"ntmux3_terminal_closed"'* ]] &&
    (( SECONDS < 10 ))
  then
    pass "-T ${scenario}: ntmux3 dying without a verdict fails with ntmux3_terminal_closed"
  else
    fail "-T ${scenario}: rc=${rc} out='${out}' err='${err}' seconds=${SECONDS}"
  fi
done

run_test
SECONDS=0
run_terminal returned someorg/somerepo
if (( rc == 1 )) && [[ -z $out ]] &&
  [[ $err == *'"message":"ntmux3 exited with status 1 before a tmux session was ready."'* ]] &&
  (( SECONDS < 10 ))
then
  pass "-T returned: an early return without a verdict fails promptly with ntmux3_failed"
else
  fail "-T returned: rc=${rc} out='${out}' err='${err}' seconds=${SECONDS}"
fi

run_test
SECONDS=0
startup_deadline=2 run_terminal silent someorg/somerepo
if (( rc == 1 )) && [[ -z $out ]] &&
  [[ $err == *'"code":"ntmux3_terminal_not_started"'* ]] &&
  (( SECONDS < 10 ))
then
  pass "-T fails with ntmux3_terminal_not_started when ntmux3 never starts"
else
  fail "-T silent: rc=${rc} out='${out}' err='${err}' seconds=${SECONDS}"
fi

run_test
SECONDS=0
deadline=2 run_terminal deadline someorg/somerepo
if (( rc == 1 )) && [[ -z $out ]] &&
  [[ $err == *'"code":"ntmux3_terminal_timeout"'* ]] &&
  (( SECONDS < 10 ))
then
  pass "-T deadline: fails with ntmux3_terminal_timeout"
else
  fail "-T deadline: rc=${rc} out='${out}' err='${err}' seconds=${SECONDS}"
fi

run_test
lost_bin="${t_dir}/lost-bin"
mkdir -p "$lost_bin"
printf '#!/usr/bin/env bash\nexit 0\n' > "${lost_bin}/tail"
chmod +x "${lost_bin}/tail"
extra_path=$lost_bin run_terminal deadline someorg/somerepo
if (( rc == 1 )) && [[ $err == *'"code":"ntmux3_terminal_log_lost"'* ]]
then
  pass "-T fails with ntmux3_terminal_log_lost when the log stream ends"
else
  fail "-T log lost: rc=${rc} err='${err}'"
fi

run_test
NTMUX3_TEST_OSASCRIPT_FAIL=1 run_terminal ready someorg/somerepo
if (( rc == 1 )) && [[ -z $out ]] &&
  [[ $err == *'"code":"ntmux3_terminal_open_failed"'* ]] &&
  [[ $(leftover_logs) == 0 ]]
then
  pass "-T fails with ntmux3_terminal_open_failed when osascript fails"
else
  fail "-T osascript failure: rc=${rc} out='${out}' err='${err}' leftover=$(leftover_logs)"
fi

run_test
rm -f "${t_dir}/err"
(
  cd "$t_dir" &&
    TIMVISHER_AGENT=1 NTMUX3_TEST_SCENARIO=deadline TMPDIR="${t_dir}/tmp" \
    PATH="${stub_bin}:${PATH}" \
    exec bash -c "${preamble} ntmux3 -T someorg/somerepo" 2>"${t_dir}/err" >/dev/null
) &
outer=$!
tail_pid=
for _ in {1..100}
do
  tail_pid=$(pgrep -f "tail -n \+1 -F ${t_dir}/tmp/ntmux3-terminal" | head -n 1) || true
  if [[ -n $tail_pid ]] && grep -q '"code":"ntmux3_started"' "${t_dir}/err" 2>/dev/null
  then
    break
  fi
  sleep 0.1
done
if [[ -n $tail_pid ]]
then
  kill -TERM "$(ps -o ppid= -p "$tail_pid" | tr -d ' ')" 2>/dev/null || true
fi
wait "$outer" 2>/dev/null || true
sleep 0.5
if [[ -n $tail_pid ]] && ! kill -0 "$tail_pid" 2>/dev/null && [[ $(leftover_logs) == 0 ]]
then
  pass "-T stops its tail and removes its log when the waiter is terminated"
else
  fail "-T interrupted waiter: tail_pid='${tail_pid}' alive=$(kill -0 "${tail_pid:-0}" 2>/dev/null && echo yes) leftover=$(leftover_logs)"
fi

run_test
rc=0
out=$(cd "$t_dir" && env -u TIMVISHER_AGENT PATH="${stub_bin}:${PATH}" \
  bash -c "${preamble} ntmux3 -T someorg/somerepo" 2>"${t_dir}/err") || rc=$?
want_arg=$(printf 'tell script "timvisher Terminal" to runCommandInteractively("cd %s && ntmux3 someorg/somerepo")' "$t_dir")
if (( rc == 0 )) && [[ -z $out ]] && [[ $(cat "${t_dir}/osascript.arg") == "$want_arg" ]]
then
  pass "-T without TIMVISHER_AGENT just opens the window"
else
  fail "-T without agent: rc=${rc} out='${out}' arg='$(cat "${t_dir}/osascript.arg")'"
fi

for combo in '-T -d' '-d -T'
do
  run_test
  read -ra combo_args <<<"$combo"
  rm -f "${t_dir}/osascript.arg"
  combo_err=$(TIMVISHER_AGENT=1 PATH="${stub_bin}:${PATH}" \
    bash -c "${preamble} ntmux3 \"\$@\"" _ "${combo_args[@]}" someorg/somerepo 2>&1 >/dev/null) &&
    combo_rc=0 || combo_rc=$?
  if (( combo_rc == 1 )) &&
    [[ $combo_err == *'"code":"ntmux3_failed"'* ]] &&
    [[ ! -e ${t_dir}/osascript.arg ]]
  then
    pass "ntmux3 ${combo} is rejected"
  else
    fail "ntmux3 ${combo}: rc=${combo_rc} err='${combo_err}'"
  fi
done

echo ""
echo "Results: $((tests - failures))/${tests} passed"

if (( 0 < failures ))
then
  exit 1
fi
