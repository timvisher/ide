run_test
log=$(new_log real-detached)
reset_tmux
run_ntmux3 "$log" "printf '%s' '${session_dir}'" REAL -d someorg/somerepo
codes=$(jq -r .code "$log" | paste -sd, -) || true
if [[ $codes == ntmux3_started,ntmux3_worktree_building,ntmux3_worktree_ready,ntmux3_session_ready ]]
then
  pass "a successful ntmux3 -d with the log set reports the session, not a failure"
