assert_exit_reported() {
  local desc=$1 clone=$2 ntmux=$3 message=$4
  local log
  log=$(new_log "exit-${RANDOM}")
  run_test
  reset_tmux
  run_ntmux3 "$log" "$clone" "$ntmux" someorg/somerepo
  local last
  last=$(tail -n 1 "$log" | jq -r '.code + ": " + .message') || true
  if [[ $last == "ntmux3_failed: ${message}" ]] &&
    (( $(jq -r 'select(.code == "ntmux3_failed") | .code' "$log" | wc -l) == 1 )) &&
    [[ $(state_dirs) == 0 ]]
  then
    pass "$desc"
  else
    fail "${desc}: last='${last}' log='$(cat "$log")' state_dirs=$(state_dirs)"
  fi
}

assert_exit_reported "a failure that bypasses ntmux3__fail is reported as ntmux3_failed" \
  "printf '%s' '${session_dir}'" 'return 1' \
  'ntmux3 exited with status 1 before a tmux session was ready.'
assert_exit_reported "returning 0 without a session is reported as ntmux3_failed" \
  "printf '%s' '${session_dir}'" 'return 0' \
  'ntmux3 exited with status 0 before a tmux session was ready.'
assert_exit_reported "being interrupted mid-run is reported as ntmux3_failed" \
  "self=\$BASHPID; kill -INT \$(ps -o ppid= -p \$self); printf '%s' '${session_dir}'" 'return 0' \
  'ntmux3 was interrupted before a tmux session was ready.'
assert_exit_reported "being hung up mid-run is reported as ntmux3_failed" \
  "self=\$BASHPID; kill -HUP \$(ps -o ppid= -p \$self); printf '%s' '${session_dir}'" 'return 0' \
  'ntmux3 was hung up before a tmux session was ready.'
assert_exit_reported "being terminated mid-run is reported as ntmux3_failed" \
  "self=\$BASHPID; kill -TERM \$(ps -o ppid= -p \$self); printf '%s' '${session_dir}'" 'return 0' \
  'ntmux3 was terminated before a tmux session was ready.'
assert_exit_reported "ntmux3__fail is the only verdict when it already reported" \
  'return 1' 'return 0' \
  "Unable to clone 'someorg/somerepo'"

run_test
log=$(new_log no-state-dir)
reset_tmux
ntmux3_tmpdir="${t_dir}/does-not-exist" run_ntmux3 "$log" "printf '%s' '${session_dir}'" 'return 0' someorg/somerepo
codes=$(jq -r .code "$log" | paste -sd, -) || true
if [[ $codes == ntmux3_started,ntmux3_failed ]]
then
  pass "ntmux3 fails promptly when it cannot create its state directory"
else
  fail "no state dir: codes='${codes}'"
fi

run_test
log=$(new_log history)
result=$(TIMVISHER_AICTL_LOG="$log" TMPDIR="${t_dir}/tmp" bash -c "${preamble}
  set -o history
  ntmux3__main() { ntmux3__history someorg/fromhistory; ntmux3__fail boom; }
  ntmux3
  history 1
" 2>/dev/null) || true
if [[ $result == *'ntmux3 someorg/fromhistory' ]] && [[ $(state_dirs) == 0 ]]
then
