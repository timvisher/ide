chmod +x "${stub_bin}/tmux"

reset_tmux() {
  : > "${t_dir}/tmux.calls"
  : > "${t_dir}/sessions/list"
  local session
  for session in "$@"
  do
    printf '%s\n' "$session" >> "${t_dir}/sessions/list"
  done
}

run_test
log=$(new_log attach)
reset_tmux o/r/b
PATH="${stub_bin}:${PATH}" TIMVISHER_AICTL_LOG="$log" bash -c "${preamble} ntmux3__attach 'o/r/b'" 2>/dev/null || true
line=$(cat "$log")
if [[ $(classify "$line") == '{"state":"ready","session":"o/r/b","path":"/fake/session/path"}' ]] &&
  grep -q '^attach after ready$' "${t_dir}/tmux.calls"
then
  pass "ntmux3__attach emits ntmux3_session_ready before attaching"
else
  fail "ntmux3__attach: log='${line}' calls='$(cat "${t_dir}/tmux.calls")'"
fi

run_test
log=$(new_log attach-missing)
reset_tmux
rc=0
PATH="${stub_bin}:${PATH}" TIMVISHER_AICTL_LOG="$log" bash -c "${preamble} ntmux3__attach 'o/r/b'" 2>/dev/null || rc=$?
codes=$(jq -r .code "$log" | paste -sd, -) || true
if (( rc == 1 )) && [[ $codes == ntmux3_failed ]] && ! grep -q '^attach' "${t_dir}/tmux.calls"
then
  pass "ntmux3__attach fails instead of reporting a session that does not exist"
else
  fail "ntmux3__attach missing session: rc=${rc} codes='${codes}' calls='$(cat "${t_dir}/tmux.calls")'"
fi

session_dir="${t_dir}/session"
mkdir -p "$session_dir"

run_test
log=$(new_log scrub)
reset_tmux
PATH="${stub_bin}:${PATH}" TIMVISHER_AICTL_LOG="$log" \
  bash -c "${preamble} new_tmux_session scrubbed '${session_dir}' '' ''" >/dev/null 2>&1 || true
if grep -q '^new-session <unset>$' "${t_dir}/tmux.calls" &&
  grep -q "^attach ${log}$" "${t_dir}/tmux.calls"
then
  pass "TIMVISHER_AICTL_LOG is scrubbed from the environment that creates the tmux session"
else
  fail "tmux env scrub: calls='$(cat "${t_dir}/tmux.calls")'"
fi

run_test
log=$(new_log new-session-fails)
reset_tmux
rc=0
NTMUX3_TEST_TMUX_NEW_SESSION_FAILS=1 PATH="${stub_bin}:${PATH}" TIMVISHER_AICTL_LOG="$log" \
  bash -c "${preamble} new_tmux_session broken '${session_dir}' '' ''" >/dev/null 2>&1 || rc=$?
if (( rc == 1 )) && [[ ! -s $log ]] && ! grep -q '^attach' "${t_dir}/tmux.calls"
then
  pass "new_tmux_session fails, without attaching or reporting, when tmux cannot create the session"
