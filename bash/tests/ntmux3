#!/usr/bin/env bash

# Tests for ntmux3 agent shim

set -euo pipefail

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

script="$(cd "$(dirname "$0")/.." && pwd)/bin/ntmux3"

# ---------------------------------------------------------------------------
# Structured output tests
# ---------------------------------------------------------------------------

# Test: shim emits aictl_die with correct code
run_test
result=$("$script" -d foo/bar 2>&1 || true)
if [[ $result == *'"code":"ntmux3_not_a_binary"'* ]]
then
  pass "emits aictl_die with code ntmux3_not_a_binary"
else
  fail "expected code ntmux3_not_a_binary: got '${result}'"
fi

# Test: shim emits level:error
run_test
result=$("$script" 2>&1 || true)
if [[ $result == *'"level":"error"'* ]]
then
  pass "emits level:error"
else
  fail "expected level:error: got '${result}'"
fi

# Test: shim mentions source ~/.bashrc in suggestions
run_test
result=$("$script" 2>&1 || true)
if [[ $result == *'source ~/.bashrc'* ]]
then
  pass "mentions source ~/.bashrc"
else
  fail "expected source ~/.bashrc mention: got '${result}'"
fi

# Test: shim mentions timvisher_git info
run_test
result=$("$script" 2>&1 || true)
if [[ $result == *'timvisher_git info'* ]]
then
  pass "mentions timvisher_git info"
else
  fail "expected timvisher_git info mention: got '${result}'"
fi

# Test: shim exits non-zero
run_test
"$script" >/dev/null 2>&1 && rc=0 || rc=$?
if (( 0 < rc ))
then
  pass "exits non-zero"
else
  fail "expected non-zero exit, got 0"
fi

# Test: shim teaches -T and that it blocks
run_test
result=$("$script" 2>&1 || true)
if [[ $result == *'ntmux3 -T org/repo/branch-name'* ]] && [[ $result == *'run_in_background'* ]]
then
  pass "mentions -T and that it blocks"
else
  fail "expected -T mention: got '${result}'"
fi

# ---------------------------------------------------------------------------
# Fallback aictl_die stub tests
# ---------------------------------------------------------------------------

# Test: fallback stub produces valid JSON with correct code when aictl.bash
# is not available (simulate by unsetting HOME to break the source path)
run_test
result=$(HOME=/nonexistent "$script" 2>&1 || true)
if [[ $result == *'"code":"ntmux3_not_a_binary"'* ]]
then
  pass "fallback stub produces correct code"
else
  fail "fallback stub code: got '${result}'"
fi

# Test: fallback stub produces correct message
run_test
result=$(HOME=/nonexistent "$script" 2>&1 || true)
if [[ $result == *'shell function'* ]]
then
  pass "fallback stub produces correct message"
else
  fail "fallback stub message: got '${result}'"
fi

# ---------------------------------------------------------------------------
# ntmux3 -T and instruction streaming (bash/functions/tmux.bash)
# ---------------------------------------------------------------------------

# shellcheck disable=SC2317

funcs_dir="$(cd "$(dirname "$0")/../functions" && pwd)"

kill_tree() {
  local pid child
  for child in $(pgrep -P "$1")
  do
    kill_tree "$child"
  done
  kill -KILL "$1" 2>/dev/null || true
}

t_dir=
cleanup() {
  local pid
  if [[ -n $t_dir && -f ${t_dir}/pids ]]
  then
    while read -r pid
    do
      kill_tree "$pid"
    done < "${t_dir}/pids"
  fi
  if [[ -n $t_dir ]]
  then
    pkill -KILL -f "${t_dir}/" 2>/dev/null || true
    rm -rf "$t_dir"
  fi
}
trap cleanup EXIT
t_dir=$(mktemp -d)

stub_bin="${t_dir}/bin"
mkdir -p "$stub_bin" "${t_dir}/tmp" "${t_dir}/sessions"

preamble="
  source '${funcs_dir}/logging.bash'
  source '${funcs_dir}/aictl.bash'
  source '${funcs_dir}/tmux.bash'
"

emit() {
  env -u TIMVISHER_AICTL_LOG bash -c "${preamble}"' aictl_info "$@"' _ "$@" 2>&1
}

classify() {
  local rc=0 out
  out=$(bash -c "${preamble}"' ntmux3__classify_instruction "$1"' _ "$1" 2>&1) || rc=$?
  if (( rc == 0 ))
  then
    printf '%s' "$out"
  else
    printf 'rc=%s%s' "$rc" "${out:+ out=${out}}"
  fi
}

assert_eq() {
  local desc=$1 want=$2 got=$3
  run_test
  if [[ $got == "$want" ]]
  then
    pass "$desc"
  else
    fail "${desc}: want '${want}', got '${got}'"
  fi
}

assert_eq "classifier: started carries the pid" \
  '{"state":"started","pid":4242}' \
  "$(classify "$(emit --code ntmux3_started --message m --data '{"pid":4242}')")"
assert_eq "classifier: started without data has a null pid" \
  '{"state":"started","pid":null}' \
  "$(classify "$(emit --code ntmux3_started --message m)")"
assert_eq "classifier: started with a non-numeric pid has a null pid" \
  '{"state":"started","pid":null}' \
  "$(classify "$(emit --code ntmux3_started --message m --data '{"pid":"x"}')")"
assert_eq "classifier: started with non-object data has a null pid" \
  '{"state":"started","pid":null}' \
  "$(classify "$(emit --code ntmux3_started --message m --data '"x"')")"
assert_eq "classifier: session_ready is ready with session and path" \
  '{"state":"ready","session":"o/r/b","path":"/p"}' \
  "$(classify "$(emit --code ntmux3_session_ready --message m --data '{"session":"o/r/b","path":"/p"}')")"
assert_eq "classifier: session_ready without data is failed" \
  '{"state":"failed","code":"ntmux3_session_ready","message":"ntmux3_session_ready carried no session name"}' \
  "$(classify "$(emit --code ntmux3_session_ready --message m)")"
assert_eq "classifier: session_ready with an empty session is failed" \
  '{"state":"failed","code":"ntmux3_session_ready","message":"ntmux3_session_ready carried no session name"}' \
  "$(classify "$(emit --code ntmux3_session_ready --message m --data '{"session":""}')")"
assert_eq "classifier: ntmux3_failed is failed with its message" \
  '{"state":"failed","code":"ntmux3_failed","message":"Unable to clone x"}' \
  "$(classify "$(emit --code ntmux3_failed --message 'Unable to clone x')")"
assert_eq "classifier: worktree_building is progress" \
  '{"state":"progress","code":"ntmux3_worktree_building"}' \
  "$(classify "$(emit --code ntmux3_worktree_building --message m)")"
assert_eq "classifier: an unknown code is progress" \
  '{"state":"progress","code":"timvisher_git_stack_base_inherited"}' \
  "$(classify "$(emit --code timvisher_git_stack_base_inherited --message m)")"
assert_eq "classifier: non-JSON noise is rejected" \
  'rc=1' "$(classify 'Cloning into foo...')"
assert_eq "classifier: non-instruction JSON is rejected" \
  'rc=1' "$(classify '{"code":"ntmux3_session_ready","data":{"session":"s"}}')"

terminal_number() {
  bash -c "${preamble}"' ntmux3__terminal_number "$1" 5' _ "$1"
}

assert_eq "terminal numbers: 10 is 10" 10 "$(terminal_number 10)"
assert_eq "terminal numbers: 010 is decimal 10" 10 "$(terminal_number 010)"
assert_eq "terminal numbers: 08 is decimal 8" 8 "$(terminal_number 08)"
assert_eq "terminal numbers: 0 falls back to the default" 5 "$(terminal_number 0)"
assert_eq "terminal numbers: 00 falls back to the default" 5 "$(terminal_number 00)"
assert_eq "terminal numbers: non-numeric falls back to the default" 5 "$(terminal_number 1x)"

# ---------------------------------------------------------------------------
# Emitters
# ---------------------------------------------------------------------------

new_log() {
  local log="${t_dir}/${1}.jsonl"
  : > "$log"
  printf '%s' "$log"
}

run_test
log=$(new_log fail)
err=$(TIMVISHER_AICTL_LOG="$log" bash -c "${preamble} ntmux3__fail 'boom'" 2>&1) || true
if [[ $err == "boom"$'\n'"$(cat "$log")" ]] &&
  [[ $(jq -r '.code + " " + .message' "$log") == "ntmux3_failed boom" ]]
then
  pass "ntmux3__fail echoes for the human and emits ntmux3_failed"
else
  fail "ntmux3__fail: stderr='${err}' log='$(cat "$log" 2>/dev/null)'"
fi

run_test
err=$(env -u TIMVISHER_AGENT -u TIMVISHER_AICTL_LOG bash -c "${preamble} ntmux3__fail 'boom'" 2>&1) || true
if [[ $err == boom ]]
then
  pass "ntmux3__fail emits no instruction when nobody is listening"
else
  fail "ntmux3__fail unlistened: stderr='${err}'"
fi

cat > "${stub_bin}/tmux" <<STUB
#!/usr/bin/env bash
printf '%s %s\n' "\$1" "\${TIMVISHER_AICTL_LOG-<unset>}" >> '${t_dir}/tmux.calls'
