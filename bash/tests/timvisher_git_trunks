#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2016,SC2034 # check's conditions are eval'd when it runs, and read variables shellcheck can't see
source "$(dirname "$0")/lib/timvisher_tests.bash" || exit 1

# Tests for timvisher_git's trunk roots: migrate-trunks out of ~/.cache,
# and healing worktrees whose trunk was wiped.

failures=0
tests=0

check() {
  local name=$1
  shift
  (( tests++ ))
  if "$@"
  then
    echo "PASS: $name"
  else
    echo "FAIL: $name" >&2
    printf '  rc=%s\n  out: %s\n  err: %s\n' "$rc" "$out" "$err" >&2
    (( failures++ ))
  fi
}

script_dir=$(cd "$(dirname "$0")/.." && pwd) || exit 1
script=$script_dir/bin/timvisher_git

# shellcheck source=/dev/null
source "$script_dir/functions/real_bin.bash" || exit 1
test_git=$(TIMVISHER_REAL_BIN_SKIP=$(timvisher_real_bin_script_dirs git) timvisher_real_bin git "$script_dir/bin/git") ||
  { echo "No real git found" >&2; exit 1; }

tmpdir=$(mktemp -d) || exit 1
trap 'rm -rf "$tmpdir"' EXIT
tmpdir=$(cd "$tmpdir" && pwd -P) || exit 1
unset TIMVISHER_AGENT

mkdir -p "$tmpdir/mockbin" || exit 1
printf '#!/usr/bin/env bash\nexit 1\n' > "$tmpdir/mockbin/gh"
chmod +x "$tmpdir/mockbin/gh"
export PATH=$tmpdir/mockbin:$PATH

tg() {
  "$test_git" -c user.email=t@t -c user.name=T -c core.hooksPath=/dev/null "$@"
}

origin=$tmpdir/origin
tg init -q "$origin" || exit 1
printf 'one\n' > "$origin/file"
tg -C "$origin" add file
tg -C "$origin" commit -q -m initial || exit 1
tg -C "$origin" branch feature/kept

n=${GIT_CONFIG_COUNT:-0}
export "GIT_CONFIG_KEY_${n}=url.${origin}.insteadOf"
export "GIT_CONFIG_VALUE_${n}=https://github.com/testorg/testrepo"
export GIT_CONFIG_COUNT=$(( n + 1 ))

out='' err='' rc=0
run() {
  local h=$1
  shift
  out=$(cd "$tmpdir" && timvisher_tests_with_home "$h" "$script" "$@" 2>"$tmpdir/err")
  rc=$?
  err=$(< "$tmpdir/err")
}

legacy_of() { printf '%s\n' "$1/.cache/timvisher_git_worktrees/repo_trunks"; }
root_of() { printf '%s\n' "$1/.local/share/timvisher_git/repo_trunks"; }

# A HOME with testorg/testrepo cached at the old root, and a worktree of
# feature/kept made from it.
new_home() {
  local h=$tmpdir/$1 trunk
  mkdir -p "$h/git" "$(legacy_of "$h")/testorg" || return 1
  ln -s "$HOME/.functions" "$h/.functions" || return 1
  trunk=$(legacy_of "$h")/testorg/testrepo
  tg init -q --bare "$trunk" &&
    tg -C "$trunk" remote add origin https://github.com/testorg/testrepo &&
    tg -C "$trunk" fetch -q origin &&
    tg -C "$trunk" remote set-head origin -a >/dev/null || return 1
  run "$h" clone testorg/testrepo/feature/kept
  (( rc == 0 )) || { printf 'clone failed: %s\n' "$err" >&2; return 1; }
  printf '%s\n' "$h"
}

wt_head() { tg -C "$1" rev-parse HEAD 2>/dev/null; }

# --- migrate-trunks --------------------------------------------------------

h=$(new_home mig) || exit 1
wt=$h/git/testorg/testrepo/feature/kept
head_before=$(wt_head "$wt")
legacy=$(legacy_of "$h")
root=$(root_of "$h")

fork=$legacy/forkorg/testrepo
mkdir -p "${fork%/*}"
tg init -q --bare "$fork"
printf '%s\n' "$legacy/testorg/testrepo/objects" > "$fork/objects/info/alternates"
mkdir -p "$h/.config/git"
tg config --file "$h/.config/git/config_machine" --add maintenance.repo "$legacy/testorg/testrepo"

plain=$legacy/plainorg/plainrepo
plain_wt=$h/git/plainorg/plainrepo/feature/kept
mkdir -p "${plain%/*}" "${plain_wt%/*}"
tg clone -q "$origin" "$plain" &&
  tg -C "$plain" worktree add -q "$plain_wt" feature/kept 2>/dev/null || exit 1
plain_head=$(wt_head "$plain_wt")

run "$h" migrate-trunks --dry-run
check 'dry run: lists the trunk with its worktree' \
  eval '(( rc == 0 )) && [[ $out == *"move testorg/testrepo: 1 worktree(s)"* ]]'
check 'dry run: changes nothing' \
  eval '[[ -d $legacy/testorg/testrepo && ! -e $root/testorg/testrepo ]]'

run "$h" migrate-trunks
check 'migrate: exits 0' eval '(( rc == 0 ))'
check 'migrate: the trunk is at the new root, not the old' \
  eval '[[ -d $root/testorg/testrepo/objects && ( -L $legacy || ! -e $legacy/testorg/testrepo ) ]]'
check 'migrate: the worktree still works, at the same commit' \
  eval '[[ $(wt_head "$wt") == "$head_before" ]]'
check 'migrate: the worktree names the new trunk' \
  eval '[[ $(cat "$wt/.git") == "gitdir: $root/testorg/testrepo/worktrees/"* ]]'
check 'migrate: the fork'"'"'s alternates follow its parent' \
  eval '[[ $(cat "$root/forkorg/testrepo/objects/info/alternates") == "$root/testorg/testrepo/objects" ]]'
check 'migrate: a non-bare trunk moves too, and its worktree follows' \
  eval '[[ -d $root/plainorg/plainrepo/.git && $(wt_head "$plain_wt") == "$plain_head" && $(cat "$plain_wt/.git") == "gitdir: $root/plainorg/plainrepo/.git/worktrees/"* ]]'
check 'migrate: maintenance names the new trunk' \
  eval '[[ $(tg config --file "$h/.config/git/config_machine" --get-all maintenance.repo | sort -u) == "$root/testorg/testrepo" ]]'
if [[ $(uname -s) == Darwin ]]
then
  check 'migrate on a Mac: the old root links to the new' \
    eval '[[ -L $legacy && $(cd "$legacy" && pwd -P) == "$(cd "$root" && pwd -P)" ]]'
else
  check 'migrate off a Mac: no link at the old root' eval '[[ ! -e $legacy ]]'
fi

run "$h" migrate-trunks
check 'migrate again: nothing to move' \
  eval '(( rc == 0 )) && [[ $out == "nothing to move"* ]]'

# --- copy across filesystems ----------------------------------------------

copy_root=
if [[ -d /dev/shm && -w /dev/shm ]]
then
  copy_root=$(mktemp -d /dev/shm/x.test-git-trunks.XXXXXX) || copy_root=
fi
if [[ -n $copy_root ]] &&
   [[ $(stat -c %d "$copy_root" 2>/dev/null) != "$(stat -c %d "$tmpdir" 2>/dev/null)" ]]
then
  h=$(new_home copy) || exit 1
  wt=$h/git/testorg/testrepo/feature/kept
  head_before=$(wt_head "$wt")
  out=$(cd "$tmpdir" && timvisher_tests_with_home "$h" env TIMVISHER_GIT_TRUNKS_DIR="$copy_root/repo_trunks" \
    "$script" migrate-trunks 2>"$tmpdir/err")
  rc=$?
  err=$(< "$tmpdir/err")
  check 'copy: exits 0' eval '(( rc == 0 ))'
  check 'copy: the trunk is on the other filesystem, and gone from the old root' \
    eval '[[ -d $copy_root/repo_trunks/testorg/testrepo && ! -d $(legacy_of "$h")/testorg/testrepo ]]'
  check 'copy: the worktree still works, at the same commit' \
    eval '[[ $(wt_head "$wt") == "$head_before" ]]'
  rm -rf "$copy_root"
else
  [[ -n $copy_root ]] && rm -rf "$copy_root"
  echo "SKIP: copy across filesystems (no separate /dev/shm here)"
fi

# --- busy and conflicting trunks -------------------------------------------

h=$(new_home busy) || exit 1
trunk=$(legacy_of "$h")/testorg/testrepo
( exec 3< "$trunk/HEAD" && exec sleep 60 ) &
holder=$!
run "$h" migrate-trunks --dry-run
check 'dry run: a trunk with a file held open is busy, naming the process' \
  eval '[[ $out == *"busy testorg/testrepo:"*"pid $holder "* ]]'
run "$h" migrate-trunks
check 'migrate: a busy trunk stays where it is, exit 4' \
  eval '(( rc == 4 )) && [[ -d $trunk/objects && ! -e $(root_of "$h")/testorg/testrepo ]]'
kill "$holder" 2>/dev/null
wait "$holder" 2>/dev/null

mkdir -p "$(root_of "$h")/testorg"
tg init -q --bare "$(root_of "$h")/testorg/testrepo"
run "$h" migrate-trunks --dry-run
check 'dry run: a trunk at both roots with different refs is a conflict' \
  eval '[[ $out == *"conflict testorg/testrepo"* ]]'
run "$h" migrate-trunks
check 'migrate: a conflict leaves both and fails' \
  eval '(( rc != 0 )) && [[ -d $trunk/objects && -d $(root_of "$h")/testorg/testrepo/objects ]]'

# --- adopting an old root that was put somewhere on purpose ----------------

h=$(new_home adopt) || exit 1
wt=$h/git/testorg/testrepo/feature/kept
head_before=$(wt_head "$wt")
mkdir -p "$tmpdir/volume"
mv "$h/.cache/timvisher_git_worktrees" "$tmpdir/volume/trunks"
ln -s "$tmpdir/volume/trunks" "$h/.cache/timvisher_git_worktrees"
run "$h" migrate-trunks --dry-run
check 'dry run: an old root outside ~/.cache is adopted, not moved' \
  eval '[[ $out == *"adopt:"* && $out == *"would link"* && ! -L $(root_of "$h") ]]'
run "$h" migrate-trunks
check 'adopt: the new root links to the old root'"'"'s real place' \
  eval '(( rc == 0 )) && [[ -L $(root_of "$h") && $(cd "$(root_of "$h")" && pwd -P) == "$tmpdir/volume/trunks/repo_trunks" ]]'
check 'adopt: the trunk did not move and the worktree still works' \
  eval '[[ -d $tmpdir/volume/trunks/repo_trunks/testorg/testrepo/objects && $(wt_head "$wt") == "$head_before" ]]'

# --- heal --------------------------------------------------------------------

h=$(new_home heal) || exit 1
wt=$h/git/testorg/testrepo/feature/kept
head_before=$(wt_head "$wt")
admin=$(sed 's/^gitdir: //' "$wt/.git")
trunk=${admin%/worktrees/*}

printf 'gitdir: %s\n' "$tmpdir/gone/worktrees/${admin##*/}" > "$wt/.git"
run "$h" clone "$wt"
check 'a worktree whose trunk only moved is relinked, not healed' \
  eval '(( rc == 0 )) && [[ $err != *HEAL:* && $(wt_head "$wt") == "$head_before" ]]'

printf 'changed\n' > "$wt/file"
rm -rf "${trunk:?}"
run "$h" heal --dry-run
check 'heal --dry-run: an orphan whose trunk is gone would be cloned again' \
  eval '(( rc == 0 )) && [[ $out == *"would clone testorg/testrepo, then re-attach '"'"'$wt'"'"'"* ]]'
run "$h" clone "$wt"
check 'clone heals an orphaned worktree, saying so loudly' \
  eval '(( rc == 0 )) && [[ $err == *"HEAL: worktree"* && $err == *"never pushed"* && $err == *stashes* ]]'
check 'healed: on its branch, at origin'"'"'s commit' \
  eval '[[ $(tg -C "$wt" symbolic-ref --short HEAD) == feature/kept && $(wt_head "$wt") == "$(tg -C "$origin" rev-parse feature/kept)" ]]'
check 'healed: its files are untouched and show as uncommitted' \
  eval '[[ $(cat "$wt/file") == changed && $(tg -C "$wt" status --porcelain) == " M file" ]]'

lost=$h/git/testorg/testrepo/feature/never-pushed
mkdir -p "$lost"
printf 'gitdir: %s\n' "$tmpdir/gone/worktrees/never-pushed" > "$lost/.git"
printf 'mine\n' > "$lost/mine"
run "$h" heal
check 'heal: a worktree whose branch is on no origin stays orphaned, saying why' \
  eval '(( rc != 0 )) && [[ $err == *"stays orphaned"*"heal --branch"* && $(cat "$lost/.git") == "gitdir: $tmpdir/gone/worktrees/never-pushed" ]]'
run "$h" heal --branch feature/never-pushed "$lost"
check 'heal --branch: re-attached from the trunk branch, files kept' \
  eval '(( rc == 0 )) && [[ $(tg -C "$lost" symbolic-ref --short HEAD) == feature/never-pushed && $(tg -C "$lost" status --porcelain) == *"?? mine"* && $(cat "$lost/mine") == mine ]]'

echo ""
echo "Results: $(( tests - failures ))/${tests} passed"
(( failures == 0 ))
