#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2016,SC2034 # check's conditions are eval'd when it runs, and read variables shellcheck can't see
source "$(dirname "$0")/lib/timvisher_tests.bash" || exit 1

# Tests for timvisher_git's trunk roots: healing worktrees whose trunk was
# wiped.

failures=0
tests=0

check() {
  local name=$1
  shift
  (( tests++ ))
  if "$@"
  then
    echo "PASS: $name"
  else
    echo "FAIL: $name" >&2
    printf '  rc=%s\n  out: %s\n  err: %s\n' "$rc" "$out" "$err" >&2
    (( failures++ ))
  fi
}

script_dir=$(cd "$(dirname "$0")/.." && pwd) || exit 1
script=$script_dir/bin/timvisher_git

# shellcheck source=/dev/null
source "$script_dir/functions/real_bin.bash" || exit 1
test_git=$(TIMVISHER_REAL_BIN_SKIP=$(timvisher_real_bin_script_dirs git) timvisher_real_bin git "$script_dir/bin/git") ||
  { echo "No real git found" >&2; exit 1; }

tmpdir=$(mktemp -d) || exit 1
trap 'rm -rf "$tmpdir"' EXIT
tmpdir=$(cd "$tmpdir" && pwd -P) || exit 1
unset TIMVISHER_AGENT

mkdir -p "$tmpdir/mockbin" || exit 1
printf '#!/usr/bin/env bash\nexit 1\n' > "$tmpdir/mockbin/gh"
chmod +x "$tmpdir/mockbin/gh"
export PATH=$tmpdir/mockbin:$PATH

tg() {
  "$test_git" -c user.email=t@t -c user.name=T -c core.hooksPath=/dev/null "$@"
}

origin=$tmpdir/origin
tg init -q "$origin" || exit 1
printf 'one\n' > "$origin/file"
tg -C "$origin" add file
tg -C "$origin" commit -q -m initial || exit 1
tg -C "$origin" branch feature/kept

n=${GIT_CONFIG_COUNT:-0}
export "GIT_CONFIG_KEY_${n}=url.${origin}.insteadOf"
export "GIT_CONFIG_VALUE_${n}=https://github.com/testorg/testrepo"
export GIT_CONFIG_COUNT=$(( n + 1 ))

out='' err='' rc=0
run() {
  local h=$1
  shift
  out=$(cd "$tmpdir" && timvisher_tests_with_home "$h" "$script" "$@" 2>"$tmpdir/err")
  rc=$?
  err=$(< "$tmpdir/err")
}

legacy_of() { printf '%s\n' "$1/.cache/timvisher_git_worktrees/repo_trunks"; }

# A HOME with testorg/testrepo cached at the old root, and a worktree of
# feature/kept made from it.
new_home() {
  local h=$tmpdir/$1 trunk
  mkdir -p "$h/git" "$(legacy_of "$h")/testorg" || return 1
  ln -s "$HOME/.functions" "$h/.functions" || return 1
  trunk=$(legacy_of "$h")/testorg/testrepo
  tg init -q --bare "$trunk" &&
    tg -C "$trunk" remote add origin https://github.com/testorg/testrepo &&
    tg -C "$trunk" fetch -q origin &&
    tg -C "$trunk" remote set-head origin -a >/dev/null || return 1
  run "$h" clone testorg/testrepo/feature/kept
  (( rc == 0 )) || { printf 'clone failed: %s\n' "$err" >&2; return 1; }
  printf '%s\n' "$h"
}

wt_head() { tg -C "$1" rev-parse HEAD 2>/dev/null; }

# --- heal --------------------------------------------------------------------

h=$(new_home heal) || exit 1
wt=$h/git/testorg/testrepo/feature/kept
head_before=$(wt_head "$wt")
admin=$(sed 's/^gitdir: //' "$wt/.git")
trunk=${admin%/worktrees/*}

printf 'gitdir: %s\n' "$tmpdir/gone/worktrees/${admin##*/}" > "$wt/.git"
run "$h" clone "$wt"
check 'a worktree whose trunk only moved is relinked, not healed' \
  eval '(( rc == 0 )) && [[ $err != *HEAL:* && $(wt_head "$wt") == "$head_before" ]]'

printf 'changed\n' > "$wt/file"
rm -rf "${trunk:?}"
run "$h" heal --dry-run
check 'heal --dry-run: an orphan whose trunk is gone would be cloned again' \
  eval '(( rc == 0 )) && [[ $out == *"would clone testorg/testrepo, then re-attach '"'"'$wt'"'"'"* ]]'
run "$h" clone "$wt"
check 'clone heals an orphaned worktree, saying so loudly' \
  eval '(( rc == 0 )) && [[ $err == *"HEAL: worktree"* && $err == *"never pushed"* && $err == *stashes* ]]'
check 'healed: on its branch, at origin'"'"'s commit' \
  eval '[[ $(tg -C "$wt" symbolic-ref --short HEAD) == feature/kept && $(wt_head "$wt") == "$(tg -C "$origin" rev-parse feature/kept)" ]]'
check 'healed: its files are untouched and show as uncommitted' \
  eval '[[ $(cat "$wt/file") == changed && $(tg -C "$wt" status --porcelain) == " M file" ]]'

lost=$h/git/testorg/testrepo/feature/never-pushed
mkdir -p "$lost"
printf 'gitdir: %s\n' "$tmpdir/gone/worktrees/never-pushed" > "$lost/.git"
printf 'mine\n' > "$lost/mine"
run "$h" heal
check 'heal: a worktree whose branch is on no origin stays orphaned, saying why' \
  eval '(( rc != 0 )) && [[ $err == *"stays orphaned"*"heal --branch"* && $(cat "$lost/.git") == "gitdir: $tmpdir/gone/worktrees/never-pushed" ]]'
run "$h" heal --branch feature/never-pushed "$lost"
check 'heal --branch: re-attached from the trunk branch, files kept' \
  eval '(( rc == 0 )) && [[ $(tg -C "$lost" symbolic-ref --short HEAD) == feature/never-pushed && $(tg -C "$lost" status --porcelain) == *"?? mine"* && $(cat "$lost/mine") == mine ]]'

echo ""
echo "Results: $(( tests - failures ))/${tests} passed"
(( failures == 0 ))
