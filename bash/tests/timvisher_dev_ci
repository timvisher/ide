fi

run_test
gd_out=$( ( assert_dev_integration_worktrees "$gd_feat" ) 2>&1 )
if [[ $gd_out == *dev_ci_run_not_integration_worktree* ]] &&
   [[ $gd_out == *"run-tests -C"* ]]
