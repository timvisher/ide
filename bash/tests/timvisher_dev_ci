# A dev worktree under $TIMVISHER_GIT_HOME/<org>/<repo>/dev with fabricated
# origin/main and upstream/main refs.  $4 soft=yes adds the soft-fork cookie;
# upstream_ahead=yes puts a commit on upstream/main the trunk lacks.
make_pull_fixture() {
  local org=$1 repo=$2 soft=$3 ahead=$4
  local wt="$TIMVISHER_GIT_HOME/$org/$repo/dev"

  mkdir -p "$wt" || return 1
  "$test_git" init -q -b main "$wt"
  "$test_git" -C "$wt" config core.hooksPath /dev/null
  "$test_git" -C "$wt" config user.email t@t
  "$test_git" -C "$wt" config user.name t
  "$test_git" -C "$wt" commit -q --allow-empty -m base
  local base; base=$("$test_git" -C "$wt" rev-parse HEAD)
  "$test_git" -C "$wt" update-ref refs/remotes/origin/main "$base"
  "$test_git" -C "$wt" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main

  if [[ $ahead == yes ]]
  then
    "$test_git" -C "$wt" commit -q --allow-empty -m upstream-only
    "$test_git" -C "$wt" update-ref refs/remotes/upstream/main "$("$test_git" -C "$wt" rev-parse HEAD)"
    "$test_git" -C "$wt" reset -q --hard "$base"
  else
    "$test_git" -C "$wt" update-ref refs/remotes/upstream/main "$base"
  fi
  "$test_git" -C "$wt" symbolic-ref refs/remotes/upstream/HEAD refs/remotes/upstream/main

  [[ $soft == yes ]] && touch "$wt/x.timvisher_git.soft-fork"
  : > "$wt/x.active-worktrees"
  printf '%s' "$wt"
}

