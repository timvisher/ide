#!/usr/bin/env bash

# Tests for timvisher_dev_ci's agent-facing surface: --help, hooks
# subcommand, run-tests convenience, and structured error paths.

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

script_dir="$(cd "$(dirname "$0")/.." && pwd)" ||
  { echo "cannot resolve script_dir" >&2; exit 1; }
script="${script_dir}/bin/timvisher_dev_ci"

tmpdir=$(mktemp -d) || { echo "mktemp failed" >&2; exit 1; }
trap 'rm -rf "$tmpdir"' EXIT

# Override TIMVISHER_GIT_HOME so all path validation runs against the
# fixture, not the real ~/git/.  Also override XDG_CONFIG_HOME so the
# DEV_CI_REGISTRY default lands in a fresh empty dir (avoids reading
# the real registry).
export TIMVISHER_GIT_HOME="$tmpdir/git"
export XDG_CONFIG_HOME="$tmpdir/config"
mkdir -p "$TIMVISHER_GIT_HOME" "$XDG_CONFIG_HOME"

# ---------------------------------------------------------------------------
# --help
# ---------------------------------------------------------------------------

run_test
out=$("$script" --help 2>&1)
rc=$?
if (( rc == 0 )) &&
   [[ $out == *"NAME"* ]] &&
   [[ $out == *"timvisher_dev_ci"* ]] &&
   [[ $out == *"AGENT USAGE"* ]] &&
   [[ $out == *"HOOK RESOLUTION"* ]] &&
   [[ $out == *"run-tests"* ]]
then
  pass "--help prints structured help and exits 0"
else
  fail "--help: rc=$rc, output missing expected sections"
fi

run_test
out=$("$script" -h 2>&1)
if [[ $out == *"NAME"* ]]
then
  pass "-h alias works"
else
  fail "-h alias missing NAME"
fi

run_test
out=$("$script" help 2>&1)
if [[ $out == *"NAME"* ]]
then
  pass "help alias works"
else
  fail "help alias missing NAME"
fi

# ---------------------------------------------------------------------------
# hooks: subcommand validation
# ---------------------------------------------------------------------------

run_test
out=$("$script" hooks 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"type":"instruction"'* ]] &&
   [[ $out == *'"level":"error"'* ]] &&
   [[ $out == *'"code":"dev_ci_hooks_no_subcommand"'* ]]
then
  pass "hooks (no subcommand) emits aictl_die JSON"
else
  fail "hooks: rc=$rc out='$out'"
fi

run_test
out=$("$script" hooks frob 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_hooks_unknown_subcommand"'* ]] &&
   [[ $out == *"frob"* ]]
then
  pass "hooks frob emits dev_ci_hooks_unknown_subcommand JSON"
else
  fail "hooks frob: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks ls: path validation (cwd outside TIMVISHER_GIT_HOME)
# ---------------------------------------------------------------------------

run_test
out=$(cd "$tmpdir" && "$script" hooks ls 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_path_not_in_git_home"'* ]] &&
   [[ $out == *"$TIMVISHER_GIT_HOME"* ]]
then
  pass "hooks ls outside TIMVISHER_GIT_HOME emits structured error with the right path"
else
  fail "hooks ls outside git home: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks ls: explicit non-existent path
# ---------------------------------------------------------------------------

run_test
out=$("$script" hooks ls "$tmpdir/does-not-exist" 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_path_not_dir"'* ]]
then
  pass "hooks ls non-existent path emits dev_ci_path_not_dir"
else
  fail "hooks ls non-existent: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks ls: valid worktree under TIMVISHER_GIT_HOME (no resolvable hooks)
# ---------------------------------------------------------------------------

# Build a fake worktree at $TIMVISHER_GIT_HOME/myorg/myrepo/dev/.  We
# don't need it to be a real git repo for hooks ls -- just a directory
# under the right path shape.  Use the canonical (symlink-resolved)
# path for assertions because the script outputs `pwd -P` form.
fake_wt_unresolved="$TIMVISHER_GIT_HOME/myorg/myrepo/dev"
mkdir -p "$fake_wt_unresolved"
fake_wt=$(cd "$fake_wt_unresolved" && pwd -P)

# Hook resolution calls `timvisher_gh -C <wt> info --json`, which hits
# the GitHub API.  Stub it via PATH so the test makes no network calls
# and does not depend on `timvisher_gh` being installed.  The stub
# derives org/repo/branchPath from the -C path the way the real tool
# does, and records each invocation so tests can assert on caching and
# on the path actually queried.
fake_git_home_real=$(cd "$TIMVISHER_GIT_HOME" && pwd -P)
mkdir -p "$tmpdir/mockbin"
cat > "$tmpdir/mockbin/timvisher_gh" <<MOCK
#!/usr/bin/env bash
if [[ \$1 == -C && \$3 == info && \$4 == --json ]]
then
  printf '%s\\n' "\$2" >> "$tmpdir/tgh-calls"
  rel=\${2#${TIMVISHER_GIT_HOME}/}
  rel=\${rel#${fake_git_home_real}/}
  org=\${rel%%/*}
  rest=\${rel#*/}
  repo=\${rest%%/*}
  branch=\${rest#*/}
  [[ \$branch == "\$repo" ]] && branch=""
  jq -n --arg org "\$org" --arg repo "\$repo" --arg branch "\$branch" \\
    '{timvisher_git: {org: \$org, repo: \$repo, branch: \$branch,
                      branchPath: \$branch, absPath: "", prefixPath: ""},
      timvisher_gh: {me: \$org,
                     forkNetwork: {mainRepo: (\$org + "/" + \$repo),
                                   mainOwner: \$org}}}'
  exit 0
fi
echo "(mock) unhandled: \$*" >&2
exit 2
MOCK
chmod +x "$tmpdir/mockbin/timvisher_gh"

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks ls 2>&1)
rc=$?
if (( rc == 0 )) &&
   [[ $out == *"hooks for $fake_wt"* ]] &&
   [[ $out == *"run-tests.sh"* ]] &&
   [[ $out == *"(none)"* ]]
then
  pass "hooks ls in valid worktree lists KNOWN_HOOKS with (none) when unresolved"
else
  fail "hooks ls valid worktree: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks run: explicit unresolvable hook
# ---------------------------------------------------------------------------

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks run nope.sh 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_hook_unresolvable"'* ]] &&
   [[ $out == *"nope.sh"* ]]
then
  pass "hooks run nope.sh hard-errors with dev_ci_hook_unresolvable"
else
  fail "hooks run nope.sh: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks run: no args, no resolvable hooks
# ---------------------------------------------------------------------------

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks run 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_hooks_run_none_resolved"'* ]]
then
  pass "hooks run (no args, nothing resolved) errors with dev_ci_hooks_run_none_resolved"
else
  fail "hooks run none resolved: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks run: explicit hook resolves and executes (end-to-end)
# ---------------------------------------------------------------------------

# Drop a hook into REPO_HOOKS_EXT_DIR (XDG_CONFIG_HOME-rooted) at level
# 1 (fork-network repo), so it resolves for any branch under myorg/myrepo.
hook_dir="$XDG_CONFIG_HOME/timvisher/ide/timvisher_dev_ci/hooks/myorg/myrepo"
mkdir -p "$hook_dir"
marker="$tmpdir/hook-ran"
cat > "$hook_dir/run-tests.sh" <<HOOK
#!/usr/bin/env bash
echo "ran: \$0"
touch "$marker"
HOOK
chmod +x "$hook_dir/run-tests.sh"

run_test
rm -f "$marker"
out=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks run run-tests.sh 2>&1)
rc=$?
if (( rc == 0 )) && [[ -f $marker ]]
then
  pass "hooks run run-tests.sh resolves and executes the hook"
else
  fail "hooks run end-to-end: rc=$rc marker_exists=$( [[ -f $marker ]] && echo yes || echo no ) out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks run: -C flag selects worktree, hook arg comes after
# ---------------------------------------------------------------------------

run_test
rm -f "$marker"
# Run from outside the worktree, point at it via -C. This exercises the
# arg parser distinguishing -C PATH from hook-name positionals.
out=$(cd "$tmpdir" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks run -C "$fake_wt" run-tests.sh 2>&1)
rc=$?
if (( rc == 0 )) && [[ -f $marker ]]
then
  pass "hooks run -C PATH HOOK runs the named hook in the targeted worktree"
else
  fail "hooks run -C: rc=$rc marker_exists=$( [[ -f $marker ]] && echo yes || echo no ) out='$out'"
fi

run_test
# -C without an argument should error cleanly (not get parsed as a hook).
out=$(cd "$tmpdir" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks run -C 2>&1)
rc=$?
if (( rc != 0 )) && [[ $out == *'"code":"dev_ci_hooks_run_missing_C_arg"'* ]]
then
  pass "hooks run -C (no arg) emits dev_ci_hooks_run_missing_C_arg"
else
  fail "hooks run -C no arg: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks ls: cwd-independence
# ---------------------------------------------------------------------------

# Test: `hooks ls <path>` answers for <path> from any cwd
run_test
from_inside=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks ls 2>&1)
: > "$tmpdir/tgh-calls"
from_outside=$(cd "$tmpdir" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks ls "$fake_wt" 2>&1)
queried_path=$(sort -u "$tmpdir/tgh-calls")
if [[ $from_inside == "$from_outside" ]] && [[ $from_inside == *"run-tests.sh"* ]]
then
  pass "hooks ls from a non-repo cwd matches hooks ls from inside the worktree"
else
  fail "hooks ls cwd-independence: inside='${from_inside}' outside='${from_outside}'"
fi

# The context must be resolved from the target worktree, not the cwd.
run_test
if [[ $queried_path == "$fake_wt" ]]
then
  pass "hooks ls <path> resolves context from <path>, not the caller's cwd"
else
  fail "expected timvisher_gh -C '${fake_wt}', got '${queried_path}'"
fi

# The resolved hook must actually appear, not just match an all-(none)
# answer on both sides.
run_test
if [[ $from_outside == *"$hook_dir/run-tests.sh"* ]]
then
  pass "hooks ls from outside resolves the level-1 hook"
else
  fail "hooks ls from outside did not resolve the hook: '${from_outside}'"
fi

# ---------------------------------------------------------------------------
# context blob is fetched once per worktree, not once per hook name
# ---------------------------------------------------------------------------

run_test
: > "$tmpdir/tgh-calls"
(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks ls >/dev/null 2>&1)
calls=$(wc -l < "$tmpdir/tgh-calls" | tr -d ' ')
if (( calls == 1 ))
then
  pass "hooks ls resolves the context blob once for all KNOWN_HOOKS"
else
  fail "expected 1 timvisher_gh call across all KNOWN_HOOKS, got ${calls}"
fi

# ---------------------------------------------------------------------------
# an unresolvable context halts loudly instead of reporting (none)
# ---------------------------------------------------------------------------

mkdir -p "$tmpdir/failbin"
cat > "$tmpdir/failbin/timvisher_gh" <<'MOCK'
#!/usr/bin/env bash
echo "Not in a git repository" >&2
exit 1
MOCK
chmod +x "$tmpdir/failbin/timvisher_gh"

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/failbin:$PATH" "$script" hooks ls 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_worktree_context_unresolvable"'* ]] &&
   [[ $out != *"(none)"* ]]
then
  pass "hooks ls halts on an unresolvable context instead of reporting (none)"
else
  fail "hooks ls context error: rc=$rc out='$out'"
fi

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/failbin:$PATH" "$script" hooks run run-tests.sh 2>&1)
rc=$?
if (( rc != 0 )) && [[ $out == *'"code":"dev_ci_worktree_context_unresolvable"'* ]]
then
  pass "hooks run halts on an unresolvable context"
else
  fail "hooks run context error: rc=$rc out='$out'"
fi

# The underlying stderr must survive to the operator; discarding it is
# what made the original bug invisible.
run_test
stderr_out=$(cd "$fake_wt" && PATH="$tmpdir/failbin:$PATH" "$script" hooks run run-tests.sh 2>&1)
if [[ $stderr_out == *"Not in a git repository"* ]]
then
  pass "the failing timvisher_gh stderr reaches the operator"
else
  fail "timvisher_gh stderr was swallowed: '${stderr_out}'"
fi

# ---------------------------------------------------------------------------
# a well-formed but incomplete blob is an error, not "no hook configured"
# ---------------------------------------------------------------------------

mkdir -p "$tmpdir/badbin"
cat > "$tmpdir/badbin/timvisher_gh" <<'MOCK'
#!/usr/bin/env bash
echo '{"timvisher_git":{"repo":"myrepo"},"timvisher_gh":{}}'
MOCK
chmod +x "$tmpdir/badbin/timvisher_gh"

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/badbin:$PATH" "$script" hooks ls 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_worktree_context_unresolvable"'* ]] &&
   [[ $out != *"(none)"* ]]
then
  pass "a blob missing required fields halts instead of reporting (none)"
else
  fail "incomplete blob: rc=$rc out='$out'"
fi

mkdir -p "$tmpdir/garbagebin"
cat > "$tmpdir/garbagebin/timvisher_gh" <<'MOCK'
#!/usr/bin/env bash
echo 'not json at all'
MOCK
chmod +x "$tmpdir/garbagebin/timvisher_gh"

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/garbagebin:$PATH" "$script" hooks ls 2>&1)
rc=$?
if (( rc != 0 )) && [[ $out == *'"code":"dev_ci_worktree_context_unresolvable"'* ]]
then
  pass "malformed JSON from timvisher_gh halts"
else
  fail "malformed blob: rc=$rc out='$out'"
fi

# An empty string builds hook paths with a doubled slash, which
# match nothing -- as unusable as a missing key.
mkdir -p "$tmpdir/emptybin"
cat > "$tmpdir/emptybin/timvisher_gh" <<'MOCK'
#!/usr/bin/env bash
echo '{"timvisher_git":{"repo":"myrepo","branchPath":"dev"},"timvisher_gh":{"me":"","forkNetwork":{"mainOwner":""}}}'
MOCK
chmod +x "$tmpdir/emptybin/timvisher_gh"

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/emptybin:$PATH" "$script" hooks ls 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_worktree_context_unresolvable"'* ]] &&
   [[ $out != *"(none)"* ]]
then
  pass "an empty-string mainOwner/me halts instead of reporting (none)"
else
  fail "empty-string blob: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# a worktree sitting directly at <org>/<repo> has an empty branchPath
# ---------------------------------------------------------------------------

# Test: an empty branchPath still resolves the repo-rung hook.  The
# rung walk inputs are read one per line, so an empty field in the middle
# of that list must not shift the ones after it.
flat_wt_unresolved="$TIMVISHER_GIT_HOME/myorg/flatrepo"
mkdir -p "$flat_wt_unresolved"
flat_wt=$(cd "$flat_wt_unresolved" && pwd -P)
flat_hook_dir="$XDG_CONFIG_HOME/timvisher/ide/timvisher_dev_ci/hooks/myorg/flatrepo"
mkdir -p "$flat_hook_dir"
printf '#!/usr/bin/env bash\n' > "$flat_hook_dir/run-tests.sh"
chmod +x "$flat_hook_dir/run-tests.sh"

run_test
out=$(cd "$tmpdir" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks ls "$flat_wt" 2>&1)
rc=$?
if (( rc == 0 )) && [[ $out == *"$flat_hook_dir/run-tests.sh"* ]]
then
  pass "an empty branchPath still resolves the repo-rung hook"
else
  fail "flat worktree: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# find_hooks tri-state at the function level
# ---------------------------------------------------------------------------

# Load the helper functions without the top-level dispatch.  The mock
# goes on PATH for the function-level tests only, and comes back off
# before the script-level tests resume.
fh_body=$(sed '/^case \${1:-} in$/,$ d' "$script")
eval "$fh_body"
saved_path=$PATH
PATH="$tmpdir/mockbin:$PATH"

# find_hooks emits NUL-terminated paths and reports found vs none by
# exit code; an unresolvable context is the caller's prime, not its
# return value.
run_test
_worktree_context=()
worktree_context "$fake_wt"
declare -a fh_out=()
readarray -d '' -t fh_out < <(find_hooks "$fake_wt" "run-tests.sh")
fh_found_count=${#fh_out[@]}
find_hooks "$fake_wt" "run-tests.sh" >/dev/null
fh_found_rc=$?
readarray -d '' -t fh_out < <(find_hooks "$fake_wt" "definitely-not-a-hook.sh")
fh_none_count=${#fh_out[@]}
find_hooks "$fake_wt" "definitely-not-a-hook.sh" >/dev/null
fh_none_rc=$?
if (( fh_found_rc == 0 )) && (( fh_found_count == 1 )) &&
   (( fh_none_rc == 1 )) && (( fh_none_count == 0 ))
then
  pass "find_hooks: exit 0 + paths when found, exit 1 + nothing when none"
else
  fail "find_hooks: found rc=${fh_found_rc} n=${fh_found_count}; none rc=${fh_none_rc} n=${fh_none_count}"
fi

# Test: a path containing a newline survives the rung walk intact
run_test
newline_hook=$(printf '%s/weird\nname.sh' "$hook_dir")
printf '#!/usr/bin/env bash\n' > "$newline_hook" 2>/dev/null && chmod +x "$newline_hook" 2>/dev/null
if [[ -x $newline_hook ]]
then
  readarray -d '' -t fh_out < <(find_hooks "$fake_wt" "$(printf 'weird\nname.sh')")
  if (( ${#fh_out[@]} == 1 )) && [[ ${fh_out[0]} == "$newline_hook" ]]
  then
    pass "a hook path containing a newline round-trips as one element"
  else
    fail "newline path: got ${#fh_out[@]} element(s): $(printf '%q ' "${fh_out[@]}")"
  fi
  rm -f "$newline_hook"
else
  fail "newline path: could not create the fixture"
fi

# Test: find_hooks refuses to walk an unprimed context.  run-tests.sh
# resolves for this fixture when primed, so "no output" here is the
# refusal and not a "no hook configured" answer.
run_test
_worktree_context=()
unprimed_stdout=$(find_hooks "$fake_wt" "run-tests.sh" 2>/dev/null) && rc=0 || rc=$?
if (( 0 < rc )) && [[ -z $unprimed_stdout ]]
then
  pass "find_hooks on an unprimed context refuses to answer"
else
  fail "unprimed find_hooks: rc=${rc} stdout='${unprimed_stdout}'"
fi

# ---------------------------------------------------------------------------
# the context cache is keyed canonically, not by path spelling
# ---------------------------------------------------------------------------

run_test
_worktree_context=()
: > "$tmpdir/tgh-calls"
worktree_context "$fake_wt"
worktree_context "${fake_wt}/"
worktree_context "$fake_wt_unresolved"
calls=$(wc -l < "$tmpdir/tgh-calls" | tr -d ' ')
if (( calls == 1 ))
then
  pass "worktree_context caches across equivalent spellings of one worktree"
else
  fail "expected 1 lookup across 3 spellings, got ${calls}"
fi

# Test: a gate-then-run pair resolves the blob once, not twice
run_test
_worktree_context=()
: > "$tmpdir/tgh-calls"
hook_exists "$fake_wt" "run-tests.sh" &&
  run_hooks "$fake_wt" "run-tests.sh" >/dev/null 2>&1
calls=$(wc -l < "$tmpdir/tgh-calls" | tr -d ' ')
if (( calls == 1 ))
then
  pass "hook_exists followed by run_hooks resolves the context once"
else
  fail "expected 1 lookup across hook_exists + run_hooks, got ${calls}"
fi

# ---------------------------------------------------------------------------
# ensure_repo_script migrates a legacy x. file to the context-derived path
# ---------------------------------------------------------------------------

run_test
_worktree_context=()
legacy_wt="$TIMVISHER_GIT_HOME/myorg/legacyrepo/feature/deep"
mkdir -p "$legacy_wt"
cat > "$legacy_wt/x.run-tests.sh" <<'LEGACY'
#!/usr/bin/env bash
echo legacy
LEGACY
REPO_HOOKS_DIR="$tmpdir/repo-hooks"
REPO_HOOKS_EXT_DIR="$tmpdir/ext-hooks"
mkdir -p "$REPO_HOOKS_DIR" "$REPO_HOOKS_EXT_DIR"
ensure_repo_script "$legacy_wt" "run-tests.sh" >/dev/null 2>&1
migrated="$REPO_HOOKS_DIR/myorg/legacyrepo/feature/deep/run-tests.sh"
if [[ -x $migrated ]]
then
  pass "ensure_repo_script migrates x. files to <main-owner>/<repo>/<branchPath>/"
else
  fail "legacy migration: expected '${migrated}'; tree: $(find "$REPO_HOOKS_DIR" -type f 2>/dev/null | tr '\n' ' ')"
fi

PATH=$saved_path

# ---------------------------------------------------------------------------
# run-tests convenience wraps hooks run run-tests.sh
# ---------------------------------------------------------------------------

run_test
rm -f "$marker"
out=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" run-tests 2>&1)
rc=$?
if (( rc == 0 )) && [[ -f $marker ]]
then
  pass "run-tests convenience executes the resolved run-tests.sh"
else
  fail "run-tests convenience: rc=$rc marker_exists=$( [[ -f $marker ]] && echo yes || echo no ) out='$out'"
fi

# ---------------------------------------------------------------------------
# hooks run: failing hook surfaces dev_ci_hook_failed
# ---------------------------------------------------------------------------

cat > "$hook_dir/run-tests.sh" <<'HOOK'
#!/usr/bin/env bash
echo "intentional failure" >&2
exit 7
HOOK
chmod +x "$hook_dir/run-tests.sh"

run_test
out=$(cd "$fake_wt" && PATH="$tmpdir/mockbin:$PATH" "$script" hooks run run-tests.sh 2>&1)
rc=$?
if (( rc != 0 )) && [[ $out == *'"code":"dev_ci_hook_failed"'* ]]
then
  pass "failing hook surfaces dev_ci_hook_failed JSON"
else
  fail "failing hook: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# Unknown top-level command
# ---------------------------------------------------------------------------

run_test
out=$("$script" totally-bogus 2>&1)
rc=$?
if (( rc != 0 )) &&
   [[ $out == *'"code":"dev_ci_unknown_command"'* ]] &&
   [[ $out == *"totally-bogus"* ]]
then
  pass "unknown command emits dev_ci_unknown_command JSON"
else
  fail "unknown command: rc=$rc out='$out'"
fi

# ---------------------------------------------------------------------------
# resolve_retire_merge_ref: soft forks measure "merged" against origin,
# regular forks against upstream.
# ---------------------------------------------------------------------------

# Use the real git (not the agent wrapper) for fixture setup.
test_git="$(brew --prefix)/bin/git"

# Load the script's functions by stripping the top-level dispatch.
rrmr_body=$(sed '/^case \${1:-} in$/,$ d' "$script")
eval "$rrmr_body"

# Build a bare-ish worktree fixture with the requested remote-tracking
# refs.  We fabricate refs/remotes/* directly so we don't need real
# remotes or network.  $1=dir, then name=target pairs:
#   origin/main upstream/main origin/HEAD=origin/main ...
make_ref_fixture() {
  local dir=$1; shift
  "$test_git" init "$dir" >/dev/null 2>&1
  "$test_git" -C "$dir" -c user.email=t@t -c user.name=t \
    -c core.hooksPath=/dev/null commit --allow-empty -m init >/dev/null 2>&1
  local head_sha; head_sha=$("$test_git" -C "$dir" rev-parse HEAD)
  local spec
  for spec in "$@"
  do
    if [[ $spec == *=* ]]
    then
      # symbolic ref: refs/remotes/<a>/HEAD -> refs/remotes/<b>
      "$test_git" -C "$dir" symbolic-ref "refs/remotes/${spec%%=*}" "refs/remotes/${spec#*=}"
    else
      "$test_git" -C "$dir" update-ref "refs/remotes/${spec}" "$head_sha"
    fi
  done
}

# soft fork -> origin (cookie present; upstream refs also exist but are ignored)
run_test
sf_wt="$tmpdir/rrmr_softfork"
make_ref_fixture "$sf_wt" origin/main upstream/main origin/HEAD=origin/main upstream/HEAD=upstream/main
touch "$sf_wt/x.timvisher_git.soft-fork"
rrmr_out=$(resolve_retire_merge_ref "$sf_wt")
if [[ $rrmr_out == "origin/main" ]]
then
  pass "resolve_retire_merge_ref: soft fork resolves to origin/<trunk>"
else
  fail "soft fork: expected 'origin/main', got '${rrmr_out}'"
fi

# regular fork -> upstream (no cookie)
