# A dev integration worktree on branch 'dev' tracking local 'main' (remote '.'
# avoids needing a real remote), plus one feature worktree per extra branch.
make_integrate_fixture() {
  local root=$1
  shift
  local repo="${root}/repo/dev"

  mkdir -p "$repo" || return 1
  "$test_git" init -q -b main "$repo" || return 1
  "$test_git" -C "$repo" config core.hooksPath /dev/null
  "$test_git" -C "$repo" config user.email t@t
  "$test_git" -C "$repo" config user.name t
  printf 'base\n' > "$repo/shared.txt"
  "$test_git" -C "$repo" add -A
  "$test_git" -C "$repo" commit -q -m base

  # 'dev' starts behind main so a successful integrate visibly moves it.
  "$test_git" -C "$repo" checkout -q -b dev
  "$test_git" -C "$repo" config branch.dev.remote .
  "$test_git" -C "$repo" config branch.dev.merge refs/heads/main

  touch "$repo/x.dev-integration-branch"
  : > "$repo/x.active-worktrees"

  local name content wt
  for name in "$@"
  do
    content=${name#*=}
    name=${name%%=*}
    wt="${root}/repo/${name}"
    "$test_git" -C "$repo" branch -q "$name" main
    "$test_git" -C "$repo" worktree add -q "$wt" "$name" || return 1
    printf '%s\n' "$content" > "$wt/shared.txt"
    "$test_git" -C "$wt" commit -q -am "$name"
    printf '%s\n' "$wt" >> "$repo/x.active-worktrees"
  done

  printf '%s\n' "$repo"
}

scratch_branches() {
  "$test_git" -C "$1" for-each-ref --format='%(refname:short)' \
    'refs/heads/x.dev-ci-integrate-*'
}

