# A dev integration worktree on branch 'dev' tracking local 'main' (remote '.'
# avoids needing a real remote), plus one feature worktree per extra branch.
make_integrate_fixture() {
  local root=$1
  shift
  local repo="${root}/repo/dev"

  mkdir -p "$repo" || return 1
  "$test_git" init -q -b main "$repo" || return 1
  "$test_git" -C "$repo" config core.hooksPath /dev/null
  "$test_git" -C "$repo" config user.email t@t
  "$test_git" -C "$repo" config user.name t
  printf 'base\n' > "$repo/shared.txt"
  "$test_git" -C "$repo" add -A
  "$test_git" -C "$repo" commit -q -m base

  # 'dev' starts behind main so a successful integrate visibly moves it.
  "$test_git" -C "$repo" checkout -q -b dev
  "$test_git" -C "$repo" config branch.dev.remote .
  "$test_git" -C "$repo" config branch.dev.merge refs/heads/main

  touch "$repo/x.dev-integration-branch"
  : > "$repo/x.active-worktrees"
  # The git wrapper latches this on its first call in a worktree with an
  # upstream, so every real dev worktree already has it.
  touch "$repo/x.upstream-configured"

  local name content wt
  for name in "$@"
  do
    content=${name#*=}
    name=${name%%=*}
    wt="${root}/repo/${name}"
    "$test_git" -C "$repo" branch -q "$name" main
    "$test_git" -C "$repo" worktree add -q "$wt" "$name" || return 1
    printf '%s\n' "$content" > "$wt/shared.txt"
    "$test_git" -C "$wt" commit -q -am "$name"
    printf '%s\n' "$wt" >> "$repo/x.active-worktrees"
  done

  printf '%s\n' "$repo"
}

scratch_branches() {
  "$test_git" -C "$1" for-each-ref --format='%(refname:short)' \
    'refs/heads/x.dev-ci-integrate/'
}

int_hooks="$ide_config/timvisher_dev_ci/hooks"
int_ntmux_log="$tmpdir/int-ntmux.log"

# Where ntmux3 puts a fixture's integration worktree.
int_worktree() {
  printf '%s/%s/repo/x.dev-ci-integrate/dev' "$fake_git_home_real" "$(basename "$1")"
}

# ntmux3 without tmux: an absolute path is ensure_session's call for an
# existing worktree; <org>/<repo>/<branch> <base> adds the worktree to the
# fixture's repository.
int_mock_ntmux3() {
  run_ntmux3() {
    printf '%s\n' "$*" >> "$int_ntmux_log"
    [[ $1 == -d ]] || return 1
    [[ $2 == /* ]] && return 0
    local org_repo=${2%%/x.dev-ci-integrate/*}
    "$test_git" -C "$TIMVISHER_GIT_HOME/$org_repo/dev" worktree add -q \
      -b "${2#"$org_repo"/}" "$TIMVISHER_GIT_HOME/$2" "$3"
  }
}

# HEAD, index and every file in the dev worktree except the status file the
# pipeline reports through.  The index is hashed before any git command here
# can refresh it.
dev_snapshot() {
  local d=$1 f
  shasum -a 256 < "$d/.git/index"
  "$test_git" -C "$d" symbolic-ref HEAD
  "$test_git" -C "$d" rev-parse HEAD
  "$test_git" -C "$d" ls-files -s
  (
    cd "$d" || exit 1
    find . -path ./.git -prune -o -type f ! -name x.dev-ci.status -print |
      LC_ALL=C sort |
      while IFS= read -r f
      do
        printf '%s ' "$f"
        shasum -a 256 < "$f"
      done
  )
}

reflog_count() {
  "$test_git" -C "$1" reflog show --format=%H "$2" -- 2>/dev/null | wc -l | tr -d ' '
}

# A post-integrate.sh at the fixture's repo rung that logs the toplevel it
# ran in and what dev's shared.txt held at that moment.
make_recording_post_integrate() {
  local org=$1 dev=$2 log=$3 rc=${4:-0}
  mkdir -p "$int_hooks/$org/repo"
  cat > "$int_hooks/$org/repo/post-integrate.sh" <<HOOK
#!/usr/bin/env bash
printf '%s|%s\n' "\$(git rev-parse --show-toplevel)" "\$(cat '$dev/shared.txt')" >> '$log'
exit $rc
HOOK
  chmod +x "$int_hooks/$org/repo/post-integrate.sh"
}

run_integrate() {
  (
    int_mock_ntmux3
    PATH="$tmpdir/mockbin:$PATH"
    cmd_integrate_local -C "$1"
  )
}

