# ---------------------------------------------------------------------------
# verification cache
# ---------------------------------------------------------------------------

vc_home="$tmpdir/vcstore"
VERIFIED_STORE="$vc_home"

# A worktree under $TIMVISHER_GIT_HOME with one committed file and a
# resolvable run-tests hook.
make_vc_fixture() {
  local org=$1 repo=$2 body=$3
  local wt="$TIMVISHER_GIT_HOME/$org/$repo/main"
  mkdir -p "$wt"
  "$test_git" init -q -b main "$wt"
  "$test_git" -C "$wt" config core.hooksPath /dev/null
  "$test_git" -C "$wt" config user.email t@t
  "$test_git" -C "$wt" config user.name t
  printf '%s\n' "$body" > "$wt/f.txt"
  "$test_git" -C "$wt" add -A
  "$test_git" -C "$wt" commit -q -m init
  printf '%s' "$wt"
}

vc_hook_dir="$REPO_HOOKS_EXT_DIR/vcorg/vcrepo"
mkdir -p "$vc_hook_dir"
printf '#!/usr/bin/env bash\nexit 0\n' > "$vc_hook_dir/run-tests.sh"
chmod +x "$vc_hook_dir/run-tests.sh"   # find_hooks only resolves executable hooks

vc_wt=$(make_vc_fixture vcorg vcrepo original)
_worktree_context=()
_worktree_context[$(worktree_context_key "$vc_wt")]=$(
  jq -n '{timvisher_git: {repo: "vcrepo", branchPath: "main"},
          timvisher_gh: {me: "vcorg", forkNetwork: {mainOwner: "vcorg"}}}')

# A dirty worktree is not cacheable: HEAD^{tree} would name content the
# tests did not run against.
run_test
vc_tree_clean=$(verifiable_tree "$vc_wt")
printf 'dirt\n' > "$vc_wt/untracked.txt"
vc_tree_dirty=$(verifiable_tree "$vc_wt" && echo CACHEABLE)
rm -f "$vc_wt/untracked.txt"
if [[ -n $vc_tree_clean ]] && [[ -z $vc_tree_dirty ]]
then
  pass "verifiable_tree: a tree when clean, nothing when dirty"
else
  fail "verifiable_tree: clean='${vc_tree_clean}' dirty='${vc_tree_dirty}'"
fi

# The same content under a rewritten history is the same work.
run_test
vc_key_before=$(verification_key "$(verification_key_inputs "$vc_wt" run-tests)")
"$test_git" -C "$vc_wt" commit -q --amend -m "same tree, new commit"
vc_key_after=$(verification_key "$(verification_key_inputs "$vc_wt" run-tests)")
if [[ -n $vc_key_before ]] && [[ $vc_key_before == "$vc_key_after" ]]
then
  pass "verification_key: unchanged by a commit that leaves the tree alone"
else
  fail "key across amend: before='${vc_key_before}' after='${vc_key_after}'"
fi

# Editing the hook is different work even though the tree did not move.
run_test
printf '#!/usr/bin/env bash\n# edited\nexit 0\n' > "$vc_hook_dir/run-tests.sh"
chmod +x "$vc_hook_dir/run-tests.sh"
vc_key_hook=$(verification_key "$(verification_key_inputs "$vc_wt" run-tests)")
if [[ $vc_key_hook != "$vc_key_after" ]]
then
  pass "verification_key: changes when the hook content changes"
else
  fail "key across hook edit: unchanged '${vc_key_hook}'"
fi

# A dependency moving underneath an unchanged consumer is different work.
run_test
vc_key_dep_a=$(verification_key "$(verification_key_inputs "$vc_wt" run-tests depkey-aaa)")
vc_key_dep_b=$(verification_key "$(verification_key_inputs "$vc_wt" run-tests depkey-bbb)")
if [[ $vc_key_dep_a != "$vc_key_dep_b" ]] && [[ $vc_key_dep_a != "$vc_key_hook" ]]
then
  pass "verification_key: a dependency key is part of the consumer's key"
else
  fail "dep keys: a='${vc_key_dep_a}' b='${vc_key_dep_b}' none='${vc_key_hook}'"
fi

# No resolvable hook means there is no "what was run" to record.
run_test
mv "$vc_hook_dir/run-tests.sh" "$vc_hook_dir/run-tests.sh.off"
vc_nohook=$(verification_key_inputs "$vc_wt" run-tests && echo CACHEABLE)
mv "$vc_hook_dir/run-tests.sh.off" "$vc_hook_dir/run-tests.sh"
if [[ -z $vc_nohook ]]
then
  pass "verification_key_inputs: refuses when no hook resolves"
else
  fail "no-hook: got '${vc_nohook}'"
fi

# Record then look up, and confirm layout B put it where it claims.
run_test
vc_inputs=$(verification_key_inputs "$vc_wt" run-tests)
vc_key=$(verification_key "$vc_inputs")
vc_tree=$(jq -r '.tree' <<<"$vc_inputs")
verified_record "$vc_wt" run-tests "$vc_inputs" 12
vc_expect="$vc_home/vcorg/vcrepo/run-tests/$vc_tree/$vc_key/vcorg_vcrepo_run-tests_${vc_key}.json"
if verified_lookup "$vc_wt" run-tests "$vc_inputs" && [[ -f $vc_expect ]]
then
  pass "verified_record/lookup: round-trips at <org>/<repo>/<tool>/<tree>/<key>"
else
  fail "record/lookup: hit=$(verified_lookup "$vc_wt" run-tests "$vc_inputs" && echo y || echo n) file=$([[ -f $vc_expect ]] && echo y || echo n)"
fi

# The entry must be able to explain and re-prove itself.
run_test
vc_recomputed=$(verification_key "$(jq -c '.key_inputs' "$vc_expect")")
if jq -e '.schema == 1 and .result == "pass" and .provenance.commit != ""' "$vc_expect" >/dev/null &&
   [[ $vc_recomputed == "$vc_key" ]]
then
  pass "verified entry: valid JSON whose key_inputs rehash to its own key"
else
  fail "entry self-check: recomputed='${vc_recomputed}' key='${vc_key}'"
fi

# A corrupted entry is a miss, never a green run.
run_test
cp "$vc_expect" "$vc_expect.bak"
printf '{"schema":1,"result":"pass","key":"deadbeef","key_inputs":{}}\n' > "$vc_expect"
vc_corrupt=$(verified_lookup "$vc_wt" run-tests "$vc_inputs" && echo HIT)
printf 'not json at all' > "$vc_expect"
vc_garbage=$(verified_lookup "$vc_wt" run-tests "$vc_inputs" && echo HIT)
mv "$vc_expect.bak" "$vc_expect"
if [[ -z $vc_corrupt ]] && [[ -z $vc_garbage ]]
then
  pass "verified_lookup: a tampered or unparseable entry is a miss"
else
  fail "corrupt handling: tampered='${vc_corrupt}' garbage='${vc_garbage}'"
fi

# The escape hatch has to work in both directions.
run_test
vc_bypass=$(TIMVISHER_DEV_CI_NO_MEMO=1 verified_lookup "$vc_wt" run-tests "$vc_inputs" && echo HIT)
if [[ -z $vc_bypass ]] && verified_lookup "$vc_wt" run-tests "$vc_inputs"
then
  pass "TIMVISHER_DEV_CI_NO_MEMO: bypasses a hit that is otherwise there"
else
  fail "no-memo: bypassed='${vc_bypass}'"
fi

# ls renders an entry, forget removes a scope, and neither can be talked
# into touching anything outside the store.
run_test
vc_ls=$(cmd_verified ls 2>/dev/null)
if [[ $vc_ls == *"vcorg/vcrepo"* ]] && [[ $vc_ls == *"run-tests"* ]]
then
  pass "verified ls: renders a cached entry"
else
  fail "verified ls: got '${vc_ls}'"
fi

run_test
mkdir -p "$tmpdir/vc-outside"
printf 'keep me\n' > "$tmpdir/vc-outside/sentinel"
vc_escape_rc=0
( cmd_verified forget ../vc-outside ) >/dev/null 2>&1 || vc_escape_rc=$?
if (( vc_escape_rc != 0 )) && [[ -f $tmpdir/vc-outside/sentinel ]]
then
  pass "verified forget: refuses a scope resolving outside the store, and deletes nothing"
else
  fail "verified forget escape: rc=${vc_escape_rc} sentinel=$([[ -f $tmpdir/vc-outside/sentinel ]] && echo intact || echo DELETED)"
fi

run_test
cmd_verified forget vcorg/vcrepo >/dev/null 2>&1
if [[ ! -d $vc_home/vcorg/vcrepo ]] &&
   ! verified_lookup "$vc_wt" run-tests "$vc_inputs"
then
  pass "verified forget: drops the scope so the next run re-verifies"
else
  fail "verified forget: dir=$([[ -d $vc_home/vcorg/vcrepo ]] && echo present || echo gone) hit=$(verified_lookup "$vc_wt" run-tests "$vc_inputs" && echo y || echo n)"
fi

# The pipeline resets whatever it is given to @{u}; a feature worktree must
# not be mistaken for a dev integration branch.
run_test
gd_feat="$TIMVISHER_GIT_HOME/gdorg/gdrepo/feature"
gd_dev="$TIMVISHER_GIT_HOME/gdorg/gdrepo/dev"
mkdir -p "$gd_feat" "$gd_dev"
touch "$gd_dev/x.dev-integration-branch"
gd_feat_rc=0
( assert_dev_integration_worktrees "$gd_feat" ) >/dev/null 2>&1 || gd_feat_rc=$?
gd_dev_rc=0
( assert_dev_integration_worktrees "$gd_dev" ) >/dev/null 2>&1 || gd_dev_rc=$?
if (( gd_feat_rc != 0 )) && (( gd_dev_rc == 0 ))
then
  pass "assert_dev_integration_worktrees: refuses a feature worktree, allows a marked one"
else
  fail "integration guard: feature rc=${gd_feat_rc} dev rc=${gd_dev_rc}"
fi

run_test
gd_out=$( ( assert_dev_integration_worktrees "$gd_feat" ) 2>&1 )
if [[ $gd_out == *dev_ci_run_not_integration_worktree* ]] &&
   [[ $gd_out == *"run-tests -C"* ]]
then
  pass "assert_dev_integration_worktrees: names a code and points at run-tests"
else
  fail "integration guard message: '${gd_out}'"
fi

# ---------------------------------------------------------------------------
# dependency farm
# ---------------------------------------------------------------------------

# A real git home with two orgs, one of which has a repo carrying both a
# trunk and a pinned branch.
fm_home="$TIMVISHER_GIT_HOME"
mkdir -p "$fm_home/fmorg/dep/main" "$fm_home/fmorg/dep/pinned" \
         "$fm_home/fmorg/other/main" "$fm_home/fmother/thing/main"
printf 'trunk\n'  > "$fm_home/fmorg/dep/main/marker"
printf 'pinned\n' > "$fm_home/fmorg/dep/pinned/marker"
printf 'other\n'  > "$fm_home/fmorg/other/main/marker"
printf 'thing\n'  > "$fm_home/fmother/thing/main/marker"
fm_root="$tmpdir/farm"

run_test
farm_build "$fm_root" "fmorg/dep/main=$fm_home/fmorg/dep/pinned"
fm_overridden=$(cat "$fm_root/fmorg/dep/main/marker" 2>/dev/null)
fm_sibling=$(cat "$fm_root/fmorg/other/main/marker" 2>/dev/null)
fm_otherorg=$(cat "$fm_root/fmother/thing/main/marker" 2>/dev/null || echo MISSING)
if [[ $fm_overridden == pinned ]] && [[ $fm_sibling == other ]] && [[ $fm_otherorg != MISSING ]]
then
  pass "farm_build: overrides one repo path, leaves siblings and other orgs reachable"
else
  fail "farm: overridden='${fm_overridden}' sibling='${fm_sibling}' otherorg='${fm_otherorg}'"
fi

# The override must not be written through a symlink into the real git home.
run_test
fm_real_trunk=$(cat "$fm_home/fmorg/dep/main/marker" 2>/dev/null)
if [[ $fm_real_trunk == trunk ]]
then
  pass "farm_build: the real git home is untouched by an override"
else
  fail "farm leaked into the real home: '${fm_real_trunk}'"
fi

# The whole mechanism rests on a farm path staying a farm path.
run_test
if farm_assert_preserves_symlinks "$fm_root" "fmorg/dep/main" "$fm_home/fmorg/dep/pinned"
then
  pass "farm_assert_preserves_symlinks: a logical cd keeps the farm path and lands on the pin"
else
  fail "farm symlink preservation: cd gave '$(cd "$fm_root/fmorg/dep/main" && pwd)'"
fi

# Rebuilding is idempotent, and dropping the override restores the trunk.
run_test
farm_build "$fm_root" "fmorg/dep/main=$fm_home/fmorg/dep/pinned"
fm_again=$(cat "$fm_root/fmorg/dep/main/marker" 2>/dev/null)
farm_build "$fm_root"
fm_cleared=$(cat "$fm_root/fmorg/dep/main/marker" 2>/dev/null)
if [[ $fm_again == pinned ]] && [[ $fm_cleared == trunk ]]
then
  pass "farm_build: rebuilds idempotently and clears an override when it is dropped"
else
  fail "farm rebuild: again='${fm_again}' cleared='${fm_cleared}'"
fi

# No overrides means no farm: the real git home already says the right thing.
run_test
if ! farm_required && farm_required "fmorg/dep/main=$fm_home/fmorg/dep/pinned"
then
  pass "farm_required: only when something is actually overridden"
else
  fail "farm_required: empty=$(farm_required && echo y || echo n) with=$(farm_required x=y && echo y || echo n)"
fi

# A missing target is a hard error, not a dangling symlink nobody notices.
run_test
fm_bad_rc=0
farm_build "$fm_root" "fmorg/dep/main=$tmpdir/does-not-exist" >/dev/null 2>&1 || fm_bad_rc=$?
if (( fm_bad_rc != 0 ))
then
  pass "farm_build: refuses an override whose target does not exist"
else
  fail "farm bad target: rc=${fm_bad_rc}"
fi

# run_hooks hands the farm to the hook and nothing else: resolution already
# happened against the real git home, which is what derives org/repo/branch.
run_test
fi_wt="$TIMVISHER_GIT_HOME/fiorg/firepo/main"
mkdir -p "$fi_wt"
"$test_git" init -q -b main "$fi_wt"
"$test_git" -C "$fi_wt" config core.hooksPath /dev/null
fi_hook_dir="$REPO_HOOKS_EXT_DIR/fiorg/firepo"
mkdir -p "$fi_hook_dir"
printf '#!/usr/bin/env bash\nprintf "GITHOME=%%s\\n" "${TIMVISHER_GIT_HOME:-<unset>}"\n' \
  > "$fi_hook_dir/run-tests.sh"
chmod +x "$fi_hook_dir/run-tests.sh"
_worktree_context[$(worktree_context_key "$fi_wt")]=$(
  jq -n '{timvisher_git: {repo: "firepo", branchPath: "main"},
          timvisher_gh: {me: "fiorg", forkNetwork: {mainOwner: "fiorg"}}}')

hook_git_home=''
fi_plain=$(run_hooks "$fi_wt" "run-tests.sh" 2>/dev/null | grep '^GITHOME=')
hook_git_home="$fm_root"
fi_farmed=$(run_hooks "$fi_wt" "run-tests.sh" 2>/dev/null | grep '^GITHOME=')
hook_git_home=''
fi_after=$(run_hooks "$fi_wt" "run-tests.sh" 2>/dev/null | grep '^GITHOME=')

if [[ $fi_plain == "GITHOME=${TIMVISHER_GIT_HOME}" ]] &&
   [[ $fi_farmed == "GITHOME=${fm_root}" ]] &&
   [[ $fi_after == "$fi_plain" ]]
then
  pass "run_hooks: a hook sees the farm when one is set, and the real home otherwise"
else
  fail "hook git home: plain='${fi_plain}' farmed='${fi_farmed}' after='${fi_after}'"
fi

# Resolution must not follow the farm: the worktree does not live there.
run_test
hook_git_home="$fm_root"
readarray -d '' -t fi_resolved < <(find_hooks "$fi_wt" "run-tests.sh")
hook_git_home=''
if (( 1 == ${#fi_resolved[@]} )) && [[ ${fi_resolved[0]} == "$fi_hook_dir/run-tests.sh" ]]
then
  pass "find_hooks: unaffected by a farm, since hooks are not addressed through it"
else
  fail "resolution under farm: found ${#fi_resolved[@]}: ${fi_resolved[*]}"
fi

# ---------------------------------------------------------------------------
# dependency pins
# ---------------------------------------------------------------------------

# A consumer whose hook reads a dependency the way the real ones do, through
# ${git_home}/<org>/<repo>/main, plus a dependency repo with a trunk and a
# pinned branch.
pn_wt="$TIMVISHER_GIT_HOME/pnorg/consumer/dev"
mkdir -p "$pn_wt"
"$test_git" init -q -b main "$pn_wt"
"$test_git" -C "$pn_wt" config core.hooksPath /dev/null
mkdir -p "$TIMVISHER_GIT_HOME/pndep/lib/main" "$TIMVISHER_GIT_HOME/pndep/lib/pinned"
printf 'trunk\n'  > "$TIMVISHER_GIT_HOME/pndep/lib/main/marker"
printf 'pinned\n' > "$TIMVISHER_GIT_HOME/pndep/lib/pinned/marker"

pn_hook_dir="$REPO_HOOKS_EXT_DIR/pnorg/consumer"
mkdir -p "$pn_hook_dir"
cat > "$pn_hook_dir/run-tests.sh" <<'HOOK'
#!/usr/bin/env bash
git_home=${TIMVISHER_GIT_HOME:-${HOME}/git}
printf 'DEP=%s\n' "$(cat "${git_home}/pndep/lib/main/marker" 2>/dev/null)"
HOOK
chmod +x "$pn_hook_dir/run-tests.sh"
_worktree_context[$(worktree_context_key "$pn_wt")]=$(
  jq -n '{timvisher_git: {repo: "consumer", branchPath: "dev"},
          timvisher_gh: {me: "pnorg", forkNetwork: {mainOwner: "pnorg"}}}')

# One pin becomes one override per branch directory of the pinned repo.
run_test
printf '# a comment\n\npndep/lib @ %s\n' "$TIMVISHER_GIT_HOME/pndep/lib/pinned" \
  > "$pn_wt/$DEPENDENCY_PINS_FILENAME"
readarray -t pn_ovr < <(dependency_pin_overrides "$pn_wt")
if (( 2 == ${#pn_ovr[@]} )) &&
   printf '%s\n' "${pn_ovr[@]}" | grep -qx "pndep/lib/main=$TIMVISHER_GIT_HOME/pndep/lib/pinned" &&
   printf '%s\n' "${pn_ovr[@]}" | grep -qx "pndep/lib/pinned=$TIMVISHER_GIT_HOME/pndep/lib/pinned"
then
  pass "dependency_pin_overrides: one pin covers every branch dir of the repo"
else
  fail "pin expansion: ${#pn_ovr[@]} -> ${pn_ovr[*]}"
fi

# The point of the whole thing: the consumer's hook reads the pinned tree.
run_test
_worktree_farm=()
hook_git_home=''
pn_pinned=$(run_hooks "$pn_wt" "run-tests.sh" 2>/dev/null | grep '^DEP=')
rm -f "$pn_wt/$DEPENDENCY_PINS_FILENAME"
_worktree_farm=()
hook_git_home=''
pn_unpinned=$(run_hooks "$pn_wt" "run-tests.sh" 2>/dev/null | grep '^DEP=')
hook_git_home=''
if [[ $pn_pinned == "DEP=pinned" ]] && [[ $pn_unpinned == "DEP=trunk" ]]
then
  pass "pins: a consumer's hook reads the pinned tree, and the trunk without a pin"
else
  fail "pin end-to-end: pinned='${pn_pinned}' unpinned='${pn_unpinned}'"
fi

# No pins means no farm at all, not an empty one.
run_test
_worktree_farm=()
pn_nofarm=$(worktree_farm "$pn_wt")
printf 'pndep/lib @ %s\n' "$TIMVISHER_GIT_HOME/pndep/lib/pinned" > "$pn_wt/$DEPENDENCY_PINS_FILENAME"
_worktree_farm=()
pn_farm=$(worktree_farm "$pn_wt")
if [[ -z $pn_nofarm ]] && [[ -n $pn_farm ]] && [[ -d $pn_farm ]]
then
  pass "worktree_farm: nothing without pins, a built farm with them"
else
  fail "worktree_farm: nofarm='${pn_nofarm}' farm='${pn_farm}'"
fi

# A malformed line is reported and skipped, not silently treated as a pin.
run_test
printf 'this line has no at-sign\npndep/lib @ %s\n' "$TIMVISHER_GIT_HOME/pndep/lib/pinned" \
  > "$pn_wt/$DEPENDENCY_PINS_FILENAME"
# Asserting on the warning itself is not possible here -- aictl is quiet in
# the harness -- so assert the behaviour: the bad line contributes nothing
# and the good one still expands.
readarray -t pn_ovr2 < <(dependency_pin_overrides "$pn_wt" 2>/dev/null)
if (( 2 == ${#pn_ovr2[@]} )) &&
   ! printf '%s\n' "${pn_ovr2[@]}" | grep -q 'no at-sign'
then
  pass "dependency_pin_overrides: a malformed line contributes nothing, good ones survive"
else
  fail "malformed pin: kept=${#pn_ovr2[@]} -> ${pn_ovr2[*]}"
fi

# A pin naming a repo with no worktrees would otherwise expand to nothing
# at all, which looks exactly like having no pin.
run_test
printf 'pndep/absent @ %s\n' "$TIMVISHER_GIT_HOME/pndep/lib/pinned" \
  > "$pn_wt/$DEPENDENCY_PINS_FILENAME"
readarray -t pn_absent < <(dependency_pin_overrides "$pn_wt" 2>/dev/null)
pn_absent_farm=''
_worktree_farm=()
pn_absent_farm=$(worktree_farm "$pn_wt")
rm -f "$pn_wt/$DEPENDENCY_PINS_FILENAME"
if (( 0 == ${#pn_absent[@]} )) && [[ -z $pn_absent_farm ]]
then
  pass "dependency_pin_overrides: a repo with no worktrees yields no override and no farm"
else
  fail "absent repo pin: overrides=${#pn_absent[@]} farm='${pn_absent_farm}'"
fi

# retire_merged_worktrees: a branch that has landed in its retirement ref
# should be commented out of x.active-worktrees.
run_test
rt_dev="$TIMVISHER_GIT_HOME/rtorg/rtrepo/dev"
rt_landed="$TIMVISHER_GIT_HOME/rtorg/rtrepo/landed"
rt_live="$TIMVISHER_GIT_HOME/rtorg/rtrepo/live"
mkdir -p "$rt_dev"
"$test_git" init -q -b main "$rt_dev"
"$test_git" -C "$rt_dev" config core.hooksPath /dev/null
"$test_git" -C "$rt_dev" config user.email t@t
"$test_git" -C "$rt_dev" config user.name t
"$test_git" -C "$rt_dev" commit -q --allow-empty -m base
"$test_git" -C "$rt_dev" branch -q landed
"$test_git" -C "$rt_dev" commit -q --allow-empty -m later
"$test_git" -C "$rt_dev" update-ref refs/remotes/origin/main "$("$test_git" -C "$rt_dev" rev-parse HEAD)"
"$test_git" -C "$rt_dev" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
"$test_git" -C "$rt_dev" branch -q live
"$test_git" -C "$rt_dev" worktree add -q "$rt_landed" landed
"$test_git" -C "$rt_dev" worktree add -q "$rt_live" live
"$test_git" -C "$rt_live" commit -q --allow-empty -m "not yet landed"
touch "$rt_dev/x.timvisher_git.soft-fork" "$rt_landed/x.timvisher_git.soft-fork" "$rt_live/x.timvisher_git.soft-fork"
printf '%s\n%s\n' "$rt_landed" "$rt_live" > "$rt_dev/x.active-worktrees"

declare -A dev_branches=(["$rt_dev"]="$rt_landed $rt_live")
declare -A all_worktrees=(["$rt_landed"]=1 ["$rt_live"]=1)
retire_merged_worktrees >/dev/null 2>&1

rt_landed_line=$(grep -cxF -- "$rt_landed" "$rt_dev/x.active-worktrees")
rt_landed_commented=$(grep -cxF -- "# $rt_landed" "$rt_dev/x.active-worktrees")
rt_live_line=$(grep -cxF -- "$rt_live" "$rt_dev/x.active-worktrees")

if (( rt_landed_line == 0 )) && (( rt_landed_commented == 1 )) && (( rt_live_line == 1 ))
then
  pass "retire_merged_worktrees: comments out a landed branch, keeps a live one"
else
  fail "retire: landed-live=${rt_landed_line} landed-commented=${rt_landed_commented} live=${rt_live_line}; file: $(tr '\n' '|' < "$rt_dev/x.active-worktrees")"
fi

# The real x.active-worktrees entries are in tilde form, and the real git
# home is under $HOME so ${wt/#$HOME/~} actually converts. The fixture above
# cannot exercise that: its git home is a tmpdir outside $HOME.
run_test
rt2_home="$HOME/git/rt2org/rt2repo"
rt2_dev="$rt2_home/dev"
rt2_landed="$rt2_home/timvisher/landed-with-slash"
mkdir -p "$rt2_dev"
"$test_git" init -q -b main "$rt2_dev"
"$test_git" -C "$rt2_dev" config core.hooksPath /dev/null
"$test_git" -C "$rt2_dev" config user.email t@t
"$test_git" -C "$rt2_dev" config user.name t
"$test_git" -C "$rt2_dev" commit -q --allow-empty -m base
"$test_git" -C "$rt2_dev" branch -q timvisher/landed-with-slash
"$test_git" -C "$rt2_dev" commit -q --allow-empty -m later
"$test_git" -C "$rt2_dev" update-ref refs/remotes/origin/main "$("$test_git" -C "$rt2_dev" rev-parse HEAD)"
"$test_git" -C "$rt2_dev" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
"$test_git" -C "$rt2_dev" worktree add -q "$rt2_landed" timvisher/landed-with-slash
touch "$rt2_dev/x.timvisher_git.soft-fork" "$rt2_landed/x.timvisher_git.soft-fork"

# written exactly as the real file does: tilde form
printf '~/git/rt2org/rt2repo/timvisher/landed-with-slash\n' > "$rt2_dev/x.active-worktrees"

declare -A dev_branches=(["$rt2_dev"]="$rt2_landed")
declare -A all_worktrees=(["$rt2_landed"]=1)
retire_merged_worktrees >/dev/null 2>&1

rt2_after=$(cat "$rt2_dev/x.active-worktrees")
if [[ $rt2_after == '# ~/git/rt2org/rt2repo/timvisher/landed-with-slash' ]]
then
  pass "retire_merged_worktrees: retires a tilde-form entry under \$HOME"
else
  fail "retire tilde form: file is '${rt2_after}'"
fi

# ---------------------------------------------------------------------------
# upstream baseline
# ---------------------------------------------------------------------------

# Two worktrees of one repo, plus a second repo, so the manifest has to key
# per repository rather than per worktree.
bl_a="$TIMVISHER_GIT_HOME/blorg/blrepo/dev"
bl_a2="$TIMVISHER_GIT_HOME/blorg/blrepo/feature"
bl_b="$TIMVISHER_GIT_HOME/blorg/other/dev"
mkdir -p "$bl_a" "$bl_b"
for d in "$bl_a" "$bl_b"
do
  "$test_git" init -q -b main "$d"
  "$test_git" -C "$d" config core.hooksPath /dev/null
  "$test_git" -C "$d" config user.email t@t
  "$test_git" -C "$d" config user.name t
  "$test_git" -C "$d" commit -q --allow-empty -m base
  "$test_git" -C "$d" update-ref refs/remotes/origin/main "$("$test_git" -C "$d" rev-parse HEAD)"
  "$test_git" -C "$d" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
  "$test_git" -C "$d" update-ref refs/remotes/upstream/main "$("$test_git" -C "$d" rev-parse HEAD)"
  "$test_git" -C "$d" symbolic-ref refs/remotes/upstream/HEAD refs/remotes/upstream/main
done
"$test_git" -C "$bl_a" branch -q feature
"$test_git" -C "$bl_a" worktree add -q "$bl_a2" feature

run_test
# Assigned straight to the global the other functions read: command
# substitution runs baseline_establish in a subshell, so the global it sets
# for itself cannot reach this shell.
baseline_file=$(baseline_establish "$bl_a" "$bl_a2" "$bl_b")
bl_file=$baseline_file
bl_repos=$(jq -r '.repos | length' "$bl_file" 2>/dev/null)
if [[ -f $bl_file ]] && (( bl_repos == 2 ))
then
  pass "baseline_establish: one entry per repository, not per worktree"
else
  fail "baseline repos: file='${bl_file}' repos=${bl_repos}"
fi

run_test
bl_a_sha=$("$test_git" -C "$bl_a" rev-parse origin/main)
if [[ $(baseline_commit "$bl_a" origin) == "$bl_a_sha" ]] &&
   [[ $(baseline_commit "$bl_a2" origin) == "$bl_a_sha" ]] &&
   [[ $(baseline_ref "$bl_a" origin) == origin/main ]]
then
  pass "baseline_commit: both worktrees of a repo read the same recorded commit"
else
  fail "baseline_commit: dev='$(baseline_commit "$bl_a" origin)' feature='$(baseline_commit "$bl_a2" origin)' expected='${bl_a_sha}'"
fi

# The point of the whole thing: upstream moving after the baseline must not
# change what the run targets.
run_test
"$test_git" -C "$bl_a" commit -q --allow-empty -m "upstream moved after the baseline"
"$test_git" -C "$bl_a" update-ref refs/remotes/origin/main "$("$test_git" -C "$bl_a" rev-parse HEAD)"
bl_moved=$("$test_git" -C "$bl_a" rev-parse origin/main)
if [[ $bl_moved != "$bl_a_sha" ]] && [[ $(baseline_commit "$bl_a" origin) == "$bl_a_sha" ]]
then
  pass "baseline_commit: still the pinned commit after origin moves"
else
  fail "baseline drift: ref now '${bl_moved}', baseline says '$(baseline_commit "$bl_a" origin)'"
fi

# No baseline means fall back to live refs rather than failing, so a partial
# rollout degrades to today's behaviour.
run_test
bl_saved=$baseline_file
baseline_file=''
bl_none=$(TIMVISHER_DEV_CI_BASELINE='' baseline_commit "$bl_a" origin && echo FOUND)
baseline_file=$bl_saved
if [[ -z $bl_none ]]
then
  pass "baseline_commit: reports nothing when no baseline was established"
else
  fail "baseline fallback: got '${bl_none}'"
fi

# A repo with no upstream remote records an empty upstream, not a bogus one.
run_test
bl_noup="$TIMVISHER_GIT_HOME/blorg/noupstream/dev"
mkdir -p "$bl_noup"
"$test_git" init -q -b main "$bl_noup"
"$test_git" -C "$bl_noup" config core.hooksPath /dev/null
"$test_git" -C "$bl_noup" config user.email t@t
"$test_git" -C "$bl_noup" config user.name t
"$test_git" -C "$bl_noup" commit -q --allow-empty -m base
baseline_establish "$bl_noup" >/dev/null
if ! baseline_commit "$bl_noup" upstream >/dev/null 2>&1
then
  pass "baseline_establish: a repo without an upstream remote records none"
else
  fail "baseline no-upstream: got '$(baseline_commit "$bl_noup" upstream)'"
fi
baseline_file=$bl_saved

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

mock_finish || (( failures += 1 ))

echo
echo "Tests: $tests, Failures: $failures"
exit $failures
