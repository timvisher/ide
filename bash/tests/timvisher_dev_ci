      reset_dev_worktree_to_upstream "$guard_wt") >/dev/null 2>&1 &&
   [[ $("$test_git" -C "$guard_wt" rev-parse HEAD) == "$guard_upstream_head" ]]
then
  pass "reset_dev_worktree_to_upstream: resets a marked worktree to @{u}"
else
  fail "reset_dev_worktree_to_upstream did not reset a marked worktree: head=$("$test_git" -C "$guard_wt" rev-parse HEAD) want=$guard_upstream_head"
fi
rm -f "$guard_wt/x.dev-integration-branch"
"$test_git" -C "$guard_wt" reset -q --hard "$guard_head"

run_test
reset_sites=$(awk '
  /^[A-Za-z_][A-Za-z0-9_]*\(\) *\{/ { fn = $1; sub(/\(\).*/, "", fn) }
  /^}/ { fn = "" }
  /^[[:space:]]*#/ { next }
  /(^|[;&|!(]|then|do)[[:space:]]*(command[[:space:]]+)?git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+reset([[:space:]]|$)/ {
    printf "%d:%s\n", NR, (fn == "" ? "<top-level>" : fn)
  }
' "$script")
if [[ $reset_sites == +([0-9]):reset_dev_worktree_to_upstream ]]
then
  pass "git reset runs only in reset_dev_worktree_to_upstream"
else
  fail "git reset must run only in reset_dev_worktree_to_upstream; found: $(tr '\n' ' ' <<<"$reset_sites")"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

echo
echo "Tests: $tests, Failures: $failures"
exit $failures
