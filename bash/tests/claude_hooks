#!/usr/bin/env bash

# Tests for the Stop hooks under ai/claude/HOME/.claude/hooks/.
# Covers positive (should-block) and negative (should-pass) cases for
# pattern-based hooks. Each test feeds a synthetic transcript through
# the hook and checks whether `decision: "block"` is emitted.

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

repo_root="$(cd "$(dirname "$0")/.." && pwd)/.."
hooks_dir="${repo_root}/ai/claude/HOME/.claude/hooks"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

tp="$tmpdir/transcript.jsonl"
input_file="$tmpdir/input.json"

# Run a hook with the given assistant text. Returns the hook's stdout.
run_hook() {
  local hook=$1
  local text=$2
  local stop_active=${3:-false}

  # Use jq to safely build the transcript JSON regardless of quoting.
  jq -nc --arg t "$text" '{type:"assistant",message:{content:[{type:"text",text:$t}]}}' > "$tp"
  jq -nc --arg p "$tp" --argjson sa "$stop_active" \
    '{transcript_path:$p, stop_hook_active:$sa}' > "$input_file"

  "${hooks_dir}/${hook}" < "$input_file"
}

assert_blocks() {
  local hook=$1 text=$2 label=$3
  run_test
  result=$(run_hook "$hook" "$text")
  if [[ -n $result ]] && printf '%s' "$result" | jq -e '.decision == "block"' >/dev/null
  then
    pass "$label"
  else
    fail "$label — expected block, got: '${result}'"
  fi
}

assert_passes() {
  local hook=$1 text=$2 label=$3
  run_test
  result=$(run_hook "$hook" "$text")
  if [[ -z $result ]]
  then
    pass "$label"
  else
    fail "$label — expected pass, got: '${result}'"
  fi
}

# ---------------------------------------------------------------------------
# no-push-stop.sh
# ---------------------------------------------------------------------------

# Asking permission
assert_blocks no-push-stop.sh "Should I push?" \
  "no-push: blocks 'should I push?'"
assert_blocks no-push-stop.sh "Want me to push?" \
  "no-push: blocks 'want me to push?'"
assert_blocks no-push-stop.sh "All set. Ready to push when you are." \
  "no-push: blocks 'ready to push'"

# Declarative
assert_blocks no-push-stop.sh "I'll push the branch now." \
  "no-push: blocks 'I will push'"
assert_blocks no-push-stop.sh "Let me push these commits." \
  "no-push: blocks 'let me push'"

# Announce-then-defer (the case from the live transcript)
assert_blocks no-push-stop.sh \
  "I haven't pushed — flagging since you have a wip commit underneath." \
  "no-push: blocks 'haven't pushed —' announcement"
assert_blocks no-push-stop.sh \
  "let me know if you want this rebased/pushed somewhere" \
  "no-push: blocks 'rebased/pushed somewhere' offer"

# Plan/list items
assert_blocks no-push-stop.sh "$(printf '1. Build\n2. Test\n3. Push to origin')" \
  "no-push: blocks numbered '3. Push' plan item"
assert_blocks no-push-stop.sh "Then push to origin." \
  "no-push: blocks 'Then push'"

# False-positive checks (must PASS)
assert_passes no-push-stop.sh "I haven't pushed it to the array yet." \
  "no-push: passes 'haven't pushed it to the array' (array.push prose)"
assert_passes no-push-stop.sh "I pushed somewhere earlier in the function." \
  "no-push: passes 'pushed somewhere' (function-flow prose)"
assert_passes no-push-stop.sh "If you want push notifications, install the app." \
  "no-push: passes 'push notifications'"
assert_passes no-push-stop.sh "We can use array.push to add items." \
  "no-push: passes 'array.push' technical prose"

# Loop guard — when stop_hook_active=true, the hook must stay silent
# even on a normally-blocking phrase. Without this the harness would
# loop on the rule injection.
run_test
result=$(run_hook no-push-stop.sh "Should I push?" true)
if [[ -z $result ]]
then
  pass "no-push: silent on second-stop loop guard"
else
  fail "no-push: loop guard didn't suppress: '${result}'"
fi

# ---------------------------------------------------------------------------
# no-stalling-stop.sh
# ---------------------------------------------------------------------------

# Ownership dodging
assert_blocks no-stalling-stop.sh \
  "This is a pre-existing bug; not from my recent changes." \
  "no-stalling: blocks 'pre-existing bug … not from'"
assert_blocks no-stalling-stop.sh \
  "That's an existing issue we should triage separately." \
  "no-stalling: blocks dismissive 'existing issue'"

# Session-length self-stopping
assert_blocks no-stalling-stop.sh "This session has gotten long; let me wrap up." \
  "no-stalling: blocks 'session has gotten long'"
assert_blocks no-stalling-stop.sh "Good place to stop for now." \
  "no-stalling: blocks 'good place to stop'"

# Permission-seeking
assert_blocks no-stalling-stop.sh "Should I commit?" \
  "no-stalling: blocks 'should I commit?'"
assert_blocks no-stalling-stop.sh "Want me to keep going?" \
  "no-stalling: blocks 'want me to keep going?'"

# False-positive checks
assert_passes no-stalling-stop.sh \
  "The pre-existing API contract requires this field." \
  "no-stalling: passes 'pre-existing API contract' prose"
assert_passes no-stalling-stop.sh \
  "I've filed an existing issue on GitHub for this." \
  "no-stalling: passes 'an existing issue on GitHub'"
assert_passes no-stalling-stop.sh \
  "This list is getting long; will trim it." \
  "no-stalling: passes 'list is getting long'"
assert_passes no-stalling-stop.sh "Is there a typo in this commit?" \
  "no-stalling: passes 'a typo in this commit?'"
assert_passes no-stalling-stop.sh \
  "We could rebase the commit, or revert it." \
  "no-stalling: passes 'rebase the commit, or revert'"

# ---------------------------------------------------------------------------
# worktree-lock-pretool.sh + worktree-lock-sessionend.sh
# ---------------------------------------------------------------------------
#
# These hooks are not pattern-based — they manage filesystem locks
# under ~/.claude/locks/<slug>/ keyed by session_id. Each test gets a
# fresh temp git worktree and a clean lockdir so cases don't bleed.
# Lockdirs go under $tmpdir (not the real $HOME) by overriding HOME
# for the hook invocation.

# Use a sandboxed HOME so tests never touch the user's real lockdir.
# The repo's git wrapper sources $HOME/.functions/logging.bash, so the
# test HOME has to expose that path or the wrapper bails before the
# hook ever sees the input. Symlink the user's real .functions in.
wlock_home="$tmpdir/home"
mkdir -p "$wlock_home/.claude/locks"
[[ -d $HOME/.functions ]] && ln -sf "$HOME/.functions" "$wlock_home/.functions"

wlock_slug() { printf '%s' "${1//\//-}"; }
wlock_lockdir() { printf '%s/.claude/locks/%s' "$wlock_home" "$(wlock_slug "$1")"; }

wlock_init_worktree() {
  # Initializes a worktree at the given path and prints its
  # canonical-path form. macOS $TMPDIR resolves through /private/...,
  # and `git rev-parse --show-toplevel` returns the resolved form, so
  # the hook's lock slug derives from the resolved path. Tests must
  # use the same form when computing expected lockdirs.
  local wt=$1
  rm -rf -- "$wt"
  mkdir -p "$wt"
  git -C "$wt" init -q
  touch "$wt/transcript.jsonl"
  ( cd "$wt" && pwd -P )
}

wlock_input() {
  local sess=$1 tp=$2 tool=$3 path=$4 key=${5:-file_path}
  if [[ -z $path ]]
  then
    jq -nc --arg s "$sess" --arg tp "$tp" --arg t "$tool" \
      '{session_id:$s, transcript_path:$tp, tool_name:$t, tool_input:{}}'
  else
    jq -nc --arg s "$sess" --arg tp "$tp" --arg t "$tool" \
      --arg p "$path" --arg k "$key" \
      '{session_id:$s, transcript_path:$tp, tool_name:$t,
        tool_input: {($k): $p}}'
  fi
}

wlock_run_pre() { HOME="$wlock_home" "${hooks_dir}/worktree-lock-pretool.sh"; }
wlock_run_end() { HOME="$wlock_home" "${hooks_dir}/worktree-lock-sessionend.sh"; }

WT_A=$(wlock_init_worktree "$tmpdir/wt-A")
WT_B=$(wlock_init_worktree "$tmpdir/wt-B")
LOCK_A="$(wlock_lockdir "$WT_A")"
LOCK_B="$(wlock_lockdir "$WT_B")"

# T1: fresh acquire — empty stdout, owner.json names sess-A.
run_test
out=$(printf '%s' "$(wlock_input sess-A "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre)
if [[ -z $out ]] \
  && [[ -e "$LOCK_A/active/owner.json" ]] \
  && [[ $(jq -r .session_id "$LOCK_A/active/owner.json") == sess-A ]]
then
  pass "wlock-pre: fresh Edit acquires; owner=sess-A"
else
  fail "wlock-pre: fresh acquire — out='$out' owner=$(cat "$LOCK_A/active/owner.json" 2>/dev/null)"
fi

# T2: reentrant by same session — silent allow.
run_test
out=$(printf '%s' "$(wlock_input sess-A "$WT_A/transcript.jsonl" Write "$WT_A/g.txt")" | wlock_run_pre)
if [[ -z $out ]] \
  && [[ $(jq -r .session_id "$LOCK_A/active/owner.json") == sess-A ]]
then
  pass "wlock-pre: reentrant by sess-A"
else
  fail "wlock-pre: reentrant — expected silent, got '$out'"
fi

# T3: contention by other session, owner live → deny JSON.
run_test
out=$(printf '%s' "$(wlock_input sess-B "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre)
if printf '%s' "$out" | jq -e '.hookSpecificOutput.permissionDecision == "deny"' >/dev/null
then
  pass "wlock-pre: contention denies sess-B"
else
  fail "wlock-pre: contention — expected deny JSON, got '$out'"
fi

# T4: stale transcript → other session reclaims.
run_test
touch -d '2020-01-01' "$WT_A/transcript.jsonl"
out=$(printf '%s' "$(wlock_input sess-B "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre)
if [[ -z $out ]] \
  && [[ $(jq -r .session_id "$LOCK_A/active/owner.json") == sess-B ]]
then
  pass "wlock-pre: sess-B reclaims stale-transcript lock"
else
  fail "wlock-pre: stale reclaim — out='$out' owner=$(jq -r .session_id "$LOCK_A/active/owner.json" 2>/dev/null)"
fi

# T5: missing transcript → reclaim.
run_test
touch "$WT_A/transcript.jsonl"
printf '%s' "$(wlock_input sess-B "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre >/dev/null  # ensure sess-B holds
rm -f "$WT_A/transcript.jsonl"
out=$(printf '%s' "$(wlock_input sess-A "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre)
if [[ -z $out ]] \
  && [[ $(jq -r .session_id "$LOCK_A/active/owner.json") == sess-A ]]
then
  pass "wlock-pre: sess-A reclaims missing-transcript lock"
else
  fail "wlock-pre: missing-transcript reclaim — owner=$(jq -r .session_id "$LOCK_A/active/owner.json" 2>/dev/null)"
fi

# T6: cross-worktree — Edit anchored on file's worktree, not cwd's.
run_test
touch "$WT_A/transcript.jsonl"
out=$(printf '%s' "$(wlock_input sess-C "$WT_A/transcript.jsonl" Edit "$WT_B/f.txt")" | wlock_run_pre)
if [[ -z $out ]] \
  && [[ -e "$LOCK_B/active/owner.json" ]] \
  && [[ $(jq -r .session_id "$LOCK_B/active/owner.json") == sess-C ]]
then
  pass "wlock-pre: cross-worktree Edit locks target's worktree"
else
  fail "wlock-pre: cross-worktree — expected lock on WT_B; got out='$out' owner=$(jq -r .session_id "$LOCK_B/active/owner.json" 2>/dev/null)"
fi

# T7: NotebookEdit anchors on tool_input.notebook_path.
run_test
WT_NB=$(wlock_init_worktree "$tmpdir/wt-nb")
LOCK_NB="$(wlock_lockdir "$WT_NB")"
out=$(printf '%s' "$(wlock_input sess-D "$WT_NB/transcript.jsonl" NotebookEdit "$WT_NB/x.ipynb" notebook_path)" | wlock_run_pre)
if [[ -z $out ]] \
  && [[ $(jq -r .session_id "$LOCK_NB/active/owner.json") == sess-D ]]
then
  pass "wlock-pre: NotebookEdit anchors on notebook_path"
else
  fail "wlock-pre: NotebookEdit — owner=$(jq -r .session_id "$LOCK_NB/active/owner.json" 2>/dev/null)"
fi

# T8: outside-repo target — no lock attempted.
run_test
WT_OUT="$tmpdir/not-a-repo"
mkdir -p "$WT_OUT"
LOCK_OUT="$(wlock_lockdir "$WT_OUT")"
out=$(printf '%s' "$(wlock_input sess-E "$WT_A/transcript.jsonl" Edit "$WT_OUT/orphan.txt")" | wlock_run_pre)
if [[ -z $out ]] && [[ ! -e "$LOCK_OUT/active" ]]
then
  pass "wlock-pre: outside-repo target no-ops"
else
  fail "wlock-pre: outside-repo — out='$out' lock=$(ls "$LOCK_OUT/active" 2>/dev/null)"
fi

# T9: missing tool_input.file_path → no-op.
run_test
out=$(printf '%s' "$(wlock_input sess-F "$WT_A/transcript.jsonl" Edit '')" | wlock_run_pre)
if [[ -z $out ]]
then
  pass "wlock-pre: missing file_path no-ops"
else
  fail "wlock-pre: missing file_path — got '$out'"
fi

# T10: unmatched tool name (Read) → no-op even when matcher fired.
run_test
out=$(printf '%s' "$(wlock_input sess-G "$WT_A/transcript.jsonl" Read "$WT_A/f.txt")" | wlock_run_pre)
if [[ -z $out ]]
then
  pass "wlock-pre: non-mutating tool name no-ops"
else
  fail "wlock-pre: Read tool — got '$out'"
fi

# T11: SessionEnd by non-owner — lock untouched.
run_test
# Reset: sess-A holds WT_A.
rm -rf -- "$LOCK_A/active"
printf '%s' "$(wlock_input sess-A "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre >/dev/null
end_in=$(jq -nc '{session_id: "sess-not-owner"}')
printf '%s' "$end_in" | wlock_run_end
if [[ -e "$LOCK_A/active/owner.json" ]] \
  && [[ $(jq -r .session_id "$LOCK_A/active/owner.json") == sess-A ]]
then
  pass "wlock-end: non-owner SessionEnd is a no-op"
else
  fail "wlock-end: non-owner SessionEnd evicted owner"
fi

# T12: SessionEnd by owner — releases.
run_test
end_in=$(jq -nc '{session_id: "sess-A"}')
printf '%s' "$end_in" | wlock_run_end
if [[ ! -e "$LOCK_A/active" ]]
then
  pass "wlock-end: owner SessionEnd releases the lock"
else
  fail "wlock-end: owner SessionEnd left active/ behind"
fi

# T13: SessionEnd scans every lockdir — one session can hold multiple.
run_test
# Reset both lockdirs so sess-X starts from a clean slate; previous
# tests may have left WT_B owned by another session.
rm -rf -- "$LOCK_A/active" "$LOCK_B/active"
printf '%s' "$(wlock_input sess-X "$WT_A/transcript.jsonl" Edit "$WT_A/f.txt")" | wlock_run_pre >/dev/null
printf '%s' "$(wlock_input sess-X "$WT_A/transcript.jsonl" Edit "$WT_B/f.txt")" | wlock_run_pre >/dev/null
if [[ ! -e "$LOCK_A/active/owner.json" ]] || [[ ! -e "$LOCK_B/active/owner.json" ]] \
  || [[ $(jq -r .session_id "$LOCK_A/active/owner.json") != sess-X ]] \
  || [[ $(jq -r .session_id "$LOCK_B/active/owner.json") != sess-X ]]
then
  fail "wlock-end: setup — sess-X did not acquire both worktrees"
else
  end_in=$(jq -nc '{session_id: "sess-X"}')
  printf '%s' "$end_in" | wlock_run_end
  if [[ ! -e "$LOCK_A/active" ]] && [[ ! -e "$LOCK_B/active" ]]
  then
    pass "wlock-end: owner SessionEnd releases all held worktrees"
  else
    fail "wlock-end: multi-worktree release left $(ls -d "$LOCK_A/active" "$LOCK_B/active" 2>/dev/null)"
  fi
fi

echo ""
echo "Results: $((tests - failures))/${tests} passed"

if (( 0 < failures ))
then
  exit 1
fi
