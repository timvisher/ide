#!/usr/bin/env bash
# shellcheck disable=SC2088

# Tests for ntmux3__session_name_from_path (bash/functions/tmux.bash).
#
# Covers alias resolution: file-level aliases (which beat all other
# rules), ~/git/ prefix, directory-level aliases (exact match and
# subpath suffix), $HOME-relative fallback, symlink canonicalization
# of input and alias keys, bare-filename inputs, and ~/git as a symlink.

failures=0
tests=0

fail() {
  echo "FAIL: $1" >&2
  ((failures++)) || true
}

pass() {
  echo "PASS: $1"
}

run_test() {
  ((tests++)) || true
}

tests_dir="$(cd "$(dirname "$0")" && pwd)" || exit 1
source "${tests_dir}/lib/timvisher_tests.bash" || exit 1
funcs_dir="$(cd "${tests_dir}/../functions" && pwd)" || exit 1

tmpdir=
trap '[[ -z $tmpdir ]] || rm -rf -- "$tmpdir"' EXIT
tmpdir=$(mktemp -d) || { echo 'mktemp failed' >&2; exit 1; }

# Build the directory layout the function inspects in the runner's HOME.
fake_home=$HOME
if [[ -L ${fake_home}/.config/timvisher/ide ]]
then
  rm -- "${fake_home}/.config/timvisher/ide" || {
    echo "FAIL: setup unlink" >&2
    exit 1
  }
fi
mkdir -p \
  "${fake_home}/git/timvisher/ide/main" \
  "${fake_home}/Documents/datadog" \
  "${fake_home}/Documents/datadog/projects/foo" \
  "${fake_home}/.config/timvisher/ide" \
  "${fake_home}/real-target" || {
    echo "FAIL: setup mkdir" >&2
    exit 1
  }
touch "${fake_home}/Documents/datadog/todo.org" \
  "${fake_home}/git/timvisher/ide/main/CLAUDE.md" \
  "${fake_home}/real-target/file.org" || {
    echo "FAIL: setup touch" >&2
    exit 1
  }

# Symlink ~/symlinked-target -> ~/real-target so we can test canonical
# path matching when the input traverses a symlink.
ln -s "${fake_home}/real-target" "${fake_home}/symlinked-target" || {
  echo "FAIL: setup ln" >&2
  exit 1
}

cat > "${fake_home}/.config/timvisher/ide/ntmux3_path_aliases" <<EOF
# Comments and blank lines should be ignored.

~/Documents/datadog/todo.org=timvisher/todo
~/Documents/datadog=DataDog
~/git/timvisher/ide/main/CLAUDE.md=ide-claude-md
~/real-target/file.org=real-target-file
EOF

run_case() {
  local input=$1
  (
    shopt -s extglob
    source "${funcs_dir}/tmux.bash"
    ntmux3__session_name_from_path "$input"
  )
}

assert_eq() {
  local label=$1 expected=$2 actual=$3
  if [[ $actual == "$expected" ]]
  then
    pass "$label"
  else
    fail "$label: expected '${expected}', got '${actual}'"
  fi
}

# --- File-level alias precedence ---

# Test: file-level alias beats directory-level alias
run_test
assert_eq "file-level alias wins over dir alias" \
  "timvisher/todo" \
  "$(run_case "${fake_home}/Documents/datadog/todo.org")"

# Test: file-level alias beats ~/git/ prefix (most-specific wins)
run_test
assert_eq "file-level alias wins over ~/git/ prefix" \
  "ide-claude-md" \
  "$(run_case "${fake_home}/git/timvisher/ide/main/CLAUDE.md")"

# Test: input through a symlink resolves to canonical path and matches
# a file-level alias keyed under the real target.
run_test
assert_eq "symlinked input matches alias on canonical path" \
  "real-target-file" \
  "$(run_case "${fake_home}/symlinked-target/file.org")"

# --- Directory-level aliases ---

# Test: directory-level alias still works when a directory is passed
run_test
assert_eq "dir-level alias for parent dir" \
  "DataDog" \
  "$(run_case "${fake_home}/Documents/datadog")"

# Test: directory-level alias resolves subpath suffix
run_test
assert_eq "dir-level alias subpath suffix" \
  "DataDog/projects/foo" \
  "$(run_case "${fake_home}/Documents/datadog/projects/foo")"

# --- ~/git/ prefix ---

# Test: ~/git/ prefix wins when no alias matches
run_test
assert_eq "~/git/ prefix" \
  "timvisher/ide/main" \
  "$(run_case "${fake_home}/git/timvisher/ide/main")"

# Test: file under ~/git/ with no file-level alias falls back to
# ~/git/ prefix (filename is dropped because the prefix only knows
# about directories).
run_test
touch "${fake_home}/git/timvisher/ide/main/README.md"
assert_eq "~/git/ file with no file-alias falls back to ~/git/ prefix" \
  "timvisher/ide/main" \
  "$(run_case "${fake_home}/git/timvisher/ide/main/README.md")"

# --- Fallbacks ---

# Test: $HOME-relative fallback for unaliased path
run_test
mkdir -p "${fake_home}/random/elsewhere"
assert_eq "\$HOME-relative fallback" \
  "random/elsewhere" \
  "$(run_case "${fake_home}/random/elsewhere")"

# Test: nonexistent path returns failure
run_test
output=$(run_case "${fake_home}/does/not/exist" 2>&1) && rc=0 || rc=$?
if (( rc == 1 ))
then
  pass "nonexistent path returns 1"
else
  fail "nonexistent path: rc=${rc} output='${output}'"
fi

# --- ntmux3__resolve_session_name (shared resolver) ---
#
# The resolver is what both the managed-worktree path and the
# existing-repo/open path call, so an existing foreign repo is named by
# exactly the same rules as a managed worktree.  It delegates to
# ntmux3__session_name_from_path and only adds a basename fallback when
# that returns nothing (paths outside $HOME).
run_resolve() {
  (
    shopt -s extglob
    source "${funcs_dir}/tmux.bash"
    ntmux3__resolve_session_name "$@"
  )
}

# Delegates to the ~/git/ prefix rule — identical to the managed path.
run_test
assert_eq "resolver: ~/git/ path uses session_name_from_path" \
  "timvisher/ide/main" \
  "$(run_resolve "${fake_home}/git/timvisher/ide/main")"

# Delegates to the \$HOME-relative rule for an unaliased path under \$HOME.
run_test
assert_eq "resolver: \$HOME-relative path delegates" \
  "random/elsewhere" \
  "$(run_resolve "${fake_home}/random/elsewhere")"

# A path entirely outside \$HOME has no session_name_from_path match, so
# the resolver falls back to basename (this is the behavior the open path
# previously had inline; now shared with the managed path).  The dir lives
# under tmpdir but outside fake_home, so it is genuinely outside \$HOME.
run_test
mkdir -p "${tmpdir}/outside/elsewhere"
assert_eq "resolver: out-of-\$HOME path falls back to basename" \
  "elsewhere" \
  "$(run_resolve "${tmpdir}/outside/elsewhere")"

# --- ~/git as a symlink to another volume ---
sym_home="${tmpdir}/sym-home"
sym_vol_git="${tmpdir}/Volumes/Dev/git"
mkdir -p "$sym_home" "${sym_vol_git}/timvisher/ide/main" || {
  echo "FAIL: setup symlinked ~/git" >&2
  exit 1
}
ln -s "$sym_vol_git" "${sym_home}/git" || {
  echo "FAIL: setup symlinked ~/git ln" >&2
  exit 1
}

run_sym() {
  local fn=$1
  shift
  # shellcheck disable=SC2016
  timvisher_tests_with_home "$sym_home" bash -c '
    shopt -s extglob
    source "$1/tmux.bash"
    fn=$2
    shift 2
    "$fn" "$@"
  ' _ "$funcs_dir" "$fn" "$@"
}

run_test
assert_eq "symlinked ~/git: path through the symlink" \
  "timvisher/ide/main" \
  "$(run_sym ntmux3__session_name_from_path "${sym_home}/git/timvisher/ide/main")"

run_test
assert_eq "symlinked ~/git: resolved volume path" \
  "timvisher/ide/main" \
  "$(run_sym ntmux3__session_name_from_path "${sym_vol_git}/timvisher/ide/main")"

run_test
assert_eq "symlinked ~/git: resolver keeps the ~/git-relative name" \
  "timvisher/ide/main" \
  "$(run_sym ntmux3__resolve_session_name "${sym_vol_git}/timvisher/ide/main")"

run_test
assert_eq "symlinked ~/git: git root resolves to the volume" \
  "$(cd "$sym_vol_git" && pwd -P)" \
  "$(run_sym ntmux3__git_root_real)"

echo ""
echo "Results: $((tests - failures))/${tests} passed"

if (( 0 < failures ))
then
  exit 1
fi
