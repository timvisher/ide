#!/usr/bin/env bash

# Bash port of the Go notify library at
# dd-source/domains/cloud-networks/shared/libs/go/os/notify/
#
# Delivers messages to both stderr (TTY line) and the OS notification
# system. On macOS: OSC 9 (Ghostty/iTerm/WezTerm), OSC 99 (Kitty),
# tmux DCS passthrough, osascript fallback.
#
# Usage:
#   timvisher_notify "Title" "message"
#   timvisher_notify --silent "Title" "message"   # TTY only, no OS notification
#
# Env:
#   TIMVISHER_NOTIFY_DEBUG=1  — enable debug output to stderr
#
# On a Datadog workspace (WORKSPACES_DAEMON_SOCKET set) the OS notification
# goes to Tim's laptop through the agent relay's notify op, which shows it
# as '<workspace>: <title>'.

set -euo pipefail

timvisher_notify__debug() {
  if [[ -n ${TIMVISHER_NOTIFY_DEBUG:-} ]]
  then
    printf 'notify[debug]: %s\n' "$1" >&2
  fi
}

timvisher_notify__detect_terminal() {
  local tp=${TERM_PROGRAM:-}

  if [[ -n $tp && $tp != tmux ]]
  then
    printf '%s' "$tp"
    return
  fi

  # Inside tmux: check the global environment tmux inherited at launch.
  if [[ $tp == tmux ]]
  then
    local raw
    if raw=$(tmux show-environment -g TERM_PROGRAM 2>/dev/null)
    then
      timvisher_notify__debug "tmux global TERM_PROGRAM raw='${raw}'"
      local val=${raw#TERM_PROGRAM=}
      if [[ -n $val && $val != tmux ]]
      then
        printf '%s' "$val"
        return
      fi
    else
      timvisher_notify__debug "tmux show-environment TERM_PROGRAM failed"
    fi
  fi

  # Fall back to terminal-specific env vars.
  if [[ -n ${GHOSTTY_RESOURCES_DIR:-} ]]
  then
    printf 'ghostty'
  elif [[ -n ${ITERM_SESSION_ID:-} ]]
  then
    printf 'iTerm.app'
  elif [[ -n ${WEZTERM_EXECUTABLE:-} ]]
  then
    printf 'WezTerm'
  elif [[ -n ${KITTY_PID:-} ]]
  then
    printf 'kitty'
  fi
}

timvisher_notify__tmux_allow_passthrough() {
  local val
  if ! val=$(tmux show-option -gv allow-passthrough 2>/dev/null)
  then
    timvisher_notify__debug "tmux show-option allow-passthrough failed"
    return 1
  fi
  val=${val%$'\n'}
  timvisher_notify__debug "tmux allow-passthrough='${val}'"
  [[ $val == on ]]
}

timvisher_notify__tmux_passthrough() {
  local seq=$1

  if [[ -z ${TMUX:-} ]]
  then
    printf '%s' "$seq"
    return
  fi

  if ! timvisher_notify__tmux_allow_passthrough
  then
    return 1
  fi

  # DCS tmux; <escaped-sequence> ST
  # Inner ESC bytes must be doubled for tmux to forward them.
  local escaped=${seq//$'\x1b'/$'\x1b\x1b'}
  printf '\x1bPtmux;%s\x1b\\' "$escaped"
}

timvisher_notify__native_notify_warned=0

timvisher_notify__osascript() {
  local title=$1 message=$2

  if (( timvisher_notify__native_notify_warned < 1 ))
  then
    timvisher_notify__native_notify_warned=1
    printf '%s\n' \
      "notify: using osascript for notifications. For native terminal notifications:" \
      "  - Use a terminal that supports OSC 9 (iTerm2, Ghostty, WezTerm) or OSC 99 (Kitty)" \
      >&2
    if [[ -n ${TMUX:-} ]]
    then
      printf '%s\n' "  - Enable tmux passthrough: set -g allow-passthrough on" >&2
    fi
  fi

  osascript -e "display notification \"${message//\"/\\\"}\" with title \"${title//\"/\\\"}\"" 2>/dev/null || true
}

timvisher_notify__terminal_bundle_id() {
  case $1 in
    ghostty) printf 'com.mitchellh.ghostty' ;;
    iTerm.app) printf 'com.googlecode.iterm2' ;;
    WezTerm) printf 'com.github.wez.wezterm' ;;
    kitty) printf 'net.kovidgoyal.kitty' ;;
    *) return 1 ;;
  esac
}

# A pane write succeeds even when the terminal won't show the banner, so
# it must only be tried when the banner will show: the terminal app isn't
# frontmost (it hides its own banners while focused) and a client can
# see the pane (tmux drops passthrough for panes nobody sees). Any
# question left unanswered means osascript, which always shows.
timvisher_notify__pane_banner_will_show() {
  local term=$1

  local term_bundle
  if ! term_bundle=$(timvisher_notify__terminal_bundle_id "$term")
  then
    timvisher_notify__debug "no bundle id known for terminal '${term}'"
    return 1
  fi

  local front_info front_bundle
  if ! front_info=$(lsappinfo info -only bundleID "$(lsappinfo front 2>/dev/null)" 2>/dev/null)
  then
    timvisher_notify__debug "cannot tell the frontmost app"
    return 1
  fi
  if [[ $front_info =~ (bundleID|\"CFBundleIdentifier\")=\"([^\"]*)\" ]]
  then
    front_bundle=${BASH_REMATCH[2]}
  fi
  if [[ -z ${front_bundle:-} || $front_bundle == "$term_bundle" ]]
  then
    timvisher_notify__debug "frontmost app '${front_bundle:-unknown}' may hide the banner"
    return 1
  fi

  local attached window_active zoomed pane_active
  if ! read -r attached window_active zoomed pane_active < <(
    tmux display -p -t "$TMUX_PANE" '#{session_attached} #{window_active} #{window_zoomed_flag} #{pane_active}' 2>/dev/null
  )
  then
    timvisher_notify__debug "cannot read tmux visibility for TMUX_PANE='${TMUX_PANE}'"
    return 1
  fi
  if (( attached < 1 )) || [[ $window_active != 1 ]] || [[ $zoomed == 1 && $pane_active != 1 ]]
  then
    timvisher_notify__debug "pane not visible: attached=${attached} window_active=${window_active} zoomed=${zoomed} pane_active=${pane_active}"
    return 1
  fi
}

timvisher_notify__write_tmux_pane_tty() {
  local wrapped=$1 term=$2

  if [[ -z ${TMUX:-} || -z ${TMUX_PANE:-} ]]
  then
    timvisher_notify__debug "no tmux pane tty: TMUX='${TMUX:-}' TMUX_PANE='${TMUX_PANE:-}'"
    return 1
  fi

  if ! timvisher_notify__pane_banner_will_show "$term"
  then
    return 1
  fi

  local pane_tty
  if ! pane_tty=$(tmux display -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null) || [[ -z $pane_tty ]]
  then
    timvisher_notify__debug "cannot resolve tmux pane tty for TMUX_PANE='${TMUX_PANE}'"
    return 1
  fi

  if [[ ! -c $pane_tty ]] || ! { printf '%s' "$wrapped" > "$pane_tty"; } 2>/dev/null
  then
    timvisher_notify__debug "cannot write to tmux pane tty '${pane_tty}'"
    return 1
  fi

  timvisher_notify__debug "wrote to tmux pane tty '${pane_tty}' for TMUX_PANE='${TMUX_PANE}'"
}

timvisher_notify__platform_notify() {
  local title=$1 message=$2

  local term
  term=$(timvisher_notify__detect_terminal)
  timvisher_notify__debug "detected terminal='${term}' TERM_PROGRAM='${TERM_PROGRAM:-}' TMUX='${TMUX:-}' GHOSTTY_RESOURCES_DIR='${GHOSTTY_RESOURCES_DIR:-}'"

  local seq
  case $term in
    iTerm.app|ghostty|WezTerm)
      seq=$(printf '\x1b]9;%s\x1b\\' "$message")
      ;;
    kitty)
      seq=$(printf '\x1b]99;i=1:d=0;%s\x1b\\\x1b]99;i=1:p=body;%s\x1b\\' "$title" "$message")
      ;;
    *)
      timvisher_notify__debug "fallback to osascript: unknown terminal '${term}'"
      timvisher_notify__osascript "$title" "$message"
      return
      ;;
  esac

  local wrapped
  if ! wrapped=$(timvisher_notify__tmux_passthrough "$seq")
  then
    timvisher_notify__debug "fallback to osascript: tmux passthrough unavailable"
    timvisher_notify__osascript "$title" "$message"
    return
  fi

  timvisher_notify__debug "sending native notification via ${term} (tmux-wrapped=$([[ -n ${TMUX:-} ]] && echo true || echo false))"

  # Write directly to /dev/tty so escape sequences bypass any pipe
  # and reach the terminal emulator.
  local tty=${TIMVISHER_NOTIFY_TTY:-/dev/tty}
  if [[ -c $tty ]] && { true > "$tty"; } 2>/dev/null
  then
    printf '%s' "$wrapped" > "$tty"
    return
  fi

  timvisher_notify__debug "cannot write to ${tty}, trying tmux pane tty"
  if ! timvisher_notify__write_tmux_pane_tty "$wrapped" "$term"
  then
    timvisher_notify__debug "fallback to osascript: cannot write to /dev/tty or tmux pane tty"
    timvisher_notify__osascript "$title" "$message"
  fi
}

# A workspace has no screen of Tim's, so the relay is the only way to show
# one. Never fatal, despite set -e: a notification that didn't arrive must
# not stop the caller.
timvisher_notify__relay() {
  local title=$1 message=$2
  local client=${TIMVISHER_NOTIFY_RELAY_CLIENT:-$HOME/.local/state/timvisher/agent-relay/notify}

  if [[ ! -x $client ]]
  then
    printf 'notify: not shown on the laptop: no agent relay client at %s\n' "$client" >&2
    return 0
  fi
  "$client" --title "$title" --body "$message" </dev/null || true
}

timvisher_notify__send() {
  local title=$1 message=$2 silent=${3:-}

  printf '%s: %s\n' "$title" "$message" >&2

  if [[ $silent == --silent ]]
  then
    return 0
  fi
  if [[ -n ${WORKSPACES_DAEMON_SOCKET:-} ]]
  then
    timvisher_notify__relay "$title" "$message"
  else
    timvisher_notify__platform_notify "$title" "$message"
  fi
}

# --- main ---

if [[ ${BASH_SOURCE[0]} == "${0}" ]]
then
  silent=""
  if [[ ${1:-} == --silent ]]
  then
    silent=--silent
    shift
  fi

  if (( $# < 2 ))
  then
    printf 'Usage: %s [--silent] <title> <message>\n' "${0##*/}" >&2
    exit 1
  fi

  timvisher_notify__send "$1" "$2" "$silent"
fi
