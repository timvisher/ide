#!/usr/bin/env bash

source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

# Shared gh helpers.
# shellcheck source=/dev/null
source ~/.functions/gh.bash ||
  {
    echo "Unable to source gh helpers" >&2
    exit 1
  }

gh_url_repo() {
  local spec owner repo _
  spec=$(timvisher_gh__repo_spec_from_url "$1")
  IFS=/ read -r owner repo _ <<< "$spec"
  printf '%s/%s\n' "$owner" "$repo"
}

show_help() {
  cat <<'USAGE'
  timvisher_gh - GitHub workflow commands

  Usage:
    timvisher_gh [-C <path>] <subcommand> [args...]
    timvisher_gh -R OWNER/REPO info <field>

    timvisher_gh info <field>    Query repository metadata
    timvisher_gh info --json     Query the whole context blob
    timvisher_gh pr              Create a PR from pr.md (or open existing)
    timvisher_gh pr edit         Edit an existing PR from pr.md
    timvisher_gh pr merge [gh-opts]  Merge the PR referenced by pr.md.url
    timvisher_gh pr ready        Wait for CI checks to pass, then mark PR ready
    timvisher_gh issue           Create an issue from issue.md (or open existing)
    timvisher_gh issue edit      Edit an existing issue from issue.md
    timvisher_gh comment [--pull-request=URL] <file>
                                 Post a comment on a PR from <file>
    timvisher_gh comment reply <target> <file> [--reaction R]...
                                 Reply to a review comment from <file>
    timvisher_gh comment edit [--force] <file>
                                 Update a posted comment from <file>
    timvisher_gh comment react [--delete] <target> --reaction R...
                                 Add or remove your reactions on a comment
    timvisher_gh comment resolve [--unresolve] <target>
                                 Resolve or reopen a review thread
    timvisher_gh comment get <target> [<file>]
                                 Fetch a comment into <file> + <file>.json
    timvisher_gh comment delete [--force] <file>
                                 Delete the comment tracked by <file>.json

  pr subcommand:
    - Requires a clean git status
    - Pushes the current branch before creating
    - Reads title from line 1 and body from line 3+ of pr.md

  pr edit subcommand:
    - Requires pr.md.url to exist
    - Updates the PR title and body from pr.md

  pr merge subcommand:
    - Requires pr.md.url to exist
    - Tries rebase, then squash, then merge (based on repo settings)
    - Repos listed in ~/.config/timvisher/ide/gh-pr-merge-comment-repos
      are merged by posting a '/merge' comment instead
    - Extra arguments are passed to 'gh pr merge'
    - Blocks until the PR is actually merged (polls past any merge
      queue); on confirmed merge, drops an 'x.merged' cookie at the
      worktree top level so worktree gc can eagerly reap it
    - Override poll/timeout with TIMVISHER_GH_PR_MERGE_POLL_INTERVAL
      (default 10s) and TIMVISHER_GH_PR_MERGE_TIMEOUT (default 7200s)

  pr ready subcommand:
    - Requires pr.md.url to exist
    - Polls CI checks until all pass, then runs 'gh pr ready'
    - Exclude patterns are loaded from org-level then repo-level files:
        ~/.config/timvisher/ide/bash/bin/timvisher_gh.config/orgs/OWNER/pr/ready/exclude-checks.txt
        ~/.config/timvisher/ide/bash/bin/timvisher_gh.config/repos/OWNER/REPO/pr/ready/exclude-checks.txt
      Org-level patterns apply to every repo in the org; repo-level
      patterns add to them. One regex pattern per line; matching check
      names are ignored. Lines starting with '#' and blank lines are
      skipped.
    - Set TIMVISHER_GH_PR_READY_POLL_INTERVAL to override the default
      10-second poll interval

  issue subcommand:
    - Reads title from line 1 and body from line 3+ of issue.md

  issue edit subcommand:
    - Requires issue.md.url to exist
    - Updates the issue title and body from issue.md

  comment subcommands:
    - Each posted or fetched comment is a <file> plus <file>.json, the
      source of truth (kind, id, database_id, url, author, created_at,
      thread_id, posted {body, reactions, resolved}). <file>.url is
      regenerated from it; a legacy <file>.url alone is adopted into
      <file>.json on first use.
    - <target> is a comment URL or a tracked <file>. A URL is
      https://github.com/OWNER/REPO/pull/N, optionally followed by
      /files or /changes and a ?query, ending in #discussion_r<ID>
      (review comment) or #issuecomment-<ID> (top-level comment).
    - R is a reaction: +1 -1 laugh confused heart hooray rocket eyes,
      the matching emoji (👍 👎 😄 😕 ❤️ 🎉 🚀 👀, without skin tones), or
      a GraphQL ReactionContent name. --reaction repeats.
    - Rerunning a verb converges instead of repeating it. Verbs print
      the comment URL on stdout (get prints the file; delete prints
      nothing) and exit non-zero if anything didn't converge. Only
      github.com is supported; the gh shim picks the account for the
      comment's owner.
    - <file> paths resolve from the repository root.

  comment <file>:
    - Posts <file> as a top-level comment on the PR from
      --pull-request=URL, pr.md.url, or the Chrome active tab
    - If <file>.json already exists, prints its URL and posts nothing

  comment reply <target> <file> [--reaction R]...:
    - Replies to a review comment (#discussion_r<ID>) with <file>
    - --reaction reacts to the comment being replied to
    - If <file>.json already exists, the reply isn't posted again

  comment edit [--force] <file>:
    - Updates the posted comment from <file> under a lease: if GitHub's
      copy no longer matches the body recorded in <file>.json, prints a
      diff and refuses. Fold those changes into <file>, then rerun with
      --force, which overwrites GitHub's copy
    - A file adopted from a legacy <file>.url has no recorded body yet,
      so its first edit isn't leased

  comment react [--delete] <target> --reaction R...:
    - Adds (or with --delete removes) your reactions on the comment;
      reacting again or removing an absent reaction is a no-op
    - A tracked <file> records them in posted.reactions

  comment resolve [--unresolve] <target>:
    - Resolves (or reopens) the review thread holding the comment

  comment get <target> [<file>]:
    - Writes the comment's body to <file> and its state to <file>.json
    - Without <file>, names it <ts>-<author>-<slug>.md, where <ts> is
      the UTC creation time (+%FT%H-%M-%S%z) and <slug> is the first 60
      characters of the body with whitespace collapsed
    - Refreshing a tracked file keeps local edits that aren't posted
      yet, and their lease; push them with 'comment edit'

  comment delete [--force] <file>:
    - Deletes the comment tracked by <file>.json and removes its state
    - Prompts for confirmation before deleting, unless --force is given
      (intended for batch cleanup of many tracked comments); --force
      refuses comments someone else wrote
    - A comment that's already gone (404/410) only counts as gone when
      its repository is still reachable; any other failure keeps the
      state and exits non-zero

  info subcommand:
    - Queries metadata about the current repository via GitHub API
    - <field> is a virtual field name (not raw jq):
        .forkNetwork.mainRepo   OWNER/REPO of the fork network root
                                (the repo itself if not a fork)
        .forkNetwork.mainOwner  Owner of the fork network root
        .archived               true if the repository is archived,
                                false otherwise
        .me                     Authenticated GitHub username
    - --json emits every field at once, merged with
      'timvisher_git info --json'.  Unlike the scalar fields, --json
      therefore requires a worktree under $TIMVISHER_GIT_HOME, since
      that is what timvisher_git decomposes:
        {"timvisher_git": {org, repo, branch, branchPath, absPath,
                           prefixPath},
         "timvisher_gh":  {me, archived, forkNetwork: {mainRepo,
                                                       mainOwner}}}
    - A context is required: a git worktree (the current directory or
      -C <path>), or a repository named with -R.  Extra positional
      arguments are an error.
    - -R takes no worktree, so --json, which needs one, is an error with
      -R; query the scalar fields instead.
    - .me is context-sensitive by design: the gh account is pinned per
      repository owner, so it varies by repo.  Cache it per context,
      never process-wide.

  Both pr/issue create subcommands:
    - Store the resulting URL in <file>.url
    - Open the URL in the browser on subsequent runs

  Options:
    -C <path>           Resolve context from <path> instead of the
                        current directory.  Must come BEFORE the
                        subcommand.
    -R, --repo OWNER/REPO
                        Name a repository instead of resolving one
                        from a worktree, like gh's -R.  Takes OWNER/REPO
                        or github.com/OWNER/REPO.  Only 'info' accepts
                        it; every other subcommand needs a worktree.
                        Mutually exclusive with -C.  Must come BEFORE
                        the subcommand.
    -h, --help, help    Show this help
USAGE
}

# Usage text is diagnostic by default: it accompanies a caller error, so
# it belongs on stderr. show_help is the only path that wants it on
# stdout, because there the caller asked for it.
usage() {
  show_help >&2
}

chdir=
repo_override=
while (( 0 < $# ))
do
  case $1 in
    -C)
      (( 2 <= $# )) ||
        die 'Option -C requires a <path> argument'
      [[ -n $2 ]] ||
        die 'Option -C requires a non-empty <path> argument'
      chdir=$2
      shift 2
      ;;
    -R|--repo)
      (( 2 <= $# )) ||
        die 'Option %s requires an OWNER/REPO argument' "$1"
      [[ -n $2 ]] ||
        die 'Option %s requires a non-empty OWNER/REPO argument' "$1"
      repo_override=$2
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if (( $# == 0 ))
then
  usage
  exit 1
fi

case $1 in
  -h|--help|help)
    show_help
    exit 0
    ;;
esac

if [[ -n $chdir && -n $repo_override ]]
then
  die 'Options -C and -R are mutually exclusive: -C names a worktree, -R names a repository'
fi

if [[ -n $repo_override ]]
then
  [[ $1 == info ]] ||
    die "Option -R is only supported with 'info'; '%s' needs a worktree (use -C)" "$1"

  repo_spec=${repo_override#github.com/}
  if ! [[ $repo_spec =~ ^[^/]+/[^/]+$ ]]
  then
    die "Option -R: '%s' is not OWNER/REPO (or github.com/OWNER/REPO)" "$repo_override"
  fi
else
  if [[ -n $chdir && ! -d $chdir ]]
  then
    die "Option -C: unable to enter '%s'" "$chdir"
  fi

  toplevel=$(command git -C "${chdir:-.}" rev-parse --show-toplevel) ||
    die 'Not in a git repository'

  cd "$toplevel" ||
    die 'Unable to cd to top level directory '%s'' "$toplevel"

  # Determine the target remote for the operation.
  # Use the branch's tracking remote when set; otherwise prefer 'upstream'
  # (fork parent) if it exists, falling back to 'origin'.  This respects
  # soft-fork repos where tracking intentionally points at origin.
  target_remote=
  tracking_remote=$(command git config "branch.$(command git rev-parse --abbrev-ref HEAD).remote" 2>/dev/null) || true
  if [[ -n $tracking_remote ]] && git remote | grep -qx "$tracking_remote"
  then
    target_remote=$tracking_remote
  elif git remote | grep -q '^upstream$'
  then
    target_remote='upstream'
  else
    target_remote='origin'
  fi

  # Get the OWNER/REPO spec from the remote's URL (host-agnostic, so
  # Enterprise host aliases resolve like github.com).
  repo_spec=$(timvisher_gh__repo_spec_from_url "$(git remote get-url "$target_remote")")
  [[ -n $repo_spec ]] ||
    die "Could not determine repository spec for remote '%s'" "$target_remote"
fi

# Pin GH_TOKEN to the gh account configured for this repo's org, so we
# authenticate as the identity that can see the repo on multi-account setups.
# This is the same resolution the gh PATH shim applies to all gh calls; doing
# it here too keeps timvisher_gh correct even if invoked without the shim
# first on PATH. No mapping → active account (the unchanged default). The
# comment verbs restore the caller's GH_TOKEN instead and rely on the shim,
# because their targets can be in any org.
startup_gh_token_set=0
startup_gh_token=
if [[ -v GH_TOKEN ]]
then
  startup_gh_token_set=1
  startup_gh_token=$GH_TOKEN
fi
timvisher_gh__pin_token_for_owner "${repo_spec%%/*}" ||
  die "No gh token for the account mapped to org '%s'. Authenticate it (gh auth login)." \
    "${repo_spec%%/*}"

# --- subcommand: pr ---

gh_pr_ready() {
  local pr_url
  pr_url=$(< "${toplevel}/pr.md.url") ||
    die 'pr.md.url unreadable'

  [[ -n $pr_url ]] ||
    die 'pr_url unset. Does pr.md.url exist at top level?'

  # Load exclude patterns for checks that should be ignored (e.g.
  # mergegate, which never completes until all others pass). Org-level
  # patterns apply to every repo in the org; repo-level patterns add to
  # them.
  local config_dir="${HOME}/.config/timvisher/ide/bash/bin/timvisher_gh.config"
  local repo_slug_from_url=${pr_url#https://github.com/}
  repo_slug_from_url=${repo_slug_from_url%%/pull/*}
  local owner_from_url=${repo_slug_from_url%%/*}

  local -a exclude_patterns=()
  local exclude_file
  for exclude_file in \
    "${config_dir}/orgs/${owner_from_url}/pr/ready/exclude-checks.txt" \
    "${config_dir}/repos/${repo_slug_from_url}/pr/ready/exclude-checks.txt"
  do
    [[ -r $exclude_file ]] ||
      continue
    while IFS= read -r line
    do
      # Trim leading/trailing whitespace
      line=${line#"${line%%[![:space:]]*}"}
      line=${line%"${line##*[![:space:]]}"}
      # Skip blank lines and comments
      [[ -n $line && $line != '#'* ]] && exclude_patterns+=("$line")
    done < "$exclude_file"
    info 'Loaded exclude pattern(s) from %s' "$exclude_file"
  done

  local poll_interval=${TIMVISHER_GH_PR_READY_POLL_INTERVAL:-10}
  local checks_out checks_json checks_refusal filtered_json total pending_count fail_count pass_count

  while true
  do
    checks_out=$(command gh -R "$(gh_url_repo "$pr_url")" pr checks "$pr_url" --json name,bucket 2>&1) || true
    checks_refusal=$(grep '^{"type":"instruction","level":"error"' <<<"$checks_out")
    if [[ -n $checks_refusal ]]
    then
      printf '%s\n' "$checks_refusal" >&2
      die "gh refused to check '%s'; not retrying" "$pr_url"
    fi
    checks_json=$(grep -v '^{"type":"instruction"' <<<"$checks_out")

    # Validate we got parseable JSON; empty output or error text means no checks yet
    if [[ -z $checks_json ]] || ! jq -e 'type == "array"' <<<"$checks_json" >/dev/null 2>&1
    then
      info 'No checks found yet; retrying in %ds' "$poll_interval"
      sleep "$poll_interval"
      continue
    fi

    # Filter out excluded checks
    filtered_json=$checks_json
    for pattern in "${exclude_patterns[@]}"
    do
      filtered_json=$(jq --arg pat "$pattern" '[.[] | select(.name | test($pat) | not)]' <<<"$filtered_json")
    done

    total=$(jq 'length' <<<"$filtered_json")
    pending_count=$(jq '[.[] | select(.bucket == "pending")] | length' <<<"$filtered_json")
    fail_count=$(jq '[.[] | select(.bucket == "fail")] | length' <<<"$filtered_json")
    pass_count=$(jq '[.[] | select(.bucket == "pass")] | length' <<<"$filtered_json")

    info 'Checks: %d total, %d pass, %d pending, %d fail' \
         "$total" "$pass_count" "$pending_count" "$fail_count"

    if (( 0 < fail_count ))
    then
      jq -r '.[] | select(.bucket == "fail") | .name' <<<"$filtered_json" |
        while IFS= read -r name
        do
          error 'Failed check: %s' "$name"
        done
      die 'CI checks failed; not marking as ready'
    fi

    if (( pending_count == 0 ))
    then
      info 'All %d check(s) passed (or excluded)' "$total"
      break
    fi

    info 'Waiting for %d pending check(s); retrying in %ds' "$pending_count" "$poll_interval"
    sleep "$poll_interval"
  done

  command gh -R "$(gh_url_repo "$pr_url")" pr ready "$pr_url" ||
    die 'Unable to mark PR as ready'

  info 'PR marked as ready for review: %s' "$pr_url"
}

gh_pr_edit() {
  [[ -r pr.md.url ]] ||
    die ''pr.md.url' does not exist; create a PR first'

  [[ -r pr.md ]] ||
    die 'Expected PR file '%s' not readable' "${toplevel}/pr.md"

  command gh -R "$(gh_url_repo "$(< pr.md.url)")" pr edit \
          "$(< pr.md.url)" \
          --title "$(head -n1 pr.md)" \
          -F <(tail -n+3 pr.md) ||
    die 'Unable to edit PR'

  info 'PR updated'
}

# Block until the PR is genuinely merged. Both merge paths (gh pr merge
# and the /merge comment) can return before the merge actually lands —
# gh pr merge may only enqueue, and the comment is processed
# asynchronously by a bot / merge queue. Poll PR state until MERGED so
# callers can act on a confirmed merge (e.g. drop the cookie).
gh_pr_wait_until_merged() {
  local pr_url=$1
  local poll_interval=${TIMVISHER_GH_PR_MERGE_POLL_INTERVAL:-10}
  local timeout=${TIMVISHER_GH_PR_MERGE_TIMEOUT:-7200}
  local waited=0
  local state

  while true
  do
    # state is MERGED|CLOSED|OPEN.
    state=$(command gh -R "$(gh_url_repo "$pr_url")" pr view "$pr_url" --json state -q .state 2>/dev/null) || true

    case $state in
      MERGED)
        return 0 ;;
      CLOSED)
        die 'PR was closed without merging: %s' "$pr_url" ;;
    esac

    if (( timeout <= waited ))
    then
      die 'Timed out after %ds waiting for merge to complete: %s (merge may still land; cookie not dropped)' \
          "$waited" "$pr_url"
    fi

    info 'Waiting for merge to complete (state=%s); retrying in %ds' "${state:-unknown}" "$poll_interval"
    sleep "$poll_interval"
    (( waited += poll_interval )) || true
  done
}

# Record an authoritative "this worktree was merged" marker that the gc
# eager-reap tier keys on. Written only after a CONFIRMED merge. The x.
# prefix keeps it gitignored; the gc reads its mtime for the 4-day window.
gh_pr__drop_merged_cookie() {
  local pr_url=$1 strategy=$2
  local cookie="${toplevel}/x.merged"

  if {
    printf 'merged_at=%s\n' "$(date -u '+%FT%TZ')"
    printf 'pr_url=%s\n'    "$pr_url"
    printf 'strategy=%s\n'  "$strategy"
  } > "$cookie"
  then
    info 'Wrote merged cookie %s' "$cookie"
  else
    warn 'Could not write merged cookie %s' "$cookie"
  fi
}

gh_pr_merge() {
  display_script "$0"

  local pr_url
  pr_url=$(< "${toplevel}/pr.md.url") ||
    die 'pr.md.url unreadable'

  [[ -n $pr_url ]] ||
    die 'pr_url unset. Does pr.md.url exist at top level?'

  local repo_slug_from_url=${pr_url#https://github.com/}
  repo_slug_from_url=${repo_slug_from_url%%/pull/*}
  local repo_slug_lc=${repo_slug_from_url,,}

  # Repos that merge via comment (e.g. /merge) instead of gh pr merge.
  local comment_merge_config="${HOME}/.config/timvisher/ide/gh-pr-merge-comment-repos"
  if [[ -r $comment_merge_config ]] && grep -qix "$repo_slug_lc" "$comment_merge_config"
  then
    read -rp "Request merge for ${pr_url} by commenting '/merge'? y/N " r
    if [[ $r != y ]]
    then
      info "Exiting at user's request."
      return
    fi

    gh -R "$repo_slug_from_url" pr comment "$pr_url" --body "/merge" ||
      die "Couldn't post /merge comment to '%s'" "$pr_url"

    info "Requested merge via comment for %s; waiting for merge queue" "$pr_url"
    gh_pr_wait_until_merged "$pr_url"
    gh_pr__drop_merged_cookie "$pr_url" comment
    info 'PR merged: %s' "$pr_url"
    return 0
  fi

  local capabilities_json
  capabilities_json=$(
    gh -R "$repo_slug_from_url" repo view "$repo_slug_from_url" --json 'mergeCommitAllowed,rebaseMergeAllowed,squashMergeAllowed,viewerDefaultMergeMethod'
  )

  local strategies=()
  jq -e '.mergeCommitAllowed' <<<"$capabilities_json" >/dev/null && strategies+=(merge)
  jq -e '.squashMergeAllowed' <<<"$capabilities_json" >/dev/null && strategies+=(squash)
  jq -e '.rebaseMergeAllowed'  <<<"$capabilities_json" >/dev/null && strategies+=(rebase)

  (( ${#strategies[@]} )) ||
    die 'Repository allows no merge strategies: rebase, squash, and merge are all disabled.'

  read -rp "Really merge ${pr_url}? y/N " r

  if [[ $r != y ]]
  then
    info "Exiting at user's request."
    return
  fi

  local merged=
  for ((i = 0; i < ${#strategies[@]}; i++))
  do
    local strat=${strategies[i]}

    if gh -R "$repo_slug_from_url" pr merge "$@" "--${strat}" "$pr_url"
    then
      merged=$strat
      break
    fi

    local next=${strategies[i+1]:-}
    if [[ -n $next ]]
    then
      read -rp "Merge with '${strat}' failed. Try '${next}'? Y/n " ans
      [[ ${ans,,} == n* ]] && die "Aborted after '${strat}' failure."
    fi
  done

  [[ -n ${merged-} ]] ||
    die "Couldn't merge PR '%s' with any strategy (tried: %s)" \
        "$pr_url" "${strategies[*]}"

  info 'Merge requested via %s; waiting for it to complete' "$merged"
  gh_pr_wait_until_merged "$pr_url"
  gh_pr__drop_merged_cookie "$pr_url" "$merged"
  info 'PR merged via %s' "$merged"
}

gh_pr() {
  case ${1-} in
    edit)
      shift
      gh_pr_edit "$@"
      return
      ;;
    merge)
      shift
      gh_pr_merge "$@"
      return
      ;;
    ready)
      shift
      gh_pr_ready "$@"
      return
      ;;
  esac

  if [[ -r pr.md.url ]]
  then
    info ''pr.md.url' already exists. Opening'
    osascript -e 'on run argv
  tell script "timvisher Browser" to openUrl(item 1 of argv)
end run' "$(< pr.md.url)"
    return
  fi

  local base_branch
  base_branch=$(gh -R "$repo_spec" repo view "$repo_spec" --json defaultBranchRef --jq .defaultBranchRef.name) ||
    die "Could not determine default branch for repository '%s'" "$repo_spec"

  [[ -r pr.md ]] ||
    die 'Expected PR file '%s' not readable' "${toplevel}/pr.md"

  local status
  status=$(command git status --porcelain)

  [[ -z $status ]] ||
    die '%s\ngit status is not clean' "$status"

  command git push -v origin HEAD ||
    die 'Unable to git push'

  osascript -e 'tell script "timvisher Browser" to activate()'

  local pr_url
  pr_url=$(
    command gh -R "$repo_spec" pr create \
            --draft \
            --base "$base_branch" \
            --title "$(head -n1 pr.md)" \
            -F <(tail -n+3 pr.md)
        ) ||
    die 'Unable to create PR'

  tee <<<"$pr_url" pr.md.url

  osascript -e 'on run argv
  tell script "timvisher Browser" to openUrl(item 1 of argv)
end run' "$pr_url"
}

# --- subcommand: issue ---

gh_issue_edit() {
  [[ -r issue.md.url ]] ||
    die ''issue.md.url' does not exist; create an issue first'

  [[ -r issue.md ]] ||
    die 'Expected issue file '%s' not readable' "${toplevel}/issue.md"

  command gh -R "$(gh_url_repo "$(< issue.md.url)")" issue edit \
          "$(< issue.md.url)" \
          --title "$(head -n1 issue.md)" \
          -F <(tail -n+3 issue.md) ||
    die 'Unable to edit issue'

  info 'Issue updated'
}

gh_issue() {
  case ${1-} in
    edit)
      shift
      gh_issue_edit "$@"
      return
      ;;
  esac

  if [[ -r issue.md.url ]]
  then
    info ''issue.md.url' already exists. Opening'
    osascript -e 'on run argv
  tell script "timvisher Browser" to openUrl(item 1 of argv)
end run' "$(< issue.md.url)"
    return
  fi

  [[ -r issue.md ]] ||
    die 'Expected issue file '%s' not readable' "${toplevel}/issue.md"

  osascript -e 'tell script "timvisher Browser" to activate()'

  local issue_url
  issue_url=$(
    command gh -R "$repo_spec" issue create \
            --title "$(head -n1 issue.md)" \
            -F <(tail -n+3 issue.md)
        ) ||
    die 'Unable to create issue'

  tee <<<"$issue_url" issue.md.url

  osascript -e 'on run argv
  tell script "timvisher Browser" to openUrl(item 1 of argv)
end run' "$issue_url"
}

# --- subcommand: comment ---

comment__url_re='^https://github\.com/([A-Za-z0-9-]+)/([A-Za-z0-9._-]+)/pull/([0-9]+)(/(files|changes))?(\?[^#]*)?#(discussion_r|issuecomment-)([0-9]+)$'

gh_comment__unpin_token() {
  if (( startup_gh_token_set ))
  then
    export GH_TOKEN=$startup_gh_token
  else
    unset GH_TOKEN
  fi
}

gh_comment__http_status() {
  local status
  read -r _ status _ <<<"${1%%$'\n'*}"
  if [[ ${1%%$'\n'*} == HTTP/* && $status =~ ^[0-9]{3}$ ]]
  then
    printf '%s' "$status"
  else
    printf 'none'
  fi
}

gh_comment__repo_reachable() {
  local owner_repo=$1 response
  response=$(gh api --method HEAD --include "/repos/${owner_repo}" --hostname github.com 2>&1)
  [[ $(gh_comment__http_status "$response") == 2?? ]]
}

comment__response=''
comment__status=''
comment__body=''

comment__capture() {
  local rc=$1
  comment__status=$(gh_comment__http_status "$comment__response")
  comment__body=''
  if [[ $comment__response == *$'\r\n\r\n'* ]]
  then
    comment__body=${comment__response#*$'\r\n\r\n'}
  fi
  (( rc == 0 )) && [[ $comment__status == 2?? ]]
}

comment__api() {
  comment__response=$(gh api --include "$@" --hostname github.com 2>&1)
  comment__capture $?
}

comment__graphql() {
  local owner=$1 query=$2
  shift 2
  comment__response=$(TIMVISHER_GH_OWNER=$owner gh api --include graphql -f query="$query" "$@" --hostname github.com 2>&1)
  comment__capture $? &&
    jq -e '(.errors // []) | length == 0' >/dev/null 2>&1 <<<"$comment__body"
}

comment__normalize() {
  local text=${1//$'\r'/}
  text=${text%"${text##*[!$'\n']}"}
  printf '%s' "$text"
}

comment__reaction_rest() {
  case ${1,,} in
    +1|thumbs_up|👍) echo +1 ;;
    -1|thumbs_down|👎) echo -1 ;;
    laugh|😄) echo laugh ;;
    confused|😕) echo confused ;;
    heart|❤️|❤) echo heart ;;
    hooray|🎉) echo hooray ;;
    rocket|🚀) echo rocket ;;
    eyes|👀) echo eyes ;;
    *) return 1 ;;
  esac
}

comment__reaction_enum() {
  case $1 in
    +1) echo THUMBS_UP ;;
    -1) echo THUMBS_DOWN ;;
    *) echo "${1^^}" ;;
  esac
}

comment__reactions=()
comment__args=()

comment__parse_reactions() {
  local verb=$1 raw rest
  shift
  comment__reactions=()
  comment__args=()
  while (( 0 < $# ))
  do
    case $1 in
      --reaction)
        (( 2 <= $# )) ||
          die "comment %s: --reaction requires a value" "$verb"
        raw=$2
        shift 2
        ;;
      --reaction=*)
        raw=${1#--reaction=}
        shift
        ;;
      *)
        comment__args+=("$1")
        shift
        continue
        ;;
    esac
    raw=${raw#"${raw%%[![:space:]]*}"}
    raw=${raw%"${raw##*[![:space:]]}"}
    rest=$(comment__reaction_rest "$raw") ||
      die "comment %s: '%s' isn't a reaction (expected one of +1 -1 laugh confused heart hooray rocket eyes, the matching emoji 👍 👎 😄 😕 ❤️ 🎉 🚀 👀 without skin tones, or a GraphQL ReactionContent name)" "$verb" "$raw"
    comment__reactions+=("$rest")
  done
}

comment__reject_flags() {
  local verb=$1 a
  shift
  for a in "$@"
  do
    [[ $a == -* ]] &&
      die "comment %s: unknown flag '%s'" "$verb" "$a"
  done
  return 0
}

c_owner='' c_repo='' c_pr='' c_kind='' c_db='' c_url='' c_file='' c_json=''

comment__parse_url() {
  [[ $1 =~ $comment__url_re ]] ||
    return 1
  [[ ${BASH_REMATCH[2]} != . && ${BASH_REMATCH[2]} != .. ]] ||
    return 1
  c_owner=${BASH_REMATCH[1]}
  c_repo=${BASH_REMATCH[2]}
  c_pr=${BASH_REMATCH[3]}
  c_db=${BASH_REMATCH[8]}
  if [[ ${BASH_REMATCH[7]} == discussion_r ]]
  then
    c_kind=review_comment
    c_url="https://github.com/${c_owner}/${c_repo}/pull/${c_pr}#discussion_r${c_db}"
  else
    c_kind=issue_comment
    c_url="https://github.com/${c_owner}/${c_repo}/pull/${c_pr}#issuecomment-${c_db}"
  fi
}

comment__endpoint() {
  if [[ $c_kind == review_comment ]]
  then
    printf 'repos/%s/%s/pulls/comments/%s' "$c_owner" "$c_repo" "$c_db"
  else
    printf 'repos/%s/%s/issues/comments/%s' "$c_owner" "$c_repo" "$c_db"
  fi
}

comment__sidecar_write() {
  local file=$1 json=$2 url
  if ! json=$(jq . <<<"$json" 2>/dev/null)
  then
    error "Refusing to write malformed state to '%s.json'" "$file"
    return 1
  fi
  if ! printf '%s\n' "$json" > "${file}.json"
  then
    error "Unable to write '%s.json'" "$file"
    return 1
  fi
  url=$(jq -r '.url // empty' <<<"$json")
  if [[ -n $url ]] && ! printf '%s\n' "$url" > "${file}.url"
  then
    error "Unable to write '%s.url'" "$file"
    return 1
  fi
}

comment__writable() {
  local file=$1 dir
  dir=$(dirname -- "$file")
  [[ -d $dir && -w $dir ]] ||
    die "Can't record state next to '%s': '%s' isn't a writable directory" "$file" "$dir"
  [[ ! -e ${file}.json || -w ${file}.json ]] ||
    die "Can't record state in '%s.json': it isn't writable" "$file"
  [[ ! -e ${file}.url || -w ${file}.url ]] ||
    die "Can't record state in '%s.url': it isn't writable" "$file"
}

comment__has_sidecar() {
  [[ -e ${1}.json || -e ${1}.url ]]
}

comment__sidecar_load() {
  local file=$1 json url
  if [[ -e ${file}.json ]]
  then
    [[ -r ${file}.json ]] ||
      die "'%s.json' isn't readable" "$file"
    json=$(jq -e 'select(type == "object" and (.url | type) == "string")' "${file}.json" 2>/dev/null) ||
      die "'%s.json' isn't a comment sidecar (no url)" "$file"
    url=$(jq -r '.url' <<<"$json")
    comment__parse_url "$url" ||
      die "'%s.json' holds an unexpected url: '%s'" "$file" "$url"
    if [[ ! -r ${file}.url || $(< "${file}.url") != "$url" ]]
    then
      printf '%s\n' "$url" 2>/dev/null > "${file}.url" ||
        info "Couldn't regenerate '%s.url' from '%s.json'" "$file" "$file"
    fi
    printf '%s\n' "$json"
    return 0
  fi
  [[ -r ${file}.url ]] ||
    die "'%s.url' isn't readable" "$file"
  url=$(< "${file}.url")
  url=${url//[[:space:]]/}
  comment__parse_url "$url" ||
    die "'%s.url' doesn't hold a comment URL: '%s'" "$file" "$url"
  json=$(jq -n --arg kind "$c_kind" --arg url "$c_url" --argjson db "$c_db" \
           '{kind: $kind, database_id: $db, url: $url}')
  comment__sidecar_write "$file" "$json" ||
    exit 1
  info "Adopted legacy '%s.url' into '%s.json'" "$file" "$file"
  printf '%s\n' "$json"
}

comment__target() {
  local target=$1
  c_file='' c_json=''
  if comment__parse_url "$target"
  then
    return 0
  fi
  [[ $target == https://* || $target == http://* ]] &&
    die "'%s' doesn't look like a comment URL (expected https://github.com/OWNER/REPO/pull/N, optionally /files or /changes and a ?query, ending in #discussion_r<ID> or #issuecomment-<ID>)" "$target"
  comment__has_sidecar "$target" ||
    die "'%s' is neither a comment URL nor a tracked file (no '%s.json' or '%s.url')" "$target" "$target" "$target"
  c_json=$(comment__sidecar_load "$target") ||
    exit 1
  c_file=$target
  comment__parse_url "$(jq -r '.url' <<<"$c_json")"
}

comment__from_rest() {
  jq --arg kind "$c_kind" '{
    kind: $kind,
    id: .node_id,
    database_id: .id,
    url: .html_url,
    author: (.user.login // "ghost"),
    created_at: .created_at
  } + (if .in_reply_to_id then {in_reply_to: .in_reply_to_id} else {} end)'
}

comment__fetch() {
  comment__api "$(comment__endpoint)" ||
    die "Unable to read '%s' (HTTP status '%s'): %s" "$c_url" "$comment__status" "$comment__response"
  printf '%s' "$comment__body"
}

comment__node_id() {
  local id
  id=$(jq -r '.id // empty' <<<"${c_json:-{\}}")
  if [[ -z $id ]]
  then
    local remote
    remote=$(comment__fetch) ||
      exit 1
    id=$(jq -r '.node_id // empty' <<<"$remote")
  fi
  [[ -n $id ]] ||
    die "Unable to find the node id of '%s'" "$c_url"
  printf '%s' "$id"
}

comment__viewer() {
  comment__response=$(TIMVISHER_GH_OWNER=$c_owner gh api --include user --hostname github.com 2>&1)
  comment__capture $? ||
    die "Unable to find out who you are on GitHub (HTTP status '%s'): %s" "$comment__status" "$comment__response"
  jq -r '.login // empty' <<<"$comment__body"
}

comment__root() {
  local root_db remote
  root_db=$(jq -r '.in_reply_to // empty' <<<"${c_json:-{\}}")
  if [[ -z $root_db ]]
  then
    remote=$(comment__fetch) ||
      exit 1
    root_db=$(jq -r '.in_reply_to_id // empty' <<<"$remote")
    if [[ -z $root_db ]]
    then
      jq -c '{database_id: .id, id: .node_id}' <<<"$remote"
      return 0
    fi
  fi
  local saved_db=$c_db
  c_db=$root_db
  remote=$(comment__fetch) ||
    exit 1
  c_db=$saved_db
  jq -c '{database_id: .id, id: .node_id}' <<<"$remote"
}

# shellcheck disable=SC2016
comment__thread() {
  local root_id=$1 cursor='' query found
  query='query($owner: String!, $repo: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $after) {
        pageInfo { hasNextPage endCursor }
        nodes { id isResolved comments(first: 1) { nodes { id } } }
      }
    }
  }
}'
  while :
  do
    local -a page_args=(-f owner="$c_owner" -f repo="$c_repo" -F number="$c_pr")
    [[ -n $cursor ]] && page_args+=(-f after="$cursor")
    comment__graphql "$c_owner" "$query" "${page_args[@]}" ||
      die "Unable to list review threads on '%s' (HTTP status '%s'): %s" "$c_url" "$comment__status" "$comment__response"
    found=$(jq -c --arg root "$root_id" '
      .data.repository.pullRequest.reviewThreads.nodes[]
      | select(.comments.nodes[0].id == $root)
      | {thread_id: .id, resolved: .isResolved}' <<<"$comment__body" | head -n 1)
    if [[ -n $found ]]
    then
      printf '%s' "$found"
      return 0
    fi
    jq -e '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage' >/dev/null <<<"$comment__body" ||
      break
    cursor=$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor' <<<"$comment__body")
  done
  die "Unable to find the review thread holding '%s'" "$c_url"
}

# shellcheck disable=SC2016
comment__viewer_reactions() {
  local id=$1 query
  query='query($id: ID!) {
  node(id: $id) { ... on Reactable { reactionGroups { content viewerHasReacted } } }
}'
  comment__graphql "$c_owner" "$query" -f id="$id" ||
    die "Unable to read reactions on '%s' (HTTP status '%s'): %s" "$c_url" "$comment__status" "$comment__response"
  jq -c '[.data.node.reactionGroups[]? | select(.viewerHasReacted) | .content
          | if . == "THUMBS_UP" then "+1" elif . == "THUMBS_DOWN" then "-1" else ascii_downcase end]
         | sort' <<<"$comment__body"
}

comment__sidecar_update() {
  [[ -n $c_file ]] ||
    return 0
  local filter=$1
  shift
  c_json=$(jq "$@" "$filter" <<<"$c_json") ||
    die "Unable to update '%s.json'" "$c_file"
  comment__sidecar_write "$c_file" "$c_json" ||
    exit 1
}

comment__slug() {
  jq -rn --arg text "$1" '$text
    | gsub("[\u0000-\u001f\u007f/]"; " ")
    | gsub("\\s+"; " ")
    | sub("^[ .-]+"; "")
    | .[0:60]
    | sub("[ .]+$"; "")'
}

comment__author_slug() {
  local author=${1//[^A-Za-z0-9-]/-}
  while [[ $author == *--* ]]
  do
    author=${author//--/-}
  done
  author=${author#-}
  author=${author%-}
  printf '%s' "${author:-ghost}"
}

comment__name_prefix() {
  local created_at=$1 author=$2 ts
  if [[ $created_at == *Z ]]
  then
    ts=${created_at%Z}+0000
  elif [[ $created_at =~ ^(.*)([+-][0-9]{2}):([0-9]{2})$ ]]
  then
    ts=${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}
  else
    ts=$created_at
  fi
  ts=${ts//:/-}
  printf '%s-%s' "$ts" "$(comment__author_slug "$author")"
}

# shellcheck disable=SC2016
comment__react_apply() {
  local mode=$1 id mutation r failures=0
  shift
  (( 0 < $# )) ||
    return 0
  id=$(comment__node_id) ||
    exit 1
  if [[ $mode == delete ]]
  then
    mutation='mutation($id: ID!, $content: ReactionContent!) {
  removeReaction(input: {subjectId: $id, content: $content}) { reaction { content } }
}'
  else
    mutation='mutation($id: ID!, $content: ReactionContent!) {
  addReaction(input: {subjectId: $id, content: $content}) { reaction { content } }
}'
  fi
  local -a done_reactions=()
  for r in "$@"
  do
    if comment__graphql "$c_owner" "$mutation" -f id="$id" -f content="$(comment__reaction_enum "$r")"
    then
      done_reactions+=("$r")
    else
      error "Unable to %s reaction '%s' on '%s' (HTTP status '%s'): %s" "$mode" "$r" "$c_url" "$comment__status" "$comment__response"
      (( failures += 1 ))
    fi
  done
  if (( 0 < ${#done_reactions[@]} ))
  then
    local list
    list=$(printf '%s\n' "${done_reactions[@]}" | jq -R . | jq -sc .)
    if [[ $mode == delete ]]
    then
      comment__sidecar_update '.id = $id | .posted.reactions = ((.posted.reactions // []) - $list | sort)' \
        --arg id "$id" --argjson list "$list"
    else
      comment__sidecar_update '.id = $id | .posted.reactions = ((.posted.reactions // []) + $list | unique)' \
        --arg id "$id" --argjson list "$list"
    fi
  fi
  (( failures == 0 ))
}

comment__record_posted() {
  local file=$1 json=$2 url
  url=$(jq -r '.url' <<<"$json")
  if ! comment__sidecar_write "$file" "$json"
  then
    printf '%s\n' "$url"
    die "Posted '%s', but couldn't record it next to '%s'; put that URL in '%s.url' before rerunning, or it will be posted again" "$url" "$file" "$file"
  fi
}

# Resolve the PR URL for comment operations.
# Checks (in order): --pull-request= flag, pr.md.url, Chrome active tab.
resolve_pr_url() {
  local url=${comment_pr_url:-}

  if [[ -z $url ]] && [[ -r pr.md.url ]]
  then
    url=$(< pr.md.url)
  fi

  if [[ -z $url ]]
  then
    url=$(osascript -e 'tell script "timvisher Browser" to getActiveTabUrl()' 2>/dev/null) || true
  fi

  if ! [[ $url == *github*/pull/?* ]]
  then
    die "'%s' doesn't look like a PR URL" "${url:-<empty>}"
  fi

  printf '%s' "$url"
}

comment__pr_from_url() {
  [[ $1 =~ ^https://github\.com/([A-Za-z0-9-]+)/([A-Za-z0-9._-]+)/pull/([0-9]+) ]] ||
    die "'%s' isn't a github.com PR URL (GitHub Enterprise hosts aren't supported)" "$1"
  printf '%s/%s/pull/%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

gh_comment_post() {
  comment__reject_flags post "$@"
  local comment_file=${1-}

  [[ -n $comment_file ]] ||
    die 'comment requires a <file> argument'

  (( $# <= 1 )) ||
    die "comment: unexpected argument '%s'" "$2"

  [[ -r $comment_file ]] ||
    die "'%s' is not readable" "$comment_file"

  local json
  if comment__has_sidecar "$comment_file"
  then
    json=$(comment__sidecar_load "$comment_file") ||
      exit 1
    if [[ -n ${comment_pr_url:-} ]]
    then
      local want have
      want=$(comment__pr_from_url "$comment_pr_url") ||
        exit 1
      have=$(comment__pr_from_url "$(jq -r '.url' <<<"$json")") ||
        exit 1
      [[ ${want,,} == "${have,,}" ]] ||
        die "'%s' was already posted on '%s', not '%s'; use a separate file per comment" "$comment_file" "https://github.com/${have}" "$comment_pr_url"
    fi
    info "'%s' was already posted" "$comment_file"
    jq -r '.url' <<<"$json"
    return
  fi

  local pr_url pr
  pr_url=$(resolve_pr_url) ||
    exit $?
  pr=$(comment__pr_from_url "$pr_url") ||
    exit 1
  IFS=/ read -r c_owner c_repo _ c_pr <<<"$pr"
  c_kind=issue_comment
  comment__writable "$comment_file"

  gh_comment__unpin_token

  local body
  body=$(< "$comment_file")
  comment__api --method POST "repos/${c_owner}/${c_repo}/issues/${c_pr}/comments" -f "body=${body}" ||
    die "Unable to post comment (HTTP status '%s'): %s" "$comment__status" "$comment__response"

  json=$(comment__from_rest <<<"$comment__body" | jq --arg body "$(comment__normalize "$body")" '.posted = {body: $body}') ||
    die "Posted a comment, but GitHub's response was unexpected: %s" "$comment__response"
  comment__record_posted "$comment_file" "$json"
  jq -r '.url' <<<"$json"
}

gh_comment_reply() {
  comment__parse_reactions reply "$@"
  set -- "${comment__args[@]}"
  comment__reject_flags reply "$@"

  local target=${1-}
  local reply_file=${2-}

  [[ -n $target ]] ||
    die 'comment reply requires a <target> argument (a comment URL or a tracked file)'

  [[ -n $reply_file ]] ||
    die 'comment reply requires a <file> argument'

  (( $# <= 2 )) ||
    die "comment reply: unexpected argument '%s'" "$3"

  [[ -r $reply_file ]] ||
    die "'%s' is not readable" "$reply_file"

  comment__target "$target"
  [[ $c_kind == review_comment ]] ||
    die "'%s' is a top-level comment; GitHub only threads replies to review comments (#discussion_r<ID>)" "$c_url"

  gh_comment__unpin_token

  local root root_db reply_json reply_url
  root=$(comment__root) ||
    exit 1
  root_db=$(jq -r '.database_id' <<<"$root")

  if comment__has_sidecar "$reply_file"
  then
    reply_json=$(comment__sidecar_load "$reply_file") ||
      exit 1
    local recorded
    recorded=$(jq -r '.in_reply_to // empty' <<<"$reply_json")
    if [[ -n $recorded && $recorded != "$root_db" ]] ||
       [[ $(comment__pr_from_url "$(jq -r '.url' <<<"$reply_json")") != "${c_owner}/${c_repo}/pull/${c_pr}" ]]
    then
      die "'%s' was already posted as '%s', which isn't a reply in the thread holding '%s'; use a separate file per reply" "$reply_file" "$(jq -r '.url' <<<"$reply_json")" "$c_url"
    fi
    info "'%s' was already posted" "$reply_file"
    reply_url=$(jq -r '.url' <<<"$reply_json")
  else
    comment__writable "$reply_file"
    local body
    body=$(< "$reply_file")
    comment__api --method POST "repos/${c_owner}/${c_repo}/pulls/${c_pr}/comments" \
                 -F "in_reply_to=${root_db}" -f "body=${body}" ||
      die "Unable to post reply (HTTP status '%s'): %s" "$comment__status" "$comment__response"
    reply_json=$(comment__from_rest <<<"$comment__body" |
                   jq --arg body "$(comment__normalize "$body")" \
                      --argjson root "$root_db" \
                      --arg thread_id "$(jq -r '.thread_id // empty' <<<"${c_json:-{\}}")" \
                      '.posted = {body: $body} | .in_reply_to = $root
                       | if $thread_id != "" then .thread_id = $thread_id else . end') ||
      die "Posted a reply, but GitHub's response was unexpected: %s" "$comment__response"
    comment__record_posted "$reply_file" "$reply_json"
    reply_url=$(jq -r '.url' <<<"$reply_json")
  fi

  comment__react_apply add "${comment__reactions[@]}" ||
    {
      printf '%s\n' "$reply_url"
      die "Replied, but not every reaction converged on '%s'; rerun the same command" "$c_url"
    }

  printf '%s\n' "$reply_url"
}

# shellcheck disable=SC2016
gh_comment_edit() {
  local force=0
  while (( 0 < $# ))
  do
    case $1 in
      --force|-f) force=1; shift ;;
      --pull-request=*) shift ;;
      --) shift; break ;;
      -*) die "comment edit: unknown flag '%s'" "$1" ;;
      *) break ;;
    esac
  done

  local comment_file=${1-}

  [[ -n $comment_file ]] ||
    die 'comment edit requires a <file> argument'

  (( $# <= 1 )) ||
    die "comment edit: unexpected argument '%s'" "$2"

  [[ -r $comment_file ]] ||
    die "'%s' is not readable" "$comment_file"

  comment__has_sidecar "$comment_file" ||
    die "'%s.json' does not exist; post a comment first" "$comment_file"
  c_json=$(comment__sidecar_load "$comment_file") ||
    exit 1
  c_file=$comment_file
  comment__parse_url "$(jq -r '.url' <<<"$c_json")"

  gh_comment__unpin_token

  local remote local_body remote_body posted_body
  remote=$(comment__fetch) ||
    exit 1
  remote_body=$(comment__normalize "$(jq -r '.body // ""' <<<"$remote")")
  local_body=$(comment__normalize "$(< "$comment_file")")

  if [[ $local_body == "$remote_body" ]]
  then
    comment__sidecar_update '. * $fresh | .posted.body = $body' \
      --argjson fresh "$(comment__from_rest <<<"$remote")" --arg body "$remote_body"
    info "'%s' already matches GitHub" "$comment_file"
    printf '%s\n' "$c_url"
    return
  fi

  if jq -e '.posted.body | type == "string"' >/dev/null <<<"$c_json"
  then
    posted_body=$(comment__normalize "$(jq -r '.posted.body' <<<"$c_json")")
    if [[ $remote_body != "$posted_body" ]] && (( ! force ))
    then
      diff -u --label "posted (${comment_file}.json)" --label "GitHub (${c_url})" \
        <(printf '%s\n' "$posted_body") <(printf '%s\n' "$remote_body") >&2
      die "GitHub's copy of '%s' changed since it was posted; fold those changes into '%s', then rerun with --force" "$c_url" "$comment_file"
    fi
  fi

  comment__api --method PATCH "$(comment__endpoint)" -f "body=$(< "$comment_file")" ||
    die "Unable to update comment (HTTP status '%s'): %s" "$comment__status" "$comment__response"

  comment__sidecar_update '. * $fresh | .posted.body = $body' \
    --argjson fresh "$(comment__from_rest <<<"$comment__body")" --arg body "$local_body"
  info 'Comment updated'
  printf '%s\n' "$c_url"
}

gh_comment_react() {
  local mode=add
  local -a rest=()
  comment__parse_reactions react "$@"
  set -- "${comment__args[@]}"
  while (( 0 < $# ))
  do
    case $1 in
      --delete) mode=delete; shift ;;
      --) shift; rest+=("$@"); break ;;
      -*) die "comment react: unknown flag '%s'" "$1" ;;
      *) rest+=("$1"); shift ;;
    esac
  done

  (( ${#rest[@]} == 1 )) ||
    die 'comment react requires exactly one <target> (a comment URL or a tracked file)'
  (( 0 < ${#comment__reactions[@]} )) ||
    die 'comment react requires at least one --reaction'

  comment__target "${rest[0]}"
  gh_comment__unpin_token

  comment__react_apply "$mode" "${comment__reactions[@]}" ||
    die "Not every reaction converged on '%s'; rerun the same command" "$c_url"
  printf '%s\n' "$c_url"
}

# shellcheck disable=SC2016
gh_comment_resolve() {
  local resolved=true
  local -a rest=()
  while (( 0 < $# ))
  do
    case $1 in
      --unresolve) resolved=false; shift ;;
      --) shift; rest+=("$@"); break ;;
      -*) die "comment resolve: unknown flag '%s'" "$1" ;;
      *) rest+=("$1"); shift ;;
    esac
  done

  (( ${#rest[@]} == 1 )) ||
    die 'comment resolve requires exactly one <target> (a review comment URL or a tracked file)'

  comment__target "${rest[0]}"
  [[ $c_kind == review_comment ]] ||
    die "'%s' is a top-level comment; only review threads (#discussion_r<ID>) can be resolved" "$c_url"

  gh_comment__unpin_token

  local thread_id
  thread_id=$(jq -r '.thread_id // empty' <<<"${c_json:-{\}}")
  if [[ -z $thread_id ]]
  then
    local root thread
    root=$(comment__root) ||
      exit 1
    thread=$(comment__thread "$(jq -r '.id' <<<"$root")") ||
      exit 1
    thread_id=$(jq -r '.thread_id' <<<"$thread")
  fi

  local mutation
  if [[ $resolved == true ]]
  then
    mutation='mutation($id: ID!) { resolveReviewThread(input: {threadId: $id}) { thread { isResolved } } }'
  else
    mutation='mutation($id: ID!) { unresolveReviewThread(input: {threadId: $id}) { thread { isResolved } } }'
  fi
  comment__graphql "$c_owner" "$mutation" -f id="$thread_id" ||
    die "Unable to %s the thread holding '%s' (HTTP status '%s'): %s" \
      "$([[ $resolved == true ]] && echo resolve || echo unresolve)" "$c_url" "$comment__status" "$comment__response"

  comment__sidecar_update '.thread_id = $thread_id | .posted.resolved = $resolved' \
    --arg thread_id "$thread_id" --argjson resolved "$resolved"
  printf '%s\n' "$c_url"
}

comment__tracks_target() {
  local json=$1
  [[ $(jq -r '.kind // empty' <<<"$json") == "$c_kind" &&
     $(jq -r '.database_id // empty' <<<"$json") == "$c_db" ]] &&
    [[ $(comment__pr_from_url "$(jq -r '.url' <<<"$json")" 2>/dev/null) == "${c_owner}/${c_repo}/pull/${c_pr}" ]]
}

# shellcheck disable=SC2016
gh_comment_get() {
  comment__reject_flags get "$@"
  local target=${1-} file=${2-}

  [[ -n $target ]] ||
    die 'comment get requires a <target> argument (a comment URL or a tracked file)'
  (( $# <= 2 )) ||
    die "comment get: unexpected argument '%s'" "$3"

  comment__target "$target"
  if [[ -n $c_file ]]
  then
    [[ -z $file || $file == "$c_file" ]] ||
      die "comment get: '%s' is already a tracked file; refresh it with 'comment get %s'" "$c_file" "$c_file"
    file=$c_file
  fi

  gh_comment__unpin_token

  local remote fresh remote_body
  remote=$(comment__fetch) ||
    exit 1
  fresh=$(comment__from_rest <<<"$remote")
  remote_body=$(comment__normalize "$(jq -r '.body // ""' <<<"$remote")")

  if [[ -z $file ]]
  then
    local prefix candidate slug
    prefix=$(comment__name_prefix "$(jq -r '.created_at' <<<"$fresh")" "$(jq -r '.author' <<<"$fresh")")
    for candidate in "${prefix}".md "${prefix}"-*.md
    do
      [[ -e ${candidate}.json ]] ||
        continue
      if comment__tracks_target "$(jq -c . "${candidate}.json" 2>/dev/null || echo '{}')"
      then
        file=$candidate
        break
      fi
    done
    if [[ -z $file ]]
    then
      slug=$(comment__slug "$remote_body")
      file="${prefix}${slug:+-$slug}.md"
    fi
  fi

  local existing='{}' write_body=1 baseline
  if comment__has_sidecar "$file"
  then
    existing=$(comment__sidecar_load "$file") ||
      exit 1
    comment__tracks_target "$existing" ||
      die "'%s' already tracks '%s', not '%s'" "$file" "$(jq -r '.url' <<<"$existing")" "$c_url"
  elif [[ -e $file ]]
  then
    die "'%s' exists and isn't tracked; pick another file" "$file"
  fi

  baseline=$remote_body
  if [[ -e $file ]]
  then
    local local_body posted
    local_body=$(comment__normalize "$(< "$file")")
    posted=$(jq -r '.posted.body // empty' <<<"$existing")
    if [[ $local_body != "$remote_body" && $local_body != "$(comment__normalize "$posted")" ]]
    then
      write_body=0
      baseline=$posted
      info "Keeping local edits in '%s'; push them with 'comment edit %s'" "$file" "$file"
    fi
  fi
  comment__writable "$file"

  local reactions
  reactions=$(comment__viewer_reactions "$(jq -r '.id' <<<"$fresh")") ||
    exit 1
  c_file=$file
  c_json=$(jq --argjson fresh "$fresh" --arg body "$baseline" --argjson reactions "$reactions" \
             '. * $fresh | (if $body == "" then del(.posted.body) else .posted.body = $body end)
              | .posted.reactions = $reactions' <<<"$existing")
  if [[ $c_kind == review_comment ]]
  then
    local root thread
    root=$(comment__root) ||
      exit 1
    thread=$(comment__thread "$(jq -r '.id' <<<"$root")") ||
      exit 1
    c_json=$(jq --argjson thread "$thread" '.thread_id = $thread.thread_id | .posted.resolved = $thread.resolved' <<<"$c_json")
  fi

  if (( write_body ))
  then
    printf '%s\n' "$remote_body" > "$file" ||
      die "Unable to write '%s'" "$file"
  fi
  comment__sidecar_write "$file" "$c_json" ||
    exit 1
  printf '%s\n' "$file"
}

gh_comment_delete() {
  local force=0

  # Leading flags. --force skips the confirmation prompt (batch cleanup).
  while (( 0 < $# ))
  do
    case "$1" in
      --force|-f) force=1; shift ;;
      --)         shift; break ;;
      -*)         die "comment delete: unknown flag '%s'" "$1" ;;
      *)          break ;;
    esac
  done

  local comment_file=${1-}

  [[ -n $comment_file ]] ||
    die 'comment delete requires a <file> argument'

  (( $# <= 1 )) ||
    die "comment delete: unexpected argument '%s'" "$2"

  if ! comment__has_sidecar "$comment_file"
  then
    info "'%s.json' doesn't exist. Assuming already cleaned up." "$comment_file"
    return
  fi

  c_json=$(comment__sidecar_load "$comment_file") ||
    exit 1
  c_file=$comment_file
  comment__parse_url "$(jq -r '.url' <<<"$c_json")"

  info 'Found comment URL: %s' "$c_url"

  local comment_path owner_repo="${c_owner}/${c_repo}"
  comment_path=/$(comment__endpoint)

  gh_comment__unpin_token

  local author viewer
  author=$(jq -r '.author // empty' <<<"$c_json")
  if [[ -n $author ]]
  then
    viewer=$(comment__viewer) ||
      exit 1
    if [[ ${author,,} != "${viewer,,}" ]] && (( force ))
    then
      die "'%s' is %s's comment, not yours; --force only deletes your own comments, so rerun without it to confirm" "$c_url" "$author"
    fi
  fi

  local head_response head_status
  head_response=$(gh api --method HEAD --include "${comment_path}" --hostname github.com 2>&1)
  head_status=$(gh_comment__http_status "$head_response")

  case $head_status in
    2??)
      ;;
    404|410)
      gh_comment__repo_reachable "$owner_repo" ||
        die "'%s' returned %s, but repository '%s' isn't reachable either, so access may be the problem; keeping '%s.json'" "$comment_path" "$head_status" "$owner_repo" "$comment_file"
      info "Comment at '%s' no longer exists. Removing stale '%s.json'." "$comment_path" "$comment_file"
      rm -fv "${comment_file}.json" "${comment_file}.url" >&2 ||
        die "Unable to remove stale '%s.json'" "$comment_file"
      return
      ;;
    *)
      die "Unable to check whether '%s' still exists (HTTP status '%s'); keeping '%s.json': %s" "$comment_path" "$head_status" "$comment_file" "$head_response"
      ;;
  esac

  if (( ! force ))
  then
    local whose=''
    [[ -n $author && ${author,,} != "${viewer,,}" ]] &&
      whose=" (${author}'s comment, not yours)"
    read -rp "Really delete '${comment_path}'${whose}? y/N " resp
    if [[ $resp != y ]]
    then
      info "Aborted at user's request."
      return
    fi
  fi

  local delete_response delete_status
  delete_response=$(
    gh api \
       "${comment_path}" \
       --method DELETE \
       --include \
       -H "Accept: application/vnd.github+json" \
       -H "X-GitHub-Api-Version: 2022-11-28" \
       "${comment_path}" \
       --hostname github.com \
       2>&1
  )
  delete_status=$(gh_comment__http_status "$delete_response")

  case $delete_status in
    2??)
      rm -fv "${comment_file}.json" "${comment_file}.url" >&2 ||
        die "Deleted comment for '%s', but unable to remove '%s.json'" "$comment_file" "$comment_file"
      info "Deleted comment for '%s'" "$comment_file"
      ;;
    404|410)
      gh_comment__repo_reachable "$owner_repo" ||
        die "DELETE '%s' returned %s, but repository '%s' isn't reachable either, so access may be the problem; keeping '%s.json'" "$comment_path" "$delete_status" "$owner_repo" "$comment_file"
      rm -fv "${comment_file}.json" "${comment_file}.url" >&2 ||
        die "Comment already gone for '%s', but unable to remove '%s.json'" "$comment_file" "$comment_file"
      info "Comment already gone. Removed state for '%s'" "$comment_file"
      ;;
    *)
      die "Unexpected response deleting comment for '%s' (HTTP status '%s'); keeping '%s.json': %s" "$comment_file" "$delete_status" "$comment_file" "$delete_response"
      ;;
  esac
}

gh_comment() {
  local comment_pr_url=''

  while (( 0 < $# ))
  do
    case $1 in
      --pull-request=*)
        comment_pr_url=${1##--pull-request=}
        shift
        ;;
      *)
        break
        ;;
    esac
  done

  case ${1-} in
    edit)    shift; gh_comment_edit "$@" ;;
    reply)   shift; gh_comment_reply "$@" ;;
    react)   shift; gh_comment_react "$@" ;;
    resolve) shift; gh_comment_resolve "$@" ;;
    get)     shift; gh_comment_get "$@" ;;
    delete)  shift; gh_comment_delete "$@" ;;
    *)       gh_comment_post "$@" ;;
  esac
}

# --- subcommand: info ---

gh_info__repo_json() {
  command gh api "repos/${repo_spec}" --jq '{fork, source: .source.full_name, archived}' ||
    die 'Unable to query repo metadata for %s' "$repo_spec"
}

gh_info__main_repo() {
  local repo_json=$1 is_fork source_repo
  is_fork=$(jq -r .fork <<<"$repo_json")
  source_repo=$(jq -r .source <<<"$repo_json")

  if [[ $is_fork == true && $source_repo != null ]]
  then
    printf '%s\n' "$source_repo"
  else
    printf '%s\n' "$repo_spec"
  fi
}

gh_info() {
  local field=${1-}

  [[ -n $field ]] ||
    die 'info requires a <field> argument'

  (( $# <= 1 )) ||
    die "info: unexpected argument '%s'; use 'timvisher_gh -C <path> info %s' to query another worktree, or 'timvisher_gh -R OWNER/REPO info %s' to query another repository" \
      "$2" "$field" "$field"

  local repo_json
  case $field in
    .forkNetwork.mainRepo)
      repo_json=$(gh_info__repo_json) ||
        return $?
      gh_info__main_repo "$repo_json"
      ;;
    .archived)
      repo_json=$(gh_info__repo_json) ||
        return $?
      jq -r '.archived == true' <<<"$repo_json"
      ;;
    .forkNetwork.mainOwner)
      local main_repo
      main_repo=$(gh_info .forkNetwork.mainRepo) ||
        return $?
      printf '%s\n' "${main_repo%%/*}"
      ;;
    .me)
      command gh -R "$repo_spec" api user --jq .login ||
        die 'Unable to query authenticated user'
      ;;
    --json)
      # The .timvisher_* keys are namespaced so a caller can merge this
      # document into gh's own JSON if they want both. We deliberately
      # do not do that merge for them by extending gh's output in
      # place, because gh cannot be modified and every route in costs
      # more than it returns:
      #
      #   - '--json' rejects unknown field names outright ("Unknown
      #     JSON field"), so naming our keys there would mean
      #     intercepting the flag and rewriting the caller's field list
      #     against a registry of names that are ours.
      #   - gh's '--jq' is gojq, not jq. Lifting the expression out to
      #     a real jq so it can see merged keys swaps the evaluator
      #     under the caller: gojq has no keys_unsorted and no
      #     $__loc__, so expressions that did not change would start
      #     behaving differently.
      #   - Responses are not all objects. 'pr list --json' is an
      #     array, which has no top-level key to extend, so the
      #     semantics would be per-command rather than general.
      #   - '--template' could never see merged keys, and the gh shim
      #     execs gh, so capturing output to post-process it would cost
      #     streaming, pager behavior and exit-code transparency on
      #     every gh call to serve the few that want our context.
      #
      # Hence a subcommand we own the contract for: always an object,
      # no foreign flags to rewrite, no evaluator swapped. Callers who
      # want both documents merge them on their side.
      [[ -z $repo_override ]] ||
        die "info --json needs a worktree, since it merges 'timvisher_git info --json'; -R names only a repository, so query a single field instead"

      local git_blob main_repo archived me
      git_blob=$(timvisher_git info --json) ||
        die 'Unable to query timvisher_git context for %s' "$toplevel"
      repo_json=$(gh_info__repo_json) ||
        return $?
      main_repo=$(gh_info__main_repo "$repo_json")
      archived=$(jq '.archived == true' <<<"$repo_json")
      me=$(gh_info .me) ||
        return $?

      jq -n \
        --argjson git "$git_blob" \
        --arg me "$me" \
        --arg mainRepo "$main_repo" \
        --argjson archived "$archived" \
        '$git + {timvisher_gh: {me: $me,
                                archived: $archived,
                                forkNetwork: {mainRepo: $mainRepo,
                                              mainOwner: ($mainRepo | split("/")[0])}}}' ||
        die 'Unable to render JSON'
      ;;
    *)
      die "Unknown info field: '%s'" "$field"
      ;;
  esac
}

# --- dispatch ---

cmd=$1
shift

case $cmd in
  info)
    gh_info "$@"
    ;;
  pr)
    gh_pr "$@"
    ;;
  issue)
    gh_issue "$@"
    ;;
  comment)
    gh_comment "$@"
    ;;
  *)
    usage
    exit 1
    ;;
esac
