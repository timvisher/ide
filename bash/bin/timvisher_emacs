#!/usr/bin/env bash

# shellcheck source=/dev/null
source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

# shellcheck source=/dev/null
source ~/.functions/aictl.bash ||
  {
    echo "Unable to source aictl functions" >&2
    exit 1
  }

# shellcheck source=/dev/null
source ~/.functions/tool_log.bash ||
  {
    echo "Unable to source tool_log functions" >&2
    exit 1
  }

# shellcheck source-path=SCRIPTDIR source=../lib/timvisher_emacs_peers.bash
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib/timvisher_emacs_peers.bash" ||
  {
    echo "Unable to source timvisher_emacs peers functions" >&2
    exit 1
  }

timvisher_emacs__schema_version=1

# The budget, in seconds, for one probe of one Emacs: 'agent-shell ls'
# and the session scan. Not a liveness verdict -- an Emacs running Lisp
# cannot service its server until it yields, so the probe measures
# contention, not health. 60 clears the worst contention measured on a
# loaded Emacs (36s for '(emacs-pid)', 2026-11-14) rather than the cost
# of the query itself, which is microseconds whatever the buffer count.
timvisher_emacs__probe_timeout=60

timvisher_emacs__prompt_cell_jq='def prompt_cell: (.permission_prompt // "-") | split("\n") | map(select(test("^```") | not)) | join(" ")
  | gsub("[[:space:]]+"; " ") | if 60 < length then .[0:59] + "…" else . end;'

# Matches the process name of an Emacs (emacs, Emacs, emacs-31.1) and
# not emacsclient.
timvisher_emacs__process_re='^emacs(-[0-9.]+)?$'

show_help() {
  cat <<'EOF'
Usage: timvisher_emacs server ls [--schema-version <N>]
       timvisher_emacs server socket <pid>
       timvisher_emacs server eval [--timeout <seconds>] <pid> <expression>
       timvisher_emacs agent-shell ls [--format json|table] [--timeout <seconds>] [--local] [--refresh]
       timvisher_emacs agent-shell peers [--format json|table]
       timvisher_emacs agent-shell start --emacs <pid> [--agent claude|codex] [--prompt-file <file>] [--timeout <seconds>]
       timvisher_emacs agent-shell get-server [--timeout <seconds>] <session>
       timvisher_emacs agent-shell send [--timeout <seconds>] [--emacs <pid>] <session> <message-file|->
       timvisher_emacs agent-shell is-wedged [--quiet-seconds <N>] [--timeout <seconds>] <session>
       timvisher_emacs agent-shell recover fork [--message-file <file>] [--timeout <seconds>] <session>
       timvisher_emacs agent-shell permission-prompt [--show] <session>
       timvisher_emacs agent-shell permission-prompt approve|approve-always|deny [--timeout <seconds>] <session>
       timvisher_emacs agent-shell turn cancel [--timeout <seconds>] <session>
       timvisher_emacs agent-shell launch [<checkout options>] claude|codex [<emacs args>...]
       timvisher_emacs cleanup [--no-dry-run] [--even-with-agent-shells] [--timeout <seconds>]
       timvisher_emacs dev [<checkout options>] [--] [<emacs args>...]

  server ls      print every live Emacs server as JSON (see 'timvisher_emacs server ls --help')
  server socket  print the absolute socket path of the Emacs with that pid
  server eval    evaluate an expression in the Emacs with that pid; prints its value
  agent-shell ls          list every agent-shell in every live Emacs: name, ref, status,
                          queued prompts, agent, Emacs pid, buffer, directory and, for a
                          blocked shell, its pending permission prompt's title; JSON when
                          stdout is not a terminal, a table when it is; every Emacs is
                          probed at once, and one that does not answer within --timeout
                          seconds (default 60) is reported under .unreachable, with why, and
                          none of its shells are listed; exits 3 when any Emacs went
                          unreachable, so an incomplete roster is detectable without
                          knowing to read .unreachable; with peers configured, every
                          peer's sessions too, as <peer>:<name>, and the Emacsen a peer
                          could not reach under .unreachable with its host (--local: this
                          host only; --refresh: skip the peer cache)
  agent-shell peers       list the configured peers, their transport and target, and
                          whether each answers now
  agent-shell start       start a new agent-shell (claude by default) in the Emacs with that
                          pid, submit the prompt file once it is ready, wait for its session,
                          and print it as JSON with the name and ref to message it by; for
                          an ntmux3 worktree's Emacs, take the pid from ntmux3 get-editor-pid
  agent-shell get-server  print, as JSON, the Emacs server hosting that session's agent-shell;
                          when the search falls back to scanning the servers, an Emacs that
                          does not answer within --timeout seconds (default 60) makes the
                          answer unknown rather than 'not here'
  agent-shell send        queue the file's text in that agent-shell, or submit it if the
                          shell is idle with nothing typed at its prompt; prints queued or
                          submitted, and reports on stderr which Emacs it resolved to and
                          how; --emacs names the Emacs outright, for when resolution
                          cannot settle it and 'agent-shell ls' can show you which; '-'
                          reads the message from stdin; to a peer's session it can also
                          print duplicate (already delivered) or deferred (peer
                          unreachable, kept in its outbox)
  agent-shell is-wedged   print a JSON report on whether that agent-shell is wedged; the
                          answer is .wedged (jq -e .wedged), with the evidence in .reasons;
                          an Emacs that does not answer within --timeout seconds (default 60)
                          is timvisher_emacs_wedge_undetermined, which is not a verdict and
                          not grounds for recover fork
  agent-shell recover fork
                          fork that agent-shell into a new one; once it is ready, show it in
                          the old one's windows, kill the old one, and tell the new one it
                          is a recovery fork in one note carrying the old one's queued
                          prompts in order (plus --message-file's text); prints the outcome
                          as JSON
  agent-shell permission-prompt [--show]
                          print, as JSON, that agent-shell's latest pending permission
                          prompt: its title and its options (allow_once, allow_always,
                          reject_once); exits 1 when none is pending
  agent-shell permission-prompt approve|approve-always|deny
                          answer that prompt with its allow_once, allow_always or
                          reject_once option, through agent-shell's own response path
                          (deny also interrupts the turn, as the prompt's reject key does);
                          waits up to --timeout (default 10) for the answer to land and
                          prints the outcome as JSON
  agent-shell turn cancel interrupt that agent-shell's running turn, as its interrupt key
                          does without asking; waits up to --timeout (default 30) for it to
                          go idle and prints the outcome as JSON; an idle shell is left alone
  agent-shell launch      start a new Emacs, through op run, running a claude or codex
                          agent-shell
  cleanup        stop every emacsclient, then every Emacs (TERM, then KILL after 5s);
                 a dry run unless --no-dry-run. An Emacs hosting an agent-shell is
                 spared and named, as is one that did not answer, since a probe that
                 did not come back is not permission; --even-with-agent-shells kills
                 them too
  dev            start Emacs against dev checkouts of agent-shell, acp.el and shell-maker

Servers are found by the pid of the Emacs that owns them, whatever the
server is named and wherever its socket lives.

A <session> names the agent-shell's Claude session: its id, its name (ide-3f), its
ListAgents ref (4b1e9a), or both as ListAgents prints them ("ide-3f
[4b1e9a]"), resolved through the Claude session files. Its Emacs is the
nearest Emacs ancestor of the session's process, else the server whose
agent-shell buffers include the session.
A <session> can also be <peer>:<session>, a session on another host. A
bare <session> that matches no session here is looked up on the peers,
and resolves when exactly one has it. Peers are the JSON files in
${XDG_CONFIG_HOME:-~/.config}/timvisher/agent-shell/peers.d/<peer>.json:
  {"name": "ws1", "transport": "ssh", "host": "workspace-ws1",
   "ssh_options": ["-o", "ProxyCommand=none"], "probe": ["<argv>"]}
  {"name": "laptop", "transport": "socket", "socket": "~/.local/state/x.sock",
   "outbox": "~/.local/state/x-outbox"}
command (default ~/bin/timvisher_emacs) is the peer's timvisher_emacs. A
probe that exits non-zero marks the peer unreachable without connecting.
A message to an unreachable socket peer with an outbox is deferred into
that Maildir for its keeper to deliver.

Queued text reads as though Tim typed it, so start a message to another
agent with a "From the ... agent (session ...)" line.

permission-prompt approve|approve-always|deny and turn cancel act on
another session's decisions. An agent runs them only when Tim has
explicitly said to answer that prompt or cancel that turn (relayed
instructions included), never on its own judgment. Every
permission-prompt and turn call is logged, with its caller, to the tool
log (timvisher_tool_log).

A busy agent-shell (not one waiting on a permission prompt) is wedged
when its agent process is dead, when no session/prompt request is in
flight, or when the agent has been silent for --quiet-seconds (default
300) with no tool call running. Silence during a running tool call is a
long tool call and never counts.

Checkout options (dev and agent-shell launch):
  --agent-shell <dir>  default $timvisher_agent_shell_checkout, else agent-shell-plus/main
  --acp-el <dir>       default $timvisher_acp_el_checkout, else acp.el/main
  --shell-maker <dir>  default $timvisher_shell_maker_checkout, else shell-maker/main

Each checkout is put on the load-path with -L, has its .elc files
deleted, and is exported as the timvisher_*_checkout variable init.el
reads.
EOF
}

show_ls_help() {
  cat <<'EOF'
Usage: timvisher_emacs server ls [--schema-version <N>]

Print the live Emacs servers of this user as JSON:

  {"schema_version": 1, "servers": [<server>...]}

Server fields:
  pid          the Emacs's pid
  server_name  the socket's file name (server-name in that Emacs)
  socket       the socket's absolute path; pass it to emacsclient -s
  command      the Emacs's command line

An Emacs without a server is not listed.

--schema-version <N> exits 1 unless the current schema_version is <N>.

Schema versions:
  1  the first version; no breaking changes yet.
EOF
}

usage() {
  show_help >&2
}

timvisher_emacs__server_sockets() {
  local -a scope=(-c "/${timvisher_emacs__process_re}/i")
  if [[ -n ${1-} ]]
  then
    scope+=(-p "$1")
  fi

  local line pid socket
  while IFS= read -r line
  do
    case $line in
      p*)
        pid=${line#p}
        ;;
      n/*)
        # Linux lsof follows a Unix socket's path with ' type=STREAM'.
        socket=${line#n}
        socket=${socket% type=*}
        [[ -S $socket ]] && printf '%s\t%s\n' "$pid" "$socket"
        ;;
    esac
  done < <(lsof -a -U -u "$(id -u)" "${scope[@]}" -F pn 2>/dev/null)
}

timvisher_emacs__ls() {
  local pin=''

  while (( 0 < $# ))
  do
    case $1 in
      -h|--help)
        show_ls_help
        return 0
        ;;
      --schema-version)
        pin=${2-}
        shift 2 || { show_ls_help >&2; return 2; }
        ;;
      *)
        show_ls_help >&2
        return 2
        ;;
    esac
  done

  if [[ -n $pin && $pin != "$timvisher_emacs__schema_version" ]]
  then
    aictl_error \
      --code timvisher_emacs_schema_version_mismatch \
      --message "timvisher_emacs's server list is schema_version ${timvisher_emacs__schema_version}, not ${pin}." \
      --reason "server ls --schema-version pins the record contract; this tool serves only its current version." \
      --suggestion "Update the caller for schema_version ${timvisher_emacs__schema_version} and pass --schema-version ${timvisher_emacs__schema_version}" \
      --suggestion "See 'timvisher_emacs server ls --help' for the fields and what changed between versions"
    return 1
  fi

  local pid socket command
  while IFS=$'\t' read -r pid socket
  do
    command=$(ps -o command= -p "$pid") || continue
    jq -n --argjson pid "$pid" --arg socket "$socket" --arg command "$command" \
      '{pid: $pid, server_name: ($socket | split("/") | last), socket: $socket, command: $command}' ||
      return 1
  done < <(timvisher_emacs__server_sockets) |
    jq -s --argjson schema_version "$timvisher_emacs__schema_version" \
      '{schema_version: $schema_version, servers: .}'
}

timvisher_emacs__check_pid() {
  local pid=$1

  if [[ ! $pid =~ ^[0-9]+$ ]]
  then
    aictl_error \
      --code timvisher_emacs_bad_pid \
      --message "'${pid}' is not a pid." \
      --suggestion "Find the pid with 'timvisher_emacs server ls'"
    return 1
  fi

  local name
  if ! name=$(ps -o comm= -p "$pid" 2>/dev/null)
  then
    aictl_error \
      --code timvisher_emacs_no_such_process \
      --message "No process has pid ${pid}." \
      --suggestion "Find a live Emacs with 'timvisher_emacs server ls'"
    return 1
  fi

  name=${name##*/}
  shopt -s nocasematch
  if [[ ! $name =~ $timvisher_emacs__process_re ]]
  then
    shopt -u nocasematch
    aictl_error \
      --code timvisher_emacs_not_emacs \
      --message "Process ${pid} is ${name}, not an Emacs." \
      --suggestion "Find a live Emacs with 'timvisher_emacs server ls'"
    return 1
  fi
  shopt -u nocasematch
}

timvisher_emacs__socket() {
  local pid=$1
  timvisher_emacs__check_pid "$pid" || return 1

  local socket
  IFS=$'\t' read -r _ socket < <(timvisher_emacs__server_sockets "$pid")
  if [[ -z $socket ]]
  then
    aictl_error \
      --code timvisher_emacs_no_server \
      --message "Emacs ${pid} is not running a server." \
      --reason "Every Emacs loading the ide init.el starts one (ide-control-server-start); a failed start is only a message in *Messages*." \
      --suggestion "Start one in that Emacs with M-x ide-control-server-start, or M-x server-start"
    return 1
  fi
  printf '%s\n' "$socket"
}

timvisher_emacs__eval() {
  local timeout=10

  while (( 0 < $# ))
  do
    case $1 in
      --timeout)
        timeout=${2-}
        shift 2 || { usage; return 2; }
        ;;
      *)
        break
        ;;
    esac
  done

  (( 2 == $# )) || { usage; return 2; }

  local pid=$1 expression=$2 socket
  socket=$(timvisher_emacs__socket "$pid") || return 1
  timvisher_emacs__emacsclient "$timeout" "$pid" "$socket" "$expression"
}

timvisher_emacs__emacsclient() {
  # --errfile leaves emacsclient's own diagnostics for the caller and
  # reports nothing: a subcommand whose failure mode is itself the
  # answer has to say what the failure means where it knows, not here.
  local errfile=''
  if [[ ${1-} == --errfile ]]
  then
    errfile=${2-}
    shift 2
  fi

  local timeout=$1 pid=$2 socket=$3 expression=$4

  local out err
  err=$(mktemp) || return 1
  if ! out=$(emacsclient -s "$socket" -w "$timeout" --eval "$expression" 2> "$err")
  then
    if [[ -n $errfile ]]
    then
      cat -- "$err" > "$errfile"
      rm -f -- "$err"
      return 1
    fi
    aictl_error \
      --code timvisher_emacs_eval_failed \
      --message "emacsclient could not evaluate the expression in Emacs ${pid}." \
      --reason "$(< "$err")" \
      --suggestion "A busy Emacs (a minibuffer prompt, a long command) answers late: retry with a longer --timeout" \
      --suggestion "Check that the expression reads and evaluates in that Emacs"
    rm -f -- "$err"
    return 1
  fi
  rm -f -- "$err"
  printf '%s\n' "$out"
}

# Probes every live Emacs at once rather than one after another, so a
# budget that cannot be met is paid once for the whole run instead of
# once per unanswering Emacs: at 27 servers the serial form took
# timeout x busy-count. Each probe's stdout, stderr and exit status are
# left in <dir> under the Emacs's pid; the rows come back in the order
# timvisher_emacs__server_sockets gave them, so callers that pick the
# first match still pick the same one the serial scan did.
timvisher_emacs__probe_servers() {
  local timeout=$1 query=$2 dir=$3

  local pid socket
  local -a probe_pids=() probe_rows=()
  while IFS=$'\t' read -r pid socket
  do
    emacsclient -s "$socket" -w "$timeout" --eval "$query" > "$dir/$pid.out" 2> "$dir/$pid.err" &
    probe_pids+=("$!")
    probe_rows+=("$pid"$'\t'"$socket")
  done < <(timvisher_emacs__server_sockets)

  local i rc
  for (( i = 0; i < ${#probe_pids[@]}; i += 1 ))
  do
    rc=0
    wait "${probe_pids[i]}" || rc=$?
    printf '%s\t%s\n' "${probe_rows[i]}" "$rc"
  done
}

# An Emacs whose server socket already holds a backlog of abandoned
# probes refuses new connections outright, in milliseconds, instead of
# timing out -- so 'refused' means busier than 'timeout' does, and a
# longer budget will not help it.
timvisher_emacs__probe_reason() {
  local err=$1

  if grep -qi 'connection refused' -- "$err"
  then
    printf 'refused\n'
  elif grep -qi 'timed out' -- "$err"
  then
    printf 'timeout\n'
  else
    printf 'error\n'
  fi
}

# emacsclient leads its diagnostics with a blank line often enough that
# 'head -1' comes back empty, so take the first line that says anything.
timvisher_emacs__probe_detail() {
  awk 'NF { print; exit }' "$1"
}

timvisher_emacs__eval_value() {
  local out
  out=$(timvisher_emacs__emacsclient "$@") || return 1
  timvisher_emacs__elisp_string_value <<< "$out"
}

timvisher_emacs__elisp_string() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

timvisher_emacs__with_helpers() {
  local emacs_d
  emacs_d=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../emacs/emacs.d" && pwd -P) || return 1
  # Loaded from this checkout on every call, not from the target Emacs's
  # own config: the helpers then always match this CLI, and an Emacs
  # holding an older copy picks up the current one.
  printf '(progn (load %s nil t) (load %s nil t) (load %s nil t) (load %s nil t) %s)' \
    "$(timvisher_emacs__elisp_string "$emacs_d/timvisher-agent-shell-send.el")" \
    "$(timvisher_emacs__elisp_string "$emacs_d/timvisher-agent-shell-recover.el")" \
    "$(timvisher_emacs__elisp_string "$emacs_d/timvisher-agent-shell-start.el")" \
    "$(timvisher_emacs__elisp_string "$emacs_d/timvisher-agent-shell-permission.el")" \
    "$1"
}

timvisher_emacs__elisp_string_value() {
  perl -0pe 's/\A"//; s/"\n?\z//; s/\\(.)/$1/gs'
}

timvisher_emacs__ancestor_emacs() {
  local pid=$1 ppid name
  while [[ $pid =~ ^[0-9]+$ ]] && (( 1 < pid ))
  do
    read -r ppid name < <(ps -o ppid=,comm= -p "$pid" 2>/dev/null) || return 1
    name=${name##*/}
    shopt -s nocasematch
    if [[ $name =~ $timvisher_emacs__process_re ]]
    then
      shopt -u nocasematch
      printf '%s\n' "$pid"
      return 0
    fi
    shopt -u nocasematch
    pid=$ppid
  done
  return 1
}

timvisher_emacs__ref_hashes() {
  local sock=$1 session_id=$2
  printf 'session:%s' "$sock" | shasum -a 256 | cut -d' ' -f1
  # Claude Code hashes session:sid:<id> instead behind its
  # tengu_session_stable_address flag, so a ref minted either way resolves.
  printf 'session:sid:%s' "$session_id" | shasum -a 256 | cut -d' ' -f1
}

timvisher_emacs__resolve_session() {
  local ref=$1
  local sessions_dir=${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/sessions

  local -a session_files=("$sessions_dir"/*.json)
  [[ -e ${session_files[0]} ]] || return 0

  local want_name='' want_ref=''
  if [[ $ref =~ ^(.*[^[:space:]])[[:space:]]*\[([0-9a-f]{6,12})\]$ ]]
  then
    want_name=${BASH_REMATCH[1]}
    want_ref=${BASH_REMATCH[2]}
  elif [[ $ref =~ ^[0-9a-f]{6,12}$ ]]
  then
    want_ref=$ref
  fi

  local sid pid name sock rank hash best=6 entry
  local -a matches=()
  while IFS=$'\x1f' read -r sid pid name sock
  do
    rank=''
    if [[ -z $want_name && ( $sid == "$ref" ) ]]
    then
      rank=0
    elif [[ -z $want_name && -n $name && $name == "$ref" ]]
    then
      rank=1
    elif [[ -n $want_ref && -n $sock && ( -z $want_name || $name == "$want_name" ) ]]
    then
      while read -r hash
      do
        [[ $hash == "$want_ref"* ]] && rank=2
      done < <(timvisher_emacs__ref_hashes "$sock" "$sid")
    fi
    [[ -n $rank ]] || continue
    # A session whose process is gone still resolves, after every live
    # match: a wedge with a dead agent is what recover fork is for, and
    # its shell is found by session id in the buffer scan.
    kill -0 "$pid" 2>/dev/null || (( rank += 3 ))
    entry=$sid$'\t'$pid$'\t'$name
    if (( rank < best ))
    then
      best=$rank
      matches=("$entry")
    elif (( rank == best ))
    then
      matches+=("$entry")
    fi
  done < <(jq -r '[.sessionId, (.pid | tostring), (.name // ""), (.messagingSocketPath // "")] | join("\u001f")' \
             "${session_files[@]}" 2>/dev/null)

  if (( 1 < ${#matches[@]} ))
  then
    local -a suggestions=()
    for entry in "${matches[@]}"
    do
      IFS=$'\t' read -r sid _ name <<< "$entry"
      suggestions+=(--suggestion "${name} is session ${sid}")
    done
    aictl_error \
      --code timvisher_emacs_ambiguous_session \
      --message "'${ref}' matches ${#matches[@]} sessions." \
      --reason "A short ref can collide with a session started after it was listed." \
      --suggestion "Name the session by its full id, or by its name and ref as ListAgents prints them" \
      "${suggestions[@]}"
    return 1
  fi

  (( 1 == ${#matches[@]} )) && printf '%s\n' "${matches[0]}"
  return 0
}

timvisher_emacs__agent_shell_server() {
  # The probe budget defaults to its own rather than the calling
  # subcommand's --timeout, which is how long the target may take to do
  # the work: letting 'send --timeout 10' shrink it would buy a misroute
  # back. is-wedged passes its own, because there --timeout already
  # means "how long may this host take to answer" and defaults to this
  # same budget.
  local ref=$1 timeout=${2:-$timvisher_emacs__probe_timeout} want_emacs=${3-}
  local sessions_dir=${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/sessions

  local resolved session_id=$ref session_pid='' name=''
  resolved=$(timvisher_emacs__resolve_session "$ref") || return 1
  if [[ -n $resolved ]]
  then
    IFS=$'\t' read -r session_id session_pid name <<< "$resolved"
  fi

  local emacs_pid socket
  if [[ -n $want_emacs ]]
  then
    timvisher_emacs__check_pid "$want_emacs" || return 1
    socket=$(timvisher_emacs__socket "$want_emacs") || return 1
    printf '%s\t%s\tdirected\t%s\t%s\n' "$want_emacs" "$socket" "$session_id" "$name"
    return 0
  fi

  local query verify dir answer answered process_fallback=''
  query="(and (fboundp (quote timvisher-agent-shell-send-buffer)) (timvisher-agent-shell-send-buffer $(timvisher_emacs__elisp_string "$session_id")) t)"

  if [[ -n $session_pid ]] && emacs_pid=$(timvisher_emacs__ancestor_emacs "$session_pid")
  then
    socket=$(timvisher_emacs__socket "$emacs_pid") || return 1
    # The session's process says where it started, not where its shell
    # is now: a session copied to another worktree leaves the old
    # process running under its old Emacs, and sending there is how a
    # message lands in a shell nobody reads. Ask before believing it.
    verify=$(timvisher_emacs__with_helpers "$query") || return 1
    answered=true
    answer=$(emacsclient -s "$socket" -w "$timeout" --eval "$verify" 2>/dev/null) || answered=false
    if [[ $answered == true && $answer == t ]]
    then
      printf '%s\t%s\tprocess\t%s\t%s\n' "$emacs_pid" "$socket" "$session_id" "$name"
      return 0
    fi
    # Answered nil: the pointer is stale and the scan is the authority.
    # Did not answer: unproven rather than disproven, so keep it for
    # when the scan settles nothing. The subcommand's own error against
    # the session's real host beats a vague resolution failure, and it
    # is what lets is-wedged still say 'undetermined' about a busy one.
    [[ $answered == true ]] || process_fallback=$emacs_pid$'\t'$socket
  fi

  dir=$(mktemp -d) || return 1

  local rc found=''
  local -a unanswered=()
  while IFS=$'\t' read -r emacs_pid socket rc
  do
    # A failed probe is kept apart from an answer of nil: both are
    # empty output, but only nil says the session is not in this Emacs.
    # Collapsing them resolves a busy Emacs's session to a stale shell
    # elsewhere.
    if (( 0 != rc ))
    then
      unanswered+=("${emacs_pid} ($(timvisher_emacs__probe_reason "$dir/$emacs_pid.err"))")
      continue
    fi
    if [[ -z $found && $(< "$dir/$emacs_pid.out") == t ]]
    then
      found=$emacs_pid$'\t'$socket
    fi
  done < <(timvisher_emacs__probe_servers "$timeout" "$query" "$dir")
  rm -rf -- "$dir"

  local joined=''
  if (( 0 < ${#unanswered[@]} ))
  then
    joined=$(IFS=', '; printf '%s' "${unanswered[*]}")
  fi

  if [[ -n $found ]]
  then
    IFS=$'\t' read -r emacs_pid socket <<< "$found"
    if [[ -z $joined ]]
    then
      printf '%s\t%s\tscan\t%s\t%s\n' "$emacs_pid" "$socket" "$session_id" "$name"
      return 0
    fi
    # One Emacs claiming the session does not rule out another holding
    # it too, and a handed-off session has exactly that shape: a live
    # shell in its new Emacs and a stale one in its old. Delivering to
    # whichever answered is how a message lands where nobody is reading
    # and still reports 'submitted'.
    aictl_error \
      --code timvisher_emacs_session_scan_ambiguous \
      --message "Which Emacs hosts an agent-shell for session '${ref}' cannot be settled: Emacs ${emacs_pid} has one, and ${#unanswered[@]} other server(s) could not be asked." \
      --reason "Emacs ${joined} did not answer, so whether one of them also holds this session is unknown. A session that was handed off has a shell in each, differing only by which Emacs it is in, and the stale one is the one nobody reads." \
      --suggestion "Wait for Emacs ${joined} to answer and run this again" \
      --suggestion "See which Emacsen are answering, and what they hold, with 'timvisher_emacs agent-shell ls --format json'" \
      --suggestion "If you know which Emacs you mean, act on that one directly rather than by session alone"
    return 1
  fi

  if [[ -n $process_fallback ]]
  then
    IFS=$'\t' read -r emacs_pid socket <<< "$process_fallback"
    printf '%s\t%s\tprocess\t%s\t%s\n' "$emacs_pid" "$socket" "$session_id" "$name"
    return 0
  fi

  if (( 0 < ${#unanswered[@]} ))
  then
    aictl_error \
      --code timvisher_emacs_session_scan_unreachable \
      --message "Which Emacs hosts an agent-shell for session '${ref}' is unknown: ${#unanswered[@]} of the live servers could not be probed within ${timeout}s." \
      --reason "A probe that did not come back is absence of evidence, not evidence of absence: Emacs ${joined} could each be hosting that shell while busy running Lisp. A refused probe means an Emacs busy enough that probes are already queued on it, which a longer budget will not fix." \
      --suggestion "Raise the budget with 'timvisher_emacs agent-shell get-server --timeout <seconds> ${ref}'" \
      --suggestion "Tell busy from wedged with 'timvisher_emacs server eval --timeout <seconds> <pid> (emacs-pid)'" \
      --suggestion "See which Emacsen are answering with 'timvisher_emacs agent-shell ls --format json'"
    return 1
  fi

  aictl_error \
    --code timvisher_emacs_no_such_session \
    --message "No Emacs server hosts an agent-shell for session '${ref}'." \
    --reason "Neither the session's process (from ${sessions_dir}) nor any live server's agent-shell buffers matched." \
    --suggestion "Name the session by its id, its name or its ListAgents ref; ${sessions_dir}/*.json has sessionId and name" \
    --suggestion "An Emacs without a server cannot be reached: start one there with M-x ide-control-server-start"
  return 1
}

timvisher_emacs__agent_shell_ls() {
  local format=table timeout=$timvisher_emacs__probe_timeout local_only='' refresh=''
  [[ -t 1 ]] || format=json

  while (( 0 < $# ))
  do
    case $1 in
      --format)
        format=${2-}
        [[ $format == json || $format == table ]] || { usage; return 2; }
        shift 2
        ;;
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      --local)
        local_only=1
        shift
        ;;
      --refresh)
        refresh=--refresh
        shift
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  if [[ -n $local_only ]] || ! timvisher_emacs_peers__any
  then
    timvisher_emacs__agent_shell_ls_local "$format" "$timeout"
    return
  fi

  local listing rc=0
  listing=$(timvisher_emacs__agent_shell_ls_local json "$timeout") || rc=$?
  (( 0 == rc || 3 == rc )) || return 1
  timvisher_emacs_peers__refresh "$refresh"
  listing=$(timvisher_emacs_peers__aggregate <<< "$listing") || return 1

  rc=0
  (( 0 == $(jq '.unreachable | length' <<< "$listing") )) || rc=3

  if [[ $format == json ]]
  then
    jq . <<< "$listing"
    return "$rc"
  fi

  {
    printf 'ADDRESS\tREF\tSTATUS\tQUEUED\tAGENT\tEMACS\tBUFFER\tCWD\tPROMPT\n'
    jq -r --arg home "$HOME" "$timvisher_emacs__prompt_cell_jq"' .sessions[] | . as $r |
      [.address, (.ref // "-"), .status, (.pending_prompts | tostring), (.agent // "-"),
       ((if $r.host then $r.host + ":" else "" end) + (.emacs_pid | tostring)), .buffer,
       ((.cwd // "-") | if $r.host then . else sub("^" + $home; "~") end), prompt_cell] | @tsv' <<< "$listing"
  } | column -t -s $'\t'
  timvisher_emacs__report_unreachable <<< "$listing"
  jq -r '.peers[] | select(.reachable | not) | "unreachable: peer \(.name) (\(.error))"' <<< "$listing" >&2
  return "$rc"
}

timvisher_emacs__agent_shell_ls_local() {
  local format=$1 timeout=$2

  local query='(if (not (fboundp (quote agent-shell-buffers))) "[]" (json-serialize (vconcat (delq nil (mapcar (lambda (b) (condition-case nil (with-current-buffer b (let ((st (agent-shell--state))) (list (cons (quote buffer) (buffer-name)) (cons (quote session_id) (or (map-nested-elt st (quote (:session :id))) :null)) (cons (quote agent) (let ((i (map-elt (map-elt st :agent-config) :identifier))) (if i (format "%s" i) :null))) (cons (quote status) (symbol-name (agent-shell-status))) (cons (quote permission_prompt) (if (eq (agent-shell-status) (quote blocked)) (timvisher-agent-shell-permission-summary) :null)) (cons (quote pending_prompts) (length (map-elt st :pending-prompts))) (cons (quote cwd) (or (ignore-errors (agent-shell-cwd)) :null))))) (error nil))) (agent-shell-buffers))))))'
  query=$(timvisher_emacs__with_helpers "$query") || return 1

  local dir shells unreachable pid socket rc reason detail
  dir=$(mktemp -d) || return 1
  shells=$dir/shells
  unreachable=$dir/unreachable
  : > "$shells" || { rm -rf -- "$dir"; return 1; }
  : > "$unreachable" || { rm -rf -- "$dir"; return 1; }
  while IFS=$'\t' read -r pid socket rc
  do
    if (( 0 != rc ))
    then
      reason=$(timvisher_emacs__probe_reason "$dir/$pid.err")
      detail=$(timvisher_emacs__probe_detail "$dir/$pid.err")
      jq -n --argjson pid "$pid" --arg socket "$socket" --argjson timeout "$timeout" \
        --arg reason "$reason" --arg detail "$detail" \
        '{pid: $pid, server_name: ($socket | split("/") | last), socket: $socket,
          timeout_seconds: $timeout, reason: $reason, detail: $detail}' >> "$unreachable"
      continue
    fi
    timvisher_emacs__elisp_string_value < "$dir/$pid.out" |
      jq -c --argjson pid "$pid" --arg socket "$socket" \
        '.[] + {emacs_pid: $pid, server_name: ($socket | split("/") | last), socket: $socket}' >> "$shells"
  done < <(timvisher_emacs__probe_servers "$timeout" "$query" "$dir")

  local sessions_dir=${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/sessions
  local -a session_files=("$sessions_dir"/*.json)
  local claude='[]'
  if [[ -e ${session_files[0]} ]]
  then
    local sid claude_pid name sock tmux ref
    local -a rows=()
    while IFS=$'\x1f' read -r sid claude_pid name sock tmux
    do
      kill -0 "$claude_pid" 2>/dev/null || continue
      ref=''
      [[ -n $sock ]] && ref=$(timvisher_emacs__ref_for "$sock" "$sessions_dir")
      rows+=("$(jq -cn --arg sid "$sid" --arg name "$name" --arg ref "$ref" --arg tmux "$tmux" \
        '{($sid): {name: (if $name == "" then null else $name end),
                   ref: (if $ref == "" then null else $ref end),
                   tmux: (if $tmux == "" then null else $tmux end)}}')")
    done < <(jq -r '[.sessionId, (.pid | tostring), (.name // ""), (.messagingSocketPath // ""), (.tmux // "")] | join("\u001f")' \
               "${session_files[@]}" 2>/dev/null)
    (( 0 == ${#rows[@]} )) || claude=$(printf '%s\n' "${rows[@]}" | jq -s 'add')
  fi

  local listing
  listing=$(jq -n \
    --argjson schema_version "$timvisher_emacs__schema_version" \
    --argjson claude "$claude" \
    --slurpfile shells "$shells" --slurpfile unreachable "$unreachable" \
    '{schema_version: $schema_version,
      sessions: ($shells | map({name: null, ref: null, tmux: null}
                                 + . + ($claude[.session_id // ""] // {}))
                         | sort_by(.emacs_pid, .buffer)),
      unreachable: $unreachable}')
  rm -rf -- "$dir"

  # A roster missing an Emacs's worth of shells still looks like a
  # roster, and .unreachable is easy not to read. The exit status says
  # so without a caller having to know the field exists.
  local rc=0
  (( 0 == $(jq '.unreachable | length' <<< "$listing") )) || rc=3

  if [[ $format == json ]]
  then
    jq . <<< "$listing"
    return "$rc"
  fi

  {
    printf 'NAME\tREF\tSTATUS\tQUEUED\tAGENT\tEMACS\tBUFFER\tCWD\tPROMPT\n'
    jq -r --arg home "$HOME" "$timvisher_emacs__prompt_cell_jq"' .sessions[] |
      [(.name // "-"), (.ref // "-"), .status, (.pending_prompts | tostring), (.agent // "-"),
       (.emacs_pid | tostring), .buffer, ((.cwd // "-") | sub("^" + $home; "~")), prompt_cell] | @tsv' <<< "$listing"
  } | column -t -s $'\t'
  timvisher_emacs__report_unreachable <<< "$listing"
  return "$rc"
}

timvisher_emacs__report_unreachable() {
  jq -r '.unreachable[] | "unreachable: Emacs " + (if .host then .host + ":" else "" end) +
     "\(.pid) (\(.server_name)) " +
     (if .reason == "refused" then "refused the probe, being busy with probes already queued on it"
      elif .reason == "timeout" then "did not answer within \(.timeout_seconds)s"
      else "could not be probed: \(.detail)" end) +
     "; its agent-shells are missing from this listing"' >&2
}

timvisher_emacs__agent_shell_server_json() {
  local timeout=$timvisher_emacs__probe_timeout

  while (( 0 < $# ))
  do
    case $1 in
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  (( 1 == $# )) || { usage; return 2; }

  local ref=$1 found emacs_pid socket found_by session_id name
  found=$(timvisher_emacs__agent_shell_server "$ref" "$timeout") || return 1
  IFS=$'\t' read -r emacs_pid socket found_by session_id name <<< "$found"
  jq -n \
    --argjson schema_version "$timvisher_emacs__schema_version" \
    --arg session_id "$session_id" --arg name "$name" --argjson pid "$emacs_pid" \
    --arg socket "$socket" --arg found_by "$found_by" \
    '{schema_version: $schema_version, session_id: $session_id,
      name: (if $name == "" then null else $name end), pid: $pid,
      server_name: ($socket | split("/") | last), socket: $socket, found_by: $found_by}'
}

timvisher_emacs__agent_shell_send() {
  local timeout=10 emacs=''

  while (( 0 < $# ))
  do
    case $1 in
      --timeout)
        timeout=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --emacs)
        emacs=${2-}
        [[ $emacs =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  (( 2 == $# )) || { usage; return 2; }

  local address=$1 file=$2 spool='' body='' rc
  if [[ $file == - ]]
  then
    spool=$(mktemp "${TMPDIR:-/tmp}/x.agent-shell-send.XXXXXX") || return 1
    if ! cat > "$spool"
    then
      rm -f -- "$spool"
      return 1
    fi
    file=$spool
  fi

  if [[ ! -f $file || ! -r $file ]]
  then
    aictl_error \
      --code timvisher_emacs_no_such_message_file \
      --message "The message file '${file}' is not a readable file." \
      --suggestion "Write the message to a file outside any worktree (e.g. /tmp/x.message) and pass its path"
    return 1
  fi

  local hops=0
  if timvisher_emacs_peers__is_envelope "$file"
  then
    hops=$(awk -F': *' '/^$/ { exit } tolower($1) == "x-hops" { print $2 }' "$file")
    [[ $hops =~ ^[0-9]+$ ]] || hops=0
    body=$(mktemp "${TMPDIR:-/tmp}/x.agent-shell-send.XXXXXX") || { rm -f -- "$spool"; return 1; }
    timvisher_emacs_peers__body "$file" > "$body"
    file=$body
  fi

  timvisher_emacs__agent_shell_send_file "$timeout" "$address" "$file" "$hops" "$emacs"
  rc=$?
  rm -f -- "$spool" "$body"
  return "$rc"
}

timvisher_emacs__agent_shell_send_file() {
  local timeout=$1 address=$2 file=$3 hops=$4 emacs=$5
  file=$(cd -- "$(dirname -- "$file")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$file")") || return 1

  local peer session_id
  IFS=$'\x1f' read -r peer session_id <<< "$(timvisher_emacs_peers__split "$address")"
  if [[ -n $peer ]]
  then
    if [[ -n $emacs ]]
    then
      aictl_error \
        --code timvisher_emacs_peer_unsupported \
        --message "--emacs names an Emacs on this host, so it cannot pick one for '${address}'." \
        --suggestion "Drop --emacs, or run the send on the peer: ssh <peer host> timvisher_emacs agent-shell send --emacs <pid> ${session_id} <message-file>"
      return 1
    fi
    timvisher_emacs_peers__send "$peer" "$session_id" "$file" "$hops"
    return
  fi
  if [[ $address == "$session_id" && $address == *:* && ${address%%:*} =~ $timvisher_emacs_peers__name_re ]]
  then
    timvisher_emacs_peers__config "${address%%:*}"
    return 1
  fi

  local resolved match
  if [[ -z $emacs ]] &&
       resolved=$(timvisher_emacs__resolve_session "$session_id" 2>/dev/null) &&
       [[ -z $resolved ]] && timvisher_emacs_peers__any
  then
    match=$(timvisher_emacs_peers__find "$session_id") || return 1
    if [[ -n $match ]]
    then
      timvisher_emacs_peers__send "${match%%$'\t'*}" "${match#*$'\t'}" "$file" "$hops"
      return
    fi
  fi

  local found emacs_pid socket found_by
  found=$(timvisher_emacs__agent_shell_server "$session_id" '' "$emacs") || return 1
  IFS=$'\t' read -r emacs_pid socket found_by session_id _ <<< "$found"

  local status
  status=$(timvisher_emacs__emacsclient "$timeout" "$emacs_pid" "$socket" \
    "$(timvisher_emacs__with_helpers \
      "(timvisher-agent-shell-send $(timvisher_emacs__elisp_string "$session_id") $(timvisher_emacs__elisp_string "$file"))")") ||
    return 1
  status=${status#\"}
  status=${status%\"}

  case $status in
    queued|submitted)
      # On stderr so stdout stays just the word: 'submitted' is only
      # worth anything if the caller can see which shell it went to.
      aictl_info \
        --code timvisher_emacs_send_resolved \
        --message "${status} to session ${session_id} in Emacs ${emacs_pid} (${socket##*/}), resolved by ${found_by}."
      printf '%s\n' "$status"
      ;;
    *)
      aictl_error \
        --code timvisher_emacs_no_session_buffer \
        --message "Emacs ${emacs_pid} has no agent-shell buffer with session id ${session_id}." \
        --reason "timvisher-agent-shell-send answered: ${status}" \
        --suggestion "The session may have ended or restarted under a new id; re-check it before retrying"
      return 1
      ;;
  esac
}

timvisher_emacs__agent_shell_peers() {
  local format=table
  [[ -t 1 ]] || format=json

  while (( 0 < $# ))
  do
    case $1 in
      --format)
        format=${2-}
        [[ $format == json || $format == table ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  local peer config transport target reachable reason cache fetched age now
  local -a rows=()
  now=$(timvisher_emacs_peers__now)
  while IFS= read -r peer
  do
    transport=null target=null reachable=false reason='' age=null
    if config=$(timvisher_emacs_peers__config "$peer" 2>/dev/null)
    then
      transport=$(jq -c .transport <<< "$config")
      target=$(jq -c 'if .transport == "ssh" then .host else .socket end' <<< "$config")
      if ! timvisher_emacs_peers__probe "$config"
      then
        reason='probe says not reachable'
      elif [[ $transport == '"socket"' ]]
      then
        if timvisher_emacs_peers__ping "$config"
        then
          reachable=true
        else
          reason='no answer to ping'
        fi
      elif timvisher_emacs_peers__ssh "$config" true > /dev/null 2>&1
      then
        reachable=true
      else
        reason='ssh failed'
      fi
    else
      reason='bad peer config'
    fi
    cache=$(timvisher_emacs_peers__cache_dir)/$peer.json
    if [[ -f $cache ]]
    then
      fetched=$(jq -r '.fetched_at // empty' "$cache" 2>/dev/null)
      [[ $fetched =~ ^[0-9]+$ ]] && age=$(( now - fetched ))
    fi
    rows+=("$(jq -cn --arg name "$peer" --argjson transport "$transport" --argjson target "$target" \
                --argjson reachable "$reachable" --arg reason "$reason" --argjson age "$age" \
                '{name: $name, transport: $transport, target: $target, reachable: $reachable,
                  reason: (if $reason == "" then null else $reason end), cache_age_seconds: $age}')")
  done < <(timvisher_emacs_peers__names)

  local listing='[]'
  (( 0 == ${#rows[@]} )) || listing=$(printf '%s\n' "${rows[@]}" | jq -s .)
  listing=$(jq --argjson schema_version "$timvisher_emacs__schema_version" \
              '{schema_version: $schema_version, peers: .}' <<< "$listing")

  if [[ $format == json ]]
  then
    jq . <<< "$listing"
    return
  fi
  {
    printf 'PEER\tTRANSPORT\tTARGET\tREACHABLE\tREASON\tCACHE_AGE\n'
    jq -r '.peers[] | [.name, (.transport // "-"), (.target // "-"), (.reachable | tostring),
                       (.reason // "-"), ((.cache_age_seconds // "-") | tostring)] | @tsv' <<< "$listing"
  } | column -t -s $'\t'
}

timvisher_emacs__local_only() {
  local op=$1 address=$2 peer session
  IFS=$'\x1f' read -r peer session <<< "$(timvisher_emacs_peers__split "$address")"
  [[ -z $peer ]] && return 0
  aictl_error \
    --code timvisher_emacs_peer_unsupported \
    --message "agent-shell ${op} works only on this host's sessions, not '${address}'." \
    --suggestion "Run it on the peer: ssh <peer host> timvisher_emacs agent-shell ${op} ${session}"
  return 1
}

timvisher_emacs__agent_shell_is_wedged() {
  local quiet_seconds=nil timeout=$timvisher_emacs__probe_timeout

  while (( 0 < $# ))
  do
    case $1 in
      --quiet-seconds)
        quiet_seconds=${2-}
        [[ $quiet_seconds =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  (( 1 == $# )) || { usage; return 2; }

  local found emacs_pid socket session_id
  found=$(timvisher_emacs__agent_shell_server "$1" "$timeout") || return 1
  IFS=$'\t' read -r emacs_pid socket _ session_id _ <<< "$found"

  local report errfile reason detail
  errfile=$(mktemp) || return 1
  if ! report=$(timvisher_emacs__eval_value --errfile "$errfile" "$timeout" "$emacs_pid" "$socket" \
    "$(timvisher_emacs__with_helpers \
      "(timvisher-agent-shell-wedge-report $(timvisher_emacs__elisp_string "$session_id") $quiet_seconds)")")
  then
    reason=$(timvisher_emacs__probe_reason "$errfile")
    detail=$(timvisher_emacs__probe_detail "$errfile")
    rm -f -- "$errfile"

    # An Emacs that answered with an error was reachable, so that is a
    # fault in the expression and not a verdict withheld.
    if [[ $reason == error ]]
    then
      aictl_error \
        --code timvisher_emacs_eval_failed \
        --message "emacsclient could not evaluate the wedge report in Emacs ${emacs_pid}." \
        --reason "$detail" \
        --suggestion "Check that timvisher-agent-shell-wedge-report loads and evaluates in that Emacs"
      return 1
    fi

    local -a retry=()
    if [[ $reason == refused ]]
    then
      retry=(--suggestion "A refused probe means that Emacs already has probes queued on its server socket; a longer --timeout cannot clear them, only waiting for it to yield can")
    else
      retry=(--suggestion "Retry with a longer budget: 'timvisher_emacs agent-shell is-wedged --timeout <seconds> ${1}'")
    fi

    aictl_error \
      --code timvisher_emacs_wedge_undetermined \
      --message "Whether session ${session_id} is wedged is unknown: Emacs ${emacs_pid} did not answer the wedge report within ${timeout}s (${reason})." \
      --reason "A probe that did not come back is absence of evidence, not evidence of wedging: an Emacs running Lisp cannot service its server until it yields, however healthy the shell inside it is." \
      --suggestion "This is NOT grounds for 'recover fork'. That kills the shell, and nothing here says the shell is broken" \
      --suggestion "Ask the Emacs something cheap first: 'timvisher_emacs server eval --timeout <seconds> ${emacs_pid} (emacs-pid)'" \
      "${retry[@]}"
    return 1
  fi
  rm -f -- "$errfile"

  if [[ $report != '{'* ]]
  then
    aictl_error \
      --code timvisher_emacs_no_session_buffer \
      --message "Emacs ${emacs_pid} has no agent-shell buffer with session id ${session_id}." \
      --reason "timvisher-agent-shell-wedge-report answered: ${report}"
    return 1
  fi
  jq . <<< "$report"
}

timvisher_emacs__agent_shell_recover_fork() {
  local timeout=180 message_file=''

  while (( 0 < $# ))
  do
    case $1 in
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      --message-file)
        message_file=${2-}
        shift 2 || { usage; return 2; }
        ;;
      *)
        break
        ;;
    esac
  done

  (( 1 == $# )) || { usage; return 2; }

  local message_arg=nil
  if [[ -n $message_file ]]
  then
    if [[ ! -f $message_file || ! -r $message_file ]]
    then
      aictl_error \
        --code timvisher_emacs_no_such_message_file \
        --message "The message file '${message_file}' is not a readable file." \
        --suggestion "Write the message to a file outside any worktree (e.g. /tmp/x.message) and pass its path"
      return 1
    fi
    message_file=$(cd -- "$(dirname -- "$message_file")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$message_file")") || return 1
    message_arg=$(timvisher_emacs__elisp_string "$message_file")
  fi

  local found emacs_pid socket session_id
  found=$(timvisher_emacs__agent_shell_server "$1") || return 1
  IFS=$'\t' read -r emacs_pid socket _ session_id _ <<< "$found"
  local sid_arg
  sid_arg=$(timvisher_emacs__elisp_string "$session_id")

  local status
  status=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
    "$(timvisher_emacs__with_helpers "(timvisher-agent-shell-recover-fork $sid_arg $message_arg)")") || return 1
  if [[ $status != '{'* ]]
  then
    aictl_error \
      --code timvisher_emacs_no_session_buffer \
      --message "Emacs ${emacs_pid} has no agent-shell buffer with session id ${session_id}." \
      --reason "timvisher-agent-shell-recover-fork answered: ${status}"
    return 1
  fi

  SECONDS=0
  while [[ $(jq -r .status <<< "$status") == forking ]] && (( SECONDS < timeout ))
  do
    sleep 1
    status=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
      "(timvisher-agent-shell-recover-status $sid_arg)") || return 1
  done

  case $(jq -r .status <<< "$status") in
    recovered)
      jq . <<< "$status"
      ;;
    failed)
      aictl_error \
        --code timvisher_emacs_recovery_failed \
        --message "The recovery fork of session ${session_id} failed; the old shell was left running." \
        --reason "$(jq -r '.error // "unknown"' <<< "$status")" \
        --suggestion "Fork it by hand with C-c F in that shell, or kill it and start over"
      return 1
      ;;
    *)
      aictl_error \
        --code timvisher_emacs_recovery_pending \
        --message "The recovery fork of session ${session_id} was not ready after ${timeout}s; it may still finish." \
        --reason "Emacs finishes the recovery (killing the old shell and briefing the new one) when the new shell is ready, whether or not this command is waiting." \
        --suggestion "Check on it: timvisher_emacs server eval ${emacs_pid} '(timvisher-agent-shell-recover-status ${sid_arg})'"
      return 1
      ;;
  esac
}

timvisher_emacs__log_session=''
timvisher_emacs__log_emacs_pid=''
timvisher_emacs__log_outcome=''

timvisher_emacs__logged() {
  local t0=$EPOCHREALTIME rc
  "$@"
  rc=$?

  local extra
  extra=",\"target_session\":$(timvisher_tool_log_json "$timvisher_emacs__log_session")"
  extra+=",\"emacs_pid\":${timvisher_emacs__log_emacs_pid:-null}"
  extra+=",\"outcome\":$(timvisher_tool_log_json "$timvisher_emacs__log_outcome")"
  timvisher_tool_log_write timvisher_emacs "$(realpath "${BASH_SOURCE[0]}")" "$t0" "$rc" "$extra" \
    "${timvisher_emacs__argv[@]}"
  return "$rc"
}

timvisher_emacs__wait_operation() {
  local emacs_pid=$1 socket=$2 sid_arg=$3 timeout=$4 done_filter=$5 status

  SECONDS=0
  while :
  do
    status=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
      "$(timvisher_emacs__with_helpers "(timvisher-agent-shell-operation-status $sid_arg)")") || return 1
    if [[ $status != '{'* ]] || [[ $(jq -r "$done_filter" <<< "$status") == true ]] || (( timeout <= SECONDS ))
    then
      printf '%s\n' "$status"
      return 0
    fi
    sleep 0.5
  done
}

timvisher_emacs__agent_shell_permission_prompt() {
  local answer=show timeout=10

  case ${1-} in
    --show)
      shift
      ;;
    approve|approve-always|deny)
      answer=$1
      shift
      ;;
  esac

  while (( 0 < $# ))
  do
    case $1 in
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  (( 1 == $# )) || { usage; return 2; }

  local found emacs_pid socket session_id name
  found=$(timvisher_emacs__agent_shell_server "$1") || return 1
  IFS=$'\t' read -r emacs_pid socket _ session_id name <<< "$found"
  timvisher_emacs__log_session=$session_id
  timvisher_emacs__log_emacs_pid=$emacs_pid
  local sid_arg
  sid_arg=$(timvisher_emacs__elisp_string "$session_id")

  local report
  if [[ $answer == show ]]
  then
    report=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
      "$(timvisher_emacs__with_helpers "(timvisher-agent-shell-permission-prompt $sid_arg)")") || return 1
  else
    local kind
    case $answer in
      approve) kind=allow_once ;;
      approve-always) kind=allow_always ;;
      deny) kind=reject_once ;;
    esac
    report=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
      "$(timvisher_emacs__with_helpers "(timvisher-agent-shell-permission-answer $sid_arg $(timvisher_emacs__elisp_string "$kind"))")") || return 1
  fi

  if [[ $report != '{'* ]]
  then
    timvisher_emacs__log_outcome=no_buffer
    aictl_error \
      --code timvisher_emacs_no_session_buffer \
      --message "Emacs ${emacs_pid} has no agent-shell buffer with session id ${session_id}." \
      --reason "The permission-prompt helper answered: ${report}"
    return 1
  fi

  if [[ $(jq -r '.prompt == null' <<< "$report") == true ]]
  then
    timvisher_emacs__log_outcome=no_prompt
    aictl_error \
      --code timvisher_emacs_no_permission_prompt \
      --message "Session ${session_id} has no pending permission prompt; it is $(jq -r .status <<< "$report")." \
      --suggestion "See every shell's status, and a blocked one's prompt, with 'timvisher_emacs agent-shell ls'"
    return 1
  fi

  if [[ $answer == show ]]
  then
    timvisher_emacs__log_outcome=shown
    jq --argjson schema_version "$timvisher_emacs__schema_version" \
      --arg name "$name" --argjson pid "$emacs_pid" \
      '{schema_version: $schema_version, session_id, name: (if $name == "" then null else $name end),
        emacs_pid: $pid, buffer, status, pending_count, prompt}' <<< "$report"
    return
  fi

  if [[ $(jq -r .outcome <<< "$report") == no_such_option ]]
  then
    timvisher_emacs__log_outcome=no_such_option
    local -a suggestions=()
    local offered
    while IFS= read -r offered
    do
      suggestions+=(--suggestion "It offers ${offered}")
    done < <(jq -r '.prompt.options[] | "\(.kind) (\(.name))"' <<< "$report")
    aictl_error \
      --code timvisher_emacs_no_such_permission_option \
      --message "Session ${session_id}'s permission prompt offers no ${kind} option, so ${answer} cannot answer it." \
      "${suggestions[@]}"
    return 1
  fi

  local status
  status=$(timvisher_emacs__wait_operation "$emacs_pid" "$socket" "$sid_arg" "$timeout" \
    '.operation.outcome != "scheduled" and (.status != "blocked" or .prompt.tool_call_id != .operation.tool_call_id)') ||
    return 1
  if [[ $status != '{'* ]]
  then
    timvisher_emacs__log_outcome=no_buffer
    aictl_error \
      --code timvisher_emacs_no_session_buffer \
      --message "The agent-shell of session ${session_id} went away while its prompt was being answered." \
      --reason "timvisher-agent-shell-operation-status answered: ${status}"
    return 1
  fi

  timvisher_emacs__log_outcome=$(jq -r '.operation.outcome' <<< "$status")
  case $timvisher_emacs__log_outcome in
    answered)
      jq --argjson schema_version "$timvisher_emacs__schema_version" \
        --arg name "$name" --argjson pid "$emacs_pid" --arg answer "$answer" \
        --argjson scheduled "$report" \
        '{schema_version: $schema_version, session_id, name: (if $name == "" then null else $name end),
          emacs_pid: $pid, buffer, answer: $answer,
          option: ([$scheduled.prompt.options[] | select(.option_id == $scheduled.option_id)] | first),
          answered_prompt: $scheduled.prompt, outcome: .operation.outcome, status,
          next_prompt: .prompt}' <<< "$status"
      ;;
    already_answered)
      aictl_error \
        --code timvisher_emacs_permission_already_answered \
        --message "Session ${session_id}'s permission prompt was answered by someone else before ${answer} could send its answer; nothing was sent." \
        --suggestion "Check whether another prompt is pending: timvisher_emacs agent-shell permission-prompt --show ${session_id}"
      return 1
      ;;
    failed)
      aictl_error \
        --code timvisher_emacs_permission_answer_failed \
        --message "Answering session ${session_id}'s permission prompt failed in Emacs ${emacs_pid}." \
        --reason "$(jq -r '.operation.error // "unknown"' <<< "$status")" \
        --suggestion "Answer it in that shell by hand, or ask Tim to"
      return 1
      ;;
    *)
      aictl_error \
        --code timvisher_emacs_permission_answer_pending \
        --message "Session ${session_id}'s permission prompt was not answered after ${timeout}s." \
        --reason "The answer is sent from a timer in Emacs ${emacs_pid}, which may be busy; it is still sent when the timer runs." \
        --suggestion "Check on it: timvisher_emacs agent-shell permission-prompt --show ${session_id}"
      return 1
      ;;
  esac
}

timvisher_emacs__turn_json() {
  jq --argjson schema_version "$timvisher_emacs__schema_version" --arg name "$1" --argjson pid "$2" \
    '{schema_version: $schema_version, session_id, name: (if $name == "" then null else $name end),
      emacs_pid: $pid, buffer, outcome: (.outcome // .operation.outcome), status}'
}

timvisher_emacs__agent_shell_turn_cancel() {
  local timeout=30

  while (( 0 < $# ))
  do
    case $1 in
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  (( 1 == $# )) || { usage; return 2; }

  local found emacs_pid socket session_id name
  found=$(timvisher_emacs__agent_shell_server "$1") || return 1
  IFS=$'\t' read -r emacs_pid socket _ session_id name <<< "$found"
  timvisher_emacs__log_session=$session_id
  timvisher_emacs__log_emacs_pid=$emacs_pid
  local sid_arg
  sid_arg=$(timvisher_emacs__elisp_string "$session_id")

  local report
  report=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
    "$(timvisher_emacs__with_helpers "(timvisher-agent-shell-turn-cancel $sid_arg)")") || return 1
  if [[ $report != '{'* ]]
  then
    timvisher_emacs__log_outcome=no_buffer
    aictl_error \
      --code timvisher_emacs_no_session_buffer \
      --message "Emacs ${emacs_pid} has no agent-shell buffer with session id ${session_id}." \
      --reason "timvisher-agent-shell-turn-cancel answered: ${report}"
    return 1
  fi

  if [[ $(jq -r .outcome <<< "$report") == idle ]]
  then
    timvisher_emacs__log_outcome=idle
    aictl_info \
      --code timvisher_emacs_turn_idle \
      --message "Session ${session_id} has no turn running; nothing was cancelled."
    timvisher_emacs__turn_json "$name" "$emacs_pid" <<< "$report"
    return 0
  fi

  local status
  status=$(timvisher_emacs__wait_operation "$emacs_pid" "$socket" "$sid_arg" "$timeout" \
    '.operation.outcome != "scheduled" and .status == "ready"') || return 1
  if [[ $status != '{'* ]]
  then
    timvisher_emacs__log_outcome=no_buffer
    aictl_error \
      --code timvisher_emacs_no_session_buffer \
      --message "The agent-shell of session ${session_id} went away while its turn was being cancelled." \
      --reason "timvisher-agent-shell-operation-status answered: ${status}"
    return 1
  fi

  timvisher_emacs__log_outcome=$(jq -r '.operation.outcome' <<< "$status")
  case $timvisher_emacs__log_outcome in
    cancelled)
      if [[ $(jq -r .status <<< "$status") == ready ]]
      then
        timvisher_emacs__turn_json "$name" "$emacs_pid" <<< "$status"
        return 0
      fi
      timvisher_emacs__log_outcome=cancel_pending
      aictl_error \
        --code timvisher_emacs_turn_cancel_pending \
        --message "Session ${session_id}'s turn was cancelled but it was still $(jq -r .status <<< "$status") after ${timeout}s." \
        --reason "The cancel went to the agent, which ends the turn when it acts on it." \
        --suggestion "Check the Emacs is answering at all first: 'timvisher_emacs server eval --timeout <seconds> ${emacs_pid} (emacs-pid)'" \
        --suggestion "Then 'timvisher_emacs agent-shell is-wedged ${session_id}'; only a shell it calls wedged is what 'recover fork' is for"
      return 1
      ;;
    failed)
      aictl_error \
        --code timvisher_emacs_turn_cancel_failed \
        --message "Cancelling session ${session_id}'s turn failed in Emacs ${emacs_pid}." \
        --reason "$(jq -r '.operation.error // "unknown"' <<< "$status")" \
        --suggestion "Interrupt it in that shell by hand, or ask Tim to"
      return 1
      ;;
    *)
      aictl_error \
        --code timvisher_emacs_turn_cancel_pending \
        --message "Session ${session_id}'s turn cancel had not run after ${timeout}s." \
        --reason "The cancel is sent from a timer in Emacs ${emacs_pid}, which may be busy; it is still sent when the timer runs." \
        --suggestion "Check on it with 'timvisher_emacs agent-shell ls'"
      return 1
      ;;
  esac
}

timvisher_emacs__ref_for() {
  local sock=$1 sessions_dir=$2 hash other n=6
  hash=$(printf 'session:%s' "$sock" | shasum -a 256 | cut -d' ' -f1)

  local -a others=()
  local pid other_sock
  while IFS=$'\x1f' read -r pid other_sock
  do
    [[ -z $other_sock || $other_sock == "$sock" ]] && continue
    kill -0 "$pid" 2>/dev/null || continue
    others+=("$(printf 'session:%s' "$other_sock" | shasum -a 256 | cut -d' ' -f1)")
  done < <(jq -r '[(.pid | tostring), (.messagingSocketPath // "")] | join("\u001f")' "$sessions_dir"/*.json 2>/dev/null)

  for other in "${others[@]}"
  do
    while (( n < 12 )) && [[ ${other:0:n} == "${hash:0:n}" ]]
    do
      (( n += 1 ))
    done
  done
  printf '%s\n' "${hash:0:n}"
}

timvisher_emacs__agent_shell_start() {
  local emacs_pid='' agent=claude prompt_file='' timeout=120

  while (( 0 < $# ))
  do
    case $1 in
      --emacs)
        emacs_pid=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --agent)
        agent=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --prompt-file)
        prompt_file=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  [[ -n $emacs_pid ]] || { usage; return 2; }
  case $agent in
    claude|codex)
      ;;
    *)
      aictl_error \
        --code timvisher_emacs_unknown_agent \
        --message "Unknown agent '${agent}'." \
        --suggestion "Pass --agent claude or --agent codex"
      return 2
      ;;
  esac

  local prompt_arg=nil
  if [[ -n $prompt_file ]]
  then
    if [[ ! -f $prompt_file || ! -r $prompt_file ]]
    then
      aictl_error \
        --code timvisher_emacs_no_such_message_file \
        --message "The prompt file '${prompt_file}' is not a readable file." \
        --suggestion "Write the prompt to a file outside any worktree (e.g. /tmp/x.prompt) and pass its path"
      return 1
    fi
    prompt_file=$(cd -- "$(dirname -- "$prompt_file")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$prompt_file")") || return 1
    prompt_arg=$(timvisher_emacs__elisp_string "$prompt_file")
  fi

  local socket
  socket=$(timvisher_emacs__socket "$emacs_pid") || return 1

  local status
  status=$(timvisher_emacs__eval_value 20 "$emacs_pid" "$socket" \
    "$(timvisher_emacs__with_helpers "(timvisher-agent-shell-start $(timvisher_emacs__elisp_string "$agent") $prompt_arg)")") || return 1

  local buffer buffer_arg
  buffer=$(jq -r .buffer <<< "$status") || return 1
  buffer_arg=$(timvisher_emacs__elisp_string "$buffer")

  SECONDS=0
  while [[ $(jq -r '.live and (.session_id == null)' <<< "$status") == true ]] && (( SECONDS < timeout ))
  do
    sleep 1
    status=$(timvisher_emacs__eval_value 10 "$emacs_pid" "$socket" \
      "(timvisher-agent-shell-start-status $buffer_arg)") || return 1
  done

  local session_id
  session_id=$(jq -r '.session_id // empty' <<< "$status")
  if [[ -z $session_id ]]
  then
    if [[ $(jq -r .live <<< "$status") != true ]]
    then
      aictl_error \
        --code timvisher_emacs_start_failed \
        --message "The new ${agent} agent-shell '${buffer}' in Emacs ${emacs_pid} went away before opening a session." \
        --suggestion "Look in that Emacs's *Messages* and the agent's stderr buffer for why"
    else
      aictl_error \
        --code timvisher_emacs_start_pending \
        --message "The new ${agent} agent-shell '${buffer}' in Emacs ${emacs_pid} had no session after ${timeout}s; it may still open one." \
        --reason "The prompt is submitted when the shell is ready, whether or not this command is waiting." \
        --suggestion "Check on it: timvisher_emacs server eval ${emacs_pid} '(timvisher-agent-shell-start-status ${buffer_arg})'"
    fi
    return 1
  fi

  local sessions_dir=${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/sessions name='' sock='' ref=''
  if [[ $agent == claude ]]
  then
    SECONDS=0
    while [[ -z $sock ]] && (( SECONDS < 10 ))
    do
      IFS=$'\x1f' read -r name sock < <(jq -r --arg sid "$session_id" \
        'select(.sessionId == $sid) | [(.name // ""), (.messagingSocketPath // "")] | join("\u001f")' \
        "$sessions_dir"/*.json 2>/dev/null)
      [[ -n $sock ]] || sleep 0.5
    done
    [[ -n $sock ]] && ref=$(timvisher_emacs__ref_for "$sock" "$sessions_dir")
  fi

  jq -n \
    --argjson schema_version "$timvisher_emacs__schema_version" \
    --argjson pid "$emacs_pid" --arg socket "$socket" --arg buffer "$buffer" \
    --arg agent "$agent" --arg session_id "$session_id" --arg name "$name" --arg ref "$ref" \
    '{schema_version: $schema_version, pid: $pid, server_name: ($socket | split("/") | last),
      socket: $socket, buffer: $buffer, agent: $agent, session_id: $session_id,
      name: (if $name == "" then null else $name end),
      ref: (if $ref == "" then null else $ref end)}'
}

# Which Emacsen cleanup must leave alone, as pid<TAB>why lines. An
# Emacs that did not answer counts the same as one hosting shells: a
# probe that did not come back is not permission to kill it.
timvisher_emacs__cleanup_spared() {
  local timeout=$1 listing rc=0
  listing=$(timvisher_emacs__agent_shell_ls --format json --timeout "$timeout") || rc=$?
  if (( 1 == rc || 2 == rc ))
  then
    return 1
  fi

  jq -r '([.sessions[].emacs_pid] | group_by(.)
            | map("\(.[0])\thosts \(length) agent-shell(s)") | .[]),
         (.unreachable[] | "\(.pid)\tdid not answer, so what it hosts is unknown")' \
     <<< "$listing"
}

timvisher_emacs__kill_each() {
  local dry_run=$1 label=$2 re=$3 spared=${4-}

  local -a pids=()
  local pid
  while read -r pid
  do
    pids+=("$pid")
  done < <(pgrep -u "$(id -u)" -i "$re")

  local i why
  for i in "${!pids[@]}"
  do
    pid=${pids[$i]}
    why=''
    [[ -z $spared ]] || why=$(awk -F'\t' -v p="$pid" '$1 == p { print $2; exit }' <<< "$spared")
    if [[ -n $why ]]
    then
      printf "%s Sparing %s '%s': it %s\n" "$(timvisher_date now -u '+%FT%T%z')" "$label" "$pid" "$why" >&2
      continue
    fi
    printf "%s Killing %s %d/%d '%s'\n" "$(timvisher_date now -u '+%FT%T%z')" "$label" "$(( i + 1 ))" "${#pids[@]}" "$pid" >&2
    if [[ $dry_run == true ]]
    then
      printf 'DRY_RUN: kill %s\n' "$pid" >&2
      continue
    fi

    kill "$pid"

    SECONDS=0
    while kill -0 "$pid" 2>/dev/null && (( SECONDS < 5 ))
    do
      sleep 0.1
    done

    if kill -0 "$pid" 2>/dev/null
    then
      kill -9 "$pid"
    fi
  done

  if [[ $dry_run == false ]]
  then
    pgrep -u "$(id -u)" -il "$re" >&2
  fi
}

timvisher_emacs__cleanup() {
  local dry_run=true spare=true timeout=$timvisher_emacs__probe_timeout

  while (( 0 < $# ))
  do
    case $1 in
      --no-dry-run)
        dry_run=false
        shift
        ;;
      --even-with-agent-shells)
        spare=false
        shift
        ;;
      --timeout)
        timeout=${2-}
        [[ $timeout =~ ^[0-9]+$ ]] || { usage; return 2; }
        shift 2
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  # Worked out before any emacsclient is killed, since finding out takes
  # one.
  local spared=''
  if [[ $spare == true ]] && ! spared=$(timvisher_emacs__cleanup_spared "$timeout")
  then
    aictl_error \
      --code timvisher_emacs_cleanup_cannot_tell \
      --message "Which Emacsen host agent-shells could not be established, so none were killed." \
      --reason "cleanup spares an Emacs hosting a live agent-shell, and listing them failed; killing on an unknown roster is how a repair destroys the sessions it was meant to fix." \
      --suggestion "See what 'timvisher_emacs agent-shell ls --format json' reports, and fix that first" \
      --suggestion "Kill regardless with 'timvisher_emacs cleanup --no-dry-run --even-with-agent-shells', knowing it takes live sessions with it"
    return 1
  fi

  timvisher_emacs__kill_each "$dry_run" emacsclients '^emacsclient$'
  timvisher_emacs__kill_each "$dry_run" emacsen "$timvisher_emacs__process_re" "$spared"

  echo 'Done' >&2
}

timvisher_emacs__checkout() {
  local flag=$1 dir=$2
  if [[ ! -d $dir ]]
  then
    aictl_error \
      --code timvisher_emacs_no_such_checkout \
      --message "The ${flag#--} checkout '${dir}' is not a directory." \
      --suggestion "Pass an existing checkout with ${flag} <dir>" \
      --suggestion "Or create the worktree first (ntmux3 -d)"
    return 1
  fi
  (cd -- "$dir" && pwd -P)
}

timvisher_emacs__checkouts() {
  local git_home=${TIMVISHER_GIT_HOME:-${HOME}/git}
  local agent_shell=${timvisher_agent_shell_checkout:-${git_home}/timvisher-dd/agent-shell-plus/main}
  local acp_el=${timvisher_acp_el_checkout:-${git_home}/xenodium/acp.el/main}
  local shell_maker=${timvisher_shell_maker_checkout:-${git_home}/xenodium/shell-maker/main}

  while (( 0 < $# ))
  do
    case $1 in
      --agent-shell)
        agent_shell=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --acp-el)
        acp_el=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --shell-maker)
        shell_maker=${2-}
        shift 2 || { usage; return 2; }
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done
  timvisher_emacs__rest=("$@")

  agent_shell=$(timvisher_emacs__checkout --agent-shell "$agent_shell") || return 1
  acp_el=$(timvisher_emacs__checkout --acp-el "$acp_el") || return 1
  shell_maker=$(timvisher_emacs__checkout --shell-maker "$shell_maker") || return 1

  export timvisher_agent_shell_checkout=$agent_shell
  export timvisher_acp_el_checkout=$acp_el
  export timvisher_shell_maker_checkout=$shell_maker

  local -a elcs=()
  local elc
  for elc in "$agent_shell"/*.elc "$shell_maker"/*.elc "$acp_el"/*.elc
  do
    [[ -e $elc ]] && elcs+=("$elc")
  done
  if (( 0 < ${#elcs[@]} ))
  then
    rm -v -- "${elcs[@]}" >&2
  fi

  timvisher_emacs__emacs_args=(-L "$agent_shell" -L "$shell_maker" -L "$acp_el")
}

timvisher_emacs__dev() {
  timvisher_emacs__checkouts "$@" || return
  exec emacs "${timvisher_emacs__emacs_args[@]}" "${timvisher_emacs__rest[@]}"
}

timvisher_emacs__agent_shell_launch() {
  timvisher_emacs__checkouts "$@" || return
  set -- "${timvisher_emacs__rest[@]}"

  local agent=${1-}
  shift

  case $agent in
    claude)
      timvisher_agent_start_fn=${timvisher_agent_shell_start_fn:-agent-shell-anthropic-start-claude-code}
      ;;
    codex)
      timvisher_agent_start_fn=${timvisher_agent_shell_start_fn:-agent-shell-openai-start-codex}
      ;;
    *)
      aictl_error \
        --code timvisher_emacs_unknown_agent \
        --message "Unknown agent '${agent}'." \
        --suggestion "Pass claude or codex: timvisher_emacs agent-shell launch claude"
      return 2
      ;;
  esac
  export timvisher_agent_start_fn

  # Sourced here and not at the top: it exports TIMVISHER_AGENT, which
  # the agents this Emacs starts need and the other subcommands must not
  # inherit.
  local agents_bash=${XDG_CONFIG_HOME:-${HOME}/.config}/timvisher/ide/ai/agents.bash
  if [[ -r $agents_bash ]]
  then
    # shellcheck disable=SC1090
    . "$agents_bash"
  else
    info '%s not found' "$agents_bash"
  fi

  # Unset CLAUDECODE to avoid the child Emacs connecting to the
  # parent agent's Claude Code MCP server.
  if [[ -n ${CLAUDECODE:-} ]]
  then
    warn 'Unsetting CLAUDECODE=%s to avoid MCP conflict with parent agent' "$CLAUDECODE"
    unset CLAUDECODE
  fi

  exec op run --no-masking -- \
    emacs \
    "${timvisher_emacs__emacs_args[@]}" \
    -l ~/bin/timvisher_emacs.agent-shell.el \
    "$@"
}

case ${1-} in
  -h|--help|help)
    show_help
    exit 0
    ;;
  server)
    case ${2-} in
      ls)
        shift 2
        timvisher_emacs__ls "$@"
        exit
        ;;
      socket)
        (( 3 == $# )) || { usage; exit 2; }
        timvisher_emacs__socket "$3" || exit 1
        ;;
      eval)
        shift 2
        timvisher_emacs__eval "$@"
        exit
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  agent-shell)
    case ${2-} in
      ls)
        shift 2
        timvisher_emacs__agent_shell_ls "$@"
        exit
        ;;
      start)
        shift 2
        timvisher_emacs__agent_shell_start "$@"
        exit
        ;;
      get-server)
        shift 2
        timvisher_emacs__local_only get-server "${!#}" || exit 1
        timvisher_emacs__agent_shell_server_json "$@"
        exit
        ;;
      peers)
        shift 2
        timvisher_emacs__agent_shell_peers "$@"
        exit
        ;;
      send)
        shift 2
        timvisher_emacs__agent_shell_send "$@"
        exit
        ;;
      is-wedged)
        shift 2
        timvisher_emacs__local_only is-wedged "${!#}" || exit 1
        timvisher_emacs__agent_shell_is_wedged "$@"
        exit
        ;;
      recover)
        [[ ${3-} == fork ]] || { usage; exit 2; }
        shift 3
        timvisher_emacs__local_only 'recover fork' "${!#}" || exit 1
        timvisher_emacs__agent_shell_recover_fork "$@"
        exit
        ;;
      permission-prompt)
        timvisher_emacs__argv=("$@")
        shift 2
        timvisher_emacs__logged timvisher_emacs__agent_shell_permission_prompt "$@"
        exit
        ;;
      turn)
        [[ ${3-} == cancel ]] || { usage; exit 2; }
        timvisher_emacs__argv=("$@")
        shift 3
        timvisher_emacs__logged timvisher_emacs__agent_shell_turn_cancel "$@"
        exit
        ;;
      launch)
        shift 2
        timvisher_emacs__agent_shell_launch "$@"
        exit
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  session)
    aictl_error \
      --code timvisher_emacs_renamed \
      --message "timvisher_emacs session ${2-} is now timvisher_emacs agent-shell ${2-}." \
      --suggestion "Run: timvisher_emacs agent-shell ${*:2}"
    exit 2
    ;;
  cleanup)
    shift
    timvisher_emacs__cleanup "$@"
    exit
    ;;
  dev)
    shift
    timvisher_emacs__dev "$@"
    exit
    ;;
  *)
    usage
    exit 2
    ;;
esac
