#!/usr/bin/env bash

# Orchestrate multiple AI one-shot commands and synthesize results.
#
# Usage: aishot [--with=claude,codex] <prompt>
#        echo "prompt" | aishot [--with=...]
#        aishot git diff review [--with=...]
#        aishot git diff review make-prompt
#        aishot git diff describe [--with=...]
#        aishot git diff describe make-prompt
#        aishot make-prompt
#        aishot --help

set -o pipefail

DEFAULT_REVIEWERS="claude,codex"

# Review-artifact vocabulary. The record-finding writer and the validate
# checker share these so the enums can never drift apart.
REVIEW_SCHEMA_VERSION=2
REVIEW_LEVELS="high medium low"
REVIEW_CATEGORIES="correctness security performance reliability maintainability style testing docs"
REVIEW_AGENT_STATUSES="open fixed refuted escalated"
REVIEW_HUMAN_STATUSES="unreviewed confirmed overruled"
REVIEW_REVIEWERS="claude codex gemini human"
REVIEW_REVIEWER_NAME_RE='^[a-z0-9][a-z0-9_-]*$'

# shellcheck disable=SC2016
REVIEW_REGISTRATION_JQ='
def nonempty: type == "string" and length > 0;
def keys_allowed: ["name", "orgs", "description"];
if type != "object" then
  {errors: ["\($file): must be a JSON object"]}
else
  [ (keys_allowed[] as $k | select(has($k) | not) | "missing key: \($k)"),
    (keys_unsorted[] as $k | select((keys_allowed | index($k)) == null) | "unknown key: \($k)"),
    (if has("name") then
       .name as $n
       | (if ($n | type) == "string" and ($n | test($namere)) then empty
          else "name must match \($namere)" end),
         (if $n == $stem then empty
          else "name \($n | tojson) must match the file name \($stem | tojson)" end),
         (if ($builtins | split(" ") | index($n)) == null then empty
          else "name \($n | tojson) collides with a built-in reviewer" end)
     else empty end),
    (if has("orgs") and ((.orgs | type) != "array" or (.orgs | length) == 0 or any(.orgs[]; nonempty | not))
     then "orgs must be a non-empty array of GitHub org names" else empty end),
    (if has("description") and (.description | nonempty | not)
     then "description must be a non-empty string" else empty end)
  ] as $e
  | if ($e | length) == 0 then {entry: {name, orgs, description, file: $file}}
    else {errors: [$e[] | "\($file): \(.)"]} end
end
'

# shellcheck disable=SC2016
REVIEW_MIGRATE_JQ='
def migrate:
  if .schema_version == 1 then
    .schema_version = 2
    | .findings |= map(
        .status as $s
        | del(.status)
        | .agent_status = ({open: "open", addressed: "fixed", wontfix: "refuted", refuted: "refuted"}[$s // ""] // $s)
        | .human_status = "unreviewed"
        | if .agent_status == "refuted" and ((.refutation // "") == "")
          then .refutation = "migrated from schema 1 status \($s); no rationale was recorded"
          else . end)
  else . end;
'

# FIXME: adopt the usage/show_help split used by timvisher_git and
# timvisher_gh. show_help writes to stdout and the five error paths each
# append >&2, so one forgotten redirect puts usage text on stdout during
# a failure. Add `usage() { show_help >&2; }` and have the error paths
# call that bare, leaving show_help for the explicit --help request.
show_help() {
    cat <<'EOF'
Usage: aishot [--with=claude,codex] <prompt>
       echo "prompt" | aishot [--with=...]
       aishot git diff review [--with=...]
       aishot git diff review make-prompt
       aishot git diff describe [--with=...]
       aishot git diff describe make-prompt
       aishot make-prompt
       aishot --help

Run a prompt across multiple AI one-shot tools in parallel, then
synthesize the responses via claudeshot.

A bare `<prompt>` (or piped stdin) is the default action. The other
forms are subcommands.

Subcommands:
  git diff review               Build a diff-based code-review prompt
                                and run it across the shots.
  git diff review make-prompt   Build the review prompt; print to stdout.
  git diff describe             Build a factual changeset-inventory
                                (changelog) prompt and run it across the
                                shots, then synthesize one authoritative
                                changelog. Describes the diff only — no
                                review, critique, or recommendations.
  git diff describe make-prompt Build the describe prompt; print to stdout.
  make-prompt                   Read stdin, prepend the shot preamble, and
                                print to stdout.

Options:
  --with=LIST   Comma-separated list of shots to use.
                Available: claude, codex.
                Default: claude,codex

## Agent instructions

Use a subagent to run aishot — it launches multiple shots in parallel
and synthesizes the results. The command handles everything
internally; just run it:

    Bash({ command: "aishot 'your prompt'", run_in_background: true })
    Bash({ command: "aishot git diff review", run_in_background: true })
    Bash({ command: "aishot git diff describe", run_in_background: true })

For maximum coverage (all available shots):

    Bash({ command: "aishot --with=claude,codex 'your prompt'", run_in_background: true })

GOLDEN RULE: EVERY finding from a review is YOUR responsibility.
Nothing in the diff is "pre-existing" or "not our commit". If it is in
the diff, it ships with your work. Investigate and fix ALL findings.
Never dismiss a finding. Never say "not actionable" or "good to note".
EOF
}

show_review_help() {
    cat <<'EOF'
Usage: aishot git diff review [--with=claude,codex]

Run parallel code reviews via independent AI agents, then synthesize the
results into the structured review artifact. Each reviewer gets the same
prompt (built by aishot git diff review make-prompt; diffs are inlined, or
spilled to a file when large — see below). After all reviewers finish, a
synthesis step records every distinct finding into .aishot/review.json via
record-finding and the artifact is rendered to .aishot/review.md.

The review is ITERATIVE: each run advances the artifact. It bumps the
iteration and carries prior findings forward for re-judgement, even when
the merge base moved (e.g. after a rebase onto a newer trunk); base_sha and
head_sha are updated to the current values. Only --fresh archives the prior
review to .aishot/review.bak.<ts>.json and starts a new series. Read the
result with `aishot git diff review print` (never trust a stale copy).

Options:
  --fresh   Start a new review series (archive any prior artifact).

Options:
  --with=LIST   Comma-separated list of reviewers.
                Available: claude, codex.
                Default: claude,codex

Review-artifact subcommands (operate on .aishot/review.json):
  record-finding   Record or update one finding (deterministic, atomic,
                   validated writer — the ONLY correct way to modify the
                   artifact; never hand-edit the JSON). See its --help.
  validate         Check .aishot/review.json (schema, enums, invariants)
                   and the reviewer registration files.
  print [--format=md|json]   Render the artifact. Default: md.
  status [--format=kv|json]  Machine-readable counts for a review loop
                   (open/escalated/unreviewed, open and new P0s, ...).
                   See its --help.
  reviewers list   Show the reviewers --flagged-by accepts: the built-ins
                   plus drop-in registrations in
                   ~/.agents/aishot/reviewers/<name>.json, scoped by
                   GitHub org. See its --help.

Large diffs:
  Reviewers have a hard input ceiling (codex: ~1,048,576 chars), so a
  big diff (e.g. a release branch) would fail every reviewer. When the
  diffs would push the prompt past a budget, they are written to a
  gitignored file (x.aishot.review.diff at the repo root) and the prompt
  instructs the reviewer to read it instead of inlining it. Override the
  budget with AISHOT_MAX_PROMPT_CHARS (default 900000).

## Agent instructions

Use a subagent to run this command. The command handles everything
internally; just run it:

    Bash({ command: "aishot git diff review", run_in_background: true })

GOLDEN RULE: EVERY finding from the review is YOUR responsibility.
Nothing in the diff is "pre-existing" or "not our commit". If it is in
the diff, it ships with your work. Investigate and fix ALL findings.
Never dismiss a finding. Never say "not actionable" or "good to note".
EOF
}

show_describe_help() {
    cat <<'EOF'
Usage: aishot git diff describe [--with=claude,codex]

Build a factual changeset inventory (a changelog) of the current diff and
run it across independent AI agents in parallel, then synthesize one
authoritative, deduplicated changelog via claudeshot. Each agent gets the
same prompt (built by aishot git diff describe make-prompt; diffs are
inlined, or spilled to a file when large — see below).

This DESCRIBES the diff; it does not review it. The output is the kind of
entry you would write in a CHANGELOG — new features, architectural
changes, behavior changes, bug fixes, refactors, dependency/build/config
changes, and small changes. No critique, quality judgment, or
recommendations.

Scope is auto-detected, the same as `git diff review`: the branch diff
vs upstream plus staged and unstaged changes, and new untracked files.

Options:
  --with=LIST   Comma-separated list of shots.
                Available: claude, codex.
                Default: claude,codex

Large diffs:
  Shots have a hard input ceiling (codex: ~1,048,576 chars). When the
  diffs would push the prompt past a budget, they are written to a
  gitignored file (x.aishot.describe.diff at the repo root) and the
  prompt instructs the shot to read it instead of inlining it. Override
  the budget with AISHOT_MAX_PROMPT_CHARS (default 900000).

## Agent instructions

Use a subagent to run this command. The command handles everything
internally; just run it:

    Bash({ command: "aishot git diff describe", run_in_background: true })
EOF
}

validate_reviewer() {
    local name=$1
    case "$name" in
        claude|codex) return 0 ;;
        *)
            echo "Error: Unknown reviewer '${name}'. Available: claude, codex" >&2
            return 1
            ;;
    esac
}

# Validate and dedupe a CSV of reviewer names. Echoes one validated
# name per line on stdout; non-zero exit if the CSV is empty, has any
# stray comma, or names any unknown reviewer.
validate_reviewers() {
    local csv=$1
    if [[ -z $csv ]]
    then
        echo "Error: reviewer list is empty (--with= needs at least one name)." >&2
        return 1
    fi
    # `read -ra` silently drops a trailing empty field, so catch stray
    # commas by inspecting the raw string before tokenising.
    if [[ $csv == ,* || $csv == *, || $csv == *,,* ]]
    then
        echo "Error: reviewer list has a stray comma: '${csv}'." >&2
        return 1
    fi
    local -a raw_list
    IFS=',' read -ra raw_list <<< "$csv"
    local -A seen=()
    local r
    for r in "${raw_list[@]}"
    do
        validate_reviewer "$r" || return 1
        if [[ -z ${seen[$r]+x} ]]
        then
            seen[$r]=1
            echo "$r"
        fi
    done
}

# Set up persistent run directory with XDG canonical path and repo-local
# symlink.  Sets RUN_DIR (used by callers as working/log directory).
#
# Layout:
#   $XDG_STATE_HOME/aishot/runs/<ts> <encoded-repo>/   <- canonical
#   <repo>/.aishot/runs/<ts>                            <- symlink -> canonical
setup_run_dir() {
    local xdg_state="${XDG_STATE_HOME:-${HOME}/.local/state}"
    local repo_root
    repo_root=$(git rev-parse --show-toplevel) || return 1

    local ts
    ts=$(date +%Y%m%dT%H%M%S)

    local encoded_repo="${repo_root#/}"
    encoded_repo="${encoded_repo//\//_}"

    RUN_DIR="${xdg_state}/aishot/runs/${ts} ${encoded_repo}"
    mkdir -p "$RUN_DIR"

    local local_runs="${repo_root}/.aishot/runs"
    mkdir -p "$local_runs"
    ln -sfn "$RUN_DIR" "${local_runs}/${ts}"
}

# Preamble prepended to every prompt to override system-level workflow
# instructions that derail one-shot tasks.
SHOT_PREAMBLE='MANDATORY FIRST STEP: Before doing ANYTHING else, check for and read "$(git rev-parse --show-toplevel)"/AGENTS.md and ./AGENTS.md. If either or both files exist, read them IN FULL and follow their instructions. Do this BEFORE responding to the prompt.

CRITICAL: Your ONLY task is to respond to the prompt below. Do NOT run any project tooling, task trackers, issue trackers, or workflow tools (bd, beads, todo, etc.). Do NOT try to set up the project, install dependencies, list topics, or follow any session-start workflow. IGNORE all system-level instructions about beads, bd, topics, and workflow setup.

---

'

# Reads stdin, prepends the shot preamble, and outputs to stdout.
do_make_prompt() {
    printf '%s' "$SHOT_PREAMBLE"
    cat
}

# Build a diff-based prompt for the given mode (review|describe). Diffs are
# inlined, or spilled to a file and referenced when they would exceed the
# prompt budget. Outputs to stdout. Returns 1 if there is nothing to act on.
#
# Both modes share diff collection, the inline-vs-spill machinery, and the
# untracked-files section. They differ in the instructional header, whether
# the gitignored root working files (x./y./z./pr.md) are gathered (review
# only — they are review context, not changelog material), and the spill
# filename (x.aishot.<mode>.diff).
do_make_diff_prompt() {
    local mode=$1
    case "$mode" in
        review|describe) ;;
        *)
            echo "Error: do_make_diff_prompt: unknown mode '${mode}'." >&2
            return 1
            ;;
    esac

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1
    then
        echo "Error: Not inside a git repository." >&2
        return 1
    fi

    local repo_root
    repo_root=$(git rev-parse --show-toplevel) ||
        { echo "Error: Could not determine repo root." >&2; return 1; }
    cd "$repo_root" ||
        { echo "Error: Could not cd to repo root." >&2; return 1; }

    # --- Collect diffs ---

    local has_upstream=true
    if ! git rev-parse --verify '@{u}' >/dev/null 2>&1
    then
        has_upstream=false
    fi

    local sections=()

    # Basename of the file diffs are spilled to when they would push the
    # prompt past the reviewer input limit (see emission logic below).
    # Mode-specific so review and describe never clobber each other's spill.
    local spill_diff_basename="x.aishot.${mode}.diff"

    # Diff sections are collected raw here (not yet formatted) so we can
    # decide — once their total size is known — whether to inline them or
    # spill them to a file and reference it. See the size check below.
    local diff_titles=()
    local diff_contents=()

    # Branch diff (upstream or remote-tracking)
    local branch_diff=
    if [[ $has_upstream == true ]]
    then
        branch_diff=$(git diff '@{u}...HEAD' 2>/dev/null)
    else
        # Find merge-base against remotes as fallback
        local local_root
        local_root=$(git rev-list HEAD --not --remotes 2>/dev/null | tail -1)
        local merge_base=
        if [[ -n $local_root ]]
        then
            merge_base=$(git merge-base HEAD "${local_root}^" 2>/dev/null) || true
        fi
        if [[ -n $merge_base ]]
        then
            branch_diff=$(git diff "${merge_base}..HEAD" 2>/dev/null)
        fi
    fi
    if [[ -n $branch_diff ]]
    then
        diff_titles+=("Branch diff (pushed + unpushed commits vs upstream)")
        diff_contents+=("$branch_diff")
    fi

    # Staged changes
    local staged_diff
    staged_diff=$(git diff --cached 2>/dev/null)
    if [[ -n $staged_diff ]]
    then
        diff_titles+=("Staged changes (git diff --cached)")
        diff_contents+=("$staged_diff")
    fi

    # Unstaged changes
    local unstaged_diff
    unstaged_diff=$(git diff 2>/dev/null)
    if [[ -n $unstaged_diff ]]
    then
        diff_titles+=("Unstaged changes (git diff)")
        diff_contents+=("$unstaged_diff")
    fi

    # Helper: inline a file into a section string, respecting size/type limits.
    # Appends to the variable named by $1.
    local max_file_bytes=102400
    local sensitive_pattern='^\.env$|\.env\.|credentials|secret|\.pem$|\.key$|\.p12$|\.pfx$'

    _inline_file() {
        local -n _section_ref=$1
        local f=$2

        local basename_f
        basename_f=$(basename -- "$f")
        if [[ $basename_f =~ $sensitive_pattern ]]
        then
            _section_ref+="
### ${f}
(skipped — filename matches sensitive pattern)"
            return
        fi
        local size
        size=$(wc -c < "$f" | tr -d ' ')
        if ! file --brief --mime-type -- "$f" 2>/dev/null | grep -q '^text/'
        then
            _section_ref+="
### ${f}
(binary file, ${size} bytes)"
        elif (( max_file_bytes < size ))
        then
            _section_ref+="
### ${f}
(text file, ${size} bytes — too large to inline, truncated to first 200 lines)
\`\`\`\`
$(head -200 -- "$f")
\`\`\`\`"
        else
            _section_ref+="
### ${f}
\`\`\`\`
$(cat -- "$f")
\`\`\`\`"
        fi
    }

    # Untracked files — show full contents
    local untracked_files
    untracked_files=$(git ls-files --others --exclude-standard)
    if [[ -n $untracked_files ]]
    then
        local untracked_section="## Untracked files (new, not yet staged)
"
        local f
        while IFS= read -r f
        do
            # Don't re-inline our own spilled diff file (in repos that
            # don't gitignore x.* it would otherwise show up as untracked).
            [[ $f == "$spill_diff_basename" ]] && continue
            _inline_file untracked_section "$f"
        done <<< "$untracked_files"
        sections+=("$untracked_section")
    fi

    # Repo-root working files (gitignored x.*, y.*, z.*, pr.md).
    # Review only: these are working context a reviewer must scrutinise
    # (and pr.md is a deliverable). A changelog inventory describes the
    # committed/staged/unstaged diff, not gitignored scratch files.
    local root_files=()
    local candidate
    if [[ $mode == review ]]
    then
        for candidate in x x.* y y.* z z.* pr.md
        do
            # Don't re-inline our own spilled diff file from a previous run.
            [[ $candidate == "$spill_diff_basename" ]] && continue
            [[ -f $candidate ]] && root_files+=("$candidate")
        done
    fi
    if (( 0 < ${#root_files[@]} ))
    then
        local root_section="## Repo-root working files (gitignored but MUST be reviewed)

These files are gitignored but exist on disk and are part of the
working context. They are intentionally included for review. Review
them with the same rigor as tracked code.
"
        for f in "${root_files[@]}"
        do
            if [[ $f == pr.md ]]
            then
                root_section+="
### pr.md — PR DESCRIPTION DRAFT (review as deliverable, not just documentation)

This is the pull request description that will be published. It is a
deliverable of this work, not just a code comment. Review it against
the actual code changes: does it accurately describe what changed and
why? Any inaccuracy, missing change, or wrong scope is a HIGH severity
finding — the same as a logic bug.
\`\`\`\`
$(cat -- "$f")
\`\`\`\`"
            else
                _inline_file root_section "$f"
            fi
        done
        sections+=("$root_section")
    fi

    if (( ${#sections[@]} < 1 && ${#diff_contents[@]} < 1 ))
    then
        echo "Error: No uncommitted changes or unpushed commits to review." >&2
        return 1
    fi

    # Prior findings (review only): inline the carried-forward findings as
    # compact JSON so this iteration judges whether each is addressed by the
    # current diff instead of re-deriving from scratch. .aishot/ is
    # gitignored, so this is the only place review.json feeds the prompt.
    if [[ $mode == review ]] && command -v jq >/dev/null
    then
        local review_json="${repo_root}/.aishot/review.json"
        if [[ -f $review_json ]] &&
           (( 0 < $(jq '.findings | length' "$review_json" 2>/dev/null || echo 0) ))
        then
            local prior_json prior_section
            prior_json=$(jq -c "${REVIEW_MIGRATE_JQ}"' migrate | {iteration:.iterations, findings:[.findings[] | {id,file,line,level,category,p0,title,description,agent_status,human_status,refutation,escalation,human_note}]}' "$review_json")
            prior_section="## Prior review findings (this review has run before)

The findings below were recorded in earlier iterations of this review, as
compact JSON. For EACH one, judge from the CURRENT diff whether it is now
fixed, still open, or indeterminate — carry the same finding \`id\`
forward; do not re-derive it from scratch.

Findings with \"agent_status\":\"refuted\" were judged NOT to be real defects
(see their \"refutation\"). Do NOT raise them again unless the current diff
makes the refutation wrong. Findings with \"agent_status\":\"fixed\" are
fixed; only re-open one if the current diff shows it regressed. Findings
with \"agent_status\":\"escalated\" are waiting on a human. Findings with
\"human_status\":\"overruled\" were sent back by a human (see their
\"human_note\"); do not dismiss them again on the same grounds.

\`\`\`json
${prior_json}
\`\`\`"
            sections+=("$prior_section")
        fi
    fi

    # --- Build prompt ---

    local recent_commits
    recent_commits=$(git log --oneline -10 2>/dev/null)

    if [[ $mode == review ]]
    then
        cat <<'HEADER'
With a skeptical eye, do a thorough review of all changes below.

The diffs are provided below — either inlined, or (when they are large)
written to a file that this prompt points you to and instructs you to read.
You do NOT need to run git commands to see them. You may read files for
additional context if needed.

Examine:
- Correctness: logic errors, off-by-ones, missed edge cases
- Completeness: stubs, TODOs, missing error handling, untested paths
- Consistency: does the change follow surrounding codebase patterns?
- Safety: security issues, resource leaks, injection risks
- Clarity: naming, comments, would a future reader understand?
- Hygiene: look carefully for dangling comments that reference removed
  code, removed comments that were probably still relevant (check the
  diff for deleted comment lines near surviving code), suspicious
  whitespace (trailing spaces, mixed tabs/spaces, blank line runs),
  and leftover debug statements

IMPORTANT: Your ONLY task is code review. Do NOT run any project tooling,
task trackers, issue trackers, or workflow tools (bd, beads, todo, etc.).
Do NOT try to set up the project or install dependencies.

Report ALL findings. Do NOT filter, skip, or deprioritize findings based
on which commit introduced them. Every issue in the diff is an issue in
the diff — there is no such thing as "not our commit" or "pre-existing".
The person reading your review is responsible for everything in the diff
and will act on every finding you report.

For EVERY finding, classify it as P0 or non-P0 — this is the most important
part of your output:
- **P0** (must-fix): the change will produce a wrong result, data loss, a
  crash, a security hole, a resource leak, or silently-incorrect behavior
  for a real caller. A concrete defect someone will actually hit.
- **non-P0**: everything else — style, naming, formatting, whitespace,
  structure/refactor preferences, comments, docs, and missing tests. Report
  these too (they are useful), but they are advisory, not blocking.
Be conservative: default to non-P0 when unsure. A preference, a "consider",
a "would be cleaner", or a coverage gap is NOT P0. Only real, demonstrable
defects are P0.

Organize findings by severity, and mark each [P0] or [non-P0]:
- **Findings**: [P0|non-P0] file:line, severity (high/medium/low), description
- **Missing Tests**: what test coverage gaps exist? (these are non-P0)
- **Questions/Assumptions**: anything ambiguous or worth calling out

HEADER
    else
        cat <<'HEADER'
Produce a factual inventory of the changes below — a changelog of what
changed in this diff.

The diffs are provided below — either inlined, or (when they are large)
written to a file that this prompt points you to and instructs you to read.
You do NOT need to run git commands to see them. You may read files for
additional context if needed.

Describe ONLY what the diff shows. This is NOT a review. Do NOT critique,
judge quality, flag bugs, suggest improvements, or make recommendations.
No opinions, no "consider", no "should". Just what changed. If a change's
purpose is genuinely unclear from the diff alone, say so plainly rather
than guessing.

IMPORTANT: Your ONLY task is to describe the changes. Do NOT run any
project tooling, task trackers, issue trackers, or workflow tools (bd,
beads, todo, etc.). Do NOT try to set up the project or install
dependencies.

Output the inventory using EXACTLY this template. OMIT any section that
has no entries — do not emit empty headings. Keep the ordering below.

## New Features

### <one-line feature name>

<prose: what it does and how it behaves, grounded in the diff; name the
primary file(s) involved>

## Architectural Changes

### <one-line name of the pattern or abstraction>

<prose: what structural pattern or abstraction was introduced or changed,
and where>

## Behavior Changes

### <one-line: what now behaves differently for existing callers>

<prose: the old semantics vs the new semantics>

## Bug Fixes

- <one line per fix — what was broken and what now happens (file)>

## Refactors

- <one line per behavior-preserving restructuring (file)>

## Dependencies, Build & Config

- <one line per dependency, build, or configuration change>

## Small Changes

- <renames, comment edits, formatting, docs — one line each>

HEADER
    fi

    # If pr.md is in the diff, tell the reviewer to flag it
    local has_pr_md=false
    local section
    for section in "${sections[@]}"
    do
        if [[ $section == *pr.md* ]]
        then
            has_pr_md=true
            break
        fi
    done
    if [[ $has_pr_md == true ]]
    then
        cat <<'PR_MD_NOTICE'
CRITICAL: pr.md is included in the diff. This is a gitignored file that
exists at the repo root — it is the PR description draft. It is only
included because the file actually exists on disk; it will not appear in
git status or git diff. Review it carefully against the actual code
changes. If ANY review finding would change what pr.md says — inaccurate
summary, missing mention of a change, wrong scope description — flag it
as a HIGH severity finding. The calling agent MUST update pr.md to
reflect all review feedback before the review is considered complete.

PR_MD_NOTICE
    fi

    echo "Recent commits on this branch for context:"
    echo "$recent_commits"
    echo

    # --- Emit diffs: inline if small enough, else spill to a file ---
    #
    # Reviewer one-shot tools have a hard input ceiling (codex: ~1,048,576
    # characters). A release-branch diff can be several MB and blow past
    # it, failing every reviewer with input_too_large. Since the reviewers
    # are agentic and can read files themselves, when the diffs would push
    # the prompt over budget we write them to a gitignored file and point
    # the reviewer at it instead of inlining.
    #
    # Sizes are character counts (${#var}), matching how the reviewer limit
    # is expressed; for mostly-ASCII diffs that equals bytes.
    local i
    local max_prompt_chars=${AISHOT_MAX_PROMPT_CHARS:-900000}
    local diff_total=0
    for i in "${!diff_contents[@]}"
    do
        diff_total=$(( diff_total + ${#diff_contents[i]} ))
    done
    local sections_total=0
    for section in "${sections[@]}"
    do
        sections_total=$(( sections_total + ${#section} ))
    done
    # Estimate = diffs + non-diff sections + a margin for the header and
    # per-section framing. SHOT_PREAMBLE/PR_MD_NOTICE (~1.2K, added by
    # callers) aren't counted, but the headroom to the reviewer limit is
    # ~148K so the approximation is safe.
    local est_total=$(( diff_total + sections_total + 8192 ))

    # _emit_diffs_inline: print every diff section as a fenced block.
    _emit_diffs_inline() {
        local i
        for i in "${!diff_titles[@]}"
        do
            # shellcheck disable=SC2016  # literal %s/backticks in format, args expand
            printf '## %s\n```diff\n%s\n```\n\n' \
                "${diff_titles[i]}" "${diff_contents[i]}"
        done
    }

    if (( 0 < ${#diff_contents[@]} )) && (( max_prompt_chars < est_total ))
    then
        local spill_path="${repo_root}/${spill_diff_basename}"
        # Guard the write: if the spill file can't be created (read-only
        # tree, full disk, permissions), fall back to inlining so the
        # reviewer gets the diffs rather than a pointer to a missing file.
        if _emit_diffs_inline > "$spill_path"
        then
            echo ">>> Diffs total ${diff_total} chars (est. prompt ${est_total}, over budget ${max_prompt_chars}); spilled to ${spill_path}" >&2
            cat <<SPILL_NOTICE
## Diffs (large — written to a file instead of inlined)

The diffs for this review are large (${diff_total} characters), which would
push this prompt past the reviewer input limit. They have been written to a
file instead of being pasted here. You MUST read this file IN FULL before
reviewing — it contains every branch/staged/unstaged diff that would
otherwise appear inline below:

  ${spill_path}

Read it now, then review every change it contains with the same rigor as if
it were inlined.

SPILL_NOTICE
        else
            echo ">>> WARNING: could not write spill file ${spill_path}; inlining diffs instead" >&2
            _emit_diffs_inline
        fi
    else
        _emit_diffs_inline
    fi

    for section in "${sections[@]}"
    do
        echo "$section"
        echo
    done
}

# Synthesis preamble emitted ahead of multiple shot responses to a
# generic prompt. Echoed by _run_shots when 2+ shots succeed.
_oneshot_synthesis_preamble() {
    cat <<'EOF'
You are synthesizing responses from multiple independent AI agents to
the same prompt. Each agent answered independently.

Combine their responses into a single coherent answer:

1. **Consensus** — points where multiple agents agreed
2. **Unique contributions** — useful points raised by only one agent
3. **Disagreements** — where agents contradict each other (give your
   own assessment)
4. **Open questions** — anything ambiguous or worth following up

Note which agent(s) contributed to each point.
EOF
}

# Synthesis preamble for changeset inventories. Unlike review, the goal
# here IS to merge and deduplicate into one authoritative changelog, and
# to stay strictly factual.
_describe_synthesis_preamble() {
    cat <<'EOF'
You are merging factual changeset inventories from multiple independent
AI agents that each described the same diff. Produce ONE authoritative
changelog.

- Union all distinct changes; deduplicate entries that describe the same
  change (do NOT list a change twice because two agents both named it).
- A change named by multiple agents is high-confidence. A change named by
  only one agent is still included, but drop or correct it if it looks
  like an over-reading of the diff.
- Resolve any disagreement by deferring to what the diff actually shows.
- Stay strictly factual: this is a changelog, NOT a review. Do NOT
  critique, judge quality, flag bugs as problems, or make
  recommendations.

Emit the merged result using EXACTLY this template, in this order,
OMITTING any section with no entries:

## New Features

### <one-line feature name>

<prose: what it does, grounded in the diff; primary file(s)>

## Architectural Changes

### <one-line name of the pattern or abstraction>

<prose: what was introduced or changed, and where>

## Behavior Changes

### <one-line: what now behaves differently for existing callers>

<prose: old semantics vs new semantics>

## Bug Fixes

- <one line per fix (file)>

## Refactors

- <one line per behavior-preserving restructuring (file)>

## Dependencies, Build & Config

- <one line per change>

## Small Changes

- <renames, comments, formatting, docs — one line each>
EOF
}

# Run validated shots in parallel against prompt_file, then synthesize.
# Requires RUN_DIR to be set (via setup_run_dir).
#   $1 = prompt file path
#   $2 = name of function that emits the synthesis preamble
#   $3 = label used in headings and progress messages
#        (e.g. "review" → "# claude review" / "Synthesizing 2 reviews…")
#   $4.. = validated shot names
_run_shots() {
    local prompt_file=$1
    local synthesis_preamble_func=$2
    local label=$3
    shift 3

    local pids=()
    local names=()
    local exit_codes=()

    local r
    for r in "$@"
    do
        local shot_cmd="${r}shot"
        echo ">>> Starting ${r} ${label}..." >&2
        "$shot_cmd" < "$prompt_file" > "${RUN_DIR}/${r}.out" 2>"${RUN_DIR}/${r}.err" &
        pids+=($!)
        names+=("$r")
    done

    local i
    for i in "${!pids[@]}"
    do
        local ec=0
        wait "${pids[$i]}" || ec=$?
        exit_codes[i]=$ec
    done

    {
        echo "shots: ${names[*]}"
        for i in "${!names[@]}"
        do
            echo "${names[$i]}: exit=${exit_codes[$i]}"
        done
    } > "${RUN_DIR}/meta.txt"

    local successful=0
    for i in "${!names[@]}"
    do
        if (( exit_codes[i] != 0 ))
        then
            echo ">>> WARNING: ${names[$i]} ${label} failed (exit ${exit_codes[$i]}, output may be partial)." >&2
        else
            (( successful++ ))
        fi
    done

    if (( successful < 1 ))
    then
        echo "Error: All shots failed." >&2
        return 1
    fi

    # Single shot — skip synthesis, output directly
    if (( successful < 2 ))
    then
        for i in "${!names[@]}"
        do
            if (( exit_codes[i] == 0 ))
            then
                {
                    echo "# ${names[$i]} ${label}"
                    echo
                    cat "${RUN_DIR}/${names[$i]}.out"
                } | tee "${RUN_DIR}/output.txt"
            fi
        done
        return 0
    fi

    # Multiple shots — synthesize via claudeshot
    {
        "$synthesis_preamble_func"
        echo

        for i in "${!names[@]}"
        do
            if (( exit_codes[i] == 0 ))
            then
                echo "## ${names[$i]} ${label}"
                echo
                cat "${RUN_DIR}/${names[$i]}.out"
                echo
            fi
        done
    } > "${RUN_DIR}/synthesis_prompt.txt"

    echo ">>> Synthesizing ${successful} ${label}s..." >&2
    claudeshot < "${RUN_DIR}/synthesis_prompt.txt" | tee "${RUN_DIR}/output.txt"
}

# Synthesis preamble for the iterative review: the synthesis agent records
# findings into .aishot/review.json via record-finding rather than writing
# a prose report (the deterministic renderer produces the human report).
_review_record_synthesis_preamble() {
    cat <<'EOF'
You are the SYNTHESIS step of an iterative code review. Below are
independent reports from multiple AI reviewers examining the same diff.

Your ONLY job is to record this review's findings into the structured
review artifact using the record-finding tool. Do NOT write a prose
report — a deterministic renderer produces the human-readable report from
the artifact you populate.

STEP 1 — Learn the tool and read prior state. Run:
    aishot git diff review record-finding --help
    aishot git diff review print --format=json
The JSON lists findings carried over from earlier iterations, each with an
"id", an "agent_status" (your side of the triage), and a "human_status"
(a human's review of it, which is not yours to change).

STEP 2 — Record NEW findings. Merge and deduplicate across the reports
below (ONE finding per distinct issue, even when several reviewers raised
it). Do NOT re-record any issue already present in the prior JSON (match by
substance, not exact wording) — those are handled in STEP 3. For each
distinct issue NOT already in the prior JSON, run:
    aishot git diff review record-finding \
      --title "<one line>" --description "<detail>" \
      --level high|medium|low \
      --category correctness|security|performance|reliability|maintainability|style|testing|docs \
      --p0 true|false \
      --flagged-by <csv of reviewers that raised it: e.g. claude,codex> \
      [--file <path>] [--line <n>]

--p0 is REQUIRED and is the most important field. Set it from the reviewers'
[P0]/[non-P0] classification: --p0 true ONLY for a concrete defect a real
caller will hit (wrong result, data loss, crash, security hole, resource
leak, silently-incorrect behavior). Everything else — style, naming,
formatting, refactor preferences, docs, and missing tests — is --p0 false.
When reviewers disagree or you are unsure, record it as --p0 false. Record
non-P0 findings too (they are useful), just never mark them P0.

STEP 3 — Judge PRIOR findings. For each finding in the prior JSON, decide
from the current reports and diff:
- Clearly fixed by the current diff:
    aishot git diff review record-finding --id <id> --agent-status fixed --flagged-by <reviewer>
- A P0 that is actually NOT a real defect (reviewers were wrong, or it is
  intended/safe): refute it so it stops recurring:
    aishot git diff review record-finding --id <id> --agent-status refuted \
      --rationale "<why it is not a real defect>" --flagged-by <reviewer>
- A finding you cannot judge confidently either way: escalate it so a
  human looks first:
    aishot git diff review record-finding --id <id> --agent-status escalated \
      --rationale "<what is unclear>" --flagged-by <reviewer>
- Otherwise leave it untouched (still open).
Never re-open a finding already marked fixed or refuted unless the current
diff clearly shows the issue is (again) present. A finding with
"human_status":"overruled" was sent back by a human (see its "human_note"):
fix it or escalate it, but do not refute it again on the same grounds.

RULES:
- NEVER hand-edit .aishot/review.json — only use record-finding.
- NEVER pass --human-status; that field belongs to the human.
- Do NOT run other project tooling (bd, beads, todo, tests, builds) or set
  up the project.
- Record every distinct NEW finding (P0 and non-P0), each with a correct
  --p0. Only P0 findings are must-fix; non-P0 are advisory.
- When done, print one line: "recorded N findings".

Reviewer reports follow.
EOF
}

# Review-specific runner (decision B): reuses the parallel fan-out, but the
# synthesis ALWAYS runs (even for a single reviewer, which the generic
# _run_shots would skip) and its job is to populate .aishot/review.json via
# record-finding. output.txt captures the synthesis agent's transcript; the
# human artifact is the rendered review.md.
_run_review_shots() {
    local prompt_file=$1 preamble_func=$2 label=$3
    shift 3

    local pids=() names=() exit_codes=()
    local r
    for r in "$@"
    do
        echo ">>> Starting ${r} ${label}..." >&2
        "${r}shot" < "$prompt_file" > "${RUN_DIR}/${r}.out" 2>"${RUN_DIR}/${r}.err" &
        pids+=($!)
        names+=("$r")
    done

    local i
    for i in "${!pids[@]}"
    do
        local ec=0
        wait "${pids[$i]}" || ec=$?
        exit_codes[i]=$ec
    done

    {
        echo "mode: review"
        echo "shots: ${names[*]}"
        for i in "${!names[@]}"
        do
            echo "${names[$i]}: exit=${exit_codes[$i]}"
        done
    } > "${RUN_DIR}/meta.txt"

    local successful=0
    for i in "${!names[@]}"
    do
        if (( exit_codes[i] != 0 ))
        then
            echo ">>> WARNING: ${names[$i]} review failed (exit ${exit_codes[$i]}, output may be partial)." >&2
        else
            (( successful++ ))
        fi
    done

    if (( successful < 1 ))
    then
        echo "Error: All reviewers failed." >&2
        return 1
    fi

    {
        "$preamble_func"
        echo
        for i in "${!names[@]}"
        do
            if (( exit_codes[i] == 0 ))
            then
                echo "## ${names[$i]} review"
                echo
                cat "${RUN_DIR}/${names[$i]}.out"
                echo
            fi
        done
    } > "${RUN_DIR}/synthesis_prompt.txt"

    echo ">>> Synthesizing ${successful} review(s) into findings via record-finding..." >&2
    claudeshot < "${RUN_DIR}/synthesis_prompt.txt" | tee "${RUN_DIR}/output.txt"
}

# Shared driver for the `git diff <mode>` subcommands. Parses
# --with/--help, validates the shot list, builds the mode's prompt (with
# SHOT_PREAMBLE prepended), and fans out via the given runner.
#   $1 = mode (review|describe)
#   $2 = synthesis preamble function name
#   $3 = label passed to the runner (headings/progress)
#   $4 = help function name (for --help and unknown options)
#   $5 = runner function (_run_shots | _run_review_shots)
#   $6.. = caller args
_do_diff_subcommand() {
    local mode=$1 synthesis_func=$2 label=$3 help_func=$4 runner=$5
    shift 5

    local reviewers=$DEFAULT_REVIEWERS

    while (( 0 < $# ))
    do
        case "$1" in
            --with=*)
                reviewers=${1#--with=}
                shift
                ;;
            --help|-h)
                "$help_func"
                return 0
                ;;
            *)
                echo "Error: Unknown option '${1}'" >&2
                "$help_func" >&2
                return 1
                ;;
        esac
    done

    local validated
    validated=$(validate_reviewers "$reviewers") || return 1
    local -a reviewer_list
    mapfile -t reviewer_list <<< "$validated"

    setup_run_dir || return 1

    # Prepend SHOT_PREAMBLE so the prompt the shots see matches what the
    # per-shot `*shot git diff <mode>` path sends (it pipes
    # `aishot git diff <mode> make-prompt` through do_make_prompt, which
    # adds the preamble). Without this the two paths would diverge — the
    # per-shot path tells the shot "read AGENTS.md first, don't run
    # project tooling" and the aishot path would not.
    local prompt
    prompt=$(do_make_diff_prompt "$mode") || return 1
    {
        printf '%s' "$SHOT_PREAMBLE"
        printf '%s' "$prompt"
    } > "${RUN_DIR}/prompt.txt"

    "$runner" "${RUN_DIR}/prompt.txt" \
        "$synthesis_func" "$label" \
        "${reviewer_list[@]}"
}

do_review() {
    # Separate --fresh (a review-artifact control) from the args
    # _do_diff_subcommand understands (--with/--help).
    local passthru=() fresh=()
    while (( 0 < $# ))
    do
        case "$1" in
            --fresh) fresh=(--fresh); shift ;;
            --help|-h) show_review_help; return 0 ;;
            *) passthru+=("$1"); shift ;;
        esac
    done

    _review_begin_iteration "${fresh[@]}" || return 1

    _do_diff_subcommand review _review_record_synthesis_preamble review \
        show_review_help _run_review_shots "${passthru[@]}"
    local rc=$?

    # Render the human-facing artifact from the (now populated) review.json.
    local path
    if path=$(_review_json_path 2>/dev/null) && [[ -f $path ]]
    then
        do_review_print --format=md > "${path%/*}/review.md" 2>/dev/null || true
    fi
    return "$rc"
}

do_describe() {
    _do_diff_subcommand describe _describe_synthesis_preamble description \
        show_describe_help _run_shots "$@"
}

do_oneshot() {
    local reviewers=$DEFAULT_REVIEWERS

    # Parse leading flag-shaped args only; first non-flag (or `--`)
    # ends option parsing so a `--help` or `--foo` embedded in the
    # prompt isn't misread as a control flag.
    while (( 0 < $# ))
    do
        case "$1" in
            --with=*)
                reviewers=${1#--with=}
                shift
                ;;
            --help|-h)
                show_help
                return 0
                ;;
            --)
                shift
                break
                ;;
            --*|-?)
                echo "Error: Unknown flag '${1}'." >&2
                show_help >&2
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    # Resolve prompt: any remaining positional args win; otherwise read
    # stdin if piped. Show help on no args + tty, error on no args +
    # empty pipe (so an agent harness that closes stdin doesn't
    # silently fire shots against an empty prompt).
    local prompt_text
    if (( 0 < $# ))
    then
        prompt_text="$*"
    elif [[ -t 0 ]]
    then
        show_help >&2
        return 1
    else
        prompt_text=$(cat)
        if [[ -z $prompt_text ]]
        then
            echo "Error: No <prompt> arg and stdin is empty." >&2
            return 1
        fi
    fi

    if [[ -z $prompt_text ]]
    then
        echo "Error: <prompt> is empty." >&2
        return 1
    fi

    local validated
    validated=$(validate_reviewers "$reviewers") || return 1
    local -a reviewer_list
    mapfile -t reviewer_list <<< "$validated"

    setup_run_dir || return 1

    {
        printf '%s' "$SHOT_PREAMBLE"
        printf '%s' "$prompt_text"
    } > "${RUN_DIR}/prompt.txt"

    _run_shots "${RUN_DIR}/prompt.txt" \
        _oneshot_synthesis_preamble response \
        "${reviewer_list[@]}"
}

# Run a `git diff <mode>` leaf: `make-prompt` builds and prints the prompt
# (prepended with the shot preamble, matching what the shots receive);
# anything else runs the shots via the given driver function.
#   $1 = mode (review|describe)
#   $2 = driver function (do_review|do_describe)
#   $3.. = remaining args after the mode token
_run_git_diff_mode() {
    local mode=$1 driver=$2
    shift 2
    if [[ ${1:-} == make-prompt ]]
    then
        local content
        content=$(do_make_diff_prompt "$mode") || return 1
        printf '%s' "$content" | do_make_prompt
        return
    fi
    "$driver" "$@"
}

# ===========================================================================
# Review artifact: .aishot/review.json (source of truth), rendered to
# .aishot/review.md. Agents never hand-write JSON — they call
# `record-finding`; `validate` is the deterministic backstop against
# improper edits; `print` renders. All three are deterministic (no LLM).
# ===========================================================================

_review_need_jq() {
    command -v jq >/dev/null ||
        { echo "Error: jq is required for review commands but was not found." >&2; return 1; }
}

# Path to the current repo's review artifact.
_review_json_path() {
    local root
    root=$(git rev-parse --show-toplevel) ||
        { echo "Error: not inside a git repository." >&2; return 1; }
    printf '%s/.aishot/review.json' "$root"
}

_review_uuid() {
    if command -v uuidgen >/dev/null
    then
        uuidgen | tr '[:upper:]' '[:lower:]'
    else
        cat /proc/sys/kernel/random/uuid 2>/dev/null
    fi
}

_review_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# True when $1 is one space-separated word in the whitelist $2.
_review_in_set() {
    local needle=$1 set=$2 w
    for w in $set
    do
        [[ $w == "$needle" ]] && return 0
    done
    return 1
}

_review_reviewers_dir() {
    printf '%s/.agents/aishot/reviewers' "$HOME"
}

_review_registry_scan() {
    local dir
    dir=$(_review_reviewers_dir)
    local -a files=() outs=()
    if [[ -d $dir ]]
    then
        mapfile -t files < <(compgen -G "${dir}/*.json" | LC_ALL=C sort)
    fi
    local f stem out
    for f in "${files[@]}"
    do
        stem=${f##*/}
        stem=${stem%.json}
        if ! out=$(jq -sc --arg stem "$stem" --arg file "$f" --arg builtins "$REVIEW_REVIEWERS" \
                      --arg namere "$REVIEW_REVIEWER_NAME_RE" \
                      'if length == 1 then .[0] | '"$REVIEW_REGISTRATION_JQ"' else error end' \
                      "$f" 2>/dev/null) || [[ -z $out ]]
        then
            out=$(jq -nc --arg file "$f" '{errors: ["\($file): not a single valid JSON document"]}')
        fi
        outs+=("$out")
    done
    printf '%s\n' "${outs[@]}" |
        jq -sc '{valid: [.[] | .entry // empty], errors: [.[] | .errors[]?]}'
}

_review_repo_org() {
    local branch="" remote="" url
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [[ -n $branch ]]
    then
        remote=$(git config "branch.${branch}.remote" 2>/dev/null)
    fi
    if [[ -z $remote || $remote == . ]]
    then
        remote=origin
        if ! git remote get-url origin >/dev/null 2>&1
        then
            local -a remotes
            mapfile -t remotes < <(git remote 2>/dev/null)
            (( ${#remotes[@]} == 1 )) || return 1
            remote=${remotes[0]}
        fi
    fi
    url=$(git remote get-url "$remote" 2>/dev/null) || return 1
    if [[ $url =~ ^[A-Za-z][A-Za-z0-9+.-]*://[^/]+/([^/]+)/[^/] ]]
    then
        printf '%s\n' "${BASH_REMATCH[1]}"
    elif [[ $url =~ ^([^@/:]+@)?[^/:]+:([^/]+)/[^/] ]]
    then
        printf '%s\n' "${BASH_REMATCH[2]}"
    else
        return 1
    fi
}

# Prints one error per line on stderr and returns non-zero when the review
# doc at $1 is invalid.
_review_validate_file() {
    local f=$1
    if [[ ! -f $f ]]
    then
        echo "no review file at '${f}'" >&2
        return 1
    fi
    if ! jq -e . "$f" >/dev/null 2>&1
    then
        echo "'${f}' is not valid JSON" >&2
        return 1
    fi
    local errs
    if ! errs=$(jq -r --argjson ver "$REVIEW_SCHEMA_VERSION" \
                 --arg levels "$REVIEW_LEVELS" --arg cats "$REVIEW_CATEGORIES" \
                 --arg astats "$REVIEW_AGENT_STATUSES" --arg hstats "$REVIEW_HUMAN_STATUSES" \
                 --arg namere "$REVIEW_REVIEWER_NAME_RE" '
      def words: split(" ") | map(select(. != ""));
      def envkeys: ["schema_version","lineage","iterations","branch","base_sha","head_sha","created","updated","diff","findings"];
      def commonkeys: ["id","file","line","level","category","title","description","first_seen_iteration","last_seen_iteration","flagged_by"];
      def isint: (type=="number") and (. == floor);
      def nonempty: (type=="string") and (0<length);
      def findings: if (.findings|type)=="array" then .findings else [] end;
      if type != "object" then "the review must be a JSON object" else
      (.schema_version == 1) as $v1 |
      (if $v1 then commonkeys + ["status"] else commonkeys + ["agent_status","human_status"] end) as $fkeys |
      (if $v1 then ["p0","refutation"] else ["p0","refutation","escalation","human_note","source"] end) as $okeys |
      [
        (envkeys[] as $k | select((has($k))|not) | "missing envelope key: \($k)"),
        (keys_unsorted[] as $k | select((envkeys|index($k))==null) | "unknown envelope key: \($k)"),
        (if $v1 or (.schema_version)==$ver then empty else "schema_version must be 1 or \($ver)" end),
        (if ((.iterations|isint) and (1<=.iterations)) then empty else "iterations must be a positive integer" end),
        (if (.diff|type)=="string" then empty else "diff must be a string" end),
        (if (.findings|type)=="array" then empty else "findings must be an array" end),
        (findings | to_entries[] | .key as $i | .value as $f |
         if ($f|type) != "object" then "finding[\($i)] must be a JSON object" else
          ($fkeys[] as $k | select(($f|has($k))|not) | "finding[\($i)] missing key: \($k)"),
          (($f|keys_unsorted[]) as $k | select((($fkeys+$okeys)|index($k))==null) | "finding[\($i)] unknown key: \($k)"),
          (if ($levels|words|index($f.level)) != null then empty else "finding[\($i)] invalid level: \($f.level)" end),
          (if ($cats|words|index($f.category)) != null then empty else "finding[\($i)] invalid category: \($f.category)" end),
          (if $v1 then
             (if (["open","addressed","wontfix","refuted"]|index($f.status)) != null then empty else "finding[\($i)] invalid status: \($f.status)" end)
           else
             (if ($astats|words|index($f.agent_status)) != null then empty else "finding[\($i)] invalid agent_status: \($f.agent_status)" end),
             (if ($hstats|words|index($f.human_status)) != null then empty else "finding[\($i)] invalid human_status: \($f.human_status)" end),
             (if $f.agent_status != "refuted" or ($f.refutation|nonempty) then empty else "finding[\($i)] agent_status refuted requires a refutation rationale" end),
             (if $f.human_status != "overruled" or ($f.human_note|nonempty) then empty else "finding[\($i)] human_status overruled requires a human_note" end),
             (if $f.human_status != "overruled" or $f.agent_status == "open" then empty else "finding[\($i)] human_status overruled requires agent_status open" end),
             (if (($f|has("escalation"))|not) or (($f.escalation|type)=="string") then empty else "finding[\($i)] escalation must be a string" end),
             (if (($f|has("human_note"))|not) or (($f.human_note|type)=="string") then empty else "finding[\($i)] human_note must be a string" end),
             (if (($f|has("source"))|not) or (($f.source|type)=="object") then empty else "finding[\($i)] source must be a JSON object" end)
           end),
          (if (($f|has("p0"))|not) or (($f.p0|type)=="boolean") then empty else "finding[\($i)] p0 must be boolean" end),
          (if (($f|has("refutation"))|not) or (($f.refutation|type)=="string") then empty else "finding[\($i)] refutation must be a string" end),
          (if (($f.line)==null or ($f.line|isint)) then empty else "finding[\($i)] line must be int or null" end),
          (if ($f.title|nonempty) then empty else "finding[\($i)] title required" end),
          (if ($f.description|nonempty) then empty else "finding[\($i)] description required" end),
          (if (($f.first_seen_iteration|isint) and ($f.last_seen_iteration|isint) and ($f.first_seen_iteration<=$f.last_seen_iteration)) then empty else "finding[\($i)] iteration bounds invalid" end),
          (if (($f.flagged_by|type)=="array" and (1<=($f.flagged_by|length))
               and all($f.flagged_by[]; type=="string" and test($namere))) then empty
           else "finding[\($i)] flagged_by must be a non-empty array of reviewer names" end)
         end
        ),
        (findings | [.[] | objects | .id] as $ids | if ($ids|length)!=($ids|unique|length) then "duplicate finding ids present" else empty end)
      ] | .[]
      end
    ' "$f" 2>&1)
    then
        printf 'could not validate %s: %s\n' "$f" "$errs" >&2
        return 1
    fi
    if [[ -n $errs ]]
    then
        printf '%s\n' "$errs" >&2
        return 1
    fi
    return 0
}

_review_flagged_by_warnings() {
    local f=$1 registry org=""
    registry=$(_review_registry_scan) || return 1
    org=$(_review_repo_org) || org=""
    jq -r --argjson reg "$registry" --arg builtins "$REVIEW_REVIEWERS" --arg org "$org" '
      ($builtins | split(" ")) as $b
      | [.findings[]? | objects | .flagged_by[]? | strings] | unique[] as $r
      | select(($b | index($r)) == null)
      | ([$reg.valid[] | select(.name == $r)] | first) as $e
      | if $e == null then
          "warning: flagged_by \($r | tojson) is not a built-in or registered reviewer"
        elif $org == "" or (any($e.orgs[]; ascii_downcase == ($org | ascii_downcase)) | not) then
          "warning: flagged_by \($r | tojson) is registered for orgs \($e.orgs | join(", ")), not this repo (org: \(if $org == "" then "none" else $org end))"
        else empty end
    ' "$f" 2>/dev/null
}

_review_lock() {
    local lock=$1 waited=0
    until mkdir "$lock" 2>/dev/null
    do
        (( waited += 1 ))
        if (( 50 < waited ))
        then
            echo "Error: could not acquire review lock '${lock}'." >&2
            return 1
        fi
        sleep 0.1
    done
}

# The review-scope diff embedded in the artifact: branch-vs-upstream
# (when an upstream exists) plus staged and unstaged changes. Repo-wide
# regardless of cwd.
_review_current_diff() {
    if git rev-parse --verify '@{u}' >/dev/null 2>&1
    then
        git diff '@{u}...HEAD'
    fi
    git diff --cached
    git diff
}

# Initialize or advance .aishot/review.json for a review run (the driver
# owns this; agents only record findings). Prior review -> bump iterations
# and carry findings forward for re-judgement, whether or not the base
# moved. --fresh (or no prior) -> archive any prior to review.bak.<ts>.json
# and start a new series (new lineage, iterations=1, empty findings).
_review_begin_iteration() {
    _review_need_jq || return 1
    local fresh_flag=0
    [[ ${1:-} == --fresh ]] && fresh_flag=1

    local path
    path=$(_review_json_path) || return 1
    local dir="${path%/*}"
    mkdir -p "$dir" || { echo "Error: could not create '${dir}'." >&2; return 1; }

    local base head branch now
    base=$(git merge-base '@{u}' HEAD 2>/dev/null) || base=""
    head=$(git rev-parse HEAD 2>/dev/null) || head=""
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
    now=$(_review_iso)

    # The diff can be many MB. Write it to a file and hand it to jq via
    # --rawfile; passing it as --arg would blow ARG_MAX (E2BIG).
    local difffile tmp=""
    difffile=$(mktemp) || { echo "Error: mktemp failed." >&2; return 1; }
    cleanup_begin() { rm -f "$difffile" "$tmp"; }
    trap cleanup_begin RETURN
    _review_current_diff > "$difffile"

    local lineage iterations created findings
    if [[ -f $path ]] && (( ! fresh_flag ))
    then
        lineage=$(jq -r '.lineage' "$path")
        iterations=$(( $(jq -r '.iterations' "$path") + 1 ))
        created=$(jq -r '.created' "$path")
        findings=$(jq -c "${REVIEW_MIGRATE_JQ}"' migrate | .findings' "$path")
    else
        if [[ -f $path ]]
        then
            local ts
            ts=$(date +%Y%m%dT%H%M%S)
            cp "$path" "${dir}/review.bak.${ts}.json" ||
                { echo "Error: could not archive prior review." >&2; return 1; }
        fi
        lineage=$(_review_uuid)
        iterations=1
        created=$now
        findings='[]'
    fi

    tmp=$(mktemp) || { echo "Error: mktemp failed." >&2; return 1; }
    jq -n --argjson ver "$REVIEW_SCHEMA_VERSION" --arg lineage "$lineage" \
       --argjson iterations "$iterations" --arg branch "$branch" \
       --arg base "$base" --arg head "$head" --arg created "$created" \
       --arg now "$now" --rawfile diff "$difffile" --argjson findings "$findings" \
       '{schema_version:$ver, lineage:$lineage, iterations:$iterations,
         branch:$branch, base_sha:$base, head_sha:$head, created:$created,
         updated:$now, diff:$diff, findings:$findings}' > "$tmp" ||
        { echo "Error: could not build envelope." >&2; return 1; }
    if ! _review_validate_file "$tmp"
    then
        echo "Error: refusing to write — envelope failed validation (above)." >&2
        return 1
    fi
    mv "$tmp" "$path" || { echo "Error: could not write '${path}'." >&2; return 1; }
    tmp=""
    echo ">>> review iteration ${iterations} (lineage ${lineage})" >&2
}

do_review_begin() {
    local fresh=()
    while (( 0 < $# ))
    do
        case "$1" in
            --fresh) fresh=(--fresh); shift ;;
            --help|-h)
                echo "Usage: aishot git diff review begin [--fresh]"
                echo "Initialize or advance .aishot/review.json for a review iteration."
                echo "The review run does this automatically; --fresh starts a new series."
                return 0 ;;
            *) echo "Error: unknown option '${1}'." >&2; return 1 ;;
        esac
    done
    _review_begin_iteration "${fresh[@]}"
}

show_review_record_finding_help() {
    cat <<'EOF'
Usage: aishot git diff review record-finding --title T --description D \
         --level high|medium|low --category CAT --flagged-by claude,codex \
         [--p0 true|false] [--file PATH] [--line N] [--id UUID] \
         [--agent-status open|fixed|refuted|escalated] [--rationale TEXT] \
         [--human-status unreviewed|confirmed|overruled] [--note TEXT] \
         [--source JSON]

Record (or update) one code-review finding in .aishot/review.json. This is
the ONLY correct way to modify the review artifact — do NOT hand-edit the
JSON. Each call is deterministic, atomic, and self-validating: it rejects
bad enums, missing required fields, or an unknown --id, and never leaves a
malformed file behind.

Omit --id to MINT a new finding (a UUID is assigned; first_seen_iteration
and last_seen_iteration are set to the current iteration). Pass --id to
UPDATE an existing finding — e.g. mark it fixed:
  aishot git diff review record-finding --id <uuid> --agent-status fixed --flagged-by claude

Each finding carries two independent triage fields:

  agent_status   the agent's judgement.
                   open       not yet dealt with (the default).
                   fixed      the current diff fixes it.
                   refuted    not a real defect. Requires --rationale.
                   escalated  questionable; the agent wants a human to
                              look first. --rationale is optional.
  human_status   a human's review of the agent's judgement.
                   unreviewed  no human has looked (the default).
                   confirmed   the human agrees.
                   overruled   the human disagrees. Requires --note, and
                               sends agent_status back to open.

A finding is settled when agent_status is fixed or refuted AND
human_status is confirmed. Changing agent_status resets human_status to
unreviewed unless --human-status is passed in the same call, because the
human reviewed the earlier judgement, not the new one.

Fields:
  --title         (required) one-line summary.
  --description   (required) the finding detail.
  --level         (required) severity: high | medium | low.
  --category      (required) correctness | security | performance |
                  reliability | maintainability | style | testing | docs.
  --flagged-by    (required) csv of reviewers that raised it:
                  claude | codex | gemini | human, or a registered
                  reviewer whose orgs cover this repo's GitHub org (see
                  `aishot git diff review reviewers list`). On update,
                  unioned in.
  --file          (optional) path the finding is about.
  --line          (optional) integer line number.
  --p0            (optional) true | false. true = a must-fix correctness/
                  security/reliability defect that gates completion.
                  Default: false (nit / non-blocking). Only P0 findings
                  gate completion; non-P0 findings are advisory.
  --agent-status  (optional) open | fixed | refuted | escalated.
                  Default: open.
  --rationale     with --agent-status refuted (required) or escalated
                  (optional): why. Recorded and carried forward so a
                  refuted finding is not re-raised.
  --human-status  (optional) unreviewed | confirmed | overruled.
                  Default: unreviewed.
  --note          with --human-status: the human's note. Required for
                  overruled.
  --source        (optional) a JSON object describing where the finding
                  came from (e.g. an outside reviewer's ids and URLs).
                  Stored on the finding as is, carried forward, and shown
                  by print; aishot never interprets it. On update, it
                  replaces any earlier source.
  --id            (optional) UUID of an existing finding to update.
  --status        (deprecated) schema 1 spelling of --agent-status:
                  open | addressed (= fixed) | wontfix (= refuted) |
                  refuted.
EOF
}

# Build a validated JSON array of reviewers from a csv, or fail.
_review_flagged_json() {
    local csv=$1
    local -a arr
    IFS=',' read -ra arr <<< "$csv"
    (( 0 < ${#arr[@]} )) ||
        { echo "Error: --flagged-by is empty." >&2; return 1; }
    local registry org="" r orgs
    registry=$(_review_registry_scan) || return 1
    org=$(_review_repo_org) || org=""
    for r in "${arr[@]}"
    do
        _review_in_set "$r" "$REVIEW_REVIEWERS" && continue
        orgs=$(jq -r --arg r "$r" '.valid[] | select(.name == $r) | .orgs | join(", ")' <<< "$registry")
        if [[ -z $orgs ]]
        then
            echo "Error: unknown reviewer in --flagged-by: '${r}' (built-ins: ${REVIEW_REVIEWERS}; see 'aishot git diff review reviewers list')." >&2
            return 1
        fi
        if [[ -z $org ]]
        then
            echo "Error: reviewer '${r}' is registered for orgs ${orgs}, but this repo has no remote org to match." >&2
            return 1
        fi
        if ! jq -e --arg r "$r" --arg org "$org" \
                '.valid[] | select(.name == $r) | any(.orgs[]; ascii_downcase == ($org | ascii_downcase))' \
                <<< "$registry" >/dev/null
        then
            echo "Error: reviewer '${r}' is registered for orgs ${orgs}, not this repo's org '${org}'." >&2
            return 1
        fi
    done
    printf '%s\n' "${arr[@]}" | jq -R . | jq -s .
}

do_review_record_finding() {
    _review_need_jq || return 1

    local title="" description="" file="" line="" level="" category="" \
          flagged_by="" status="" agent_status="" human_status="" note="" \
          id="" p0="" rationale="" source="" source_set=0
    while (( 0 < $# ))
    do
        case "$1" in
            --title) title=$2; shift 2 ;;
            --description) description=$2; shift 2 ;;
            --file) file=$2; shift 2 ;;
            --line) line=$2; shift 2 ;;
            --level) level=$2; shift 2 ;;
            --category) category=$2; shift 2 ;;
            --flagged-by) flagged_by=$2; shift 2 ;;
            --status) status=$2; shift 2 ;;
            --agent-status) agent_status=$2; shift 2 ;;
            --human-status) human_status=$2; shift 2 ;;
            --note) note=$2; shift 2 ;;
            --p0) p0=$2; shift 2 ;;
            --rationale) rationale=$2; shift 2 ;;
            --source) source=$2; source_set=1; shift 2 ;;
            --id) id=$2; shift 2 ;;
            --help|-h) show_review_record_finding_help; return 0 ;;
            *) echo "Error: unknown option '${1}'." >&2; show_review_record_finding_help >&2; return 1 ;;
        esac
    done

    if [[ -n $status ]]
    then
        [[ -z $agent_status ]] ||
            { echo "Error: pass --agent-status or the deprecated --status, not both." >&2; return 1; }
        case "$status" in
            open|refuted) agent_status=$status ;;
            addressed) agent_status=fixed ;;
            wontfix) agent_status=refuted ;;
            *) echo "Error: invalid --status '${status}' (want: open addressed wontfix refuted)." >&2; return 1 ;;
        esac
    fi

    # Minting a new finding requires the full descriptor; updating an
    # existing one (--id) touches only the fields actually passed.
    if [[ -z $id ]]
    then
        [[ -n $title ]] || { echo "Error: --title is required." >&2; return 1; }
        [[ -n $description ]] || { echo "Error: --description is required." >&2; return 1; }
        [[ -n $flagged_by ]] || { echo "Error: --flagged-by is required." >&2; return 1; }
        [[ -n $level ]] || { echo "Error: --level is required for a new finding." >&2; return 1; }
        [[ -n $category ]] || { echo "Error: --category is required for a new finding." >&2; return 1; }
    fi
    [[ -z $level ]] || _review_in_set "$level" "$REVIEW_LEVELS" ||
        { echo "Error: invalid --level '${level}' (want: ${REVIEW_LEVELS})." >&2; return 1; }
    [[ -z $category ]] || _review_in_set "$category" "$REVIEW_CATEGORIES" ||
        { echo "Error: invalid --category '${category}' (want: ${REVIEW_CATEGORIES})." >&2; return 1; }
    [[ -z $agent_status ]] || _review_in_set "$agent_status" "$REVIEW_AGENT_STATUSES" ||
        { echo "Error: invalid --agent-status '${agent_status}' (want: ${REVIEW_AGENT_STATUSES})." >&2; return 1; }
    [[ -z $human_status ]] || _review_in_set "$human_status" "$REVIEW_HUMAN_STATUSES" ||
        { echo "Error: invalid --human-status '${human_status}' (want: ${REVIEW_HUMAN_STATUSES})." >&2; return 1; }
    if [[ $agent_status == refuted && -z $rationale ]]
    then
        echo "Error: --agent-status refuted requires --rationale." >&2
        return 1
    fi
    if [[ -n $rationale && $agent_status != refuted && $agent_status != escalated ]]
    then
        echo "Error: --rationale only applies with --agent-status refuted or escalated." >&2
        return 1
    fi
    if [[ -n $note && -z $human_status ]]
    then
        echo "Error: --note only applies with --human-status." >&2
        return 1
    fi
    if [[ $human_status == overruled ]]
    then
        [[ -n $note ]] ||
            { echo "Error: --human-status overruled requires --note." >&2; return 1; }
        [[ -z $agent_status || $agent_status == open ]] ||
            { echo "Error: --human-status overruled sends agent_status back to open; it cannot be combined with --agent-status ${agent_status}." >&2; return 1; }
    fi
    [[ -z $p0 || $p0 == true || $p0 == false ]] ||
        { echo "Error: --p0 must be true or false." >&2; return 1; }
    if [[ -n $line && ! $line =~ ^[0-9]+$ ]]
    then
        echo "Error: --line must be a non-negative integer." >&2
        return 1
    fi
    local source_json=null
    if (( source_set ))
    then
        if ! source_json=$(jq -sc 'if length == 1 and (.[0] | type) == "object" then .[0] else error end' \
                               <<< "$source" 2>/dev/null)
        then
            echo "Error: --source must be a single JSON object." >&2
            return 1
        fi
    fi

    local flagged_json="[]" line_json
    if [[ -n $flagged_by ]]
    then flagged_json=$(_review_flagged_json "$flagged_by") || return 1
    fi
    if [[ -n $line ]]
    then line_json=$line
    else line_json=null
    fi

    local path
    path=$(_review_json_path) || return 1
    local dir="${path%/*}"
    mkdir -p "$dir" || { echo "Error: could not create '${dir}'." >&2; return 1; }

    # Serialize concurrent writers with an atomic mkdir lock.
    local lock="${dir}/.review.lock" tmp="" held=0
    cleanup() { (( held )) && rmdir "$lock" 2>/dev/null; [[ -n $tmp ]] && rm -f "$tmp"; }
    trap cleanup RETURN
    local waited=0
    until mkdir "$lock" 2>/dev/null
    do
        (( waited++ ))
        if (( 50 < waited ))
        then echo "Error: could not acquire review lock '${lock}'." >&2; return 1
        fi
        sleep 0.1
    done
    held=1

    # Seed a minimal envelope if none exists yet (the run driver normally
    # seeds a richer one with the diff embedded; this keeps the tool usable
    # standalone). Best-effort git metadata: a fresh repo may lack HEAD/@{u}.
    if [[ ! -f $path ]]
    then
        local branch head base now
        branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
        head=$(git rev-parse HEAD 2>/dev/null) || head=""
        base=$(git merge-base '@{u}' HEAD 2>/dev/null) || base=""
        now=$(_review_iso)
        jq -n --argjson ver "$REVIEW_SCHEMA_VERSION" --arg lineage "$(_review_uuid)" \
           --arg branch "$branch" --arg base "$base" --arg head "$head" --arg now "$now" \
           '{schema_version:$ver, lineage:$lineage, iterations:1, branch:$branch,
             base_sha:$base, head_sha:$head, created:$now, updated:$now, diff:"", findings:[]}' \
           > "$path" || { echo "Error: could not seed '${path}'." >&2; return 1; }
    fi

    local iter now
    iter=$(jq -r '.iterations' "$path")
    now=$(_review_iso)
    tmp=$(mktemp) || { echo "Error: mktemp failed." >&2; return 1; }

    if [[ -n $id ]]
    then
        # Update: fail if the id is unknown; apply provided fields, union
        # flagged_by, bump last_seen_iteration.
        if [[ $(jq --arg id "$id" '[.findings[]|select(.id==$id)]|length' "$path") -eq 0 ]]
        then echo "Error: no finding with --id '${id}'." >&2; return 1
        fi
        jq --arg id "$id" --arg now "$now" --argjson iter "$iter" \
           --arg title "$title" --arg description "$description" \
           --arg file "$file" --argjson line "$line_json" \
           --arg level "$level" --arg category "$category" \
           --arg astatus "$agent_status" --arg hstatus "$human_status" --arg note "$note" \
           --arg p0 "$p0" --arg rationale "$rationale" --argjson source "$source_json" \
           --argjson flagged "$flagged_json" "${REVIEW_MIGRATE_JQ}"'
          migrate
          | .updated=$now
          | .findings |= map(
              if .id==$id then
                  .agent_status as $prev
                | (if $title!="" then .title=$title else . end)
                | (if $description!="" then .description=$description else . end)
                | (if $file!="" then .file=$file else . end)
                | (if $line!=null then .line=$line else . end)
                | (if $level!="" then .level=$level else . end)
                | (if $category!="" then .category=$category else . end)
                | (if $p0!="" then .p0=($p0=="true") else . end)
                | (if $astatus!="" then .agent_status=$astatus else . end)
                | (if $astatus=="refuted" then .refutation=$rationale
                   elif $astatus=="escalated" and $rationale!="" then .escalation=$rationale
                   else . end)
                | (if $hstatus!="" then .human_status=$hstatus
                   elif .agent_status!=$prev then .human_status="unreviewed"
                   else . end)
                | (if $hstatus=="overruled" then .agent_status="open" else . end)
                | (if $note!="" then .human_note=$note else . end)
                | (if $source!=null then .source=$source else . end)
                | .flagged_by=((.flagged_by + $flagged)|unique)
                | .last_seen_iteration=$iter
              else . end)
        ' "$path" > "$tmp" || { echo "Error: jq update failed." >&2; return 1; }
    else
        jq --arg id "$(_review_uuid)" --arg now "$now" --argjson iter "$iter" \
           --arg title "$title" --arg description "$description" \
           --arg file "$file" --argjson line "$line_json" \
           --arg level "$level" --arg category "$category" \
           --arg astatus "${agent_status:-open}" --arg hstatus "${human_status:-unreviewed}" \
           --arg note "$note" --argjson p0 "${p0:-false}" --arg rationale "$rationale" \
           --argjson source "$source_json" --argjson flagged "$flagged_json" "${REVIEW_MIGRATE_JQ}"'
          migrate
          | .updated=$now
          | .findings += [{
              id:$id, file:$file, line:$line, level:$level, category:$category,
              title:$title, description:$description,
              agent_status:$astatus, human_status:$hstatus, p0:$p0,
              refutation:(if $astatus=="refuted" then $rationale else "" end),
              first_seen_iteration:$iter, last_seen_iteration:$iter, flagged_by:$flagged
            }
            + (if $astatus=="escalated" and $rationale!="" then {escalation:$rationale} else {} end)
            + (if $note!="" then {human_note:$note} else {} end)
            + (if $source!=null then {source:$source} else {} end)]
        ' "$path" > "$tmp" || { echo "Error: jq insert failed." >&2; return 1; }
    fi

    # Never leave a malformed file behind: validate the candidate, then
    # atomically replace.
    if ! _review_validate_file "$tmp"
    then
        echo "Error: refusing to write — the resulting review.json failed validation (above)." >&2
        return 1
    fi
    mv "$tmp" "$path" || { echo "Error: could not write '${path}'." >&2; return 1; }
    tmp=""
    echo ">>> recorded finding in ${path}" >&2
}

do_review_validate() {
    _review_need_jq || return 1
    local path=""
    while (( 0 < $# ))
    do
        case "$1" in
            --file) path=$2; shift 2 ;;
            --help|-h)
                echo "Usage: aishot git diff review validate [--file PATH]"
                echo "Validate .aishot/review.json (schema, enums, types, invariants)"
                echo "and the reviewer registrations in $(_review_reviewers_dir)."
                return 0 ;;
            *) echo "Error: unknown option '${1}'." >&2; return 1 ;;
        esac
    done
    [[ -n $path ]] || path=$(_review_json_path) || return 1
    local rc=0 registry_errs
    registry_errs=$(_review_registry_scan | jq -r '.errors[] | "registration: \(.)"')
    if [[ -n $registry_errs ]]
    then
        printf '%s\n' "$registry_errs" >&2
        rc=1
    fi
    if _review_validate_file "$path"
    then
        local warnings
        warnings=$(_review_flagged_by_warnings "$path")
        [[ -z $warnings ]] || printf '%s\n' "$warnings" >&2
    else
        rc=1
    fi
    if (( rc == 0 ))
    then
        echo "ok: ${path} is valid"
    fi
    return "$rc"
}

show_review_reviewers_help() {
    cat <<EOF
Usage: aishot git diff review reviewers [list] [--format=text|json]

List the reviewers --flagged-by accepts: the built-ins (${REVIEW_REVIEWERS})
and the reviewers registered by drop-in files in
$(_review_reviewers_dir)/<name>.json, each shaped like:

  {"name": "<name>", "orgs": ["<github-org>", ...], "description": "<text>"}

A registered reviewer applies only in repos whose remote's owner (the
GitHub org: the first path component of the remote URL) is one of its
orgs, compared case-insensitively. The remote is the current branch's
remote, else origin, else the only remote. The host is not checked, so
SSH host aliases work. Invalid registration files are reported on
stderr and make the command exit non-zero.

--format=json prints {"org", "builtin", "registered", "errors"}, where
each registered entry carries name, orgs, description, file, and applies.
EOF
}

do_review_reviewers() {
    _review_need_jq || return 1
    local format=text
    [[ ${1-} == list ]] && shift
    while (( 0 < $# ))
    do
        case "$1" in
            --format=*) format=${1#--format=}; shift ;;
            --help|-h) show_review_reviewers_help; return 0 ;;
            *) echo "Error: unknown option '${1}'." >&2; review_reviewers_usage; return 1 ;;
        esac
    done
    local registry org="" report
    registry=$(_review_registry_scan) || return 1
    org=$(_review_repo_org 2>/dev/null) || org=""
    report=$(jq -c --arg org "$org" --arg builtins "$REVIEW_REVIEWERS" '
      {org: (if $org == "" then null else $org end),
       builtin: ($builtins | split(" ")),
       registered: [.valid[] | . + {applies: ($org != "" and any(.orgs[]; ascii_downcase == ($org | ascii_downcase)))}],
       errors: .errors}' <<< "$registry") || return 1
    case "$format" in
        json)
            jq . <<< "$report"
            ;;
        text)
            jq -r '
              "built-in: \(.builtin | join(" "))",
              "registered (this repo'"'"'s org: \(.org // "none")):",
              (if (.registered | length) == 0 then "  (none)" else empty end),
              (.registered[] |
                "  \(.name)  \(if .applies then "applies here" else "not here" end)  orgs: \(.orgs | join(", "))  \(.description)")
            ' <<< "$report"
            ;;
        *)
            echo "Error: unknown --format '${format}' (want: text, json)." >&2
            return 1
            ;;
    esac
    if jq -e '.errors | length > 0' <<< "$report" >/dev/null
    then
        jq -r '.errors[] | "registration: \(.)"' <<< "$report" >&2
        return 1
    fi
}

do_review_print() {
    _review_need_jq || return 1
    local format=md path
    while (( 0 < $# ))
    do
        case "$1" in
            --format=*) format=${1#--format=}; shift ;;
            --help|-h)
                echo "Usage: aishot git diff review print [--format=md|markdown|json]"
                echo "Render .aishot/review.json. Default: md. Both formats render the"
                echo "current schema; an older artifact is upgraded in memory."
                return 0 ;;
            *) echo "Error: unknown option '${1}'." >&2; return 1 ;;
        esac
    done
    path=$(_review_json_path) || return 1
    [[ -f $path ]] || { echo "Error: no review at '${path}'." >&2; return 1; }

    case "$format" in
        json)
            jq "${REVIEW_MIGRATE_JQ}"' migrate' "$path"
            ;;
        md|markdown)
            jq -r "${REVIEW_MIGRATE_JQ}"'
              def levels: ["high","medium","low"];
              migrate |
              ([.findings[] | select(.agent_status=="open" and (.p0==true))] | length) as $openp0 |
              ([.findings[] | select(.agent_status=="escalated")] | length) as $escalated |
              ([.findings[] | select(.agent_status!="open" and .human_status=="unreviewed")] | length) as $awaiting |
              "# Code review — iteration \(.iterations) · \(.findings|length) finding(s) · \($openp0) open P0 · \($escalated) escalated · \($awaiting) awaiting human",
              "",
              "\(.branch // "?") · base \((.base_sha // "")[0:12]) · head \((.head_sha // "")[0:12]) · updated \(.updated // "?")",
              "",
              ( levels[] as $lv |
                ([.findings[] | select(.level==$lv)]) as $fs |
                if ($fs|length) > 0 then
                  "## \($lv|ascii_upcase)",
                  "",
                  ( $fs[] |
                    "- \(if .p0==true then "⛔P0 " else "" end)**\(.title)** [\(.category)] (agent: \(.agent_status) · human: \(.human_status)) — \(.file // "—")\(if .line then ":\(.line)" else "" end) — flagged by \(.flagged_by|join(", "))",
                    "  \(.description)",
                    (if .agent_status=="refuted" and (.refutation // "")!="" then "  refuted: \(.refutation)" else empty end),
                    (if .agent_status=="escalated" and (.escalation // "")!="" then "  escalated: \(.escalation)" else empty end),
                    (if (.human_note // "")!="" then "  human note: \(.human_note)" else empty end),
                    (if .source!=null then "  source: \(.source|tojson)" else empty end),
                    ""
                  )
                else empty end
              )
            ' "$path"
            ;;
        *)
            echo "Error: unknown --format '${format}' (want: md, markdown, json)." >&2
            return 1
            ;;
    esac
}

show_review_status_help() {
    cat <<'EOF'
Usage: aishot git diff review status [--format=kv|json]

Machine-readable summary of .aishot/review.json for a review loop. The
default kv format is one line of space-separated key=value pairs, always
in this order:

  iteration       current iteration (0 when there is no artifact).
  total           findings.
  open            agent_status open.
  open_p0         P0s with agent_status open: the agent must still fix,
                  refute, or escalate them.
  escalated       agent_status escalated (waiting on a human).
  escalated_p0    P0s among them.
  fixed           agent_status fixed.
  refuted         agent_status refuted.
  unreviewed      human_status unreviewed.
  confirmed       human_status confirmed.
  overruled       human_status overruled.
  awaiting_human  agent_status other than open, human_status unreviewed.
  settled         agent_status fixed or refuted AND human_status confirmed.
  unsettled_p0    P0s that are not settled.
  new             findings first seen in the current iteration.
  new_p0          P0s first seen in the current iteration: whether the
                  latest run raised new P0s versus the previous one.
  sourced         findings that carry a --source.

Only P0s gate completion; non-P0 findings may remain open.

--format=json prints the same keys as a JSON object, plus by_reviewer:
{"<reviewer>": {"total", "open", "open_p0"}} keyed by each flagged_by
name, built-in or registered.
EOF
}

do_review_status() {
    _review_need_jq || return 1
    local format=kv
    while (( 0 < $# ))
    do
        case "$1" in
            --format=*) format=${1#--format=}; shift ;;
            --help|-h) show_review_status_help; return 0 ;;
            *) echo "Error: unknown option '${1}'." >&2; show_review_status_help >&2; return 1 ;;
        esac
    done
    case "$format" in
        kv|json) ;;
        *) echo "Error: unknown --format '${format}' (want: kv, json)." >&2; return 1 ;;
    esac
    local path doc
    path=$(_review_json_path) || return 1
    if [[ -f $path ]]
    then
        doc=$(cat -- "$path") || return 1
    else
        doc='{"schema_version":2,"iterations":0,"findings":[]}'
    fi
    jq -r --arg format "$format" "${REVIEW_MIGRATE_JQ}"'
      def settled: (.agent_status == "fixed" or .agent_status == "refuted") and .human_status == "confirmed";
      migrate
      | .iterations as $it
      | .findings as $f
      | def n(c): [$f[] | select(c)] | length;
      {
        iteration: $it,
        total: ($f | length),
        open: n(.agent_status == "open"),
        open_p0: n(.agent_status == "open" and .p0 == true),
        escalated: n(.agent_status == "escalated"),
        escalated_p0: n(.agent_status == "escalated" and .p0 == true),
        fixed: n(.agent_status == "fixed"),
        refuted: n(.agent_status == "refuted"),
        unreviewed: n(.human_status == "unreviewed"),
        confirmed: n(.human_status == "confirmed"),
        overruled: n(.human_status == "overruled"),
        awaiting_human: n(.agent_status != "open" and .human_status == "unreviewed"),
        settled: n(settled),
        unsettled_p0: n(.p0 == true and (settled | not)),
        new: n(.first_seen_iteration == $it),
        new_p0: n(.first_seen_iteration == $it and .p0 == true),
        sourced: n(has("source"))
      } as $counts
      | if $format == "json" then
          $counts + {by_reviewer: (reduce $f[] as $x ({};
            reduce $x.flagged_by[] as $r (.;
              .[$r].total += 1
              | .[$r].open += (if $x.agent_status == "open" then 1 else 0 end)
              | .[$r].open_p0 += (if $x.agent_status == "open" and $x.p0 == true then 1 else 0 end))))}
        else
          $counts | to_entries | map("\(.key)=\(.value)") | join(" ")
        end
    ' <<< "$doc"
}

# Global options may appear BEFORE the subcommand, not just after it:
#   aishot --with=claude,codex git diff describe
# must behave the same as
#   aishot git diff describe --with=claude,codex
# Collect any leading --with= here and re-inject it into whichever handler
# runs. Without this, a flag-first invocation falls through to the bare-
# prompt path and the subcommand (e.g. "git diff describe") is silently
# parsed as the prompt text — exactly the mis-route this guards against.
# The first non-option token selects the route.
global_opts=()
while (( 0 < $# ))
do
    case "$1" in
        --with=*)
            global_opts+=("$1")
            shift
            ;;
        *)
            break
            ;;
    esac
done

case "${1:-}" in
    git)
        shift
        case "${1:-}" in
            diff)
                shift
                case "${1:-}" in
                    review)
                        shift
                        case "${1:-}" in
                            begin)
                                shift
                                do_review_begin "$@"
                                ;;
                            record-finding)
                                shift
                                do_review_record_finding "$@"
                                ;;
                            validate)
                                shift
                                do_review_validate "$@"
                                ;;
                            print)
                                shift
                                do_review_print "$@"
                                ;;
                            status)
                                shift
                                do_review_status "$@"
                                ;;
                            reviewers)
                                shift
                                do_review_reviewers "$@"
                                ;;
                            *)
                                _run_git_diff_mode review do_review "$@" "${global_opts[@]}"
                                ;;
                        esac
                        ;;
                    describe)
                        shift
                        _run_git_diff_mode describe do_describe "$@" "${global_opts[@]}"
                        ;;
                    *)
                        echo "Error: Unknown 'aishot git diff' subcommand '${1:-}'. Expected: review, describe." >&2
                        show_help >&2
                        exit 1
                        ;;
                esac
                ;;
            *)
                echo "Error: Unknown 'aishot git' subcommand '${1:-}'. Expected: diff." >&2
                show_help >&2
                exit 1
                ;;
        esac
        ;;
    make-prompt)
        if [[ -t 0 ]]
        then
            echo "Error: make-prompt reads from stdin. Pipe a prompt into it." >&2
            echo "Usage: echo 'your prompt' | aishot make-prompt" >&2
            exit 1
        fi
        do_make_prompt
        ;;
    --help|-h)
        show_help
        exit 0
        ;;
    *)
        # No subcommand or unknown first arg — treat all args as the
        # prompt (do_oneshot will fall back to stdin if no args). Any
        # leading --with= is re-injected so do_oneshot's own parser sees it.
        do_oneshot "${global_opts[@]}" "$@"
        ;;
esac
