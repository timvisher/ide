#!/usr/bin/env bash

# Run codex one-shot with streaming progress output.
#
# Usage: codexshot <prompt>
#        echo "prompt" | codexshot
#        codexshot git diff review
#        codexshot git diff describe

set -o pipefail

SELF_DIR=$(cd "$(dirname "$0")" && pwd -P)
JQ_FILTER="${SELF_DIR}/../lib/format_codex_stream_json.jq"

# shellcheck source=../lib/aishot_help.bash
source "${SELF_DIR}/../lib/aishot_help.bash"

# Reads prompt from stdin (caller is responsible for preamble via
# aishot make-prompt).
#
# Strips invalid UTF-8 sequences before handing to codex, which rejects
# non-UTF-8 stdin with "Failed to read prompt from stdin: input is not
# valid UTF-8". Diff hunks for files in legacy encodings trip this —
# notably AppleScript files saved as MacRoman, where the line-
# continuation glyph `¬` is the single byte 0xC2 (a UTF-8 lead byte
# expecting a continuation that never comes).
run_shot() {
    iconv -c -f UTF-8 -t UTF-8 |
        # codexshot is a one-shot review tool and needs no MCP servers,
        # so clear the whole table. Per-server `enabled=false` is not
        # enough: codex validates every server's transport at config-load
        # time, before `enabled` is consulted. A managed/global server
        # with an incomplete stanza — e.g. an atlassian entry missing its
        # url when the user config that would complete it isn't present
        # (a fresh machine, or a test sandbox with an isolated HOME) —
        # then aborts the whole run with "invalid transport" before the
        # shot can start. Clearing mcp_servers sidesteps that and the
        # stale-OAuth rmcp transport spam in one move.
        codex exec \
            -c 'mcp_servers={}' \
            --sandbox read-only --json - |
        jq --unbuffered -r --arg tz_offset "$(date +%z)" -f "$JQ_FILTER"
}

aishot_shot_main codexshot Codex run_shot "$@"
