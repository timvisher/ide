#!/usr/bin/env bash

source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

# Source aictl for structured agent messaging (with inline stubs fallback)
if [[ -f ~/.functions/aictl.bash ]]
then
  source ~/.functions/aictl.bash ||
    {
      echo "Unable to source aictl functions" >&2
      exit 1
    }
fi
gh_shim__json_escape() {
  local s=$1 i c
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  for (( i=1; i < 32; i+=1 ))
  do
    printf -v c "\\x$(printf '%02x' "$i")"
    [[ $s == *"$c"* ]] &&
      s=${s//"$c"/$(printf '\\u%04x' "$i")}
  done
  printf '%s' "$s"
}
gh_shim__stub_parse() {
  _sc=''
  _sm=''
  while (( 0 < $# ))
  do
    case "$1" in
      --code)
        _sc=$2
        shift 2
        ;;
      --message)
        _sm=$2
        shift 2
        ;;
      --*)
        shift 2
        ;;
      *)
        if [[ -z $_sc ]]
        then
          _sc=$1
        elif [[ -z $_sm ]]
        then
          _sm=$1
        fi
        shift
        ;;
    esac
  done
  _sc=$(gh_shim__json_escape "$_sc")
  _sm=$(gh_shim__json_escape "$_sm")
}
if ! declare -F aictl_die &>/dev/null
then
  aictl_die() {
    gh_shim__stub_parse "$@"
    printf '{"type":"instruction","level":"error","code":"%s","message":"%s","retryable":false}\n' "$_sc" "$_sm" >&2
    exit 1
  }
fi
if ! declare -F aictl_info &>/dev/null
then
  aictl_info() {
    gh_shim__stub_parse "$@"
    printf '{"type":"instruction","level":"info","code":"%s","message":"%s"}\n' "$_sc" "$_sm" >&2
  }
fi
if ! declare -F aictl_notice &>/dev/null
then
  aictl_notice() {
    gh_shim__stub_parse "$@"
    printf '{"type":"instruction","level":"warning","code":"%s","message":"%s"}\n' "$_sc" "$_sm" >&2
  }
fi

gh_args__parse() {
  local -a args=("$@")
  local n=${#args[@]} i=0 a

  gh_args__repo_value=''
  gh_args__pre=()
  gh_args__passthrough=false
  gh_args__help=false
  gh_args__command=''
  gh_args__rest=()

  while (( i < n ))
  do
    a=${args[i]}
    case $a in
      -R|--repo)
        if (( n <= i + 1 ))
        then
          gh_args__passthrough=true
          return
        fi
        gh_args__repo_value=${args[i+1]}
        (( i += 2 ))
        continue
        ;;
      -R=*|--repo=*)
        gh_args__repo_value=${a#*=}
        ;;
      -R?*)
        gh_args__repo_value=${a#-R}
        ;;
      --help|-h)
        gh_args__help=true
        gh_args__pre+=("$a")
        ;;
      --version)
        gh_args__pre+=("$a")
        ;;
      -*)
        gh_args__passthrough=true
        return
        ;;
      *)
        break
        ;;
    esac
    (( i += 1 ))
  done

  gh_args__command=${args[i]-}
  gh_args__rest=("${args[@]:i+1}")

  if [[ $gh_args__help == false ]] && (( 0 < n ))
  then
    case ${args[n-1]} in
      --help|-h)
        gh_args__help=true
        for a in "${args[@]:i}"
        do
          [[ $a == -- ]] &&
            gh_args__help=false
        done
        ;;
    esac
  fi
}

gh_args__parse "$@"
case $gh_args__command in
  __complete|__completeNoDesc)
    gh_args__help=false
    ;;
esac
if [[ $gh_args__passthrough == false && $gh_args__help == true ]]
then
  gh_help__topic=()
  if [[ -n $gh_args__command ]]
  then
    gh_help__topic=("$gh_args__command")
    for gh_help__arg in ${gh_args__rest[@]+"${gh_args__rest[@]}"}
    do
      [[ $gh_help__arg == -* ]] &&
        break
      gh_help__topic+=("$gh_help__arg")
    done
  fi
  exec "$(brew --prefix)"/bin/gh help ${gh_help__topic[@]+"${gh_help__topic[@]}"}
fi

if [[ -n $TIMVISHER_AGENT ]]
then
  # --- Noun / verb detection ---
  # The first positional is the noun (pr, issue, repo, …), the second is
  # the verb (create, edit, …). We skip flags (-*) and also consume the
  # VALUE of known value-taking global flags — otherwise `gh -R owner/repo
  # pr create` would pick up `owner/repo` as the noun and `pr` as the
  # verb, missing the real mutating pair.
  gh_guard__value_flags='^(-R|--repo|--hostname)$'
  gh_guard__noun=""
  gh_guard__verb=""
  gh_guard__skip_next=false
  for gh_guard__arg in "$@"
  do
    if [[ $gh_guard__skip_next == true ]]
    then
      gh_guard__skip_next=false
      continue
    fi
    if [[ $gh_guard__arg =~ $gh_guard__value_flags ]]
    then
      gh_guard__skip_next=true
      continue
    fi
    if [[ $gh_guard__arg == -* ]]
    then
      continue
    fi
    if [[ -z $gh_guard__noun ]]
    then
      gh_guard__noun=$gh_guard__arg
    elif [[ -z $gh_guard__verb ]]
    then
      gh_guard__verb=$gh_guard__arg
      break
    fi
  done
  gh_guard__pair="${gh_guard__noun} ${gh_guard__verb}"

  # --- Ancestor gate for timvisher_gh ---
  # timvisher_gh is the sanctioned path: it requires a human-reviewed
  # pr.md / issue.md / comment.md at repo root before posting. It shells
  # out to `gh pr create`, `gh issue create`, `gh pr comment`, etc., so
  # this wrapper must let those internal calls through. The ancestor walk
  # mirrors the one in bash/bin/git for the bd+dolt allow-path.
  gh_guard__is_timvisher_gh_ancestor() {
    local -A parent_of args_of
    local pid ppid cmd
    while read -r pid ppid cmd
    do
      parent_of[$pid]=$ppid
      args_of[$pid]=$cmd
    done < <(ps -o pid=,ppid=,args= -axww 2>/dev/null)

    local depth=0
    pid=$PPID
    while (( depth < 20 )) && [[ -n ${pid:-} && $pid != 0 && $pid != 1 ]]
    do
      # Only argv positions 0 and 1 count — position 0 for native binaries,
      # position 1 for shebang scripts (macOS ps renders these as
      # `interpreter /path/to/script …`, putting the script at argv[1]).
      # Restricting to these positions rejects false positives from
      # 'timvisher_gh' appearing as a regular later argv token.
      local -a toks=()
      read -ra toks <<< "${args_of[$pid]:-}"
      local j
      for (( j=0; j<${#toks[@]} && j<2; j++ ))
      do
        if [[ ${toks[$j]##*/} == timvisher_gh ]]
        then
          return 0
        fi
      done
      pid=${parent_of[$pid]:-}
      (( depth++ ))
    done
    return 1
  }

  # --- Verb-based IAM ---
  # gh's subcommand vocabulary is highly regular: nouns are containers
  # (pr, issue, repo, release, gist, label, project, workflow, run,
  # secret, variable, ssh-key, gpg-key, codespace, cache, ruleset, …)
  # and mutating verbs are the same shape across all of them. So one
  # verb list is enough — any noun paired with one of these verbs is a
  # mutation. New gh subcommands get blocked by default rather than
  # needing to be enumerated.
  #
  # Read-only verbs (list, view, show, status, checks, diff, browse,
  # download, clone, watch, login, logout, refresh) are deliberately
  # absent from this regex.
  gh_guard__mutating_verbs='create|edit|delete|close|reopen|comment|review|merge|ready|lock|unlock|pin|unpin|transfer|develop|rename|archive|unarchive|fork|sync|deploy-key|run|rerun|cancel|enable|disable|set|add|remove|rebuild|stop|upload|delete-asset|copy|link|unlink|field-create|field-delete|item-add|item-archive|item-create|item-delete|item-edit|mark-template|update-branch'

  if [[ $gh_guard__verb =~ ^(${gh_guard__mutating_verbs})$ ]] &&
     ! gh_guard__is_timvisher_gh_ancestor
  then
    aictl_die \
      --code "gh_mutation_blocked" \
      --message "Agents must NEVER run 'gh ${gh_guard__pair}' directly." \
      --reason "The verb '${gh_guard__verb}' mutates shared GitHub state. Creating, editing, merging, or deleting PRs / issues / comments / releases / repos / labels / secrets / keys affects systems beyond this machine. The human must review pr.md / issue.md / comment.md before any PR, issue, or comment is posted." \
      --doc "ai/HOME/.agents/skills/github/SKILL.md" \
      --suggestion "For a PR: draft pr.md, then run 'timvisher_gh pr'" \
      --suggestion "For an issue: draft issue.md, then run 'timvisher_gh issue'" \
      --suggestion "For a PR comment: draft comment.md, then run 'timvisher_gh comment comment.md'" \
      --suggestion "For any other mutation: ask the human"
  fi

  # --- gh api with mutating requests ---
  # Same IAM idea as above, applied to raw HTTP: any mutating method token
  # (POST / PUT / PATCH / DELETE — in -X / --method form, space, attached,
  # or combined short form `-XPOST`), or any field flag (-f / -F /
  # --field / --raw-field — including `-fkey=value` combined short form,
  # since pflag parses that the same way), blocks the call.
  if [[ $gh_guard__noun == api ]] && ! gh_guard__is_timvisher_gh_ancestor
  then
    for gh_guard__arg in "$@"
    do
      if [[ $gh_guard__arg =~ ^(POST|PUT|PATCH|DELETE)$ ]] ||
         [[ $gh_guard__arg =~ ^(-X|--method)=(POST|PUT|PATCH|DELETE)$ ]] ||
         [[ $gh_guard__arg =~ ^-X(POST|PUT|PATCH|DELETE)$ ]] ||
         [[ $gh_guard__arg =~ ^-[fF] ]] ||
         [[ $gh_guard__arg =~ ^(--field|--raw-field)(=|$) ]]
      then
        aictl_die \
          --code "gh_api_mutation_blocked" \
          --message "Agents must NEVER run 'gh api' with a mutating request." \
          --reason "POST / PUT / PATCH / DELETE against the GitHub API — or any -f / -F / --field / --raw-field (which implicitly POST) — can create or edit PRs, issues, comments, releases, and other shared state." \
          --doc "ai/HOME/.agents/skills/github/SKILL.md" \
          --suggestion "For a PR / issue / comment: use the timvisher_gh workflow (pr.md, issue.md, comment.md)" \
          --suggestion "For a read-only query: use 'gh search' or drop -f / -F / --method" \
          --suggestion "For any other mutation: ask the human"
      fi
    done
  fi
fi

gh_account__real_gh="$(brew --prefix)"/bin/gh
gh_account__doc='ai/HOME/.agents/skills/github/SKILL.md'

gh_account__valid_owner() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]
}

gh_account__path_from_web_url() {
  local a=$1
  case $a in
    [Hh][Tt][Tt][Pp][Ss]://[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*|[Hh][Tt][Tt][Pp]://[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*|[Hh][Tt][Tt][Pp][Ss]://[Ww][Ww][Ww].[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*|[Hh][Tt][Tt][Pp]://[Ww][Ww][Ww].[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*|[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*|[Ww][Ww][Ww].[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*|ssh://git@[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/?*)
      a=${a#*[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/}
      ;;
    git@[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]:?*)
      a=${a#*:}
      ;;
    *)
      return 1
      ;;
  esac
  printf '%s\n' "${a%%[?#]*}"
}

gh_account__owner_from_web_url() {
  local a owner
  a=$(gh_account__path_from_web_url "$1") ||
    return 1
  owner=${a%%/*}
  case $owner in
    orgs|users)
      [[ $a == */* ]] ||
        return 1
      a=${a#*/}
      owner=${a%%/*}
      ;;
    settings|notifications|login|logout|join|signup|marketplace|apps|sponsors|topics|search|explore|new|codespaces|features|enterprise|enterprises|organizations|pulls|issues|dashboard|about|pricing|account|stars|trending|collections|security|readme|copilot|discussions|site|contact|team|events|customer-stories|watching|github-copilot|advisories|home|blog|resources|solutions|premium-support|partners|education|mobile|gist|status|orgs-settings)
      return 1
      ;;
  esac
  gh_account__valid_owner "$owner" ||
    return 1
  printf '%s\n' "$owner"
}

gh_account__non_github_host() {
  case $1 in
    ''|[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]|*.[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm])
      return 1
      ;;
  esac
  return 0
}

gh_account__foreign_host() {
  local a=$1 host=''
  case $a in
    *://*)
      a=${a#*://}
      host=${a%%/*}
      host=${host##*@}
      ;;
    *@*:*)
      host=${a#*@}
      host=${host%%:*}
      ;;
    */*/*)
      host=${a%%/*}
      ;;
  esac
  [[ -n $host ]] ||
    return 1
  case $host in
    [Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]|*.[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm])
      return 1
      ;;
  esac
  printf '%s\n' "$host"
}

gh_account__owner_from_repo_value() {
  local a=$1 owner
  owner=$(gh_account__owner_from_web_url "$a") ||
    {
      a=${a#*://}
      [[ $a == */*/* ]] &&
        a=${a#*/}
      owner=${a%%/*}
    }
  gh_account__valid_owner "$owner" ||
    return 1
  printf '%s\n' "$owner"
}

gh_account__repo_spec_from_repo_value() {
  local a=$1 o r rest
  if a=$(gh_account__path_from_web_url "$a")
  then
    IFS=/ read -r o r rest <<< "$a"
    [[ -n $r ]] ||
      return 0
    printf '%s/%s\n' "$o" "${r%.git}"
    return 0
  fi
  a=$1
  [[ $a == */* ]] ||
    return 0
  printf '%s\n' "$a"
}

gh_account__account_for_owner() {
  local config_dir="${TIMVISHER_GH_CONFIG_DIR:-${HOME}/.config/timvisher/ide/bash/bin/timvisher_gh.config}"
  local want=${1,,} f org account
  for f in "${config_dir}"/orgs/*/account
  do
    [[ -r $f ]] ||
      continue
    org=${f%/account}
    org=${org##*/}
    [[ ${org,,} == "$want" ]] ||
      continue
    account=$(< "$f")
    account=${account//[[:space:]]/}
    if [[ -n $account ]]
    then
      printf '%s\n' "$account"
      return 0
    fi
  done
  for f in "${config_dir}"/orgs/*/account
  do
    [[ -r $f ]] ||
      continue
    account=$(< "$f")
    account=${account//[[:space:]]/}
    if [[ -n $account && ${account,,} == "$want" ]]
    then
      printf '%s\n' "$account"
      return 0
    fi
  done
  return 1
}

gh_account__owner_in_api_path() {
  local a=${1#/}
  case $a in
    repos/*/*|orgs/*|users/*)
      a=${a#*/}
      a=${a%%[/?#]*}
      gh_account__valid_owner "$a" ||
        return 1
      printf '%s\n' "$a"
      ;;
    *)
      return 1
      ;;
  esac
}

gh_account__owner_in_github_url() {
  local a=$1
  case $a in
    *://[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/*|*://[Ww][Ww][Ww].[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/*|[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/*|[Ww][Ww][Ww].[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/*|*://git@[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/*)
      a=${a#*[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/}
      ;;
    *git@[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]:*)
      a=${a#*[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]:}
      ;;
    *)
      return 1
      ;;
  esac
  printf '%s\n' "${a%%[/?#\"\' ]*}"
}

gh_account__github_family_url() {
  case $1 in
    *://*.[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]/*|*://*.[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm])
      return 0
      ;;
  esac
  return 1
}

gh_account__stop() {
  aictl_die \
    --code gh_target_required \
    --message "$1" \
    --reason "The gh shim picks an account only when the target is obvious; otherwise it asks rather than guess and risk using the wrong account." \
    --doc "$gh_account__doc" \
    --suggestion "Name the target before the subcommand: gh -R OWNER/REPO ${gh_args__command:-<command>} ..." \
    --suggestion "For calls with no repository (gh api user, gh gist list, gh search ...): gh -R OWNER ${gh_args__command:-<command>} ..."
}

gh_account__scan_rest() {
  local a url_owner i n=${#gh_args__rest[@]}
  for (( i=0; i < n; i+=1 ))
  do
    a=${gh_args__rest[i]}
    [[ $a == -- ]] &&
      break
    case $a in
      -R|-R*|--repo|--repo=*)
        case $gh_args__command in
          search|codespace|cs)
            ;;
          *)
            gh_account__stop "'${a}' after the subcommand can't be read reliably; put -R before the subcommand."
            ;;
        esac
        ;;
      --hostname)
        gh_account__non_github_host "${gh_args__rest[i+1]-}" &&
          gh_account__foreign=${gh_args__rest[i+1]}
        ;;
      --hostname=*)
        gh_account__non_github_host "${a#--hostname=}" &&
          gh_account__foreign=${a#--hostname=}
        ;;
    esac
    if url_owner=$(gh_account__owner_in_github_url "$a")
    then
      if [[ -z $gh_account__owner ]]
      then
        gh_account__stop "'${a}' names a github.com target the shim won't guess from; pass -R OWNER/REPO before the subcommand."
      elif [[ ${url_owner,,} != "${gh_account__owner,,}" ]]
      then
        gh_account__stop "'${a}' names '${url_owner}', not '${gh_account__owner}' (from ${gh_account__source}); pass -R ${url_owner}/REPO before the subcommand."
      fi
    elif [[ $a == *://* ]] && ! gh_account__github_family_url "$a"
    then
      gh_account__stop "'${a}' is a URL on a host other than github.com; pass -R before the subcommand if this call targets github.com."
    fi
  done
}

gh_account__scan_named_owners() {
  local a named
  for a in ${gh_args__rest[@]+"${gh_args__rest[@]}"}
  do
    [[ $a == -- ]] &&
      break
    named=''
    case $gh_args__command in
      api)
        named=$(gh_account__owner_in_api_path "$a")
        ;;
      repo)
        [[ $a =~ ^[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9._-]+$ ]] &&
          named=${a%%/*}
        ;;
    esac
    if [[ -n $named && ${named,,} != "${gh_account__owner,,}" ]]
    then
      gh_account__stop "'${a}' names '${named}', not '${gh_account__owner}' (from ${gh_account__source}); pass -R ${named}/... before the subcommand."
    fi
  done
}

gh_account__from_remotes() {
  local name url host owner first='' unknown=''
  local -a names=()
  local -A owners=()
  mapfile -t names < <(git remote 2>/dev/null)
  (( ${#names[@]} )) ||
    return 1
  for name in "${names[@]}"
  do
    url=$(git remote get-url "$name" 2>/dev/null) ||
      continue
    url=${url%.git}
    case $url in
      *://*)
        url=${url#*://}
        host=${url%%/*}
        host=${host##*@}
        host=${host%%:*}
        url=${url#*/}
        ;;
      *:*)
        host=${url%%:*}
        host=${host##*@}
        url=${url#*:}
        ;;
      *)
        unknown+=" ${name}"
        continue
        ;;
    esac
    if gh_account__non_github_host "$host"
    then
      unknown+=" ${name}"
      continue
    fi
    owner=${url%%/*}
    if [[ $url != */* ]] || ! gh_account__valid_owner "$owner"
    then
      unknown+=" ${name}"
      continue
    fi
    owners[${owner,,}]="${owners[${owner,,}]:+${owners[${owner,,}]}, }${name}"
    [[ -n $first ]] ||
      first=$owner
  done
  if [[ -n $unknown ]]
  then
    gh_account__stop "Remote(s)${unknown} aren't on github.com as far as the shim can tell, so it won't guess which repository gh will use."
  fi
  (( ${#owners[@]} )) ||
    return 1
  if (( 1 < ${#owners[@]} ))
  then
    local summary='' o
    for o in "${!owners[@]}"
    do
      summary+="${summary:+; }${o} (${owners[$o]})"
    done
    gh_account__stop "The cwd's remotes name different owners (${summary}); pass -R OWNER/REPO before the subcommand."
  fi
  gh_account__owner=$first
  gh_account__source="the cwd's git remotes"
}

gh_account__gh_repo_owner_differs() {
  local owner
  owner=$(gh_account__owner_from_repo_value "$GH_REPO") ||
    return 0
  [[ ${owner,,} != "${gh_account__owner,,}" ]]
}

gh_account__select() {
  local account token spec

  gh_account__argv=("$@")
  gh_account__owner=''
  gh_account__source=''
  gh_account__foreign=''

  [[ $gh_args__passthrough == true ]] &&
    return 0

  gh_account__argv=(${gh_args__pre[@]+"${gh_args__pre[@]}"} ${gh_args__command:+"$gh_args__command"} ${gh_args__rest[@]+"${gh_args__rest[@]}"})

  if [[ -n $gh_args__repo_value ]]
  then
    if gh_account__foreign=$(gh_account__foreign_host "$gh_args__repo_value")
    then
      export GH_REPO=$gh_args__repo_value
    elif gh_account__owner=$(gh_account__owner_from_repo_value "$gh_args__repo_value")
    then
      gh_account__source="-R '${gh_args__repo_value}'"
      spec=$(gh_account__repo_spec_from_repo_value "$gh_args__repo_value")
      if [[ -n $spec ]]
      then
        export GH_REPO=$spec
      elif [[ -n ${GH_REPO-} ]] && gh_account__gh_repo_owner_differs
      then
        aictl_notice \
          --code gh_gh_repo_dropped \
          --message "Ignoring GH_REPO '${GH_REPO}' for this call: -R '${gh_args__repo_value}' names a different owner." \
          --doc "$gh_account__doc"
        unset GH_REPO
      fi
    else
      gh_account__stop "Can't read an owner from -R '${gh_args__repo_value}'."
    fi
  fi

  case $gh_args__command in
    ''|auth|config|alias|extension|ext|help|completion|version|__complete|__completeNoDesc)
      return 0
      ;;
  esac

  if [[ -n ${GH_TOKEN-} || -n ${GITHUB_TOKEN-} ]]
  then
    aictl_notice \
      --code gh_account_deferred \
      --message "Deferring to the GH_TOKEN/GITHUB_TOKEN already in the environment; gh will run as whichever account that token belongs to." \
      --reason "A caller-set token always wins, so the gh shim did not select an account." \
      --doc "$gh_account__doc" \
      --suggestion "Unset GH_TOKEN and GITHUB_TOKEN to let the shim pick the account for the target"
    return 0
  fi

  if [[ -z $gh_account__owner && -z $gh_account__foreign && $gh_args__command == api ]] &&
     gh_account__owner=$(gh_account__owner_in_api_path "${gh_args__rest[0]-}")
  then
    gh_account__source='the gh api endpoint'
  fi

  gh_account__scan_rest

  if [[ -z $gh_account__owner && -z $gh_account__foreign && -n ${GH_REPO-} ]]
  then
    if gh_account__foreign=$(gh_account__foreign_host "$GH_REPO")
    then
      :
    elif [[ $GH_REPO == */* ]] &&
         gh_account__owner=$(gh_account__owner_from_repo_value "$GH_REPO")
    then
      gh_account__source="GH_REPO '${GH_REPO}'"
    else
      gh_account__stop "Can't read an owner from GH_REPO '${GH_REPO}'."
    fi
  fi

  if [[ -z $gh_account__foreign ]] && gh_account__non_github_host "${GH_HOST-}"
  then
    gh_account__foreign=$GH_HOST
  fi

  if [[ -n $gh_account__foreign ]]
  then
    aictl_info \
      --code gh_account_active \
      --message "The call targets '${gh_account__foreign}', not github.com; gh will run as its account for that host." \
      --doc "$gh_account__doc"
    return 0
  fi

  if [[ -z $gh_account__owner ]] && ! gh_account__from_remotes
  then
    gh_account__stop "No obvious target for 'gh ${gh_args__command}': no -R before the subcommand, no GH_REPO, and no github.com remote in the cwd."
  fi

  gh_account__scan_named_owners

  if ! account=$(gh_account__account_for_owner "$gh_account__owner")
  then
    aictl_info \
      --code gh_account_active \
      --message "No gh account is configured for '${gh_account__owner}' (from ${gh_account__source}); gh will run as its active account." \
      --doc "$gh_account__doc"
    return 0
  fi

  if ! token=$("$gh_account__real_gh" auth token --hostname github.com --user "$account" 2>/dev/null) ||
     [[ -z $token ]]
  then
    aictl_die \
      --code gh_account_token_unavailable \
      --message "Could not get a token for gh account '${account}', configured for '${gh_account__owner}' (from ${gh_account__source}); refusing to run as a different account." \
      --reason "Running as gh's active account instead could read or change '${gh_account__owner}' under the wrong identity." \
      --doc "$gh_account__doc" \
      --suggestion "Authenticate it: gh auth login --hostname github.com" \
      --suggestion "Or set GH_TOKEN yourself to run this call as a specific account"
  fi

  export GH_TOKEN=$token
  if [[ $gh_account__source == GH_REPO* ]]
  then
    aictl_notice \
      --code gh_account_selected \
      --message "Using gh account '${account}' for '${gh_account__owner}' (from ${gh_account__source} in the environment)." \
      --doc "$gh_account__doc"
  else
    aictl_info \
      --code gh_account_selected \
      --message "Using gh account '${account}' for '${gh_account__owner}' (from ${gh_account__source})." \
      --doc "$gh_account__doc"
  fi
}

gh_account__select "$@"

exec "$gh_account__real_gh" ${gh_account__argv[@]+"${gh_account__argv[@]}"}
