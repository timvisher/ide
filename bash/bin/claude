#!/usr/bin/env bash

# shellcheck disable=SC1090
source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

bin_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")") ||
  die "Couldn't resolve the wrapper's directory"

# shellcheck source=../ai/agents.bash
source "$bin_dir/../ai/agents.bash" ||
  die "Couldn't source agents.bash"

export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-op://Private/Anthropic API Key/credential}"
export CLAUDE_CODE_DISABLE_SUBSTITUTION_RM_PROMPT=1

export TIMVISHER_CLAUDE=true

timvisher_anthropic_connectivity_gate

real_claude=$(timvisher_real_bin claude "${BASH_SOURCE[0]}") ||
  die 'No claude found besides this wrapper ("%s"); install it with Homebrew or put it on PATH.' "${BASH_SOURCE[0]}"

timvisher_real_bin_skip_self "${BASH_SOURCE[0]}"
timvisher_agent_exec "$real_claude" "$@"
