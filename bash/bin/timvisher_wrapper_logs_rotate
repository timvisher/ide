#!/usr/bin/env bash

# Size-based rotation for the git wrapper's JSONL logs.
#
# trace2.jsonl grows at roughly 500 MB/day under normal use, and
# log.jsonl is already in the hundreds of MB, so a week of retention is
# multiple GB without this. Rotation is what makes "look at the last
# week" answerable at all.
#
# Size-based rather than time-based: volume tracks how much git ran, not
# how much time passed. Generations are gzipped because these are highly
# repetitive JSONL and compress ~10x.
#
# Why not an off-the-shelf rotator: logrotate is not installed and would
# be a new dependency. newsyslog(8) ships with macOS but is built for
# root plus syslogd -- /etc/newsyslog.d is root-owned, and driving it as
# a user needs -r, which its own man page calls debugging-only; tried
# that and it failed to chown the rotated file and left a temp file
# behind. If logrotate ever gets installed, prefer it: `size`, `rotate`
# and `compress` express all of this declaratively.
#
# Two rotation modes, because the two kinds of log have opposite
# correct answers:
#
#   rename    for the wrapper's *.jsonl. Every writer is a short-lived
#             git process that opens with O_APPEND, writes a line and
#             exits, so nothing holds the path across a rotation.
#             Rename's worst case is a line landing in the previous
#             generation; truncating would risk losing whatever was
#             written between the copy and the truncate.
#
#   truncate  for launchd agent logs. launchd holds StandardOutPath /
#             StandardErrorPath open for the life of a long-running job
#             -- verified: com.timvisher.gitwatch.bd-topics holds two
#             descriptors on its log -- so a rename leaves the job
#             writing into the rotated file and the live path empty
#             forever. Truncating in place keeps that descriptor valid.
#             launchd has no log rotation of its own; this is the
#             documented workaround.
#
# Readers must treat <name>.jsonl plus <name>.jsonl.N.gz (ascending N =
# older) as one logical stream.

source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

shopt -s extglob

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/timvisher/wrappers/git"
max_bytes=${TIMVISHER_WRAPPER_LOG_MAX_BYTES:-$((256 * 1024 * 1024))}
keep=${TIMVISHER_WRAPPER_LOG_KEEP:-7}

# mode: rename | truncate
rotate_one() {
  local f=$1 mode=$2 size i gz

  [[ -f $f ]] || return 0

  size=$(stat -c %s "$f" 2>/dev/null) || return 0
  if (( size < max_bytes ))
  then
    return 0
  fi

  # Drop everything at or past the keep limit, not just generation
  # $keep: lowering the limit would otherwise orphan higher generations
  # forever. Then shift the survivors up one.
  local gen
  shopt -s nullglob
  for gz in "${f}".*.gz
  do
    gen=${gz%.gz}
    gen=${gen##*.}
    [[ $gen == +([0-9]) ]] || continue
    (( keep <= gen )) && rm -f "$gz"
  done
  shopt -u nullglob

  for (( i = keep - 1; 1 <= i; i-- ))
  do
    [[ -f ${f}.${i}.gz ]] && mv -f "${f}.${i}.gz" "${f}.$((i + 1)).gz"
  done

  if [[ $mode == truncate ]]
  then
    if ! cp "$f" "${f}.1"
    then
      warn 'rotate: could not copy ‘%s’' "$f"
      return 1
    fi
    : > "$f"
  elif ! mv -f "$f" "${f}.1"
  then
    warn 'rotate: could not rename ‘%s’' "$f"
    return 1
  fi

  gzip -f "${f}.1" ||
    {
      warn 'rotate: could not gzip ‘%s.1’' "$f"
      return 1
    }

  info 'rotate: %s at %s bytes -> %s.1.gz' "$f" "$size" "$f"
}

rc=0

for name in log trace2 fsmonitor-samples
do
  rotate_one "${state_dir}/${name}.jsonl" rename || rc=1
done

# launchd agent logs. Smaller cap: these are sparse by design, so
# reaching even a few MB means something is logging on every run.
agent_log_max=${TIMVISHER_AGENT_LOG_MAX_BYTES:-$((8 * 1024 * 1024))}
shopt -s nullglob
for f in "${HOME}/Library/Logs/"timvisher_*.log "${HOME}/Library/Logs/"gitwatch-*.log
do
  max_bytes=$agent_log_max rotate_one "$f" truncate || rc=1
done
shopt -u nullglob

exit $rc
