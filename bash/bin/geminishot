#!/usr/bin/env bash

# Run gemini one-shot with streaming progress output.
#
# Usage: geminishot <prompt>
#        echo "prompt" | geminishot
#        geminishot git diff review
#        geminishot git diff describe

set -o pipefail

SELF_DIR=$(cd "$(dirname "$0")" && pwd -P)
JQ_FILTER="${SELF_DIR}/../lib/format_gemini_stream_json.jq"

# shellcheck source=../lib/aishot_help.bash
source "${SELF_DIR}/../lib/aishot_help.bash"

# Reads prompt from stdin (caller is responsible for preamble via
# aishot make-prompt).
#
# --skip-trust trusts the workspace for this session. Without it, gemini
# refuses to run in an "untrusted" directory and silently downgrades -y
# (YOLO) to default approval mode, which then blocks non-interactively
# and fails the shot (exit 55). One-shot reviews run headless against the
# current repo, so trusting the workspace for the run is the intent.
run_shot() {
    gemini -y --skip-trust -p "" -o stream-json |
        jq --unbuffered -r --arg tz_offset "$(date +%z)" -f "$JQ_FILTER"
}

aishot_shot_main geminishot Gemini run_shot "$@"
