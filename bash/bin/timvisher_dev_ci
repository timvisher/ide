#!/usr/bin/env bash

# shellcheck source-path=SCRIPTDIR/../../

# Local CI orchestrator for dev integration branches.
#
# Discovers dev integration worktrees from a registry file
# (~/.config/timvisher/ide/timvisher_dev_ci/branches) listing worktree paths.
# Resets+rebases their feature branches in parallel, then integrates
# and tests.  Uses ntmux3 -d to create standard tmux sessions and
# sends work to the :admin window.
#
# Subcommands:
#   run [path ...]    (default) full pipeline: upgrade -> sync -> test -> integrate -> test
#   status [path ...] show current status of all worktrees
#   clean [path ...]  remove status files
#
# When paths are given, only those dev branches are processed instead
# of discovering via marker files.
#   __sync        (internal) agent: pull --rebase, resolve conflicts, test
#   __integrate   (internal) script: fetch+reset dev branch; agent: merge worktrees one by one
#   __ensure_tests (internal) agent creates run-tests.sh if missing
#
# Hook scripts (run-tests.sh, post-integrate.sh) are resolved by a rung
# walk.  See "Hook helpers" below for the full model.
#
# Fork-network main owner is resolved via timvisher_gh info and cached.
#
# If a legacy x.<hook> file exists in a worktree and no hook is found
# at any rung, it is auto-migrated to the checked-in config dir under
# the fork network branch rung.

# shellcheck source=/dev/null
source ~/.functions/logging.bash ||
    {
        echo "Unable to source logging functions" >&2
        exit 1
    }

# shellcheck source=/dev/null
source ~/.functions/aictl.bash ||
    {
        echo "Unable to source aictl functions" >&2
        exit 1
    }

# Pull xenodium mains before any orchestration work.  Moved into
# cmd_run so lightweight subcommands (--help, hooks, run-tests, status,
# clean, worktrees) don't pay the network cost.
pull_xenodium_mains() {
    parallel -Jdefault_profile git -C '{}' pull ::: ~/git/xenodium/*/main >&2 ||
        die "Couldn't pull xenodium mains"
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

DEV_CI_REGISTRY=${TIMVISHER_DEV_CI_REGISTRY:-${HOME}/.config/timvisher/ide/timvisher_dev_ci/branches}
STATUS_FILENAME=x.dev-ci.status
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=${TIMVISHER_DEV_CI_HEARTBEAT_SECONDS:-30}
SELF=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
SELF_DIR=$(dirname "$SELF")
REPO_HOOKS_DIR="${SELF_DIR}/timvisher_dev_ci.config/hooks"
REPO_HOOKS_EXT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/timvisher/ide/timvisher_dev_ci/hooks"

BREW_UPGRADE_PACKAGES=(
  codex
  codex-acp
  claude-code
  beads
)

# Single source of truth for hook names recognised by `hooks ls` and
# the "run all" form of `hooks run`. Order matters: `hooks run` (no
# args) executes hooks in array order, so pre-* MUST precede the base
# hook of the same name. Adding a new hook? Add it here AND in the
# help text below.
KNOWN_HOOKS=(
    pre-run-tests.sh
    run-tests.sh
    pre-post-integrate.sh
    post-integrate.sh
)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_heartbeat_start=0
_heartbeat_last=0

heartbeat_start() {
    _heartbeat_start=$(date +%s)
    _heartbeat_last=$_heartbeat_start
}

heartbeat_due() {
    local now
    now=$(date +%s)

    (( now - _heartbeat_last < HEARTBEAT_INTERVAL_SECONDS )) && return 1

    _heartbeat_last=$now
}

heartbeat_elapsed() {
    local now
    now=$(date +%s)
    local elapsed=$(( now - _heartbeat_start ))

    printf '%d:%02d' "$(( elapsed / 60 ))" "$(( elapsed % 60 ))"
}

# Push the current branch to its push remote with --force-with-lease.
# Resolves the push remote via pushRemote > remote.pushDefault > tracking
# remote > origin, then pushes HEAD (same-named branch) to avoid the
# "upstream branch name doesn't match" error when tracking differs from
# the local branch name (e.g., soft forks tracking origin/main).
push_to_remote() {
    local dir=$1
    local err push_remote
    err=$(mktemp)
    push_remote=$(
      exec 2>"$err"
      branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
      git -C "$dir" config "branch.${branch}.pushRemote" ||
        git -C "$dir" config remote.pushDefault ||
        git -C "$dir" config "branch.${branch}.remote" ||
        printf origin
               )

    if [[ -z $push_remote ]]
    then
      error_stdout 'push_remote detection stderr: %s' < "$err"
      die "Couldn't detect push_remote. Error logs ↑"
    fi

    rm "$err"

    info "push: pushing '%s' to '%s' with --force-with-lease" "$dir" "$push_remote"
    if ! git -C "$dir" push --force-with-lease "$push_remote" HEAD
    then
        warn "push: --force-with-lease failed for '%s'" "$dir"
        return 1
    fi
}

# Integration runs on a scratch branch, and the dev branch is moved to it
# only once merge, verification and post-integrate have all passed, so a
# failure never leaves dev at @{u} plus whichever merges happened to land.
#
# The switch happens inside the dev worktree rather than in a scratch
# worktree because hook resolution derives <org>/<repo>/<branch-parts> from
# the worktree path, so hooks would resolve differently anywhere else.
INTEGRATE_SCRATCH_PREFIX='x.dev-ci-integrate'
integrate_scratch_path=''
integrate_scratch_branch=''
integrate_scratch_dev_branch=''
integrate_scratch_dev_head=''
integrate_scratch_start=''

# Put the dev branch back where it started.  Also the EXIT trap, so a die()
# anywhere in the run restores rather than stranding dev on the scratch.
integrate_scratch_restore() {
    [[ -n $integrate_scratch_branch ]] || return 0

    local path=$integrate_scratch_path
    local scratch=$integrate_scratch_branch
    local branch=$integrate_scratch_dev_branch
    local head=$integrate_scratch_dev_head

    # Cleared first: this also runs from the EXIT trap and must not recurse.
    integrate_scratch_branch=''
    trap - EXIT

    git -C "$path" merge --abort >/dev/null 2>&1
    git -C "$path" reset -q --hard >/dev/null 2>&1

    if ! git -C "$path" checkout --force -q "$branch"
    then
        error "integrate: cannot restore '%s' in '%s'; the attempt is on '%s'" \
              "$branch" "$path" "$scratch"
        return 1
    fi

    if ! git -C "$path" reset -q --hard "$head"
    then
        error "integrate: cannot reset '%s' to '%s'" "$branch" "$head"
        return 1
    fi

    # Kept, not deleted: it is the only record of what the run produced.
    warn "integrate: '%s' left unchanged at %s; the attempt is on scratch branch '%s'" \
         "$branch" "${head:0:12}" "$scratch"
}

integrate_scratch_begin() {
    local path=$1
    local branch head upstream scratch

    branch=$(git -C "$path" symbolic-ref --quiet --short HEAD) ||
        {
            error "integrate: no branch checked out in '%s'" "$path"
            return 1
        }

    head=$(git -C "$path" rev-parse HEAD) || return 1

    upstream=$(git -C "$path" rev-parse --abbrev-ref '@{u}') ||
        {
            error "integrate: '%s' (%s) tracks no upstream" "$path" "$branch"
            return 1
        }

    # Start the scratch at the run's recorded commit rather than at @{u} as
    # it resolves now. They are the same thing only if nothing re-fetched
    # since the baseline, and the whole point is not to depend on that.
    local start=$upstream
    local pinned
    if pinned=$(baseline_commit "$path" origin) || pinned=$(baseline_commit "$path" upstream)
    then
        if [[ $(git -C "$path" rev-parse "$upstream" 2>/dev/null) != "$pinned" ]]
        then
            info "integrate: '%s' has moved since the baseline; using %s" \
                 "$upstream" "${pinned:0:12}"
        fi
        start=$pinned
    fi

    scratch="${INTEGRATE_SCRATCH_PREFIX}-${branch//\//-}-$$"

    # Registered before the branch exists so a death in between still restores.
    integrate_scratch_path=$path
    integrate_scratch_dev_branch=$branch
    integrate_scratch_dev_head=$head
    integrate_scratch_branch=$scratch
    integrate_scratch_start=$start
    trap integrate_scratch_restore EXIT

    # -B so a scratch branch orphaned by a killed run is reused, not a blocker.
    if ! git -C "$path" checkout -q -B "$scratch" "$start"
    then
        integrate_scratch_branch=''
        trap - EXIT
        error "integrate: cannot start scratch branch '%s' at '%s'" "$scratch" "$start"
        return 1
    fi

    # The agent is told to fall back to 'git reset --hard @{u}', and the
    # post-merge verification compares against @{u}: both need the scratch
    # branch to track whatever dev tracks.
    if ! git -C "$path" branch -q --set-upstream-to "$upstream" "$scratch"
    then
        error "integrate: cannot point '%s' at upstream '%s'" "$scratch" "$upstream"
        return 1
    fi

    info "integrate: integrating on scratch branch '%s' at '%s'" "$scratch" "$start"
}

is_pull_upstream_worktree() {
    local branch
    branch=$(git -C "$1" symbolic-ref -q --short HEAD 2>/dev/null) || return 1
    [[ $branch == "${PULL_UPSTREAM_PREFIX}/"* ]]
}

# Advance the dev branch to the integrated tree and drop the scratch branch.
integrate_scratch_finish() {
    [[ -n $integrate_scratch_branch ]] || return 0

    local path=$integrate_scratch_path
    local scratch=$integrate_scratch_branch
    local branch=$integrate_scratch_dev_branch

    integrate_scratch_branch=''
    trap - EXIT

    if ! git -C "$path" checkout -q "$branch"
    then
        error "integrate: cannot check '%s' back out; the result is on '%s'" \
              "$branch" "$scratch"
        return 1
    fi

    if ! git -C "$path" reset -q --hard "$scratch"
    then
        error "integrate: cannot advance '%s' to '%s'" "$branch" "$scratch"
        return 1
    fi

    git -C "$path" branch -q -D "$scratch" >/dev/null 2>&1

    info "integrate: '%s' advanced to the integrated tree" "$branch"
}

# Read x.active-worktrees and emit uncommented, expanded paths.
read_active_worktrees() {
    local file=$1

    [[ -f $file ]] || return 0

    while IFS= read -r line
    do
        # skip blank lines and comments
        [[ -z $line || $line == '#'* ]] && continue
        # expand leading ~/ in the input line (literal match, not shell expansion)
        # shellcheck disable=SC2088
        if [[ $line == "~/"* ]]
        then
            line="${HOME}/${line#"~/"}"
        fi
        printf '%s\n' "$line"
    done < "$file"
}

is_remote_worktree() {
    local entry=$1
    [[ $entry != /* && $entry == *:* && ${entry%%:*} != */* ]]
}

# The entry names the remote worktree, not its branch: the branch comes
# from that worktree's HEAD symref, the same way local entries resolve
# theirs with rev-parse, so a rebase onto a new branch name there needs no
# x.active-worktrees edit here.
fetch_remote_worktree() {
    local entry=$1
    local host=${entry%%:*}
    local symref branch ref

    symref=$(git ls-remote --symref -- "$entry" HEAD) || return 1
    branch=$(sed -n 's|^ref: refs/heads/\(.*\)\tHEAD$|\1|p' <<< "$symref")
    if [[ -z $branch ]]
    then
        error "integrate: remote worktree '%s' has a detached HEAD" "$entry"
        return 1
    fi
    ref="refs/remotes/${host}/${branch}"
    git fetch --no-tags -- "$entry" "+HEAD:${ref}" >&2 || return 1
    printf '%s\n' "$ref"
}

is_dev_integration_worktree() {
    local path=$1

    [[ -f ${path}/x.dev-integration-branch ]] && return 0

    local resolved
    resolved=$(cd "$path" && pwd -P) || return 1

    local entry
    while IFS= read -r entry
    do
        [[ -d $entry ]] || continue
        [[ $(cd "$entry" && pwd -P) == "$resolved" ]] && return 0
    done < <(read_active_worktrees "$DEV_CI_REGISTRY")

    return 1
}

# ---------------------------------------------------------------------------
# Hook helpers: map worktree paths to hook scripts
# ---------------------------------------------------------------------------
#
# Hooks are resolved by walking rungs from least to most specific.  For
# a worktree at ~/git/timvisher-dd/aws-vault/dev/ where the fork network
# main is ByteNess/aws-vault and "me" is timvisher-dd, each rung is a key
# under <owner>/aws-vault/:
#
#   1. repo:    <owner>/aws-vault/<hook>
#   2. subpath: <owner>/aws-vault/<subpath>/<hook>, for every directory
#               containing a change vs '@{u}...', an uncommitted
#               change, or an untracked file, and each of its
#               ancestors, shallower before deeper, equal depths
#               ordered lexicographically
#   3. branch:  <owner>/aws-vault/dev/<hook>, exact full branch path
#               only (no prefix matching)
#
# Within a rung, the fork network main owner (ByteNess) is checked
# before me (timvisher-dd), and within an owner REPO_HOOKS_DIR is
# checked before REPO_HOOKS_EXT_DIR.  All matching hooks run, in that
# order; they do not shadow each other, so the most specific hook runs
# last.  Resolved paths are deduplicated so the same file is never
# executed twice.
#
# Subpath rungs depend on content: a clean worktree with no changes vs
# its upstream gets only the repo and branch rungs.

# Cached `timvisher_gh info --json` blobs, keyed by worktree path.
declare -A _worktree_context

# Resolve the canonical (symlinks resolved, trailing-slash-terminated)
# TIMVISHER_GIT_HOME for prefix comparisons.  Falls back to the
# unresolved value if the directory does not exist yet.
canonical_git_home() {
    local base="${TIMVISHER_GIT_HOME:-${HOME}/git}"
    if [[ -d $base ]]
    then
        base=$(cd "$base" && pwd -P)
    fi
    printf '%s/' "$base"
}

# Canonical cache key for a worktree.
# Usage: worktree_context_key "/path/to/worktree"
worktree_context_key() {
    (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "${1%/}"
}

# Populate _worktree_context for a worktree.  Returns 1 if the context
# cannot be resolved, leaving timvisher_gh's stderr intact.
# Usage: worktree_context "/path/to/worktree"
worktree_context() {
    local key
    key=$(worktree_context_key "$1")

    if [[ -n ${_worktree_context[$key]+set} ]]
    then
        return 0
    fi

    local blob
    blob=$(timvisher_gh -C "$1" info --json) ||
        return 1

    jq -e '
        (.timvisher_git.repo | type == "string" and . != "") and
        (.timvisher_git.branchPath | type == "string") and
        (.timvisher_gh.me | type == "string" and . != "") and
        (.timvisher_gh.forkNetwork.mainOwner | type == "string" and . != "")
    ' <<<"$blob" >/dev/null 2>&1 || {
        error "worktree_context: 'timvisher_gh -C %s info --json' returned a blob missing required fields" "$1"
        return 1
    }

    _worktree_context[$key]=$blob
}

# Emit the rung walk inputs from a worktree's cached context blob, one
# per line, in a fixed order: repo, branchPath, mainOwner, me.
# branchPath is the only one that may be empty, and it is not last, so
# command substitution cannot swallow it.
# Usage: fields=$(worktree_context_fields "/path/to/worktree")
worktree_context_fields() {
    local key
    key=$(worktree_context_key "$1")

    [[ -n ${_worktree_context[$key]+set} ]] ||
        die "worktree_context_fields: context for '%s' was not resolved first" "$1"

    jq -r '.timvisher_git.repo, .timvisher_git.branchPath,
           .timvisher_gh.forkNetwork.mainOwner, .timvisher_gh.me' \
        <<<"${_worktree_context[$key]}"
}

# Halt the run when a worktree's context cannot be resolved.
# Usage: die_unresolvable_context "/path/to/worktree"
die_unresolvable_context() {
    local worktree_path=$1

    aictl_die \
        --code "dev_ci_worktree_context_unresolvable" \
        --message "Cannot resolve the git/gh context for '${worktree_path}'" \
        --reason "Hook resolution needs <org>/<repo>/<branch-parts>, the fork-network main owner, and the authenticated GitHub user. All four come from 'timvisher_gh -C ${worktree_path} info --json', which either failed or returned a blob missing those fields. Its stderr is above." \
        --suggestion "Run 'timvisher_gh -C ${worktree_path} info --json' to see the failure directly" \
        --suggestion "Check 'gh auth status' for the account mapped to this repository's owner" \
        --suggestion "Confirm '${worktree_path}' is a worktree under \$TIMVISHER_GIT_HOME"
}

# Emit, NUL terminated, the repo-relative subpath of every directory
# containing a change vs '@{u}...', an uncommitted change, or an
# untracked file, plus each of its ancestors below the repo root,
# ordered shallowest first with equal depths ordered lexicographically.
# Usage: readarray -d '' -t subpaths < <(changed_subpaths "$wt")
changed_subpaths() {
    local worktree_path=$1

    local -A seen=()
    local path dir
    while IFS= read -r -d '' path
    do
        dir=$path
        if [[ $dir == */ ]]
        then
            dir=${dir%/}
            seen[$dir]=1
        fi
        while [[ $dir == */* ]]
        do
            dir=${dir%/*}
            seen[$dir]=1
        done
    done < <(
        git -C "$worktree_path" diff --name-only -z --no-renames '@{u}...' 2>/dev/null
        git -C "$worktree_path" status --porcelain=v1 -z --no-renames --untracked-files=normal 2>/dev/null |
            while IFS= read -r -d '' path
            do
                printf '%s\0' "${path:3}"
            done
    )

    local slashes line
    for dir in "${!seen[@]}"
    do
        slashes=${dir//[!\/]/}
        printf '%d\t%s\0' "${#slashes}" "$dir"
    done |
        LC_ALL=C sort -z -t $'\t' -k1,1n -k2,2 |
        while IFS= read -r -d '' line
        do
            printf '%s\0' "${line#*$'\t'}"
        done
}

_subpath_snapshot_key=""
declare -a _subpath_snapshot=()

# Usage: snapshot_changed_subpaths "/path/to/worktree"
snapshot_changed_subpaths() {
    _subpath_snapshot_key=$(worktree_context_key "$1")
    readarray -d '' -t _subpath_snapshot < <(changed_subpaths "$1")
}

# Print all matching hook scripts across the rung walk in run order, NUL
# terminated.  Returns 0 if any hook resolved, 1 if none is configured.
# Requires the worktree's context to be primed already: callers run
# worktree_context in their own shell, where a failure can halt.
# Usage: readarray -d '' -t hooks < <(find_hooks "$wt" "run-tests.sh")
find_hooks() {
    local worktree_path=$1
    local hook_name=$2

    local fields
    fields=$(worktree_context_fields "$worktree_path") ||
        return 1

    local repo branch_path main_owner me
    {
        read -r repo
        read -r branch_path
        read -r main_owner
        read -r me
    } <<<"$fields"

    local -a subpaths=()
    if [[ -n $_subpath_snapshot_key &&
          $_subpath_snapshot_key == "$(worktree_context_key "$worktree_path")" ]]
    then
        subpaths=("${_subpath_snapshot[@]}")
    else
        readarray -d '' -t subpaths < <(changed_subpaths "$worktree_path")
    fi

    local -a rungs=("")
    local subpath
    for subpath in "${subpaths[@]}"
    do
        rungs+=("/${subpath}")
    done
    [[ -n $branch_path ]] && rungs+=("/${branch_path}")

    # Deduplicate resolved paths (e.g. when me == main_owner) while
    # preserving rung order.
    local -A seen=()
    local -a resolved=()
    local rung owner dir full_path
    for rung in "${rungs[@]}"
    do
        for owner in "$main_owner" "$me"
        do
            for dir in "$REPO_HOOKS_DIR" "$REPO_HOOKS_EXT_DIR"
            do
                full_path="${dir}/${owner}/${repo}${rung}/${hook_name}"
                if [[ -x $full_path && -z ${seen[$full_path]+set} ]]
                then
                    seen[$full_path]=1
                    resolved+=("$full_path")
                fi
            done
        done
    done

    # printf reuses its format when given no arguments, so an empty
    # array would still emit one NUL and read back as a phantom path.
    (( 0 < ${#resolved[@]} )) ||
        return 1

    printf '%s\0' "${resolved[@]}"
}

# Resolve a worktree's context or halt.  Every hook lookup goes through
# here first, in the caller's shell, so an unresolvable context stops
# the run instead of reading as "no hook configured".
# Usage: require_worktree_context "/path/to/worktree"
require_worktree_context() {
    worktree_context "$1" ||
        die_unresolvable_context "$1"
}

# Boolean form of find_hooks: 0 if any hook resolves, 1 if none do.
# Halts the run when the context cannot be resolved.
# Usage: hook_exists "/path/to/worktree" "run-tests.sh"
hook_exists() {
    require_worktree_context "$1"

    local -a hooks=()
    readarray -d '' -t hooks < <(find_hooks "$1" "$2")

    (( 0 < ${#hooks[@]} ))
}

# Run all matching hooks for a given hook name.  Each hook is executed
# in a separate bash process with its cwd at the worktree.  Fails on the
# first hook that fails; returns 0 when no hook is configured, and halts
# on an unresolvable context.
# Usage: run_hooks "/path/to/worktree" "run-tests.sh"
run_hooks() {
    local worktree_path=$1
    local hook_name=$2

    require_worktree_context "$worktree_path"

    local -a resolved=()
    readarray -d '' -t resolved < <(find_hooks "$worktree_path" "$hook_name")

    # Resolved first, deliberately: hook resolution derives
    # <org>/<repo>/<branch-parts> from the real git home, so the farm must
    # not be in scope until after it has run.
    local farm
    farm=$(worktree_farm "$worktree_path")
    [[ -n $farm ]] && hook_git_home=$farm

    local hook_path
    for hook_path in "${resolved[@]}"
    do
        info "hook: running '%s'" "$hook_path"

        # Injected for the hook only.  Resolution above already ran against
        # the real git home, which is what derives <org>/<repo>/<branch-parts>
        # -- pointing the variable at the farm any earlier would send hook
        # resolution looking for the worktree somewhere it is not.
        if [[ -n $hook_git_home ]]
        then
            info "hook: dependencies resolved through '%s'" "$hook_git_home"
            (cd "$worktree_path" && TIMVISHER_GIT_HOME="$hook_git_home" bash "$hook_path") || return $?
        else
            (cd "$worktree_path" && bash "$hook_path") || return $?
        fi
    done
}

# Ensure a hook script exists.  If a legacy x.<name> file exists in the
# worktree and no hook is found at any rung, migrate it to the
# checked-in config dir (REPO_HOOKS_DIR) under the fork network path.
# Returns 0 if a hook is found (after migration), 1 otherwise.
# Usage: ensure_repo_script "/path/to/worktree" "run-tests.sh"
ensure_repo_script() {
    local worktree_path=$1
    local script_name=$2

    worktree_context "$worktree_path" ||
        die_unresolvable_context "$worktree_path"

    # Migration target uses the fork network main owner path.
    local fields
    fields=$(worktree_context_fields "$worktree_path") ||
        die_unresolvable_context "$worktree_path"

    local wt_repo branch_path main_owner
    {
        read -r wt_repo
        read -r branch_path
        read -r main_owner
    } <<<"$fields"
    local target_rel="${main_owner}/${wt_repo}"
    [[ -n $branch_path ]] && target_rel="${target_rel}/${branch_path}"

    local config_path="${REPO_HOOKS_DIR}/${target_rel}/${script_name}"
    local legacy_path="${worktree_path}/x.${script_name}"

    # Migrate legacy x. file if it exists and no config version exists
    # at any rung.
    if ! hook_exists "$worktree_path" "$script_name" &&
       [[ -f $legacy_path ]]
    then
        info "Migrating '%s' → '%s'" "$legacy_path" "$config_path"
        mkdir -p "$(dirname "$config_path")"
        cp "$legacy_path" "$config_path"
        chmod +x "$config_path"
    fi

    hook_exists "$worktree_path" "$script_name"
}

# ---------------------------------------------------------------------------
# Discovery: build the dependency graph
# ---------------------------------------------------------------------------

# Associative arrays populated by discover().
#   dev_branches[dev_path] = "wt1 wt2 wt3"   (space-separated feature worktree deps)
#   dev_branch_deps[dev_path] = "dev1 dev2"   (space-separated dev branch deps)
#   all_worktrees[wt_path] = 1                (deduplicated set)
declare -A dev_branches
declare -A dev_branch_deps
declare -A all_worktrees

discover() {
    local found=0
    local dev_dirs=()

    if [[ $# -ne 0 ]]
    then
        dev_dirs=("$@")
    else
        if [[ ! -f $DEV_CI_REGISTRY ]]
        then
            die "Registry file not found: %s" "$DEV_CI_REGISTRY"
        fi
        while IFS= read -r line
        do
            dev_dirs+=("$line")
        done < <(read_active_worktrees "$DEV_CI_REGISTRY")
    fi

    for dev_dir in "${dev_dirs[@]}"
    do
        [[ -d $dev_dir ]] || continue
        dev_dir=$(cd "$dev_dir" && pwd -P)

        local wt_file="${dev_dir}/x.active-worktrees"
        local deps=()

        # dev branches without x.active-worktrees are still tracked
        # (they just have no feature-branch deps, like shell-maker/dev).
        if [[ -f $wt_file ]]
        then
            while IFS= read -r wt
            do
                if [[ ! -d $wt ]]
                then
                    warn "Worktree '%s' listed in '%s' does not exist; skipping" "$wt" "$wt_file"
                    continue
                fi
                deps+=("$wt")
                all_worktrees["$wt"]=1
            done < <(read_active_worktrees "$wt_file")
        fi

        dev_branches["$dev_dir"]="${deps[*]}"

        # Read inter-dev-branch dependencies.
        local dev_dep_file="${dev_dir}/x.integration-branch-dependencies"
        local dev_deps=()

        if [[ -f $dev_dep_file ]]
        then
            while IFS= read -r dd
            do
                if [[ ! -d $dd ]]
                then
                    warn "Dev dep '%s' listed in '%s' does not exist; skipping" "$dd" "$dev_dep_file"
                    continue
                fi
                dev_deps+=("$dd")
            done < <(read_active_worktrees "$dev_dep_file")
        fi

        dev_branch_deps["$dev_dir"]="${dev_deps[*]}"
        found=1
    done

    if [[ $found == 0 ]]
    then
        if [[ $# -ne 0 ]]
        then
            die "No dev integration branches found at specified paths"
        else
            die "No dev integration branches found in registry: %s" "$DEV_CI_REGISTRY"
        fi
    fi

    # Transitively discover dev branch dependencies not already in the set.
    local new_deps_found=true
    while [[ $new_deps_found == true ]]
    do
        new_deps_found=false
        for dev_dir in "${!dev_branch_deps[@]}"
        do
            local dd_str=${dev_branch_deps[$dev_dir]}
            [[ -n $dd_str ]] || continue

            read -ra dd_list <<< "$dd_str"
            for dd in "${dd_list[@]}"
            do
                [[ -n ${dev_branches[$dd]+x} ]] && continue
                [[ -d $dd ]] || continue

                info "Adding transitive dependency '%s' (required by '%s')" "$dd" "$dev_dir"
                new_deps_found=true

                # Discover this dep the same way as the main loop.
                local resolved_dd
                resolved_dd=$(cd "$dd" && pwd -P)

                local wt_file="${resolved_dd}/x.active-worktrees"
                local deps=()

                if [[ -f $wt_file ]]
                then
                    while IFS= read -r wt
                    do
                        if [[ ! -d $wt ]]
                        then
                            warn "Worktree '%s' listed in '%s' does not exist; skipping" "$wt" "$wt_file"
                            continue
                        fi
                        deps+=("$wt")
                        all_worktrees["$wt"]=1
                    done < <(read_active_worktrees "$wt_file")
                fi

                dev_branches["$resolved_dd"]="${deps[*]}"

                local dev_dep_file="${resolved_dd}/x.integration-branch-dependencies"
                local dev_deps=()

                if [[ -f $dev_dep_file ]]
                then
                    while IFS= read -r sub_dd
                    do
                        if [[ ! -d $sub_dd ]]
                        then
                            warn "Dev dep '%s' listed in '%s' does not exist; skipping" "$sub_dd" "$dev_dep_file"
                            continue
                        fi
                        dev_deps+=("$sub_dd")
                    done < <(read_active_worktrees "$dev_dep_file")
                fi

                dev_branch_deps["$resolved_dd"]="${dev_deps[*]}"
            done
        done
    done
}

# Resolve the ref a finished branch must be an ancestor of before it is
# retired from x.active-worktrees.
#
# Soft forks (x.timvisher_git.soft-fork cookie) land their features in
# their own origin/<trunk>; upstream changes flow the other way, so a
# fork feature is never an ancestor of upstream and must be measured
# against origin.  Regular forks track upstream/<trunk>, so prefer that
# and fall back to origin/main only when no upstream ref exists.
# Prints the ref (e.g. "origin/main"); prints nothing if none resolves.
resolve_retire_merge_ref() {
    local wt=$1
    local ref

    if [[ -f ${wt}/x.timvisher_git.soft-fork ]]
    then
        ref=$(git -C "$wt" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) || true
        if [[ -z $ref ]] && git -C "$wt" show-ref --verify --quiet refs/remotes/origin/main 2>/dev/null
        then
            ref=origin/main
        fi
        printf '%s' "$ref"
        return 0
    fi

    ref=$(git -C "$wt" symbolic-ref -q --short refs/remotes/upstream/HEAD 2>/dev/null) || true
    if [[ -z $ref ]]
    then
        if git -C "$wt" show-ref --verify --quiet refs/remotes/upstream/main 2>/dev/null
        then
            ref=upstream/main
        elif git -C "$wt" show-ref --verify --quiet refs/remotes/origin/main 2>/dev/null
        then
            ref=origin/main
        fi
    fi
    printf '%s' "$ref"
}

# Check each active worktree to see if its branch has been merged into
# the ref it should land in (origin/<trunk> for soft forks, otherwise
# upstream/<trunk>; see resolve_retire_merge_ref).  If so, comment it out
# of x.active-worktrees and remove it from the dependency graph so we
# don't waste time syncing/integrating it.
retire_merged_worktrees() {
    for dev_dir in "${!dev_branches[@]}"
    do
        local wt_file="${dev_dir}/x.active-worktrees"
        [[ -f $wt_file ]] || continue

        local changed=false

        local deps_str=${dev_branches[$dev_dir]}
        [[ -n $deps_str ]] || continue

        read -ra wt_list <<< "$deps_str"
        local remaining=()

        for wt in "${wt_list[@]}"
        do
            # No fetch: retirement is judged against the run's baseline, the
            # same commit every other phase targets. Fetching here would let
            # a branch retire against an upstream nothing else saw.
            local merge_ref
            if [[ -f ${wt}/x.timvisher_git.soft-fork ]]
            then
                merge_ref=$(baseline_commit "$wt" origin) ||
                    merge_ref=$(resolve_retire_merge_ref "$wt")
            else
                merge_ref=$(baseline_commit "$wt" upstream) ||
                    merge_ref=$(resolve_retire_merge_ref "$wt")
            fi

            if [[ -z $merge_ref ]]
            then
                remaining+=("$wt")
                continue
            fi

            if git -C "$wt" merge-base --is-ancestor HEAD "$merge_ref" 2>/dev/null
            then
                info "retire: '%s' is fully merged into %s; commenting out" "$wt" "$merge_ref"

                # Comment out the line in x.active-worktrees.
                # The file may use ~/... or absolute paths; match either form.
                # The tilde must be escaped: bash tilde-expands the
                # replacement, so an unescaped one puts $HOME back and this
                # comes out identical to $wt -- leaving both sed expressions
                # below the same and every tilde-form entry unmatched.
                local wt_home_relative="${wt/#${HOME}/\~}"
                local escaped_wt escaped_home_rel
                escaped_wt=$(printf '%s' "$wt" | sed 's/[&/\]/\\&/g')
                escaped_home_rel=$(printf '%s' "$wt_home_relative" | sed 's/[&/\]/\\&/g')
                sed -i '' -e "s|^${escaped_wt}\$|# ${escaped_wt}|" \
                          -e "s|^${escaped_home_rel}\$|# ${escaped_home_rel}|" \
                    "$wt_file"

                # Remove from tracking.
                unset 'all_worktrees[$wt]'
                changed=true
            else
                remaining+=("$wt")
            fi
        done

        if [[ $changed == true ]]
        then
            dev_branches["$dev_dir"]="${remaining[*]}"
        fi
    done
}

# ---------------------------------------------------------------------------
# Session management
# ---------------------------------------------------------------------------

# ntmux3 is a shell function loaded via ~/.functions/tmux.bash.  Source it in
# a subshell so we get it without loading all of .bashrc.  tmux.bash requires
# extglob for extended glob patterns.
run_ntmux3() {
    (
        shopt -s extglob
        # shellcheck source=/dev/null
        source ~/.functions/logging.bash 2>/dev/null
        # shellcheck source=/dev/null
        source ~/.functions/tmux.bash 2>/dev/null ||
            {
                error "Unable to source tmux.bash"
                return 1
            }
        ntmux3 "$@"
    )
}

# Ensure an ntmux3 session exists for a worktree and return its session name.
ensure_session() {
    local worktree_path=$1

    run_ntmux3 -d "$worktree_path" ||
        {
            error "ntmux3 -d failed for '%s'" "$worktree_path"
            return 1
        }
}

# Send a command string to the :admin window of a tmux session.
# First sends M-# to clear any partial input (bash insert-comment:
# prepends # and accepts the line, giving a clean prompt).
send_to_admin() {
    local session_name=$1
    shift
    local cmd="$*"

    tmux send-keys -t="${session_name}":admin M-'#'
    tmux send-keys -t="${session_name}":admin "$cmd" C-m
}

agent_session_contract() {
    local status_file=$1

    cat <<CONTRACT_EOF
Session contract -- read this before you start.

You are running as a one-shot, non-interactive agent session. When you
stop making tool calls, the session ends and the process exits. There
is no later turn, no notification delivery, and no chance to report
back.

Consequences:

- Every background job and subagent you spawn is killed when the
  session exits. Backgrounding a long task and then ending your turn
  loses the task entirely.
- Run the test hooks in the FOREGROUND and wait for them to exit. Do
  not background them, do not delegate them to a subagent, and do not
  poll for them with sleep loops. Tests routinely take 5-15 minutes;
  a foreground command that takes that long is expected and fine.
  Raise the tool timeout rather than backgrounding.
- Do not end your turn until you have written '${status_file}'. An
  unwritten status file is recorded as a failure by the orchestrator,
  which discards the work you did even when the merge and the tests
  were clean.
- Never write 'pass' before the tests have actually exited zero.
  Reporting intent ("tests are still running, I'll report when they
  finish") is not a result.
CONTRACT_EOF
}

# ---------------------------------------------------------------------------
# Worker: __sync  (runs inside :admin pane)
#
# Agent-driven: pull --rebase, resolve conflicts, run tests.
# Script-driven: verify tests after agent finishes.
# ---------------------------------------------------------------------------

cmd__sync() {
    local worktree_path=$1
    local status_file="${worktree_path}/${STATUS_FILENAME}"

    cd "$worktree_path" ||
        {
            echo 'fail' > "$status_file"
            die "Cannot cd to '%s'" "$worktree_path"
        }

    rm -f "$status_file"

    # Ensure run-tests.sh exists before syncing.
    if ! ensure_repo_script "$worktree_path" "run-tests.sh"
    then
        info "sync: no run-tests.sh found; launching agent to create one"
        cmd__ensure_tests "$worktree_path"
    fi

    # Tracking is set correctly by timvisher_git (origin/<trunk> for soft
    # forks, upstream/<trunk> for regular forks).  Plain pull --rebase
    # follows the tracking branch -- but it also fetches, which is a second
    # observation of upstream. With a baseline, rebase onto the commit the
    # run pinned instead, so every worktree lands on the same one.
    local pull_cmd="git pull --rebase"
    local sync_pin
    if sync_pin=$(baseline_commit "$worktree_path" origin) ||
       sync_pin=$(baseline_commit "$worktree_path" upstream)
    then
        pull_cmd="git rebase ${sync_pin}"
        info "sync: rebasing onto the baseline %s" "${sync_pin:0:12}"
    fi

    require_worktree_context "$worktree_path"

    local -a run_tests_hooks=()
    readarray -d '' -t run_tests_hooks < <(find_hooks "$worktree_path" "run-tests.sh")

    local has_run_tests=false
    (( 0 < ${#run_tests_hooks[@]} )) && has_run_tests=true

    local test_instruction=""
    local hook_list
    if $has_run_tests
    then
        hook_list=$(printf '%s\n' "${run_tests_hooks[@]}")
        test_instruction="After syncing, run each of these test hooks in order and verify they pass.
If tests fail, investigate and fix the issue.
Hooks:
${hook_list}"
    else
        test_instruction="No run-tests.sh is available, so skip testing."
    fi

    local prompt_file
    prompt_file=$(mktemp "${worktree_path}/x.dev-ci-prompt.XXXXXX") || {
        echo 'fail' > "$status_file"
        die "Cannot create prompt file"
    }

    cat > "$prompt_file" <<PROMPT_EOF
$(agent_session_contract "$status_file")

You are in a feature worktree at ${worktree_path}.
This worktree contains features we are actively developing.

Run '${pull_cmd}' to sync with upstream. If there are conflicts,
resolve them. Be sure to keep the features that were developed on this
worktree -- upstream changes should be incorporated, but our feature
work takes priority when there is a genuine conflict in intent.

${test_instruction}

When done, write 'pass' to '${status_file}'.
If you cannot resolve a conflict or fix a test failure, write 'fail' to '${status_file}'.

Work in ${worktree_path}. Do not modify other directories.
PROMPT_EOF

    info "sync: launching agent for pull --rebase"

    if claudeshot "$(< "$prompt_file")"
    then
        info "sync: agent finished"
    else
        warn "sync: agent exited with error"
    fi

    rm -f "$prompt_file"

    # Capture the agent's verdict and remove the status file to prevent
    # the outer polling loop from reading a premature result (same race
    # fix as cmd__integrate).
    local final_status
    if [[ -f $status_file ]]
    then
        final_status=$(cat "$status_file")
        rm -f "$status_file"
    else
        warn "sync: agent did not write status file; marking fail"
        final_status=fail
    fi

    # Verify tests deterministically -- don't rely solely on the agent.
    if [[ $final_status == pass ]]
    then
        if $has_run_tests
        then
            info "sync: verifying tests in '%s'" "$worktree_path"
            run_hooks "$worktree_path" "pre-run-tests.sh"
            if ! run_hooks "$worktree_path" "run-tests.sh"
            then
                warn "sync: tests failed in '%s'" "$worktree_path"
                final_status=fail
            fi
        else
            info "sync: no run-tests.sh; skipping test verification"
        fi
    fi

    # Run post-sync hook if tests passed.
    if [[ $final_status == pass ]] &&
       hook_exists "$worktree_path" "post-integrate.sh"
    then
        info "sync: running post-integrate hook"
        run_hooks "$worktree_path" "pre-post-integrate.sh"
        if ! run_hooks "$worktree_path" "post-integrate.sh"
        then
            error "sync: post-integrate hook failed"
            final_status=fail
        fi
    fi

    # Push before writing the status file so the polling loop never
    # sees a premature "pass" that gets overwritten by a push failure.
    if [[ $final_status == pass ]]
    then
        if ! push_to_remote "$worktree_path"
        then
            final_status=fail
        fi
    fi

    echo "$final_status" > "$status_file"
}

# ---------------------------------------------------------------------------
# Worker: __integrate  (runs inside :admin pane)
#
# Script-driven: fetch, reset --hard @{u}, ensure run-tests.sh,
# run baseline tests.
# Agent-driven: merge worktrees ONE AT A TIME, running tests after each.
# The agent handles conflicts and cross-worktree incompatibilities.
# ---------------------------------------------------------------------------

cmd__integrate() {
    local dev_path=$1
    shift
    # remaining args are worktree paths to merge
    local worktree_paths=("$@")
    local status_file="${dev_path}/${STATUS_FILENAME}"

    cd "$dev_path" ||
        {
            echo 'fail' > "$status_file"
            die "Cannot cd to '%s'" "$dev_path"
        }

    rm -f "$status_file"

    # --- scripted baseline ---

    # No fetch when the run handed us a baseline: @{u} is re-resolved here
    # otherwise, which is a second observation of upstream and the whole
    # reason a run could target two different snapshots.
    if ! baseline_commit "$dev_path" origin >/dev/null 2>&1 &&
       ! baseline_commit "$dev_path" upstream >/dev/null 2>&1
    then
        info "integrate: no baseline; fetching"
        if ! git fetch --all
        then
            echo 'fail' > "$status_file"
            die "git fetch failed in '%s'" "$dev_path"
        fi
    fi

    if ! integrate_scratch_begin "$dev_path"
    then
        echo 'fail' > "$status_file"
        die "integrate: cannot start a scratch branch in '%s'" "$dev_path"
    fi

    # Ensure run-tests.sh exists before baseline test.
    if ! ensure_repo_script "$dev_path" "run-tests.sh"
    then
        info "integrate: no run-tests.sh found; launching agent to create one"
        cmd__ensure_tests "$dev_path"
    fi

    require_worktree_context "$dev_path"

    local -a run_tests_hooks=()
    readarray -d '' -t run_tests_hooks < <(find_hooks "$dev_path" "run-tests.sh")

    local has_run_tests=false
    (( 0 < ${#run_tests_hooks[@]} )) && has_run_tests=true

    # Run baseline tests on @{u}.  Capture output rather than
    # failing hard -- pre-existing upstream failures should not block
    # integration.  The output is passed to the agent so it can tell
    # which failures are pre-existing vs caused by the merge.
    local baseline_log="${dev_path}/x.dev-ci-baseline.log"
    local baseline_results="${dev_path}/x.dev-ci-baseline-results.txt"
    local baseline_clean=true

    if $has_run_tests
    then
        info "integrate: running baseline tests on @{u}"
        : > "$baseline_results"
        run_hooks "$dev_path" "pre-run-tests.sh"
        if TIMVISHER_DEV_CI_RESULTS_FILE="$baseline_results" \
           run_hooks "$dev_path" "run-tests.sh" > "$baseline_log" 2>&1
        then
            info "integrate: baseline tests passed"
        else
            warn "integrate: baseline tests have pre-existing failures on @{u}"
            baseline_clean=false
        fi
    else
        warn "integrate: run-tests.sh missing; skipping baseline tests"
        printf '(no run-tests.sh)\n' > "$baseline_log"
    fi

    # --- agent-driven integration ---

    # If there are no worktrees to integrate, we're done after baseline tests.
    if [[ ${#worktree_paths[@]} == 0 ]]
    then
        local early_status=pass
        if [[ $baseline_clean == true ]]
        then
            info "integrate: no worktrees to integrate; baseline tests passed; done"
        else
            warn "integrate: no worktrees to integrate; baseline has pre-existing failures (ignored)"
        fi

        # Run post-integration hook even with no worktrees (e.g. build+install).
        ensure_repo_script "$dev_path" "post-integrate.sh" || true
        if hook_exists "$dev_path" "post-integrate.sh"
        then
            info "integrate: running post-integration hook"
            run_hooks "$dev_path" "pre-post-integrate.sh"
            if ! run_hooks "$dev_path" "post-integrate.sh"
            then
                error "integrate: post-integration hook failed"
                early_status=fail
            fi
        fi

        if [[ $early_status == pass ]]
        then
            integrate_scratch_finish || early_status=fail
        else
            integrate_scratch_restore
        fi

        if [[ $early_status == pass ]]
        then
            if ! push_to_remote "$dev_path"
            then
                early_status=fail
            fi
        fi

        echo "$early_status" > "$status_file"
        [[ $early_status == pass ]]
        return
    fi

    # Build branch lists for the agent prompt.
    local branch_list=""
    local branch_names=()
    for wt in "${worktree_paths[@]}"
    do
        local branch
        branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || {
            error "integrate: cannot resolve branch for '%s'" "$wt"
            integrate_scratch_restore
            echo 'fail' > "$status_file"
            return 1
        }
        branch_list+="  - ${branch}  (from ${wt})"$'\n'
        branch_names+=("$branch")
    done

    local test_instruction=""
    local baseline_context=""
    local hook_list
    if $has_run_tests
    then
        hook_list=$(printf '%s\n' "${run_tests_hooks[@]}")
        test_instruction="After the merge, run each of these test hooks in order and verify they pass:
${hook_list}"
        if [[ $baseline_clean == false ]]
        then
            baseline_context="
IMPORTANT: The baseline tests on the upstream tracking branch ALREADY HAD FAILURES before
any branches were merged. The baseline test output is in '${baseline_log}'.
Read that file. Any test failures that also appear in the baseline are
PRE-EXISTING upstream issues -- do NOT count them as integration failures.
Only NEW failures (ones not in the baseline) indicate a problem caused by
the merge. If the only failures after merging are the same ones from the
baseline, that counts as passing."
        fi
    else
        test_instruction="No run-tests.sh is available, so skip testing."
    fi

    local regen_glob=${TIMVISHER_DEV_CI_INTEGRATE_REGEN_GLOB:-BUILD.bazel}

    local prompt_file
    prompt_file=$(mktemp "${dev_path}/x.dev-ci-prompt.XXXXXX") || {
        echo 'fail' > "$status_file"
        die "Cannot create prompt file"
    }

    cat > "$prompt_file" <<PROMPT_EOF
$(agent_session_contract "$status_file")

You are in a dev integration worktree at ${dev_path}.

You are on scratch branch '${integrate_scratch_branch}', created at
${integrate_scratch_start}, the commit this run pinned as its upstream
baseline. Do NOT switch branches or create new ones.
'${integrate_scratch_dev_branch}' is moved to your work only if you succeed,
so a failure here costs nothing.

If you need to start over, reset to ${integrate_scratch_start} -- that exact
commit, not @{u}. Every phase of this run targets it, and re-resolving a ref
could pick up an upstream the rest of the run never saw.

Integrate the following branches using a single octopus merge:

${branch_list}
Run:
  git merge ${branch_names[*]}

This merges all branches at once. If the octopus merge fails (conflicts),
fall back to merging the branches one at a time, resolving conflicts as
you go. When falling back:
1. Reset to @{u} with 'git reset --hard @{u}'.
2. Merge each branch individually with 'git merge <branch>'.
3. If a merge has conflicts, resolve them preserving the intent of both
   sides. Stage resolved files with 'git add' and complete with
   'git merge --continue'.

A conflict confined to generated files (${regen_glob// /, }) is not a real
conflict: each branch committed its own gazelle output, and post-integrate.sh
re-derives these from the merged sources. Resolve those by keeping either side
('git checkout --ours -- <path>', then 'git add <path>') and continue the
merge. Reconcile only conflicts in SOURCE files.

${test_instruction}
If tests fail, investigate and fix the issue.
${baseline_context}
Pay special attention to conflicts BETWEEN worktrees -- cases where two
feature branches both modify the same file or API in mutually incompatible
ways. When this happens, reconcile both features so they coexist correctly.

When ALL branches are integrated and tests pass, write 'pass' to '${status_file}'.
If you cannot resolve a conflict or fix a test failure, write 'fail' to '${status_file}'.

Work in ${dev_path}. Do not modify other directories.
PROMPT_EOF

    info "integrate: launching agent to integrate %d worktrees" "${#worktree_paths[@]}"

    if claudeshot "$(< "$prompt_file")"
    then
        info "integrate: agent finished"
    else
        warn "integrate: agent exited with error"
    fi

    rm -f "$prompt_file"

    # Capture the agent's verdict and remove the status file so the
    # outer polling loop cannot read a premature "pass" while we are
    # still running verification steps (race condition: the polling
    # loop could read the agent's "pass" before verification runs).
    local final_status
    if [[ -f $status_file ]]
    then
        final_status=$(cat "$status_file")
        rm -f "$status_file"
    else
        warn "integrate: agent did not write status file; marking fail"
        final_status=fail
    fi

    # Verify tests deterministically -- don't rely solely on the agent.
    # Hooks that honor TIMVISHER_DEV_CI_RESULTS_FILE write a deterministic
    # summary of each phase (vet/test/build pass/fail plus stable stderr)
    # which we diff across baseline and verify to distinguish pre-existing
    # failures from new regressions introduced by the merge.
    if [[ $final_status == pass ]] && $has_run_tests
    then
        info "integrate: verifying tests post-merge"
        local verify_log="${dev_path}/x.dev-ci-verify.log"
        local verify_results="${dev_path}/x.dev-ci-verify-results.txt"
        : > "$verify_results"
        run_hooks "$dev_path" "pre-run-tests.sh"
        if ! TIMVISHER_DEV_CI_RESULTS_FILE="$verify_results" \
             run_hooks "$dev_path" "run-tests.sh" > "$verify_log" 2>&1
        then
            if [[ $baseline_clean == false ]] \
               && diff -q "$baseline_results" "$verify_results" >/dev/null 2>&1
            then
                info "integrate: post-merge failures match baseline; treating as pass"
            else
                error "integrate: tests failed post-merge"
                final_status=fail
            fi
        fi
        rm -f "$verify_log" "$verify_results"
    fi

    rm -f "$baseline_log" "$baseline_results"

    # Run post-integration hook if integration passed.
    ensure_repo_script "$dev_path" "post-integrate.sh" || true
    if [[ $final_status == pass ]] &&
       hook_exists "$dev_path" "post-integrate.sh"
    then
        info "integrate: running post-integration hook"
        run_hooks "$dev_path" "pre-post-integrate.sh"
        if ! run_hooks "$dev_path" "post-integrate.sh"
        then
            error "integrate: post-integration hook failed"
            final_status=fail
        fi
    fi

    # Move the dev branch only now that the merge, the verification and
    # post-integrate have all passed; otherwise put it back untouched.
    # This also has to precede the push: push_to_remote pushes HEAD and
    # reads branch.<branch>.pushRemote, so from the scratch branch it would
    # push to a remote branch named after the scratch.
    if [[ $final_status == pass ]]
    then
        integrate_scratch_finish || final_status=fail
    else
        integrate_scratch_restore
    fi

    # Push before writing the status file so the polling loop never
    # sees a premature "pass" that gets overwritten by a push failure.
    if [[ $final_status == pass ]]
    then
        if ! push_to_remote "$dev_path"
        then
            final_status=fail
        fi
    fi

    echo "$final_status" > "$status_file"
    [[ $final_status == pass ]]
}

# ---------------------------------------------------------------------------
# Worker: __ensure_tests  (agent creates run-tests.sh if missing)
# ---------------------------------------------------------------------------

cmd__ensure_tests() {
    local worktree_path=$1

    cd "$worktree_path" ||
        die "Cannot cd to '%s'" "$worktree_path"

    # Check if a hook already exists in either location.
    if hook_exists "$worktree_path" "run-tests.sh"
    then
        info "ensure_tests: run-tests.sh already exists"
        return 0
    fi

    worktree_context "$worktree_path" ||
        die_unresolvable_context "$worktree_path"

    local fields
    fields=$(worktree_context_fields "$worktree_path") ||
        die_unresolvable_context "$worktree_path"

    local wt_repo branch_path main_owner me
    {
        read -r wt_repo
        read -r branch_path
        read -r main_owner
        read -r me
    } <<<"$fields"
    local target_rel="${main_owner}/${wt_repo}"
    [[ -n $branch_path ]] && target_rel="${target_rel}/${branch_path}"
    local target_path="${REPO_HOOKS_DIR}/${target_rel}/run-tests.sh"
    local fork_repo_path="${REPO_HOOKS_DIR}/${main_owner}/${wt_repo}/run-tests.sh"
    local my_repo_path="${REPO_HOOKS_DIR}/${me}/${wt_repo}/run-tests.sh"
    local subpath_path="${REPO_HOOKS_DIR}/${me}/${wt_repo}/<subpath>/run-tests.sh"
    local fork_repo_dir="${REPO_HOOKS_DIR}/${main_owner}/${wt_repo}"
    local my_repo_dir="${REPO_HOOKS_DIR}/${me}/${wt_repo}"
    local my_branch_path="${my_repo_dir}/${branch_path}/run-tests.sh"

    mkdir -p "$(dirname "$target_path")"

    local repo_rung_block branch_rung_block hook_dirs
    if [[ $fork_repo_path == "$my_repo_path" ]]
    then
        hook_dirs="${fork_repo_dir}/"
        branch_rung_block="- Branch rung (this branch only, exact match):
    ${target_path}"
        repo_rung_block="- Repo rung (this clone is on the fork-network main owner, so
  \"your repo\" and \"the upstream repo\" are the same path; anything
  written here applies to every fork the user maintains of this repo):
    ${fork_repo_path}"
    else
        repo_rung_block="- Repo rung, fork-network owner (applies to every fork):
    ${fork_repo_path}
- Repo rung, your repo (applies to all your branches):
    ${my_repo_path}"
        hook_dirs="${fork_repo_dir}/ and ${my_repo_dir}/"
        branch_rung_block="- Branch rung, your repo (this branch only, exact match):
    ${my_branch_path}
- Branch rung, fork-network owner (this branch in every fork, exact match):
    ${target_path}"
    fi

    local rung_block="${repo_rung_block}
- Subpath rung (applies on every branch that changes something under
  <subpath>, a directory relative to the repo root):
    ${subpath_path}
${branch_rung_block}

Default to the repo rung (${my_repo_path}) when the script has no
branch- or directory-specific dependencies.  Use a subpath rung when
the script only makes sense for one part of the repo (e.g. one app
in a monorepo).  Use the branch rung only when the script genuinely
differs by branch.  Use the fork-network repo rung only when you
intend to contribute the hook upstream.

A subpath rung only resolves while the worktree has a change under
that directory vs '@{u}...', an uncommitted change, or an untracked
file there.  A worktree with none of those sees only the repo and
branch rungs."

    local prompt_file
    prompt_file=$(mktemp "${worktree_path}/x.dev-ci-prompt.XXXXXX") ||
        die "Cannot create prompt file"

    cat > "$prompt_file" <<PROMPT_EOF
You are in a git worktree at ${worktree_path}.

Sanity check first.  Run:

    timvisher_dev_ci hooks ls

If a run-tests.sh hook already resolves at any rung for
this worktree, do not create a new one -- exit 0.  The orchestrator
checks too, but this guards against drift between the internal
hook_exists helper and the public CLI.

Otherwise this project is missing a run-tests.sh script.  Create one.

run-tests.sh should be a bash script that runs the full local CI
suite for this project -- everything that CI would check on a pull
request.  This includes:

- Linting (e.g. eslint, golangci-lint, shellcheck, flake8)
- Formatting checks (e.g. prettier --check, gofmt, black --check)
- Type checking if applicable (e.g. tsc --noEmit, mypy)
- Unit tests (e.g. npm test, make test, go test, pytest)
- Byte-compilation if applicable (e.g. emacs batch-byte-compile for .el files)

Examine the project structure to determine which tools and test
frameworks are in use.  Look at:
- Makefile, package.json, go.mod, setup.py/pyproject.toml, Cask, etc.
- Existing CI configuration (.github/workflows/, .gitlab-ci.yml, etc.)
- README or CONTRIBUTING docs for test instructions
- Existing hooks for sibling branches and subpaths under
  ${hook_dirs} -- they often already encode the right
  invocation; lift their content rather than reinventing.

The script should:
- Use #!/usr/bin/env bash
- cd to the repo root
- Run each check, exiting non-zero on first failure
- Print clear headers before each step (e.g. "--- lint ---", "--- test ---")
- Be executable (chmod +x)

Rung choice.  Hooks resolve by walking rungs from least to most
specific (repo, then subpath shallower to deeper, then branch), and
all matching hooks run (no shadowing), so a broader-rung hook
eliminates per-branch duplication.  Pick the broadest rung whose
semantics match the script you're writing:

${rung_block}

When you write at the repo or a subpath rung, look for redundant
branch-rung hooks at <owner-dir>/<branch>/run-tests.sh under
${hook_dirs} whose content is now covered by the broader hook, and
delete those files so the same logic does not run twice.  Branch and
subpath hooks share that tree, so only treat a directory as a branch
rung when its path is the full name of a branch ('git branch -a'),
and never delete one whose path names a directory in this repo.

Whichever path you pick, write the script there, make it
executable, and stop.  Do not run the tests yourself.
PROMPT_EOF

    info "ensure_tests: launching agent to create run-tests.sh for '%s'" "$worktree_path"

    if claudeshot "$(< "$prompt_file")"
    then
        info "ensure_tests: agent finished"
    else
        warn "ensure_tests: agent exited with error"
    fi

    rm -f "$prompt_file"

    if hook_exists "$worktree_path" "run-tests.sh"
    then
        info "ensure_tests: run-tests.sh now resolves for '%s'" "$worktree_path"
    else
        warn "ensure_tests: no run-tests.sh resolves for '%s' after the agent ran" "$worktree_path"
    fi
}

# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Upstream baseline
# ---------------------------------------------------------------------------

# A run targets one upstream state and propagates it through the tree. That
# only means anything if the run observes upstream once: fetching again in a
# later phase is a second observation, and with several repos in play the
# phases can end up targeting different snapshots, integrating and pushing a
# combination that never existed upstream and was never tested as a set.
#
# So: fetch each repo once, resolve the refs that matter to concrete commits,
# and write them down. Every later phase merges and compares against the
# recorded commit, never a ref it resolves for itself.
#
# Written to a file rather than held in memory because the phases that need
# it are not the process that establishes it -- cmd__sync and cmd__integrate
# run as separate processes in their own tmux windows.
BASELINE_SCHEMA=1
baseline_file=''

# Stable per repository rather than per worktree: several worktrees of one
# repo share refs, and fetching once per worktree is the same mistake in
# miniature.
baseline_repo_key() {
    local wt=$1
    local common

    common=$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null) || return 1
    (cd "$wt" && cd "$common" && pwd -P)
}

# Fetch each distinct repo among the given worktrees once, and record what
# origin and upstream resolved to.  Sets baseline_file and echoes the path;
# a caller that wants both from a command substitution has to assign the
# global itself, since the subshell's copy dies with it.
baseline_establish() {
    local dir=${TMPDIR:-/tmp}
    local file
    local -A seen=()
    local wt key entries=''

    file=$(mktemp "${dir}/x.dev-ci-baseline.XXXXXX") || return 1

    for wt in "$@"
    do
        [[ -d $wt ]] || continue
        key=$(baseline_repo_key "$wt") || continue
        [[ -n ${seen[$key]+x} ]] && continue
        seen[$key]=1

        info "baseline: fetching '%s'" "$key"
        git -C "$wt" fetch --all --quiet 2>/dev/null || true

        local origin_ref upstream_ref origin_sha='' upstream_sha=''
        origin_ref=$(git -C "$wt" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) || origin_ref=''
        upstream_ref=$(git -C "$wt" symbolic-ref -q --short refs/remotes/upstream/HEAD 2>/dev/null) || upstream_ref=''
        [[ -z $origin_ref ]] && git -C "$wt" show-ref --verify --quiet refs/remotes/origin/main 2>/dev/null && origin_ref=origin/main
        [[ -z $upstream_ref ]] && git -C "$wt" show-ref --verify --quiet refs/remotes/upstream/main 2>/dev/null && upstream_ref=upstream/main

        [[ -n $origin_ref ]] && origin_sha=$(git -C "$wt" rev-parse "$origin_ref" 2>/dev/null)
        [[ -n $upstream_ref ]] && upstream_sha=$(git -C "$wt" rev-parse "$upstream_ref" 2>/dev/null)

        entries+=$(jq -n --arg key "$key" \
                        --arg oref "$origin_ref" --arg osha "$origin_sha" \
                        --arg uref "$upstream_ref" --arg usha "$upstream_sha" \
                        '{($key): {origin: {ref: $oref, commit: $osha},
                                   upstream: {ref: $uref, commit: $usha}}}')
        entries+=$'\n'
    done

    printf '%s' "$entries" |
        jq -s --argjson schema "$BASELINE_SCHEMA" \
           '{schema: $schema, repos: (add // {})}' > "$file" || return 1

    baseline_file=$file
    printf '%s' "$file"
}

# The commit a worktree's repo was pinned to for this run, for 'origin' or
# 'upstream'.  Empty when there is no baseline or the repo has no such ref,
# which callers treat as "fall back to resolving it live" so a partial
# rollout degrades to today's behaviour rather than failing.
baseline_commit() {
    local wt=$1
    local which=$2
    local file=${baseline_file:-${TIMVISHER_DEV_CI_BASELINE-}}
    local key

    [[ -n $file && -f $file ]] || return 1
    key=$(baseline_repo_key "$wt") || return 1

    local sha
    sha=$(jq -r --arg key "$key" --arg which "$which" \
             '.repos[$key][$which].commit // ""' "$file" 2>/dev/null) || return 1
    [[ -n $sha ]] || return 1
    printf '%s' "$sha"
}

# The ref a worktree's repo resolved 'origin' or 'upstream' to, for messages
# and for callers that still need a name rather than a commit.
baseline_ref() {
    local wt=$1
    local which=$2
    local file=${baseline_file:-${TIMVISHER_DEV_CI_BASELINE-}}
    local key ref

    [[ -n $file && -f $file ]] || return 1
    key=$(baseline_repo_key "$wt") || return 1
    ref=$(jq -r --arg key "$key" --arg which "$which" \
             '.repos[$key][$which].ref // ""' "$file" 2>/dev/null) || return 1
    [[ -n $ref ]] || return 1
    printf '%s' "$ref"
}

# ---------------------------------------------------------------------------
# Dependency farm
# ---------------------------------------------------------------------------

# Hooks address their dependencies through ${TIMVISHER_GIT_HOME}/<org>/<repo>/…
# -- see the agent-shell-plus hook's acp_root and shell_maker_root.  So which
# tree a dependency *means* can be decided without touching any hook, by
# pointing that variable at a tree of symlinks: unoverridden paths lead back
# to the real ~/git, overridden ones lead wherever the caller says.
#
# That is what lets a feature branch pin a dependency to its own branch and be
# tested against it, instead of waiting for the pin to land in the
# dependency's trunk first.
#
# It holds only as long as nothing resolves symlinks: a hook reaching for
# pwd -P, realpath or readlink -f on a dependency escapes back to the real
# tree and silently tests the wrong thing.  bin/test uses plain `pwd`, which
# keeps the logical path, and farm_assert_preserves_symlinks checks that
# rather than trusting it.
# Set by a caller that has built a farm for the worktree whose hooks it is
# about to run; empty means hooks see the real git home and nothing changes.
hook_git_home=''

# Replace a symlinked directory in the farm with a real one holding a symlink
# per child, so a descendant can be overridden without losing its siblings.
farm_explode() {
    local dir=$1
    local target child

    if [[ -L $dir ]]
    then
        target=$(readlink "$dir") || return 1
        rm -f "$dir" || return 1
        mkdir -p "$dir" || return 1
        for child in "$target"/*
        do
            [[ -e $child ]] || continue
            ln -sfn "$child" "${dir}/$(basename "$child")" || return 1
        done
    elif [[ ! -d $dir ]]
    then
        mkdir -p "$dir" || return 1
    fi
}

# Build a farm at $1 mirroring the real git home, with each remaining
# argument an override of the form <relative/path>=<target>.
farm_build() {
    local root=$1
    shift
    local home org override rel target parent part walked

    home=$(canonical_git_home)
    home=${home%/}

    rm -rf -- "${root:?farm_build needs a root}" || return 1
    mkdir -p "$root" || return 1

    for org in "$home"/*
    do
        [[ -d $org ]] || continue
        ln -sfn "$org" "${root}/$(basename "$org")" || return 1
    done

    for override in "$@"
    do
        rel=${override%%=*}
        target=${override#*=}

        [[ -d $target ]] ||
            {
                error "farm: override target '%s' does not exist" "$target"
                return 1
            }

        # Every directory above the override has to become real before the
        # leaf can be replaced, or the override would be written through a
        # symlink into the actual ~/git.
        walked=$root
        parent=$(dirname "$rel")
        if [[ $parent != . ]]
        then
            local -a parts=()
            IFS=/ read -ra parts <<<"$parent"
            for part in "${parts[@]}"
            do
                walked="${walked}/${part}"
                farm_explode "$walked" || return 1
            done
        fi

        rm -rf -- "${root:?}/${rel:?}" || return 1
        ln -sfn "$target" "${root}/${rel}" || return 1
    done
}

# A farm is only worth building when something is actually overridden;
# otherwise the real git home already says the right thing and standing a
# mirror in front of it buys nothing but a way to be wrong.
farm_required() {
    (( 0 < $# ))
}

# Guard the farm's one load-bearing assumption.  Cheap, and it fails loudly
# rather than producing a green run against the wrong tree.
farm_assert_preserves_symlinks() {
    local root=$1 rel=$2 expected=$3
    local seen

    seen=$(cd "${root}/${rel}" 2>/dev/null && pwd) || return 1
    [[ $seen == "${root}/${rel}" ]] || return 1
    [[ -n $expected ]] || return 0
    [[ $(cd "${root}/${rel}" && pwd -P) == "$(cd "$expected" && pwd -P)" ]]
}

# A worktree pins a dependency to a tree by naming the repo, not a path:
#
#     xenodium/acp.el @ ~/git/xenodium/acp.el/terminal-caps
#
# Every branch directory that repo has in the real git home is then pointed
# at that tree in the farm, so however a consumer's hook addresses it --
# today every one of them says <org>/<repo>/main -- it resolves to the pin.
# Naming the path instead would mean guessing which one the hook asks for,
# and a guess that misses lands an override where nothing reads it: a green
# run against the unpinned tree, which is the failure this whole mechanism
# exists to prevent.
DEPENDENCY_PINS_FILENAME=x.dependency-pins
FARM_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/timvisher/dev_ci/farms"

# Expand a worktree's pins into the <relative/path>=<target> pairs farm_build
# takes.  One pin becomes one pair per branch directory of the pinned repo.
dependency_pin_overrides() {
    local wt=$1
    local file="${wt}/${DEPENDENCY_PINS_FILENAME}"

    [[ -f $file ]] || return 0

    local home line org_repo target child emitted
    home=$(canonical_git_home)
    home=${home%/}

    while IFS= read -r line
    do
        [[ -z $line || $line == '#'* ]] && continue

        if [[ $line != *@* ]]
        then
            warn "pins: ignoring '%s' in '%s'; expected '<org>/<repo> @ <worktree>'" "$line" "$file"
            continue
        fi

        org_repo=${line%%@*}
        target=${line#*@}
        # trim surrounding whitespace from both halves
        org_repo=${org_repo#"${org_repo%%[![:space:]]*}"}
        org_repo=${org_repo%"${org_repo##*[![:space:]]}"}
        target=${target#"${target%%[![:space:]]*}"}
        target=${target%"${target##*[![:space:]]}"}

        # shellcheck disable=SC2088
        [[ $target == "~/"* ]] && target="${HOME}/${target#"~/"}"

        emitted=false
        for child in "${home}/${org_repo}"/*
        do
            [[ -d $child ]] || continue
            printf '%s/%s=%s\n' "$org_repo" "$(basename "$child")" "$target"
            emitted=true
        done

        if [[ $emitted == false ]]
        then
            warn "pins: '%s' has no worktrees under '%s'; pin ignored" "$org_repo" "$home"
        fi
    done < "$file"
}

# The farm a worktree's hooks should run under, or nothing when it pins
# nothing -- in which case the real git home already says the right thing
# and standing a mirror in front of it only adds a way to be wrong.
declare -A _worktree_farm=()

worktree_farm() {
    local wt=$1
    local key root
    local -a overrides=()

    key=$(worktree_context_key "$wt")

    if [[ -n ${_worktree_farm[$key]+set} ]]
    then
        printf '%s' "${_worktree_farm[$key]}"
        return 0
    fi

    readarray -t overrides < <(dependency_pin_overrides "$wt")

    root=''
    if farm_required "${overrides[@]}"
    then
        root="${FARM_ROOT}/$(printf '%s' "$key" | sha256_stdin)"
        if farm_build "$root" "${overrides[@]}"
        then
            info "pins: '%s' resolves %d dependency path(s) through '%s'" \
                 "$wt" "${#overrides[@]}" "$root"
        else
            error "pins: cannot build a farm for '%s'; using the real git home" "$wt"
            root=''
        fi
    fi

    _worktree_farm[$key]=$root
    printf '%s' "$root"
}

# ---------------------------------------------------------------------------
# Verification cache
# ---------------------------------------------------------------------------

# A verification result is cached against a content checksum of everything
# that could change it: the tree under test, the hooks that ran, and the keys
# of the dependencies those hooks read.  The key is therefore recursive -- a
# consumer whose own tree never moved is still re-verified when a dependency
# moves underneath it, which a commit-keyed cache would miss entirely.
#
# Tree, not commit: 'reset --hard @{u}', a recreated scratch branch and a
# rebased pull-upstream branch all churn the sha while the content stands
# still, and every one of those happens on an ordinary run.
VERIFIED_SCHEMA=1
VERIFIED_STORE="${XDG_STATE_HOME:-${HOME}/.local/state}/timvisher/dev_ci/verified"

sha256_stdin() {
    shasum -a 256 | cut -d' ' -f1
}

# The tree a worktree would be verified at, or nothing when its working tree
# is dirty: HEAD^{tree} describes tracked content only, so for a dirty
# worktree it names something that is not what the tests would run against.
# Callers treat "no tree" as "not cacheable", never as an error.
verifiable_tree() {
    local wt=$1

    [[ -z $(git -C "$wt" status --porcelain 2>/dev/null) ]] || return 1
    git -C "$wt" rev-parse 'HEAD^{tree}' 2>/dev/null
}

# The hooks a tool resolves to, as a JSON array of {path, sha256}, in the
# order they would run.  Hook CONTENT is hashed, not just the path: a hook
# edited in place is different work, and a cache keyed on the path alone
# would serve a result the new hook never produced.
hook_digest_json() {
    local wt=$1
    local tool=$2
    local -a hooks=()

    readarray -d '' -t hooks < <(find_hooks "$wt" "${tool}.sh")

    (( 0 < ${#hooks[@]} )) || return 1

    local h
    for h in "${hooks[@]}"
    do
        printf '%s\n' "$h"
        sha256_stdin < "$h"
    done | jq -R . | jq -s 'to_entries
        | group_by(.key / 2 | floor)
        | map({path: .[0].value, sha256: .[1].value})'
}

# The hashed half of a cache entry.  Everything in here changes the key;
# nothing outside it does.  Dependency keys are included in declared order,
# so the hash covers the whole graph beneath this worktree.
verification_key_inputs() {
    local wt=$1
    local tool=$2
    shift 2
    local tree hooks

    tree=$(verifiable_tree "$wt") || return 1
    hooks=$(hook_digest_json "$wt" "$tool") || return 1

    local dep_keys='[]'
    if (( 0 < $# ))
    then
        dep_keys=$(printf '%s\n' "$@" | jq -R . | jq -s .)
    fi

    jq -n --arg tool "$tool" --arg tree "$tree" \
          --argjson hooks "$hooks" --argjson dep_keys "$dep_keys" \
          '{tool: $tool, tree: $tree, hooks: $hooks, dependencies: $dep_keys}'
}

# jq -S -c is the canonical serialization: sorted keys, no whitespace, so the
# same inputs hash the same way whoever wrote the file.  That is what lets a
# reader recompute the key from the entry and catch a corrupted one.
verification_key() {
    local canonical

    # Without this an empty or unparseable argument hashes to the sha256 of
    # the empty string -- a perfectly stable key that every caller agrees on
    # and that means nothing.
    canonical=$(jq -S -c -e . <<<"$1" 2>/dev/null) || return 1
    [[ -n $canonical && $canonical != null ]] || return 1

    printf '%s' "$canonical" | sha256_stdin
}

# Layout B: <org>/<repo>/<tool>/<tree>/<key>/.  The leaf is the full key, so
# two results for one tree that differ by hook or dependency cannot collide.
# Everything above the leaf is for browsing and for rm -r at a granularity a
# human would choose; it is an index, never the identity.
verified_entry_dir() {
    local wt=$1 tool=$2 tree=$3 key=$4
    local org_repo

    org_repo=$(worktree_org_repo "$wt") || return 1
    printf '%s/%s/%s/%s/%s' "$VERIFIED_STORE" "$org_repo" "$tool" "$tree" "$key"
}

verified_entry_file() {
    local wt=$1 tool=$2 tree=$3 key=$4
    local dir org_repo

    dir=$(verified_entry_dir "$wt" "$tool" "$tree" "$key") || return 1
    org_repo=$(worktree_org_repo "$wt") || return 1
    printf '%s/%s_%s_%s.json' "$dir" "${org_repo//\//_}" "$tool" "$key"
}

# A hit requires the entry to parse, to declare a schema we understand, to
# record a pass, and to still hash to its own key.  Anything else is a miss:
# a cache must never turn a corrupt or half-written file into a green run.
verified_lookup() {
    local wt=$1 tool=$2 key_inputs=$3
    local tree key file

    [[ -z ${TIMVISHER_DEV_CI_NO_MEMO-} ]] || return 1

    tree=$(jq -r '.tree' <<<"$key_inputs") || return 1
    key=$(verification_key "$key_inputs")
    file=$(verified_entry_file "$wt" "$tool" "$tree" "$key") || return 1

    [[ -f $file ]] || return 1

    jq -e --argjson schema "$VERIFIED_SCHEMA" \
        '(.schema == $schema) and (.result == "pass") and (.key | type == "string")' \
        "$file" >/dev/null 2>&1 || return 1

    local recorded recomputed
    recorded=$(jq -r '.key' "$file")
    recomputed=$(verification_key "$(jq -c '.key_inputs' "$file")")

    [[ $recorded == "$key" && $recomputed == "$key" ]]
}

# Written to a temp file in the destination directory and moved into place: a
# run killed mid-write must not leave a truncated object that parses as a hit.
verified_record() {
    local wt=$1 tool=$2 key_inputs=$3 duration_ms=${4:-0}
    local tree key dir file tmp

    [[ -z ${TIMVISHER_DEV_CI_NO_MEMO-} ]] || return 0

    tree=$(jq -r '.tree' <<<"$key_inputs") || return 1
    key=$(verification_key "$key_inputs")
    dir=$(verified_entry_dir "$wt" "$tool" "$tree" "$key") || return 1
    file=$(verified_entry_file "$wt" "$tool" "$tree" "$key") || return 1

    mkdir -p "$dir" || return 1

    local org_repo branch commit
    org_repo=$(worktree_org_repo "$wt")
    branch=$(git -C "$wt" symbolic-ref -q --short HEAD 2>/dev/null)
    commit=$(git -C "$wt" rev-parse HEAD 2>/dev/null)

    tmp=$(mktemp "${dir}/.entry.XXXXXX") || return 1

    jq -n --argjson schema "$VERIFIED_SCHEMA" \
          --arg key "$key" \
          --argjson key_inputs "$key_inputs" \
          --arg org "${org_repo%%/*}" \
          --arg repo "${org_repo#*/}" \
          --arg worktree "$wt" \
          --arg branch "$branch" \
          --arg commit "$commit" \
          --arg verified_at "$(date -u +%Y-%m-%dT%H:%M:%S%z)" \
          --argjson duration_ms "$duration_ms" \
          '{schema: $schema, result: "pass", key: $key, key_inputs: $key_inputs,
            provenance: {org: $org, repo: $repo, worktree: $worktree,
                         branch: $branch, commit: $commit,
                         verified_at: $verified_at, duration_ms: $duration_ms}}' \
        > "$tmp" || { rm -f "$tmp"; return 1; }

    mv -f "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# Upstream pull branches (soft forks)
# ---------------------------------------------------------------------------

# A soft fork never merges upstream into its trunk -- see
# sync_soft_fork_trunks, which only rebases the trunk onto origin/<trunk>.
# Upstream arrives the same way every other change does: on a feature branch
# that integrates into dev.  That branch has been produced by hand until now
# (agent-shell-plus PR #10, from pull-upstream/2026-04-29T10-26-07+0000), so
# a fork drifts until somebody notices.  Generating it here puts the refresh
# on the same footing as the rest of the pipeline.
PULL_UPSTREAM_PREFIX='pull-upstream'

# Its own status file.  This phase runs inline, before the polling phases,
# inside a worktree those phases then poll; sharing STATUS_FILENAME let the
# two see each other's verdicts.
PULL_UPSTREAM_STATUS_FILENAME=x.dev-ci-pull-upstream.status

# "<org>/<repo>" for a worktree, from its position under $TIMVISHER_GIT_HOME.
# ntmux3 addresses worktrees the same way, so the layout is the shared
# contract rather than something re-derived from the remote.
worktree_org_repo() {
    local path=$1
    local home resolved rel

    # canonical_git_home carries the TIMVISHER_GIT_HOME fallback and the
    # trailing slash; the variable is normally unset outside the tests.
    home=$(canonical_git_home)
    resolved=$(cd "$path" && pwd -P) || return 1

    rel=${resolved#"${home}"}
    [[ $rel != "$resolved" ]] || return 1

    local org=${rel%%/*}
    local rest=${rel#*/}

    # No second component means this is not <org>/<repo>/... at all.
    [[ $rest != "$rel" ]] || return 1

    local repo=${rest%%/*}

    [[ -n $org && -n $repo ]] || return 1
    printf '%s/%s' "$org" "$repo"
}

# "upstream/<trunk>" for a worktree; empty when it has no upstream remote.
resolve_upstream_trunk_ref() {
    local wt=$1
    local ref

    ref=$(git -C "$wt" symbolic-ref -q --short refs/remotes/upstream/HEAD 2>/dev/null) || true
    if [[ -z $ref ]] && git -C "$wt" show-ref --verify --quiet refs/remotes/upstream/main 2>/dev/null
    then
        ref=upstream/main
    fi
    printf '%s' "$ref"
}

# The pull-upstream worktree already registered for a dev branch, if any.
# Reused rather than opening a fresh one each run, so the worktrees do not
# pile up; a reused branch simply merges the newer upstream again.
find_pull_upstream_worktree() {
    local dev_dir=$1
    local wt branch

    # A registered path that is no longer a usable worktree still counts as
    # one, so a broken entry is reported and retried rather than quietly
    # growing a second pull-upstream branch on every run.
    while IFS= read -r wt
    do
        if [[ -d $wt ]]
        then
            branch=$(git -C "$wt" symbolic-ref -q --short HEAD 2>/dev/null) || branch=""
            if [[ $branch == "${PULL_UPSTREAM_PREFIX}/"* ]]
            then
                printf '%s' "$wt"
                return 0
            fi
        fi

        if [[ $wt == *"/${PULL_UPSTREAM_PREFIX}/"* ]]
        then
            warn "pull-upstream: '%s' is registered but not a usable worktree" "$wt"
            printf '%s' "$wt"
            return 0
        fi
    done < <(read_active_worktrees "${dev_dir}/x.active-worktrees")

    # Nothing registered.  A worktree can still exist unregistered, if a
    # previous run created one and then failed before registering it; adopt
    # it rather than stacking a second pull-upstream branch beside it.
    local line current=""
    while IFS= read -r line
    do
        case $line in
            "worktree "*)
                current=${line#worktree }
                ;;
            "branch refs/heads/${PULL_UPSTREAM_PREFIX}/"*)
                if [[ -n $current ]]
                then
                    warn "pull-upstream: adopting unregistered worktree '%s'" "$current"
                    printf '%s' "$current"
                    return 0
                fi
                ;;
        esac
    done < <(git -C "$dev_dir" worktree list --porcelain 2>/dev/null)

    return 1
}

# Append a worktree to a dev branch's active list, in the file and in the
# discovered graph: discover() has already run by the time this is called.
register_active_worktree() {
    local dev_dir=$1
    local wt=$2
    local file="${dev_dir}/x.active-worktrees"

    # Idempotent: an adopted worktree is registered on the run that finds it,
    # and must not be appended again on the next one.
    if [[ -f $file ]] && grep -qxF -- "$wt" "$file"
    then
        return 0
    fi

    printf '%s\n' "$wt" >> "$file" ||
        {
            error "pull-upstream: cannot register '%s' in '%s'" "$wt" "$file"
            return 1
        }

    local existing=${dev_branches[$dev_dir]}
    dev_branches["$dev_dir"]="${existing:+${existing} }${wt}"
    all_worktrees["$wt"]=1
}

create_pull_upstream_worktree() {
    local dev_dir=$1
    local trunk_ref=$2
    local stamp org_repo branch wt trunk_branch

    org_repo=$(worktree_org_repo "$dev_dir") ||
        {
            error "pull-upstream: cannot derive org/repo for '%s'" "$dev_dir"
            return 1
        }

    # Matches the stamp the hand-made branches already use.
    stamp=$(date -u +%Y-%m-%dT%H-%M-%S%z) || return 1
    branch="${PULL_UPSTREAM_PREFIX}/${stamp}"
    wt="$(canonical_git_home)${org_repo}/${branch}"

    # The second ntmux3 form stacks a new worktree on a branch-ish; the
    # trunk is the base because the merge has to land somewhere that can
    # become a PR into it.  ntmux3 wants the branch, not the
    # remote-tracking ref resolve_retire_merge_ref hands back, and Phase
    # 0.5 has already brought that branch up to its remote.
    trunk_branch=${trunk_ref#*/}

    info "pull-upstream: creating '%s/%s' on '%s'" "$org_repo" "$branch" "$trunk_branch"
    run_ntmux3 -d "${org_repo}/${branch}" "$trunk_branch" ||
        {
            error "pull-upstream: ntmux3 could not stack '%s/%s'" "$org_repo" "$branch"
            return 1
        }

    [[ -d $wt ]] ||
        {
            error "pull-upstream: expected worktree '%s' does not exist" "$wt"
            return 1
        }

    printf '%s' "$wt"
}

# Merge upstream into the pull-upstream branch.  A clean merge needs no
# agent; a conflicted one is exactly the "restore green CI after upstream
# merge" work, so it gets the same agent-and-status-file treatment the sync
# phase uses.
merge_upstream_into() {
    local wt=$1
    local upstream_ref=$2
    local status_file="${wt}/${PULL_UPSTREAM_STATUS_FILENAME}"

    if git -C "$wt" merge --no-edit "$upstream_ref"
    then
        info "pull-upstream: merged '%s' into '%s' cleanly" "$upstream_ref" "$wt"
        return 0
    fi

    warn "pull-upstream: '%s' conflicts; launching agent" "$upstream_ref"

    local test_instruction="No run-tests.sh is available, so skip testing."
    local -a hooks=()
    # find_hooks dies unless the worktree's context was resolved first, and it
    # runs in a process substitution, so the death is silent and the agent
    # would be told to skip the tests this phase exists to keep green.
    if worktree_context "$wt" 2>/dev/null
    then
        readarray -d '' -t hooks < <(find_hooks "$wt" "run-tests.sh")
    else
        warn "pull-upstream: cannot resolve hooks for '%s'" "$wt"
    fi
    if (( 0 < ${#hooks[@]} ))
    then
        test_instruction="Then run each of these test hooks in order and make them pass:
$(printf '%s\n' "${hooks[@]}")"
    fi

    rm -f "$status_file"

    local prompt_file
    prompt_file=$(mktemp "${wt}/x.dev-ci-prompt.XXXXXX") ||
        {
            error "pull-upstream: cannot create prompt file in '%s'" "$wt"
            return 1
        }

    cat > "$prompt_file" <<PROMPT_EOF
$(agent_session_contract "$status_file")

You are in a worktree at ${wt} whose only job is to carry upstream's
changes into this fork.

A 'git merge ${upstream_ref}' is in progress and has conflicted. Resolve
the conflicts, keeping upstream's intent for upstream's code and this
fork's intent for the fork's own features, and complete the merge.

${test_instruction}

This fork's features must still work after the merge; upstream renaming or
reworking something it owns means adapting the fork to it, not reverting it.

When the merge is complete and tests pass, write 'pass' to '${status_file}'.
If you cannot resolve a conflict or fix a test failure, write 'fail' to '${status_file}'.

Work in ${wt}. Do not modify other directories.
PROMPT_EOF

    if claudeshot "$(< "$prompt_file")"
    then
        info "pull-upstream: agent finished"
    else
        warn "pull-upstream: agent exited with error"
    fi

    rm -f "$prompt_file"

    local verdict=fail
    if [[ -f $status_file ]]
    then
        verdict=$(cat "$status_file")
        rm -f "$status_file"
    fi

    if [[ $verdict != pass ]]
    then
        error "pull-upstream: agent could not land '%s' in '%s'" "$upstream_ref" "$wt"
        return 1
    fi
}

ensure_upstream_pull_worktrees() {
    # One pull-upstream branch per REPO, not per dev branch.  A repo can
    # carry several dev branches -- a main integration plus a spun-out one
    # for features needing their own dependency pins -- and they share a
    # trunk, so the upstream merge is the same work for all of them.  Same
    # keying as sync_soft_fork_trunks.
    local -A seen_repos
    local dev_dir
    for dev_dir in "${!dev_branches[@]}"
    do
        # Regular forks already base dev on upstream/<trunk>, so they have
        # nothing to pull onto a branch.
        [[ -f ${dev_dir}/x.timvisher_git.soft-fork ]] || continue

        local common_dir
        common_dir=$(cd "$dev_dir" && git rev-parse --git-common-dir 2>/dev/null) || continue
        common_dir=$(cd "$dev_dir" && cd "$common_dir" && pwd -P)
        if [[ -n ${seen_repos[$common_dir]+x} ]]
        then
            # Still register it here: the branch is shared, but each dev
            # branch has to list it to integrate it.
            local shared
            if shared=$(find_pull_upstream_worktree "$dev_dir")
            then
                register_active_worktree "$dev_dir" "$shared" || true
            fi
            continue
        fi
        seen_repos["$common_dir"]=1

        # No fetch here: the run established its baseline before any phase
        # ran, and fetching again would be a second opinion about upstream.
        local upstream_ref trunk_ref
        upstream_ref=$(baseline_commit "$dev_dir" upstream) ||
            upstream_ref=$(resolve_upstream_trunk_ref "$dev_dir")
        if [[ -z $upstream_ref ]]
        then
            info "pull-upstream: no upstream remote for '%s'; skipping" "$dev_dir"
            continue
        fi

        trunk_ref=$(resolve_retire_merge_ref "$dev_dir")
        if [[ -z $trunk_ref ]]
        then
            info "pull-upstream: no trunk ref for '%s'; skipping" "$dev_dir"
            continue
        fi

        if git -C "$dev_dir" merge-base --is-ancestor "$upstream_ref" "$trunk_ref" 2>/dev/null
        then
            info "pull-upstream: '%s' already contains the baseline %s" \
                 "$trunk_ref" "$(baseline_ref "$dev_dir" upstream || printf '%s' "$upstream_ref")"
            continue
        fi

        local wt
        if wt=$(find_pull_upstream_worktree "$dev_dir")
        then
            info "pull-upstream: reusing '%s'" "$wt"
        else
            wt=$(create_pull_upstream_worktree "$dev_dir" "$trunk_ref") || continue
        fi

        register_active_worktree "$dev_dir" "$wt" || continue

        merge_upstream_into "$wt" "$upstream_ref" || continue
    done
}

# Sync soft fork trunks: for each unique soft fork repo (detected by the
# x.timvisher_git.soft-fork cookie), keep its trunk current with
# origin/<trunk>.  Upstream changes reach trunk only via feature
# branches -> dev, never by a direct upstream merge here, so no agent is
# involved.  For each repo: refuse if the trunk has unpublished commits,
# assert tests pass, pull --rebase from origin, then assert tests pass.
sync_soft_fork_trunks() {
    local -A seen_repos  # keyed by git common dir

    local dir
    for dir in "${!dev_branches[@]}" "${!all_worktrees[@]}"
    do
        [[ -f ${dir}/x.timvisher_git.soft-fork ]] || continue

        local common_dir
        common_dir=$(cd "$dir" && git rev-parse --git-common-dir 2>/dev/null) || continue
        common_dir=$(cd "$dir" && cd "$common_dir" && pwd -P)
        [[ -n ${seen_repos[$common_dir]+x} ]] && continue
        seen_repos["$common_dir"]=1

        info "sync_trunk: syncing soft fork repo for '%s'" "$dir"

        # sync-trunk resolves/fetches the trunk worktree and reports its
        # state against origin/<trunk>.  It does NOT merge upstream and
        # never resolves conflicts, so no agent is involved.
        #   - non-zero  => unpublished commits (or hard failure); it has
        #                  already logged the reason.
        #   - empty     => already up to date with origin/<trunk>.
        #   - a path    => behind origin/<trunk>; a rebase is needed.
        local trunk_wt
        if ! trunk_wt=$(timvisher_git sync-trunk "$dir")
        then
            error "sync_trunk: cannot sync soft fork trunk for '%s'; skipping" "$dir"
            continue
        fi

        if [[ -z $trunk_wt ]]
        then
            info "sync_trunk: trunk already up to date"
            continue
        fi

        local trunk_branch
        trunk_branch=$(git -C "$trunk_wt" symbolic-ref --short HEAD 2>/dev/null) || {
            error "sync_trunk: cannot detect trunk branch in '%s'; skipping" "$trunk_wt"
            continue
        }

        # Assert the trunk is green, rebase onto origin/<trunk>, then
        # assert it is still green.  A pre-rebase failure means the trunk
        # was already broken; don't blame (or propagate) the rebase.
        info "sync_trunk: verifying tests before rebase in '%s'" "$trunk_wt"
        if ! test_trunk "$trunk_wt"
        then
            error "sync_trunk: pre-rebase tests failed in '%s'; skipping rebase" "$trunk_wt"
            continue
        fi

        # Rebase onto the run's pinned commit where there is one: a pull
        # here would fetch, and the trunk would then sit on an upstream no
        # other phase saw.
        local trunk_target="origin/${trunk_branch}"
        local trunk_pin
        if trunk_pin=$(baseline_commit "$trunk_wt" origin)
        then
            trunk_target=$trunk_pin
        fi

        info "sync_trunk: rebasing '%s' onto %s" "$trunk_wt" "$trunk_target"
        if ! git -C "$trunk_wt" rebase "$trunk_target" >&2
        then
            error "sync_trunk: pull --rebase failed in '%s'; skipping" "$trunk_wt"
            git -C "$trunk_wt" rebase --abort >&2 2>/dev/null || true
            continue
        fi

        info "sync_trunk: verifying tests after rebase in '%s'" "$trunk_wt"
        if ! test_trunk "$trunk_wt"
        then
            error "sync_trunk: post-rebase tests failed in '%s'" "$trunk_wt"
            continue
        fi

        info "sync_trunk: succeeded"
    done
}

# Run run-tests.sh hooks against a trunk worktree.  Returns 0 if tests
# pass (or there is no resolved run-tests.sh hook), non-zero on failure.
# Soft fork trunk sync never pushes from here — origin/<trunk> advances
# via the normal feature-branch -> dev flow — so this only tests.
#
# Hooks are run with cwd set to the trunk worktree.  run_hooks itself
# does not cd, and existing callers (cmd__sync, cmd__integrate) cd
# explicitly before invoking it; sync_soft_fork_trunks runs in the
# orchestrator's cwd so the cd has to happen here.
test_trunk() {
    local trunk_wt=$1

    require_worktree_context "$trunk_wt"

    local -a test_hooks=() pre_hooks=()
    readarray -d '' -t test_hooks < <(find_hooks "$trunk_wt" "run-tests.sh")

    if (( ${#test_hooks[@]} == 0 ))
    then
        info "sync_trunk: no run-tests.sh resolved for '%s'; skipping test verification" "$trunk_wt"
        return 0
    fi

    readarray -d '' -t pre_hooks < <(find_hooks "$trunk_wt" "pre-run-tests.sh")

    if ! (
        cd "$trunk_wt" ||
            exit 1
        local hook_path
        for hook_path in "${pre_hooks[@]}" "${test_hooks[@]}"
        do
            info "hook: running '%s'" "$hook_path"
            bash "$hook_path" ||
                exit $?
        done
    )
    then
        warn "sync_trunk: tests failed in '%s'" "$trunk_wt"
        return 1
    fi

    return 0
}

# Verify all feature worktrees have clean working trees.
# Fails fast before any sync/integrate work if any worktree has
# uncommitted changes or untracked files.
# Emit the Co-authored-by trailer required by the git shim for the active
# agent, matching bin/git's own detection.  Empty when not under an agent
# (interactive runs need no trailer).
agent_coauthor_trailer() {
    if [[ -n ${TIMVISHER_CODEX:-} ]]
    then
        printf 'Co-authored-by: Codex <codex@openai.com>'
    elif [[ -n ${TIMVISHER_CLAUDE:-} || -n ${CLAUDECODE:-} ]]
    then
        printf 'Co-authored-by: Claude <noreply@anthropic.com>'
    fi
}

# BUILD.bazel is a checked-in build artifact that Gazelle/buildifier
# regenerate deterministically, so feature branches routinely leave it
# dirty after a build.  Rather than dying in preflight, auto-commit any
# worktree whose ONLY dirty paths are BUILD.bazel files, leaving genuine
# uncommitted work for preflight_check_clean to catch.
autocommit_build_artifacts() {
    local -a trailer_args=()
    local trailer
    trailer=$(agent_coauthor_trailer)
    [[ -n $trailer ]] && trailer_args=(-m "$trailer")

    for wt in "${!all_worktrees[@]}"
    do
        local status
        status=$(git -C "$wt" status --porcelain 2>/dev/null) || continue
        [[ -n $status ]] || continue

        local only_build=1
        local build_paths=()
        while IFS= read -r line
        do
            [[ -n $line ]] || continue
            local path=${line:3}
            [[ $path == *' -> '* ]] && path=${path#* -> }
            if [[ $path == 'BUILD.bazel' || $path == *'/BUILD.bazel' ]]
            then
                build_paths+=("$path")
            else
                only_build=0
                break
            fi
        done <<< "$status"

        [[ $only_build -eq 1 && ${#build_paths[@]} -ne 0 ]] || continue

        info "autocommit: committing %d regenerated BUILD.bazel file(s) in '%s'" \
            "${#build_paths[@]}" "$wt"
        if git -C "$wt" add -- "${build_paths[@]}" &&
           git -C "$wt" commit -q \
             -m 'chore(bazel): auto-commit regenerated BUILD.bazel' \
             "${trailer_args[@]}"
        then
            info "autocommit: committed BUILD.bazel in '%s'" "$wt"
        else
            warn "autocommit: failed to commit BUILD.bazel in '%s'; leaving for preflight" "$wt"
        fi
    done
}

preflight_check_clean() {
    local dirty=()

    for wt in "${!all_worktrees[@]}"
    do
        if [[ -n $(git -C "$wt" status --porcelain 2>/dev/null) ]]
        then
            dirty+=("$wt")
        fi
    done

    if [[ ${#dirty[@]} -ne 0 ]]
    then
        error "Worktrees with uncommitted changes or untracked files:"
        for wt in "${dirty[@]}"
        do
            error "  %s" "$wt"
            git -C "$wt" status --short | sed 's/^/    /' >&2
        done
        die "Refusing to sync/integrate dirty worktrees. Commit or stash first."
    fi
}

# Clean up status files before starting.
clean_status_files() {
    for wt in "${!all_worktrees[@]}"
    do
        rm -f "${wt}/${STATUS_FILENAME}"
    done
    for dev in "${!dev_branches[@]}"
    do
        rm -f "${dev}/${STATUS_FILENAME}"
    done
}

# Read a status file.  Returns the contents or empty string.
read_status() {
    local path=$1
    local status_file="${path}/${STATUS_FILENAME}"
    if [[ -f $status_file ]]
    then
        cat "$status_file"
    fi
}

# Phase 1: launch sync+test for all feature worktrees.
launch_sync_phase() {
    for wt in "${!all_worktrees[@]}"
    do
        # A pull-upstream worktree carries one merge commit and tracks the
        # trunk, so 'git pull --rebase' would replay it onto the trunk and
        # drop it -- silently undoing the merge Phase 0.6 just made.  It is
        # already current by construction; record it done and leave it be.
        if is_pull_upstream_worktree "$wt"
        then
            info "sync: skipping pull-upstream worktree '%s'" "$wt"
            echo 'pass' > "${wt}/${STATUS_FILENAME}"
            continue
        fi

        local session_name
        session_name=$(ensure_session "$wt") || {
            error "Cannot create session for '%s'; marking fail" "$wt"
            echo 'fail' > "${wt}/${STATUS_FILENAME}"
            continue
        }

        info "Launching sync for '%s' in session '%s':admin" "$wt" "$session_name"
        send_to_admin "$session_name" \
            " ${baseline_file:+TIMVISHER_DEV_CI_BASELINE='${baseline_file}' }'${SELF}' __sync '${wt}'"
    done
}

# Wait for all feature worktrees to report status.
# Populates wt_results[path]=status.
declare -A wt_results

wait_for_worktrees() {
    local pending=("${!all_worktrees[@]}")

    heartbeat_start

    while [[ ${#pending[@]} -ne 0 ]]
    do
        local still_pending=()

        for wt in "${pending[@]}"
        do
            local status
            status=$(read_status "$wt")

            case $status in
                pass)
                    info "[pass] '%s'" "$wt"
                    wt_results["$wt"]="pass"
                    ;;
                fail)
                    error "[fail] '%s'" "$wt"
                    wt_results["$wt"]="fail"
                    ;;
                *)
                    still_pending+=("$wt")
                    ;;
            esac
        done

        pending=("${still_pending[@]}")

        if [[ ${#pending[@]} -ne 0 ]]
        then
            if heartbeat_due
            then
                info "waiting %s on %d of %d worktree(s)" \
                    "$(heartbeat_elapsed)" "${#pending[@]}" "${#all_worktrees[@]}"
                for wt in "${pending[@]}"
                do
                    info "  in progress: '%s'" "$wt"
                done
            fi

            sleep "$POLL_INTERVAL_SECONDS"
        fi
    done
}

# Phase 2: launch integration for dev branches whose deps all passed.
declare -A dev_results
declare -A dev_launched

launch_integrate_phase() {
    local all_done=

    heartbeat_start

    while [[ -z $all_done ]]
    do
        all_done=true

        local in_progress=()
        local waiting=()

        for dev in "${!dev_branches[@]}"
        do
            # Already finished?
            [[ -n ${dev_results[$dev]+x} ]] && continue

            all_done=

            # Already launched?  Check for agent's status file.
            if [[ -n ${dev_launched[$dev]+x} ]]
            then
                local status
                status=$(read_status "$dev")

                case $status in
                    pass)
                        info "[pass] '%s'" "$dev"
                        dev_results["$dev"]="pass"
                        ;;
                    fail)
                        error "[fail] '%s'" "$dev"
                        dev_results["$dev"]="fail"
                        ;;
                    *)
                        in_progress+=("$dev")
                        ;;
                esac
                continue
            fi

            # Check if all deps passed (both feature worktrees and dev branches).
            local deps_str=${dev_branches[$dev]}
            local dd_str=${dev_branch_deps[$dev]}
            local all_deps_pass=true
            local any_dep_fail=
            local pending_dep=

            # Check feature worktree deps.
            if [[ -n $deps_str ]]
            then
                read -ra deps <<< "$deps_str"
                for dep in "${deps[@]}"
                do
                    case ${wt_results[$dep]:-} in
                        pass) ;;
                        fail)
                            any_dep_fail=true
                            break
                            ;;
                        *)
                            all_deps_pass=
                            pending_dep=$dep
                            break
                            ;;
                    esac
                done
            fi

            # Check dev branch deps (other integration branches that must finish first).
            if [[ -z $any_dep_fail && -n $dd_str ]]
            then
                read -ra dd_deps <<< "$dd_str"
                for dep in "${dd_deps[@]}"
                do
                    case ${dev_results[$dep]:-} in
                        pass) ;;
                        fail|skip)
                            any_dep_fail=true
                            break
                            ;;
                        *)
                            all_deps_pass=
                            pending_dep=$dep
                            break
                            ;;
                    esac
                done
            fi

            if [[ -n $any_dep_fail ]]
            then
                error "Skipping '%s' -- dependency failed" "$dev"
                dev_results["$dev"]="skip"
                continue
            fi

            if [[ -z $all_deps_pass ]]
            then
                waiting+=("${dev}"$'\t'"${pending_dep}")
                continue
            fi

            # All deps passed -- launch integration.
            local session_name
            session_name=$(ensure_session "$dev") || {
                error "Cannot create session for '%s'; marking fail" "$dev"
                dev_results["$dev"]="fail"
                continue
            }

            # Build the argument list: dev_path followed by worktree paths
            local args="${baseline_file:+TIMVISHER_DEV_CI_BASELINE='${baseline_file}' }'${SELF}' __integrate '${dev}'"
            read -ra dep_paths <<< "$deps_str"
            for dep in "${dep_paths[@]}"
            do
                args+=" '${dep}'"
            done

            info "Launching integration for '%s' in session '%s':admin" "$dev" "$session_name"
            send_to_admin "$session_name" " $args"
            dev_launched["$dev"]=1
        done

        if [[ -z $all_done ]]
        then
            if heartbeat_due
            then
                info "waiting %s on %d integrating, %d blocked of %d dev branch(es)" \
                    "$(heartbeat_elapsed)" "${#in_progress[@]}" "${#waiting[@]}" \
                    "${#dev_branches[@]}"
                for dev in "${in_progress[@]}"
                do
                    info "  integrating: '%s'" "$dev"
                done
                for entry in "${waiting[@]}"
                do
                    info "  blocked: '%s' on '%s'" "${entry%%$'\t'*}" "${entry#*$'\t'}"
                done
            fi

            sleep "$POLL_INTERVAL_SECONDS"
        fi
    done
}

# Print final summary.
print_summary() {
    echo
    echo "===== dev-ci summary ====="
    echo

    if [[ ${#wt_results[@]} -ne 0 ]]
    then
        echo "Feature worktrees:"
        for wt in "${!wt_results[@]}"
        do
            printf '  %-60s %s\n' "$wt" "${wt_results[$wt]}"
        done
        echo
    fi

    if [[ ${#dev_results[@]} -ne 0 ]]
    then
        echo "Dev integration branches:"
        for dev in "${!dev_results[@]}"
        do
            printf '  %-60s %s\n' "$dev" "${dev_results[$dev]}"
        done
        echo
    fi

    echo "=========================="

    # Return non-zero if anything failed.
    for status in "${wt_results[@]}" "${dev_results[@]}"
    do
        if [[ $status != pass ]]
        then
            return 1
        fi
    done
}

# ---------------------------------------------------------------------------
# Top-level subcommands
# ---------------------------------------------------------------------------

# Resolve a path argument to an absolute, canonical worktree path.
# Defaults to $PWD when arg is empty.  Errors via aictl_die if the
# path is not under TIMVISHER_GIT_HOME, which hook resolution
# requires (see find_hooks).
resolve_worktree_path() {
    local path=${1:-$PWD}

    if [[ ! -d $path ]]
    then
        aictl_die \
            --code "dev_ci_path_not_dir" \
            --message "'${path}' is not a directory" \
            --suggestion "cd into a worktree under \$TIMVISHER_GIT_HOME and retry"
    fi

    local resolved
    resolved=$(cd "$path" && pwd -P) ||
        aictl_die \
            --code "dev_ci_path_unreadable" \
            --message "Cannot resolve '${path}'"

    # Belt-and-suspenders: aictl_die exits today, so reaching this
    # check with empty $resolved shouldn't happen. But the codebase
    # could grow a non-exiting aictl variant, and an empty $resolved
    # would silently fall through the prefix check below since "" !=
    # "${git_base}*" is true. Trip explicitly instead.
    [[ -n $resolved ]] ||
        aictl_die \
            --code "dev_ci_path_unreadable" \
            --message "pwd -P returned empty for '${path}'"

    local git_base
    git_base=$(canonical_git_home)
    if [[ $resolved != "${git_base}"* ]]
    then
        aictl_die \
            --code "dev_ci_path_not_in_git_home" \
            --message "'${resolved}' is not under TIMVISHER_GIT_HOME ('${git_base}')" \
            --reason "Hook resolution derives <org>/<repo>/<branch-parts> from the worktree path, which requires the worktree be under \$TIMVISHER_GIT_HOME (default ~/git/)." \
            --suggestion "cd into a worktree managed by timvisher_git" \
            --suggestion "Or set TIMVISHER_GIT_HOME to override the expected root"
    fi

    printf '%s' "$resolved"
}

# `hooks ls [path]` — list every KNOWN_HOOKS entry with its
# rung-resolved paths, or "(none)" when no hook is configured.
# A context that cannot be resolved at all halts instead.
cmd_hooks_ls() {
    local worktree_path
    worktree_path=$(resolve_worktree_path "${1:-}") || exit $?

    require_worktree_context "$worktree_path"
    snapshot_changed_subpaths "$worktree_path"

    printf 'hooks for %s:\n\n' "$worktree_path"

    local hook_name
    for hook_name in "${KNOWN_HOOKS[@]}"
    do
        printf '  %s\n' "$hook_name"
        local -a resolved=()
        readarray -d '' -t resolved < <(find_hooks "$worktree_path" "$hook_name")
        if (( 0 < ${#resolved[@]} ))
        then
            local path
            for path in "${resolved[@]}"
            do
                printf '    %s\n' "$path"
            done
        else
            printf '    (none)\n'
        fi
    done
}

# `hooks run [hook ...] [-C path]` — run hooks foregrounded in the
# controlling TTY (no tmux, no nested agent).  No hook args = run all
# KNOWN_HOOKS that resolve.  Explicit hook args = run those, hard
# error on any unresolvable name.
cmd_hooks_run() {
    local -a hook_args=()
    local worktree_arg=""

    while (( 0 < $# ))
    do
        case $1 in
            --)
                # End-of-flags marker — everything after this is hook
                # names. Defensive against a future hook accidentally
                # named `-C` or starting with a hyphen.
                shift
                while (( 0 < $# ))
                do
                    hook_args+=("$1")
                    shift
                done
                ;;
            -C)
                if [[ $# -lt 2 ]]
                then
                    aictl_die \
                        --code "dev_ci_hooks_run_missing_C_arg" \
                        --message "'-C' requires a path argument" \
                        --suggestion "timvisher_dev_ci hooks run -C /path/to/worktree [hook ...]"
                fi
                worktree_arg=$2
                shift 2
                ;;
            *)
                hook_args+=("$1")
                shift
                ;;
        esac
    done

    local worktree_path
    worktree_path=$(resolve_worktree_path "$worktree_arg") || exit $?

    local -a hooks_to_run=()
    if [[ ${#hook_args[@]} == 0 ]]
    then
        # Default: run every KNOWN_HOOKS entry that resolves.
        local h
        for h in "${KNOWN_HOOKS[@]}"
        do
            hook_exists "$worktree_path" "$h" && hooks_to_run+=("$h")
        done

        if [[ ${#hooks_to_run[@]} == 0 ]]
        then
            aictl_die \
                --code "dev_ci_hooks_run_none_resolved" \
                --message "No KNOWN_HOOKS resolved for '${worktree_path}'; nothing to run" \
                --reason "Every entry in KNOWN_HOOKS (run-tests.sh, post-integrate.sh, pre-run-tests.sh, pre-post-integrate.sh) was checked across every rung and none had a matching script." \
                --suggestion "Run 'timvisher_dev_ci hooks ls' to see that nothing resolves" \
                --suggestion "Add a hook script under bash/bin/timvisher_dev_ci.config/hooks/<org>/<repo>[/<subpath>|/<branch-parts>]/" \
                --suggestion "Or run timvisher_dev_ci's full pipeline ('timvisher_dev_ci .'), which can launch an agent to author run-tests.sh"
        fi
    else
        # Explicit list: every named hook must resolve.
        local h
        local -a missing=()
        for h in "${hook_args[@]}"
        do
            hook_exists "$worktree_path" "$h" ||
                missing+=("$h")
        done

        if (( 0 < ${#missing[@]} ))
        then
            local missing_str=${missing[*]}
            aictl_die \
                --code "dev_ci_hook_unresolvable" \
                --message "Hook(s) not found at any rung for '${worktree_path}': ${missing_str}" \
                --reason "Explicit hook names must resolve via the rung walk. An unresolvable hook usually means it has not been written yet for this worktree, or the hook name was misspelled." \
                --suggestion "Run 'timvisher_dev_ci hooks ls' to see what's available" \
                --suggestion "Add the hook under bash/bin/timvisher_dev_ci.config/hooks/<org>/<repo>[/<subpath>|/<branch-parts>]/"
        fi

        hooks_to_run=("${hook_args[@]}")
    fi

    local h
    for h in "${hooks_to_run[@]}"
    do
        info "running hook: %s" "$h"
        if ! run_hooks "$worktree_path" "$h"
        then
            aictl_die \
                --code "dev_ci_hook_failed" \
                --message "Hook '${h}' failed in '${worktree_path}'" \
                --reason "The hook script exited non-zero. Stderr/stdout was streamed above." \
                --suggestion "Check the hook output above for the failing step" \
                --suggestion "Re-run the failing step directly from '${worktree_path}' to iterate"
        fi
    done
}

cmd_hooks() {
    local sub=${1:-}
    case $sub in
        ls)  cmd_hooks_ls "${@:2}" ;;
        run) cmd_hooks_run "${@:2}" ;;
        '')
            aictl_die \
                --code "dev_ci_hooks_no_subcommand" \
                --message "'hooks' requires a subcommand: ls or run" \
                --suggestion "timvisher_dev_ci hooks ls           # list resolved hooks for current worktree" \
                --suggestion "timvisher_dev_ci hooks run          # run every resolved hook" \
                --suggestion "timvisher_dev_ci hooks run HOOK     # run named hook(s)" \
                --suggestion "timvisher_dev_ci --help"
            ;;
        *)
            aictl_die \
                --code "dev_ci_hooks_unknown_subcommand" \
                --message "Unknown 'hooks' subcommand: '${sub}' (available: ls, run)" \
                --suggestion "timvisher_dev_ci hooks ls" \
                --suggestion "timvisher_dev_ci hooks run" \
                --suggestion "timvisher_dev_ci --help"
            ;;
    esac
}

# Convenience: run-tests = hooks run run-tests.sh.  Accepts -C path
# the same way 'hooks run' does.
cmd_run_tests() {
    cmd_hooks_run run-tests.sh "$@"
}

resolve_regen_conflicts() {
    local regen_glob=$1
    local conflicted path g matched

    conflicted=$(git diff --name-only --diff-filter=U) || return 1
    [[ -n $conflicted ]] || return 1

    while IFS= read -r path
    do
        matched=false
        for g in $regen_glob
        do
            if [[ $g == */* ]]
            then
                # shellcheck disable=SC2053
                [[ $path == $g ]] && { matched=true; break; }
            else
                # shellcheck disable=SC2053
                [[ ${path##*/} == $g ]] && { matched=true; break; }
            fi
        done
        "$matched" || return 1
    done <<< "$conflicted"

    while IFS= read -r path
    do
        git checkout --ours -- "$path" || return 1
        git add -- "$path" || return 1
    done <<< "$conflicted"

    GIT_EDITOR=true git merge --continue
}

# Lightweight foreground integrate: reset a dev worktree to @{u} and
# sequential-merge every branch listed in its x.active-worktrees, then run
# the post-integrate.sh hook.  No baseline tests, no nested agent, no push
# -- unlike the bare pipeline (cmd__integrate).  Sequential (not octopus)
# so a conflict pinpoints the offending branch.  A conflict confined to
# derived files (BUILD.bazel) is resolved in place and re-derived by
# post-integrate.sh, so only a genuine SOURCE conflict stops the run --
# that means two feature branches actually disagree; resolve it, or run
# the bare pipeline ('timvisher_dev_ci .') for agent-driven resolution.
#
# The reset+merge phase is refused unless the target is a dev integration
# worktree (registry entry or x.dev-integration-branch marker).  --build-only
# skips that phase and runs only the post-integrate.sh build.
#
# Usage: timvisher_dev_ci integrate [-C path] [--build-only]
cmd_integrate_local() {
    local worktree_arg=""
    local build_only=false
    while (( 0 < $# ))
    do
        case $1 in
            --build-only)
                build_only=true
                shift
                ;;
            -C)
                if [[ $# -lt 2 ]]
                then
                    aictl_die \
                        --code "dev_ci_integrate_missing_C_arg" \
                        --message "'-C' requires a path argument" \
                        --suggestion "timvisher_dev_ci integrate -C /path/to/dev-worktree"
                fi
                worktree_arg=$2
                shift 2
                ;;
            *)
                aictl_die \
                    --code "dev_ci_integrate_unexpected_arg" \
                    --message "integrate: unexpected argument '$1'" \
                    --suggestion "timvisher_dev_ci integrate [--build-only] [-C /path/to/dev-worktree]"
                ;;
        esac
    done

    local dev_path
    dev_path=$(resolve_worktree_path "$worktree_arg") || exit $?

    if ! "$build_only" && ! is_dev_integration_worktree "$dev_path"
    then
        aictl_die \
            --code "dev_ci_integrate_not_integration_worktree" \
            --message "integrate: '${dev_path}' is not a dev integration worktree" \
            --reason "A full integrate resets the worktree to @{u} and merges its x.active-worktrees. On a feature branch tracking origin/main that reset discards every commit on the branch. '${dev_path}' is neither listed in '${DEV_CI_REGISTRY}' nor marked with x.dev-integration-branch." \
            --suggestion "timvisher_dev_ci integrate --build-only -C '${dev_path}' runs the build hooks without touching git state" \
            --suggestion "Point -C at a dev integration worktree for a full integrate" \
            --suggestion "Or, if '${dev_path}' really is one, add it to '${DEV_CI_REGISTRY}' and touch '${dev_path}/x.dev-integration-branch'"
    fi

    cd "$dev_path" ||
        die "integrate: cannot cd to '%s'" "$dev_path"

    local -a paths=()

    if "$build_only"
    then
        info "integrate: --build-only in '%s'; skipping fetch, reset and merge" "$dev_path"
    else
        local active_file="${dev_path}/x.active-worktrees"

        info "integrate: fetching in '%s'" "$dev_path"
        git fetch --all ||
            die "integrate: git fetch failed in '%s'" "$dev_path"

        integrate_scratch_begin "$dev_path" ||
            die "integrate: cannot start a scratch branch in '%s'" "$dev_path"

        # Generated files (default: BUILD.bazel) are DERIVED, not source: each
        # feature commits its own gazelle output in isolation, so they collide
        # on merge even when the sources compose fine. That collision is not a
        # real conflict -- post-integrate.sh re-derives them from the merged
        # sources, and a clean regenerate+build is the positive signal that the
        # features compose. So a conflict confined to them is resolved in place
        # (keep ours, the content is about to be thrown away) and the merge
        # concluded; only genuine SOURCE conflicts stop the run. Resolving
        # after the fact rather than through a merge driver keeps this to the
        # one merge: a driver lives in the repository's shared config and
        # $GIT_DIR/info/attributes, which are common to every worktree, and
        # 'keep ours' discards the replayed side of any unrelated rebase.
        local regen_glob=${TIMVISHER_DEV_CI_INTEGRATE_REGEN_GLOB:-BUILD.bazel}

        local p
        while IFS= read -r p
        do
            paths+=("$p")
        done < <(read_active_worktrees "$active_file")

        local wt branch conflicted
        for wt in "${paths[@]}"
        do
            if is_remote_worktree "$wt"
            then
                branch=$(fetch_remote_worktree "$wt") ||
                    die "integrate: cannot fetch remote worktree '%s'" "$wt"
            else
                if [[ ! -e ${wt}/.git ]]
                then
                    warn "integrate: active worktree '%s' missing; skipping" "$wt"
                    continue
                fi
                branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD) ||
                    die "integrate: cannot resolve branch for '%s'" "$wt"
            fi

            if git merge --no-edit "$branch"
            then
                info "integrate: merged '%s'" "$branch"
                continue
            fi

            if resolve_regen_conflicts "$regen_glob"
            then
                info "integrate: merged '%s' (derived files left for post-integrate)" "$branch"
                continue
            fi

            # A conflict means two source branches genuinely disagree. Surface
            # it; do not paper over it (the branches must be made to merge
            # cleanly, e.g. by sharing a base and regenerating conflict-prone
            # generated files consistently).
            conflicted=$(git diff --name-only --diff-filter=U)
            error "integrate: unresolvable conflict merging '%s':" "$branch"
            printf '%s\n' "$conflicted" >&2
            git merge --abort
            die "integrate: real conflict in '%s' -- resolve it, or run the bare pipeline ('timvisher_dev_ci .') for agent-driven resolution" "$branch"
        done
    fi

    if hook_exists "$dev_path" "post-integrate.sh"
    then
        info "integrate: running post-integrate.sh"
        run_hooks "$dev_path" "pre-post-integrate.sh"
        run_hooks "$dev_path" "post-integrate.sh" ||
            die "integrate: post-integrate.sh failed in '%s'" "$dev_path"
    elif "$build_only"
    then
        aictl_die \
            --code "dev_ci_integrate_build_only_no_hook" \
            --message "integrate --build-only: no post-integrate.sh resolves for '${dev_path}'" \
            --reason "--build-only runs post-integrate.sh and nothing else, so an unresolved hook would build nothing while still exiting 0 -- and a caller like the cfctl shim would go on to exec a stale binary." \
            --suggestion "timvisher_dev_ci hooks ls -C '${dev_path}' shows that nothing resolves" \
            --suggestion "Add post-integrate.sh under '${REPO_HOOKS_EXT_DIR}/<org>/<repo>/<branch-parts>/'"
    fi

    # A die() anywhere above reaches the EXIT trap instead, which puts dev
    # back and keeps the scratch branch.
    integrate_scratch_finish ||
        die "integrate: cannot advance '%s' to the integrated tree" "$dev_path"

    if "$build_only"
    then
        info "integrate: done (build only, '%s')" "$dev_path"
    else
        info "integrate: done (%d worktree(s) merged into '%s')" "${#paths[@]}" "$dev_path"
    fi
}

# Browse and bust the verification cache.  Busting is the operation you reach
# for when you suspect a flake, so it has to be reachable without composing a
# jq filter -- the layout exists to make `forget` a path.
cmd_verified() {
    local action=${1-}
    shift 2>/dev/null

    case $action in
        path)
            printf '%s\n' "$VERIFIED_STORE"
            ;;
        ls)
            local scope=${1-}
            local root="${VERIFIED_STORE}${scope:+/$scope}"

            if [[ ! -d $root ]]
            then
                info "verified: nothing cached under '%s'" "$root"
                return 0
            fi

            local entry
            while IFS= read -r entry
            do
                jq -r '"\(.provenance.org)/\(.provenance.repo)  \(.key_inputs.tool)  tree=\(.key_inputs.tree[0:12])  key=\(.key[0:12])  \(.provenance.verified_at)  deps=\(.key_inputs.dependencies | length)"' \
                    "$entry" 2>/dev/null ||
                    warn "verified: unreadable entry '%s'" "$entry"
            done < <(find "$root" -name '*.json' -type f | sort)
            ;;
        forget)
            local scope=${1-}

            if [[ -z $scope ]]
            then
                aictl_die \
                    --code "dev_ci_verified_forget_needs_scope" \
                    --message "verified forget needs something to forget" \
                    --reason "Dropping the whole cache is rarely what is meant, and an empty scope would do exactly that." \
                    --suggestion "timvisher_dev_ci verified forget <org>/<repo>" \
                    --suggestion "timvisher_dev_ci verified ls    # see what is cached" \
                    --suggestion "rm -rf '${VERIFIED_STORE}'      # if the whole cache really is the intent"
            fi

            local target="${VERIFIED_STORE}/${scope}"
            local resolved_store resolved_target

            # Resolve both before comparing: '..' in a scope would otherwise
            # delete whatever it climbed out to.
            resolved_store=$(cd "$VERIFIED_STORE" 2>/dev/null && pwd -P) ||
                {
                    info "verified: no cache at '%s'" "$VERIFIED_STORE"
                    return 0
                }
            resolved_target=$(cd "$target" 2>/dev/null && pwd -P) ||
                {
                    info "verified: nothing cached at '%s'" "$target"
                    return 0
                }

            if [[ $resolved_target != "$resolved_store"/* ]]
            then
                aictl_die \
                    --code "dev_ci_verified_forget_escapes_store" \
                    --message "'${scope}' resolves outside the cache" \
                    --reason "'${resolved_target}' is not under '${resolved_store}'." \
                    --suggestion "Give a scope relative to the cache root, like <org>/<repo>"
            fi

            local n
            n=$(find "$resolved_target" -name '*.json' -type f | wc -l | tr -d ' ')
            rm -rf -- "$resolved_target" ||
                die "verified: cannot remove '%s'" "$resolved_target"
            info "verified: forgot %s entr%s under '%s'" "$n" "$( (( n == 1 )) && printf y || printf ies )" "$scope"
            ;;
        *)
            aictl_die \
                --code "dev_ci_verified_unknown_action" \
                --message "Unknown 'verified' action: '${action}'" \
                --suggestion "timvisher_dev_ci verified ls [<org>[/<repo>]]" \
                --suggestion "timvisher_dev_ci verified forget <org>[/<repo>]" \
                --suggestion "timvisher_dev_ci verified path"
            ;;
    esac
}

print_help() {
    cat <<'EOF'
NAME
    timvisher_dev_ci — local CI orchestrator for dev integration branches

SYNOPSIS
    # Full pipeline (sync + integrate + push), orchestrated via tmux + agents:
    timvisher_dev_ci                          # all dev branches in registry
                                              #   (or current worktree, when run from inside one)
    timvisher_dev_ci [run] PATH ...           # specific dev branches

    # Direct hook invocation in the controlling TTY (no tmux, no nested agent):
    timvisher_dev_ci hooks ls [PATH]                     # list resolved hooks
    timvisher_dev_ci hooks run [HOOK ...] [-C PATH]      # run hooks (all known if HOOK omitted)
    timvisher_dev_ci hooks run [-C PATH] -- [HOOK ...]   # `--` ends flags before hook names
    timvisher_dev_ci run-tests [-C PATH]                 # convenience for: hooks run run-tests.sh
    timvisher_dev_ci integrate [-C PATH]                 # merge active worktrees onto @{u} + post-integrate (no test/agent/push)
    timvisher_dev_ci integrate --build-only [-C PATH]    # post-integrate only: no fetch, no reset, no merge

    # Misc:
    timvisher_dev_ci status [PATH ...]        # show CI status of worktrees
    timvisher_dev_ci clean [PATH ...]         # remove status files
    timvisher_dev_ci worktrees active         # list active worktree paths
    timvisher_dev_ci verified ls [<org>[/<repo>]]   # browse the verification cache
    timvisher_dev_ci verified forget <org>[/<repo>] # bust part of it
    timvisher_dev_ci verified path            # where the cache lives
    timvisher_dev_ci --help|-h|help           # this message

PATHS
    PATH defaults to $PWD when omitted from any subcommand.
    All paths must be under $TIMVISHER_GIT_HOME (default ~/git/) so the
    hook resolution can derive <org>/<repo>/<branch-parts>.

    Bare `timvisher_dev_ci` (no args):
      - Outside any worktree: runs every dev branch in the registry.
      - Inside a worktree under $TIMVISHER_GIT_HOME: scopes the pipeline to
        that worktree's root (resolved via `git rev-parse --show-toplevel`,
        so subdirs of a worktree work too).

UPSTREAM BASELINE

    A run targets one upstream state and propagates it through the tree.
    Phase 0.4 fetches each repository once, resolves origin and upstream to
    concrete commits, and writes them to a manifest; every later phase
    merges and compares against the recorded commit rather than a ref it
    resolves for itself.

    Without that a run has no baseline but several, taken minutes apart, and
    with more than one repository in play it can integrate and push a
    combination of upstream states that never existed upstream and was never
    tested as a set.

    The manifest is a file, not a variable: cmd__sync and cmd__integrate run
    as separate processes in their own tmux windows, and are handed its path
    in TIMVISHER_DEV_CI_BASELINE.  The integrate scratch branch starts at the
    recorded commit, and the integration agent is told that commit rather
    than @{u}.

    A worktree whose repo has no baseline entry falls back to resolving refs
    live, so this degrades to the previous behaviour instead of failing.

DEPENDENCY PINS

    A worktree pins a dependency to a tree in x.dependency-pins, naming the
    repo rather than a path:

        # org/repo @ worktree
        xenodium/acp.el @ ~/git/xenodium/acp.el/terminal-caps

    Every branch directory that repo has in the real git home is pointed at
    that tree in the farm, so however a consumer's hook addresses it -- today
    they all say <org>/<repo>/main -- it resolves to the pin.  Naming the
    path instead would mean guessing which one the hook asks for, and a guess
    that misses puts the override where nothing reads it: a green run against
    the unpinned tree.

    A worktree with no pins gets no farm and sees the real git home, so
    pinning nothing costs nothing.

DEPENDENCY FARM

    Hooks address their dependencies through ${TIMVISHER_GIT_HOME}/<org>/
    <repo>/..., so which tree a dependency MEANS can be decided without
    editing any hook: point that variable at a tree of symlinks where
    unoverridden paths lead back to the real git home and overridden ones
    lead wherever the caller says.

    That is what lets a feature branch pin a dependency to its own branch
    and be tested against it, rather than waiting for the pin to land in
    the dependency's trunk first.

    The farm is injected for the hook process only.  Hook resolution runs
    first, against the real git home, because that is what derives
    <org>/<repo>/<branch-parts> -- a farm in scope any earlier would send
    resolution looking for the worktree somewhere it is not.

    It holds only as long as nothing resolves symlinks.  A hook reaching
    for pwd -P, realpath or readlink -f on a dependency escapes back to the
    real tree and silently tests the wrong thing.  bin/test uses plain
    `pwd`, which keeps the logical path.

VERIFICATION CACHE

    A verification result is cached against a content checksum of
    everything that could change it: the tree under test, the content of
    the hooks that ran, and the keys of the dependencies those hooks read.
    The key is recursive, so a consumer whose own tree never moved is still
    re-verified when a dependency moves underneath it.

    Keyed on the tree, not the commit: 'reset --hard @{u}', a recreated
    scratch branch and a rebased pull-upstream branch all churn the sha
    while the content stands still.

    Entries live under $XDG_STATE_HOME/timvisher/dev_ci/verified at
    <org>/<repo>/<tool>/<tree>/<key>/.  The leaf is the full key, so two
    results for one tree that differ by hook or dependency cannot collide;
    everything above it is an index for browsing and for 'forget' at a
    granularity a human would pick.  Never infer validity from a path.

    Each entry is JSON split into key_inputs (hashed) and provenance (not),
    so it can be re-proved: rehash key_inputs and compare to the filename.
    An entry that fails that, or is unparseable, or carries an unknown
    schema, is a miss -- never a green run.

    A dirty worktree is never cached in either direction, since HEAD^{tree}
    describes tracked content only.  TIMVISHER_DEV_CI_NO_MEMO=1 bypasses
    the cache entirely.

UPSTREAM PULL BRANCHES

    A soft fork (x.timvisher_git.soft-fork) never merges upstream into its
    trunk.  Upstream reaches it the way every other change does: on a feature
    branch that integrates into dev.

    When upstream/<trunk> holds commits the fork's trunk does not, the
    pipeline stacks 'pull-upstream/<timestamp>' on the trunk, registers it in
    the dev branch's x.active-worktrees, and merges upstream into it -- with
    an agent when that conflicts.  The feature sync and the integrate phase
    then treat it like any other worktree, and retire_merged_worktrees drops
    it once it lands in origin/<trunk>.

    An existing unmerged pull-upstream branch is reused rather than replaced.
    Regular forks get none of this: their dev already resets to
    upstream/<trunk>.

SCRATCH BRANCH

    Both integrate paths do their work on a scratch branch named
    'x.dev-ci-integrate-<dev-branch>-<pid>', branched from @{u} and set to
    track it.  The dev branch is moved to the result only once every merge,
    the verification run and post-integrate.sh have passed.

    So a failed integration leaves the dev branch exactly where it was, and
    the half-finished attempt stays on the scratch branch for inspection
    rather than being thrown away.  A successful one deletes the scratch.

AGENT USAGE
    To run the project's full local CI suite from inside a worktree:

        timvisher_dev_ci run-tests

    This runs the rung-resolved run-tests.sh hook(s) for the current
    worktree in the controlling TTY -- no tmux, no nested agent. The
    hook script encodes project-specific test conventions (correct
    build tags, lint flags, env vars). Prefer it over invoking
    `make test` / `golangci-lint` / `pytest` directly.

    To see exactly what would run:

        timvisher_dev_ci hooks ls

    To run every known hook in one go (run-tests.sh + post-integrate.sh
    + pre-* extension hooks):

        timvisher_dev_ci hooks run

    Difference from bare `timvisher_dev_ci`: bare invocation does
    pull --rebase, agent-driven conflict resolution, octopus merge,
    test verification, and push -- the full CI pipeline. `hooks` and
    `run-tests` only run the hook scripts. For "did my changes
    break tests?", use `run-tests`.

KNOWN HOOKS
    run-tests.sh             Full local CI suite (lint + test + build).
    post-integrate.sh        Runs after a successful integrate
                             (e.g. build + install).
    pre-run-tests.sh         Extension hook executed before run-tests.sh.
    pre-post-integrate.sh    Extension hook executed before post-integrate.sh.

HOOK RESOLUTION
    For a worktree at ~/git/<org>/<repo>/<branch-parts>/, hooks are
    resolved by walking rungs from least to most specific:

        1. repo:    <owner>/<repo>/<hook>
        2. subpath: <owner>/<repo>/<subpath>/<hook>
        3. branch:  <owner>/<repo>/<branch-parts>/<hook>

    Subpath rungs are every directory containing a change vs '@{u}...',
    an uncommitted change, or an untracked file, plus each of its
    ancestors, shallower before deeper, equal depths ordered
    lexicographically. A clean worktree with no changes vs its upstream
    gets only the repo and branch rungs. Branch rungs match the full
    branch path exactly (no prefixes).

    Within each rung, <owner> is tried as the fork-network main owner,
    then <my-github-user>. For each owner, two directories are checked
    in order:
        a. bash/bin/timvisher_dev_ci.config/hooks/  (checked-in, in this repo)
        b. ~/.config/timvisher/ide/timvisher_dev_ci/hooks/  (machine-specific)

    All matching hooks run in that order (no shadowing), so the most
    specific hook runs last. Resolved paths are deduplicated so the
    same file is never executed twice.

EXIT
    0   success
    1   failure (structured JSON on stderr: type/level/code/message
        plus reason/suggestions/doc fields when applicable)

ENVIRONMENT
    TIMVISHER_GIT_HOME            Worktree root (default: ~/git)
    TIMVISHER_DEV_CI_REGISTRY     Path to dev branch registry file
                                  (default: ~/.config/timvisher/ide/timvisher_dev_ci/branches)
    TIMVISHER_DEV_CI_HEARTBEAT_SECONDS
                                  Seconds between progress heartbeats
                                  while waiting on sync/integration
                                  (default: 30)
EOF
}

# The bare invocation and the path shortcut both reach cmd_run with a path
# the caller chose rather than one the registry vouched for, and the pipeline
# resets whatever it is handed to @{u}.  On a feature branch that discards the
# branch.  cmd_integrate_local has refused this for a while; the full pipeline
# did not, so running it from the wrong directory silently destroyed work.
assert_dev_integration_worktrees() {
    local candidate

    for candidate in "$@"
    do
        [[ -d $candidate ]] || continue
        is_dev_integration_worktree "$candidate" && continue

        aictl_die \
            --code "dev_ci_run_not_integration_worktree" \
            --message "run: '${candidate}' is not a dev integration worktree" \
            --reason "The pipeline resets a dev branch to @{u} and merges its x.active-worktrees. On a feature branch tracking origin/main that reset discards every commit on the branch. '${candidate}' is neither listed in '${DEV_CI_REGISTRY}' nor marked with x.dev-integration-branch." \
            --suggestion "timvisher_dev_ci run-tests -C '${candidate}'   # test this worktree without touching git state" \
            --suggestion "Point the run at a dev integration worktree instead" \
            --suggestion "Or, if '${candidate}' really is one, add it to '${DEV_CI_REGISTRY}' and touch '${candidate}/x.dev-integration-branch'"
    done
}

cmd_run() {
    assert_dev_integration_worktrees "$@"

    pull_xenodium_mains

    info "Phase 0: upgrading agent tooling"
    if ! brew upgrade --yes "${BREW_UPGRADE_PACKAGES[@]}" 2>&1
    then
        warn "brew upgrade had warnings (non-fatal, continuing)"
    fi

    if [[ -x ~/.config/timvisher/ide/timvisher_dev_ci/hooks/run ]]
    then
      ~/.config/timvisher/ide/timvisher_dev_ci/hooks/run ||
        die "System Extensions 'run' hook failed to run"
    fi

    # Sweep any legacy `_git/...` / `.git/...` worktrees across all
    # caches before we start.  Cheap (~400ms across all caches) and
    # ensures subsequent phases don't inherit state from the main-57o
    # regression.
    info "Phase 0.1: sweeping bogus worktrees across all caches"
    timvisher_git worktree sweep-bogus ||
      warn "sweep-bogus reported errors (non-fatal, continuing)"

    discover "$@"

    # Before any phase: one fetch per repo, and the resolved commits written
    # down. Everything after this targets the manifest, not a live ref.
    info "Phase 0.4: establishing the upstream baseline"
    baseline_establish "${!dev_branches[@]}" "${!all_worktrees[@]}" >/dev/null ||
        warn "baseline: could not establish one; phases will resolve refs live"

    retire_merged_worktrees
    info "Found %d dev branches, %d feature worktrees" "${#dev_branches[@]}" "${#all_worktrees[@]}"

    # Phase 0.5: for soft fork repos, rebase the local trunk onto
    # origin/<trunk> so that @{u} (origin/<trunk>) is current before
    # feature sync.  No upstream merge, no push, no agent.
    info "Phase 0.5: syncing soft fork trunk branches"
    sync_soft_fork_trunks

    # After the trunk is current with origin, and before the feature sync
    # that will treat it like any other worktree.
    info "Phase 0.6: refreshing soft fork upstream pull branches"
    ensure_upstream_pull_worktrees

    autocommit_build_artifacts
    preflight_check_clean
    clean_status_files

    info "Phase 1: syncing feature worktrees"
    launch_sync_phase
    wait_for_worktrees

    info "Phase 2: integrating dev branches"
    launch_integrate_phase

    print_summary
}

cmd_status() {
    discover "$@"

    echo "Feature worktrees:"
    for wt in "${!all_worktrees[@]}"
    do
        local status
        status=$(read_status "$wt")
        printf '  %-60s %s\n' "$wt" "${status:-pending}"
    done

    echo
    echo "Dev integration branches:"
    for dev in "${!dev_branches[@]}"
    do
        local status
        status=$(read_status "$dev")
        local dep_list=${dev_branches[$dev]}
        local extra_deps=${dev_branch_deps[$dev]}
        local all_deps="${dep_list:+$dep_list}${dep_list:+${extra_deps:+ }}${extra_deps:+$extra_deps}"
        printf '  %-60s %s  (deps: %s)\n' "$dev" "${status:-pending}" "${all_deps:-none}"
    done
}

# Print all active worktree paths (dev branches + their feature worktrees).
# One absolute path per line (~/‑expanded, not necessarily symlink-resolved).
cmd_worktrees_active() {
    # When called with no args and no registry, there are simply no active
    # worktrees — return empty (exit 0).  This lets worktree gc proceed
    # safely in environments without dev_ci configured.
    if [[ $# == 0 ]] && [[ ! -f $DEV_CI_REGISTRY ]]
    then
        return 0
    fi

    discover "$@"

    for dev in "${!dev_branches[@]}"
    do
        printf '%s\n' "$dev"
    done

    for wt in "${!all_worktrees[@]}"
    do
        printf '%s\n' "$wt"
    done
}

cmd_clean() {
    discover "$@"
    clean_status_files
    info "Cleaned status files"
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
#
# Dispatch order:
#   1. --help / -h / help      handled first so help is always cheap
#   2. Known subcommands by NAME (BEFORE the dir-sniff, so a literal
#      './hooks' or './run-tests' directory cannot shadow them)
#   3. Bare invocation         no args → DTRT based on cwd
#   4. Path shortcut            first arg is a readable directory → cmd_run
#   5. Unknown                  aictl_die with --help suggestion

# 1. Help bypass.
case ${1:-} in
    -h|--help|help)
        print_help
        exit 0
        ;;
esac

# 2. Known subcommands by name.
case ${1:-} in
    run)
        shift
        cmd_run "$@"
        exit
        ;;
    status)
        shift
        cmd_status "$@"
        exit
        ;;
    clean)
        shift
        cmd_clean "$@"
        exit
        ;;
    hooks)
        shift
        cmd_hooks "$@"
        exit
        ;;
    run-tests)
        shift
        cmd_run_tests "$@"
        exit
        ;;
    integrate)
        shift
        cmd_integrate_local "$@"
        exit
        ;;
    verified)
        shift
        cmd_verified "$@"
        exit
        ;;
    worktrees)
        shift
        case ${1:-} in
            active)
                shift
                cmd_worktrees_active "$@"
                exit
                ;;
            *)
                aictl_die \
                    --code "dev_ci_worktrees_unknown_subcommand" \
                    --message "worktrees: unknown subcommand '${1:-}' (available: active)" \
                    --suggestion "timvisher_dev_ci worktrees active"
                ;;
        esac
        ;;
    __sync)
        shift
        cmd__sync "$@"
        exit
        ;;
    __integrate)
        shift
        cmd__integrate "$@"
        exit
        ;;
    __ensure_tests)
        shift
        cmd__ensure_tests "$@"
        exit
        ;;
esac

# 3. Bare invocation: scope to current worktree if cwd is under
# $TIMVISHER_GIT_HOME, else fall back to the registry.
if [[ $# == 0 ]]
then
    git_base=$(canonical_git_home)
    if toplevel=$(git rev-parse --show-toplevel 2>/dev/null) &&
       [[ -d $toplevel ]]
    then
        toplevel_real=$(cd "$toplevel" && pwd -P)
        if [[ $toplevel_real == "${git_base}"* ]]
        then
            info "bare invocation inside worktree '%s'; scoping pipeline to it" "$toplevel_real"
            cmd_run "$toplevel_real"
            exit
        fi
    fi
    cmd_run
    exit
fi

# 4. Path shortcut: first arg is a readable directory.
if [[ -d $1 && -r $1 ]]
then
    cmd_run "$@"
    exit
fi

# 5. Unknown.
aictl_die \
    --code "dev_ci_unknown_command" \
    --message "Unknown command: '$1'" \
    --suggestion "timvisher_dev_ci --help" \
    --suggestion "timvisher_dev_ci hooks ls    # list resolved hooks for current worktree" \
    --suggestion "timvisher_dev_ci run-tests   # run rung-resolved run-tests.sh"
