#!/usr/bin/env bash

# shellcheck disable=SC1090
source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

bin_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")") ||
  die "Couldn't resolve the wrapper's directory"

# shellcheck source=../ai/agents.bash
source "$bin_dir/../ai/agents.bash" ||
  die "Couldn't source agents.bash"

export OPENAI_API_KEY="${OPENAI_API_KEY:-op://Private/OpenAI API Secret Key/credential}"

export TIMVISHER_CODEX=true

config_dir=${XDG_CONFIG_HOME:-${HOME}/.config}/timvisher/ide
bin_config=${config_dir}/codex-acp_bin

AGENT_BIN=()
if [[ -r $bin_config ]]
then
  # shellcheck disable=SC1090
  source "$bin_config"
fi

if [[ ${#AGENT_BIN[@]} -eq 0 ]]
then
  real_codex_acp=$(timvisher_real_bin codex-acp "${BASH_SOURCE[0]}") ||
    die 'No codex-acp found besides this wrapper ("%s"); install it with Homebrew, put it on PATH, or set AGENT_BIN in %s.' "${BASH_SOURCE[0]}" "$bin_config"
  AGENT_BIN=("$real_codex_acp")
fi

timvisher_real_bin_skip_self "${BASH_SOURCE[0]}"
timvisher_agent_exec "${AGENT_BIN[@]}" "$@"
