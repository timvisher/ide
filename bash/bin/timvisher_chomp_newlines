#!/usr/bin/env bash

# -z needs GNU sed: plain sed on Linux, Homebrew's gsed on macOS.
gnu_sed='gsed'
if sed --version > /dev/null 2>&1
then
  gnu_sed='sed'
fi

for f in "$@"
do
  # Skip files that don't exist (e.g., deleted files)
  if ! [[ -r $f ]]
  then
    continue
  fi

  t=$("$gnu_sed" -z 's/^\s*//; s/\s*$//' "$f")

  if [[ -n $t ]]
  then
    cat > "$f" <<<"$t"
  else
    printf '' > "$f"
  fi
done
