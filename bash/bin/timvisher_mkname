#!/usr/bin/env python3
"""Emit a unique, memorable "<prefix><adjective><separator><noun>" name."""

import argparse
import fcntl
import hashlib
import hmac
import os
import re
import sys
import uuid

ADJ_COUNT = 7808
NOUN_COUNT = 27046
DOMAIN = ADJ_COUNT * NOUN_COUNT

MACHINE_BITS = 8
COUNTER_BITS = 19
MACHINE_MASK = (1 << MACHINE_BITS) - 1
COUNTER_CAP = 1 << COUNTER_BITS

FEISTEL_KEY = bytes.fromhex(
    "9e3779b97f4a7c15f39cc0605cedc8341082276bf3a27251f86c6a11d0c18e95"
)
FEISTEL_ROUNDS = 8
HALF_BITS = 14
HALF_MASK = (1 << HALF_BITS) - 1
CYCLE_DOMAIN = 1 << (2 * HALF_BITS)


def _prog():
    return os.path.basename(sys.argv[0])


def die(msg):
    sys.stderr.write(f"{_prog()}: {msg}\n")
    raise SystemExit(1)


def _round_f(r, half):
    mac = hmac.new(
        FEISTEL_KEY, bytes([r]) + half.to_bytes(2, "big"), hashlib.sha256
    ).digest()
    return int.from_bytes(mac[:2], "big") & HALF_MASK


def _feistel(x):
    left = (x >> HALF_BITS) & HALF_MASK
    right = x & HALF_MASK
    for r in range(FEISTEL_ROUNDS):
        left, right = right, left ^ _round_f(r, right)
    return (left << HALF_BITS) | right


def permute(block):
    y = _feistel(block)
    while y >= DOMAIN:
        y = _feistel(y)
    return y


def _load_wordlist(path, expected):
    words = []
    with open(path, encoding="ascii") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            words.append(line)
    if len(words) != expected:
        die(
            f"wordlist {path} has {len(words)} entries, expected {expected}; "
            "the uniqueness guarantee requires the frozen lists — refusing to run"
        )
    return words


def load_wordlists():
    here = os.path.dirname(os.path.realpath(__file__))
    adjectives = _load_wordlist(
        os.path.join(here, "timvisher_mkname__adjectives.txt"), ADJ_COUNT
    )
    nouns = _load_wordlist(
        os.path.join(here, "timvisher_mkname__nouns.txt"), NOUN_COUNT
    )
    return adjectives, nouns


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    return os.path.join(base, "timvisher", "ide", "mkname")


def _atomic_write(path, text):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="ascii") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    dfd = os.open(os.path.dirname(path), os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def resolve_machine_id(sdir, override):
    path = os.path.join(sdir, "machine_id")
    if override is not None:
        if not 0 <= override <= MACHINE_MASK:
            die(f"--machine-id must be between 0 and {MACHINE_MASK}")
        _atomic_write(path, f"{override}\n")
        return override
    if os.path.exists(path):
        with open(path, encoding="ascii") as f:
            return int(f.read().strip()) & MACHINE_MASK
    node = uuid.getnode()
    digest = hashlib.sha256(node.to_bytes(8, "big")).digest()
    mid = int.from_bytes(digest[:4], "big") & MACHINE_MASK
    _atomic_write(path, f"{mid}\n")
    sys.stderr.write(
        f"{_prog()}: assigned machine slot {mid} from this host's hardware id. "
        f"If you generate names on more than one machine, run "
        f"'{_prog()} --machine-id N' (a distinct 0..{MACHINE_MASK}) on each so "
        "names never collide across machines.\n"
    )
    return mid


def next_counter(sdir):
    lock_path = os.path.join(sdir, "counter.lock")
    counter_path = os.path.join(sdir, "counter")
    lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        current = 0
        if os.path.exists(counter_path):
            with open(counter_path, encoding="ascii") as f:
                raw = f.read().strip()
                if raw:
                    current = int(raw)
        if current >= COUNTER_CAP:
            die(
                f"counter exhausted for this machine ({COUNTER_CAP} names). "
                "Assign a fresh --machine-id to get a new range."
            )
        _atomic_write(counter_path, f"{current + 1}\n")
        return current
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="timvisher_mkname",
        description="Emit a unique, memorable adjective-noun name.",
    )
    parser.add_argument(
        "--prefix", default="", help="literal string prepended to the name"
    )
    parser.add_argument(
        "--separator",
        default="-",
        help="separator between adjective and noun (default: -)",
    )
    parser.add_argument(
        "--machine-id",
        type=int,
        default=None,
        help="assign/override this machine's slot (0..%d); persisted" % MACHINE_MASK,
    )
    args = parser.parse_args(argv)
    sep = args.separator
    if len(sep) != 1:
        die("--separator must be a single character")

    adjectives, nouns = load_wordlists()
    sdir = state_dir()
    os.makedirs(sdir, exist_ok=True)

    machine_id = resolve_machine_id(sdir, args.machine_id)
    counter = next_counter(sdir)

    block = (machine_id << COUNTER_BITS) | counter
    phrase_index = permute(block)
    adj_i, noun_i = divmod(phrase_index, NOUN_COUNT)

    name = f"{adjectives[adj_i]}{sep}{nouns[noun_i]}"
    if args.prefix:
        prefix = re.sub(r"\W+", lambda _m: sep, args.prefix).strip(sep)
        if prefix:
            name = f"{prefix}{sep}{name}"
    print(name)


if __name__ == "__main__":
    main()
