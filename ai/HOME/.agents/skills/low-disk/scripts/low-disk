#!/usr/bin/env bash

# shellcheck source=/dev/null
source ~/.functions/logging.bash ||
  {
    echo "Unable to source logging functions" >&2
    exit 1
  }

script_path=$(realpath "${BASH_SOURCE[0]}") ||
  die "Unable to resolve the low-disk script path"
script_dir=${script_path%/*}

plugin_dirs=(
  "${script_dir}/plugins"
  "${XDG_CONFIG_HOME:-${HOME}/.config}/timvisher/ide/low-disk/plugins"
)

# Matches timvisher_git's own cache location, which does not follow
# XDG_CACHE_HOME.
repo_trunks_dir=${HOME}/.cache/timvisher_git_worktrees/repo_trunks

tmux_socket_dir=${TMUX_TMPDIR:-/tmp}/tmux-${UID}

export LOW_DISK=$script_path

# Help text is printed with printf rather than a heredoc: bash may back a
# heredoc with a temp file, and low-disk has to work with no free space.
show_help() {
  printf '%s\n' \
    'Usage: low-disk <subcommand> [args...]' \
    '' \
    'Subcommands:' \
    '  measure [<plugin>...]          Print what each plugin finds and how much' \
    '                                 disk it uses, as one JSON object.' \
    '  reclaim <plugin>:<target>...   Ask each plugin to reclaim its targets and' \
    '                                 print what it did, as one JSON object.' \
    '  activity                       Print each timvisher_git worktree with its' \
    '                                 tmux sessions, whether a client is attached,' \
    '                                 and whether dev_ci protects it.' \
    '  size <path>...                 Print the disk each path uses, for plugins.' \
    '' \
    'Plugins are executables in:' \
    "  ${plugin_dirs[0]}" \
    "  ${plugin_dirs[1]}" \
    '' \
    'Exit status is non-zero when any plugin fails; its entry carries an' \
    '"error" field and the other plugins still report.'
}

usage() {
  show_help >&2
}

declare -A plugins=()
plugin_names=()

discover_plugins() {
  local dir path name
  for dir in "${plugin_dirs[@]}"
  do
    for path in "$dir"/*
    do
      [[ -f $path && -x $path ]] || continue
      name=${path##*/}
      [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
      if [[ -n ${plugins[$name]+x} ]]
      then
        die "Plugin '%s' is defined twice: '%s' and '%s'" "$name" "${plugins[$name]}" "$path"
      fi
      plugins[$name]=$path
      plugin_names+=("$name")
    done
  done
}

require_plugin() {
  [[ -n ${plugins[$1]+x} ]] ||
    die "Unknown plugin '%s'. Known plugins: %s" "$1" "${plugin_names[*]}"
}

run_plugin() {
  local name=$1 out rc
  shift
  out=$("${plugins[$name]}" "$@")
  rc=$?
  if (( rc != 0 ))
  then
    jq -nc --arg n "$name" --arg e "exited ${rc}" '{($n): {error: $e}}'
    return 1
  fi
  if ! printf '%s' "$out" | jq -se 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1
  then
    jq -nc --arg n "$name" --arg e 'did not print exactly one JSON object' '{($n): {error: $e}}'
    return 1
  fi
  printf '%s' "$out" | jq -c --arg n "$name" '{($n): .}'
}

collect() {
  jq -s '{plugins: (add // {})}'
}

canonical() {
  (cd -- "$1" 2>/dev/null && pwd -P)
}

# Worktree paths come from each cache's worktrees/*/gitdir file rather than
# `git worktree list`: plain reads, no git process, no git wrapper log write.
list_worktrees() {
  local -n __worktrees=$1 __repos=$2
  local gitdir_file worktree_git worktree relative org
  for gitdir_file in "$repo_trunks_dir"/*/*/worktrees/*/gitdir "$repo_trunks_dir"/*/*/.git/worktrees/*/gitdir
  do
    [[ -f $gitdir_file ]] || continue
    IFS= read -r worktree_git < "$gitdir_file" || continue
    [[ $worktree_git == /* ]] || worktree_git=${gitdir_file%/*}/${worktree_git}
    worktree=$(canonical "${worktree_git%/.git}") || continue
    [[ -z ${__repos[$worktree]+x} ]] || continue
    relative=${gitdir_file#"$repo_trunks_dir"/}
    org=${relative%%/*}
    relative=${relative#*/}
    __repos["$worktree"]=${org}/${relative%%/*}
    __worktrees+=("$worktree")
  done
}

list_protected() {
  local -n __protected=$1
  command -v timvisher_dev_ci >/dev/null 2>&1 || return 0
  local out path
  out=$(timvisher_dev_ci worktrees active) ||
    die 'timvisher_dev_ci worktrees active failed; refusing to report activity without the protection list'
  while IFS= read -r path
  do
    [[ -n $path ]] || continue
    path=$(canonical "$path") || continue
    __protected["$path"]=1
  done < <(printf '%s\n' "$out")
}

# Every socket in the tmux socket directory is asked, not just the default
# one, so sessions started with -L still count. Only a stale socket ("no
# server running") or one removed while we looked counts as having no
# sessions; anything else, such as a sandbox refusing the connection, fails
# rather than reporting attached worktrees as idle. Panes are listed rather
# than sessions so a pane that has cd'd into a worktree counts too. Fields
# are separated by \x1f, which session names and paths do not contain in
# practice; a line that does not split into four fields fails the command.
list_panes() {
  local -n __panes=$1
  [[ -e $tmux_socket_dir ]] || return 0
  [[ -d $tmux_socket_dir && -r $tmux_socket_dir && -x $tmux_socket_dir ]] ||
    die "Cannot read the tmux socket directory '%s'" "$tmux_socket_dir"
  local socket out rc line rest sockets=()
  for socket in "$tmux_socket_dir"/*
  do
    [[ -S $socket ]] && sockets+=("$socket")
  done
  (( 0 < ${#sockets[@]} )) || return 0
  command -v tmux >/dev/null 2>&1 ||
    die "tmux sockets exist in '%s' but tmux is not installed" "$tmux_socket_dir"
  for socket in "${sockets[@]}"
  do
    out=$(tmux -S "$socket" list-panes -a \
      -F $'#{session_attached}\x1f#{session_name}\x1f#{session_path}\x1f#{pane_current_path}' 2>&1)
    rc=$?
    if (( rc != 0 ))
    then
      [[ $out == *'no server running'* || $out == *'(No such file or directory)'* ]] && continue
      die "tmux list-panes on '%s' failed: %s" "$socket" "$out"
    fi
    while IFS= read -r line
    do
      [[ -n $line ]] || continue
      rest=${line//[^$'\x1f']/}
      [[ ${#rest} == 3 && ${line%%$'\x1f'*} =~ ^[0-9]+$ ]] ||
        die "Cannot parse tmux list-panes output from '%s': %s" "$socket" "$line"
      __panes+=("$line")
    done < <(printf '%s\n' "$out")
  done
}

cmd_activity() {
  local worktrees=() panes=()
  declare -A repos=() protected=()
  list_worktrees worktrees repos
  list_protected protected
  list_panes panes

  {
    local worktree failed=0
    for worktree in "${worktrees[@]}"
    do
      jq -nc --arg p "$worktree" --arg r "${repos[$worktree]}" \
        --argjson prot "$( [[ -n ${protected[$worktree]+x} ]] && echo true || echo false )" \
        '{kind: "worktree", path: $p, repo: $r, protected: $prot}' || failed=1
    done
    local line clients name pane_path attached
    for line in "${panes[@]}"
    do
      clients=${line%%$'\x1f'*}
      line=${line#*$'\x1f'}
      name=${line%%$'\x1f'*}
      line=${line#*$'\x1f'}
      attached=$( (( 0 < clients )) && echo true || echo false )
      for pane_path in "${line%%$'\x1f'*}" "${line#*$'\x1f'}"
      do
        pane_path=$(canonical "$pane_path") || continue
        for worktree in "${worktrees[@]}"
        do
          [[ $pane_path == "$worktree" || $pane_path == "$worktree"/* ]] || continue
          jq -nc --arg p "$worktree" --arg n "$name" --argjson a "$attached" \
            '{kind: "session", path: $p, name: $n, attached: $a}' || failed=1
        done
      done
    done
    exit "$failed"
  } | jq -s '
    reduce .[] as $r ({};
      if $r.kind == "worktree" then
        .[$r.path] = {repo: $r.repo, protected: $r.protected, attached: false, sessions: []}
      else
        .[$r.path].sessions |= (. + [{name: $r.name, attached: $r.attached}] | unique)
        | .[$r.path].attached = (.[$r.path].attached or $r.attached)
      end)
    | {worktrees: .}'
  (( PIPESTATUS[0] == 0 && PIPESTATUS[1] == 0 ))
}

# Each path is sized by its own du, in parallel because du is bound by
# filesystem metadata. Workers report an index into the argument list
# rather than the path, so every record stays far below PIPE_BUF and
# parallel writes cannot interleave, and paths holding tabs or newlines
# never pass through the pipe. -x keeps du off other mounts. du exits
# non-zero when it cannot read part of a tree; that size is reported as
# incomplete rather than dropped. GNU stat is tried before BSD stat because
# GNU's `stat -f` means something else and would not fail.
cmd_size() {
  (( 0 < $# )) ||
    {
      jq -n '{sizes: {}}'
      return
    }
  local jobs
  jobs=$(getconf _NPROCESSORS_ONLN) && [[ $jobs =~ ^[0-9]+$ ]] ||
    die 'Cannot tell how many processors to size paths with'
  local paths=("$@") i
  # shellcheck disable=SC2016 # the sh -c script expands its own variables
  for (( i = 0; i < ${#paths[@]}; i++ ))
  do
    printf '%d\0%s\0' "$i" "${paths[i]}"
  done |
    xargs -0 -n 2 -P "$jobs" sh -c '
      out=$(du -skx -- "$2" 2>/dev/null)
      rc=$?
      dev=$(stat -c %d -- "$2" 2>/dev/null || stat -f %d -- "$2" 2>/dev/null)
      printf "%s\t%s\t%s\t%s\n" "$1" "$rc" "${out%%	*}" "$dev"' size |
    {
      local index rc kib dev failed=0
      while IFS=$'\t' read -r index rc kib dev
      do
        [[ $index =~ ^[0-9]+$ && -n ${paths[index]+x} ]] || continue
        [[ $dev =~ ^[0-9]+$ ]] || dev=null
        if [[ $kib =~ ^[0-9]+$ ]]
        then
          jq -nc --arg p "${paths[index]}" --argjson b "$(( kib * 1024 ))" --argjson d "$dev" \
            --argjson i "$( (( rc == 0 )) && echo false || echo true )" \
            '{($p): {bytes: $b, incomplete: $i, device: $d}}' || failed=1
        else
          jq -nc --arg p "${paths[index]}" --argjson d "$dev" \
            '{($p): {bytes: null, incomplete: true, device: $d}}' || failed=1
        fi
      done
      exit "$failed"
    } |
    jq -s '{sizes: (add // {})}'
  (( PIPESTATUS[0] == 0 && PIPESTATUS[1] == 0 && PIPESTATUS[2] == 0 && PIPESTATUS[3] == 0 ))
}

cmd_measure() {
  local names=("$@") name failed=0
  (( 0 < ${#names[@]} )) || names=("${plugin_names[@]}")
  for name in "${names[@]}"
  do
    require_plugin "$name"
  done
  {
    for name in "${names[@]}"
    do
      run_plugin "$name" measure || failed=1
    done
    exit "$failed"
  } | collect
  (( PIPESTATUS[0] == 0 && PIPESTATUS[1] == 0 ))
}

cmd_reclaim() {
  (( 0 < $# )) ||
    {
      usage
      return 1
    }
  local spec name order=() failed=0
  declare -A seen=()
  for spec in "$@"
  do
    [[ $spec == *:* ]] ||
      die "Target '%s' is not of the form <plugin>:<target>" "$spec"
    name=${spec%%:*}
    require_plugin "$name"
    if [[ -z ${seen[$name]+x} ]]
    then
      seen[$name]=1
      order+=("$name")
    fi
  done
  local targets
  {
    for name in "${order[@]}"
    do
      targets=()
      for spec in "$@"
      do
        [[ ${spec%%:*} == "$name" ]] && targets+=("${spec#*:}")
      done
      run_plugin "$name" reclaim "${targets[@]}" || failed=1
    done
    exit "$failed"
  } | collect
  (( PIPESTATUS[0] == 0 && PIPESTATUS[1] == 0 ))
}

case ${1-} in
  -h|--help)
    show_help
    exit 0
    ;;
  measure)
    command -v jq >/dev/null 2>&1 || die 'jq is required but not found'
    discover_plugins
    shift
    cmd_measure "$@"
    exit
    ;;
  reclaim)
    command -v jq >/dev/null 2>&1 || die 'jq is required but not found'
    discover_plugins
    shift
    cmd_reclaim "$@"
    exit
    ;;
  activity)
    command -v jq >/dev/null 2>&1 || die 'jq is required but not found'
    cmd_activity
    exit
    ;;
  size)
    command -v jq >/dev/null 2>&1 || die 'jq is required but not found'
    shift
    cmd_size "$@"
    exit
    ;;
  *)
    usage
    exit 1
    ;;
esac
