#!/usr/bin/env bash

# Launch Emacs (or run a batch command) in a 'timvisher_tests --shell'
# HOME built from this worktree, so ~/.config/emacs is this worktree's
# emacs/emacs.d rather than ~/git/ide's.
#
# Usage:
#   emacs/tests/emacs [--overlay <system-extensions worktree>] [<emacs args>...]
#
# Run the config's ERT tests with
# 'bash/bin/timvisher_tests --suite bash/tests/emacs_ert' instead.
#
# When --batch is among the arguments, the script prepends the
# documented init-loading sequence:
#   --eval '(add-to-list (quote load-path) (expand-file-name "~/.config/emacs"))'
#   --eval "(require 'package)"
#   --eval "(package-initialize)"
#   --eval '(load "~/.config/emacs/init.el")'

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P) || exit 1

runner_args=()
if [[ ${1-} == --overlay ]]
then
    if [[ -z ${2-} ]]
    then
        echo 'emacs/tests/emacs: --overlay needs a path' >&2
        exit 1
    fi
    if ! overlay=$(cd "$2" && pwd -P)
    then
        echo "emacs/tests/emacs: no overlay at '$2'" >&2
        exit 1
    fi
    runner_args=(--overlay "$overlay")
    shift 2
fi

emacs_args=()
for arg in "$@"
do
    if [[ $arg == --batch ]]
    then
        emacs_args=(
            --eval '(add-to-list (quote load-path) (expand-file-name "~/.config/emacs"))'
            --eval "(require 'package)"
            --eval "(package-initialize)"
            --eval '(load "~/.config/emacs/init.el")'
        )
        break
    fi
done

# The runner starts --shell at the repo root; Emacs goes back to the
# caller's directory so relative file arguments mean what they did.
caller=$PWD
cd "$repo_root" || exit 1
# shellcheck disable=SC2016
exec "$repo_root/bash/bin/timvisher_tests" "${runner_args[@]}" \
    --shell bash -c 'cd "$1" && shift && exec emacs "$@"' _ "$caller" \
    "${emacs_args[@]}" "$@"
